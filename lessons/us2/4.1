</script>
  <script>
/* =========================================================================
   Optional Google Sheets loader.
   -------------------------------------------------------------------------
   Fetches Units / Inquiries / Entities from the CSV links in
   SHEETS_CONFIG (js/sheets-config.js) and merges them into COURSE_DATA
   before the page renders. Every step is independently wrapped so a
   problem with one sheet can't affect the others, or break the site —
   it just falls back to whatever data.js already has.

   Column headers are matched case-insensitively and ignore spaces, so
   "ID", "Id", and "id" are all the same column, and "Era Start" and
   "erastart" are too. The Units tab can use either a single "Era" column
   or split "Era Start" / "Era End" columns — whichever is present gets
   combined into one display string automatically.
   ========================================================================= */

function normalizeKey(k) {
  return k.toLowerCase().replace(/\s+/g, "");
}

// Returns a copy of a parsed CSV row with every key lowercased and spaces
// stripped, so column headers can be typed/cased however feels natural in
// the sheet without breaking the merge.
function normalizeRow(row) {
  const out = {};
  Object.keys(row).forEach(k => { out[normalizeKey(k)] = row[k]; });
  return out;
}

// How long a single sheet fetch gets before being given up on. A plain
// network error rejects fast on its own, but a sandboxed preview that
// silently blocks the request (rather than rejecting it) can leave fetch()
// hanging forever -- without this, the whole page would wait on it forever
// too, since rendering is gated on loadFromSheets() resolving. `let`
// (not `const`) so a test can dial it down instead of actually waiting.
let CSV_FETCH_TIMEOUT_MS = 5000;

async function fetchCsvRows(url) {
  if (!url) return null; // blank in config — nothing to do, not an error
  // Google sometimes refuses or drops a request (rate limiting, a tab that was just
  // published, a flaky connection). Retry a couple of times before giving up.
  const delays = [0, 700, 1800];
  let lastErr = null;
  for (let attempt = 0; attempt < delays.length; attempt++) {
    if (delays[attempt]) await new Promise(r => setTimeout(r, delays[attempt]));
    try {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), CSV_FETCH_TIMEOUT_MS);
      let res;
      try {
        res = await fetch(url, { signal: controller.signal });
      } finally {
        clearTimeout(timeoutId);
      }
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const text = await res.text();
      if (/^\s*<(!doctype|html)/i.test(text)) throw new Error("Got a web page instead of CSV (is this tab published?)");
      const parsed = Papa.parse(text, { header: true, skipEmptyLines: true });
      return parsed.data;
    } catch (err) {
      lastErr = err;
    }
  }
  console.warn(`Could not load sheet (${url}) — using data.js defaults instead:`, lastErr);
  return null;
}

function mergeUnitsFromSheet(rows) {
  const byId = {};
  rows.forEach(raw => {
    const r = normalizeRow(raw);
    const id = (r.id || "").trim();
    if (!id) return;

    const eraStart = (r.erastart || "").trim();
    const eraEnd = (r.eraend || "").trim();
    const singleEra = (r.era || "").trim();
    const era = singleEra || (eraStart && eraEnd ? `${eraStart}–${eraEnd}` : (eraStart || eraEnd || ""));

    byId[id] = {
      number: (r.number || "").trim(),
      title: (r.title || "").trim(),
      era,
      icon: (r.icon || r.iconurl || "").trim(),
      theme: (r.theme || "").trim(),
      lockTheme: isTruthy(r.sensitivelesson || r.sensitive || r.sensitiveunit || r.locktheme || r.themelock || r.lockedtheme)
    };
  });

  COURSE_DATA.units.forEach(unit => {
    const patch = byId[unit.id];
    if (!patch) return; // this unit isn't in the sheet — leave data.js's version alone
    if (patch.number) unit.number = isNaN(Number(patch.number)) ? patch.number : Number(patch.number);
    if (patch.title) unit.title = patch.title;
    if (patch.era) unit.era = patch.era;
    if (patch.icon) unit.icon = patch.icon;
    if (patch.theme) unit.theme = patch.theme;
    if (patch.lockTheme) unit.lockTheme = true; // every lesson in the unit keeps the sheet's theme (Teacher View can't override it)
  });
}

// Patches an existing lesson's number/title if its id matches one already
// in data.js — everything else about that lesson (readings, videos,
// questions, etc.) is left completely alone. If the id doesn't exist yet,
// creates a bare placeholder lesson (no content) in the given unit, so a
// whole unit's lesson names can be sketched out here before any real
// content is written. If that unit doesn't exist in data.js yet either, a
// minimal placeholder unit is created too — the Units sheet (merged right
// after this) will fill in its real number/title/era if it's listed there.
// Once the Lessons tab has ANY rows, it becomes the complete, authoritative
// list of lessons for the whole site — every lesson gets rebuilt from
// scratch based on what's in the sheet. A row whose id matches a lesson
// already in data.js keeps ALL of that lesson's existing content (readings,
// videos, questions, etc.) and just applies the sheet's number/title; a
// row with a new id creates a bare placeholder lesson instead.
//
// IMPORTANT: this means any lesson NOT listed in the sheet — even a
// fully-written one still sitting in data.js — will stop showing up on
// the site once the Lessons tab is in use. If the sheet is empty (no rows
// at all, or it failed to load), nothing changes and data.js is used as-is.
function mergeLessonsFromSheet(rows) {
  if (!rows.length) return;

  const oldById = {};
  COURSE_DATA.units.forEach(unit => {
    unit.lessons.forEach(lesson => { oldById[lesson.id] = lesson; });
  });

  COURSE_DATA.units.forEach(unit => { unit.lessons = []; });

  rows.forEach(raw => {
    const r = normalizeRow(raw);
    const id = (r.id || "").trim();
    const unitId = (r.unitid || "").trim();
    const title = (r.title || "").trim();
    const number = (r.number || "").trim();
    const icon = (r.icon || r.iconurl || "").trim();
    const theme = (r.theme || "").trim();
    const lockTheme = isTruthy(r.sensitivelesson || r.sensitive || r.sensitiveunit || r.locktheme || r.themelock || r.lockedtheme);
    if (!id || !unitId || !title) return;

    let unit = COURSE_DATA.units.find(u => u.id === unitId);
    if (!unit) {
      unit = { id: unitId, number: 999, title: unitId, era: "", lessons: [] };
      COURSE_DATA.units.push(unit);
    }

    const existing = oldById[id];
    if (existing) {
      existing.number = number || existing.number;
      existing.title = title || existing.title;
      if (icon) existing.icon = icon;
      existing.theme = theme || undefined;          // this lesson's own look (blank = the unit's)
      existing.lockTheme = lockTheme || undefined;  // checked = ignore Teacher View theme overrides here
      unit.lessons.push(existing);
    } else {
      unit.lessons.push({
        id,
        number: number || "?",
        title,
        icon: icon || undefined,
        theme: theme || undefined,
        lockTheme: lockTheme || undefined,
        inquiryFocus: [],
        mentions: [],
        keyTerms: [],
        objectives: [],
        readings: [],
        videos: [],
        images: [],
        assessment: []
      });
    }
  });

  COURSE_DATA.units.forEach(unit => {
    unit.lessons.sort((a, b) => String(a.number).localeCompare(String(b.number), undefined, { numeric: true }));
  });
  COURSE_DATA.units.sort((a, b) => String(a.number).localeCompare(String(b.number), undefined, { numeric: true }));
}

// Finds a lesson by id anywhere in COURSE_DATA, regardless of unit.
function findLessonById(id) {
  for (const unit of COURSE_DATA.units) {
    const lesson = unit.lessons.find(l => l.id === id);
    if (lesson) return lesson;
  }
  return null;
}

// ---------------------------------------------------------------------
// Matching what a teacher types in the Class Schedule tab to a lesson
// ---------------------------------------------------------------------
// A teacher types "2-1", "2.1", "Lesson 2.1" -- not necessarily the exact
// text in the Lessons tab's ID column. So a schedule entry matches, in
// this order: the exact ID; the ID after tidying (case, spaces, "." vs
// "-", leading zeros, a "Lesson" prefix); the lesson's Number the same
// way; and finally -- because Google Sheets quietly turns a typed "2-1"
// into the DATE Feb 1 -- the month-and-day of a date-looking entry.
function normalizeLessonKey(value) {
  let s = String(value == null ? "" : value).trim().toLowerCase();
  s = s.replace(/^(lesson|lsn)\s*/, "");
  s = s.replace(/[\s._/\\\u2013\u2014]+/g, "-"); // 2.1, 2 1, 2_1, 2/1, 2–1  ->  2-1
  return s.split("-").map(part => /^\d+$/.test(part) ? String(Number(part)) : part).join("-");
}

const MONTH_NUMBERS = { jan: 1, feb: 2, mar: 3, apr: 4, may: 5, jun: 6, jul: 7, aug: 8, sep: 9, oct: 10, nov: 11, dec: 12 };
function lessonKeyFromAutoDate(value) {
  const t = String(value == null ? "" : value).trim().toLowerCase();
  let m;
  if ((m = t.match(/^(\d{1,2})\/(\d{1,2})(?:\/\d{2,4})?$/))) return `${Number(m[1])}-${Number(m[2])}`;          // 2/1/2026
  if ((m = t.match(/^\d{4}-(\d{1,2})-(\d{1,2})$/))) return `${Number(m[1])}-${Number(m[2])}`;                  // 2026-02-01
  if ((m = t.match(/^([a-z]{3})[a-z]*[\s.-]+(\d{1,2})(?:[\s,.-]+\d{2,4})?$/)) && MONTH_NUMBERS[m[1]]) return `${MONTH_NUMBERS[m[1]]}-${Number(m[2])}`; // Feb 1
  if ((m = t.match(/^(\d{1,2})[\s.-]+([a-z]{3})[a-z]*(?:[\s,.-]+\d{2,4})?$/)) && MONTH_NUMBERS[m[2]]) return `${MONTH_NUMBERS[m[2]]}-${Number(m[1])}`; // 1-Feb
  return null;
}

// Class periods are matched loosely too, so a Roster that says "Period 2"
// still finds a Class Schedule row that says "2" (or "02", "2nd", "P2").
function normalizePeriodKey(value) {
  let s = String(value == null ? "" : value).trim().toLowerCase();
  s = s.replace(/^(period|per\.?|pd\.?|class|block)\s*|^p(?=\d)/, "");
  s = s.replace(/^(\d+)(st|nd|rd|th)$/, "$1").replace(/\s+/g, "");
  return /^\d+$/.test(s) ? String(Number(s)) : s;
}
// map is { periodName: value }; returns the value for `period`, matching exactly first.
function lookupByPeriod(map, period) {
  if (!map || period == null || period === "") return undefined;
  if (map[period] != null) return map[period];
  const key = normalizePeriodKey(period);
  const found = Object.keys(map).find(p => normalizePeriodKey(p) === key);
  return found === undefined ? undefined : map[found];
}

// Index in `ordered` (the flat list of { unit, lesson }) for a schedule entry, or -1.
function findLessonIndexByScheduleValue(ordered, value) {
  const raw = String(value == null ? "" : value).trim();
  if (!raw) return -1;
  let i = ordered.findIndex(o => o.lesson.id === raw);
  if (i >= 0) return i;
  const keys = [normalizeLessonKey(raw)];
  const dateKey = lessonKeyFromAutoDate(raw);
  if (dateKey) keys.push(dateKey);
  for (const key of keys) {
    i = ordered.findIndex(o => normalizeLessonKey(o.lesson.id) === key);
    if (i >= 0) return i;
    i = ordered.findIndex(o => normalizeLessonKey(o.lesson.number) === key);
    if (i >= 0) return i;
  }
  return -1;
}

// "Trusts; Gilded Age" -> ["Trusts", "Gilded Age"] (semicolon list, blanks dropped)
function splitList(cell) {
  return String(cell || "").split(/\s*;\s*/).map(x => x.trim()).filter(Boolean);
}
// A number typed in an order column, or undefined if blank / not a number.
function numberOrUndefined(cell) {
  const n = parseFloat(String(cell || "").trim());
  return isNaN(n) ? undefined : n;
}

function isTruthy(value) {
  return ["yes", "true", "y", "1"].includes((value || "").trim().toLowerCase());
}

// Pulls a 4-digit year out of a Timeline entry's Date text (handles
// things like "1900", "1900s", "1980 November", "1812-15" — takes the
// first year found). Returns null if nothing looks like a year.
function extractYear(dateText) {
  const match = (dateText || "").match(/\b(1[0-9]{3}|20[0-9]{2})\b/);
  return match ? Number(match[1]) : null;
}

// Applies one lesson's dedicated tab (Objective | Mention | Key Term
// columns, read independently by row) to that lesson. Only touches a
// field if its column actually has at least one non-blank value — an
// empty Mention column leaves mentions/keyTerms untouched, so a tab can
// fill in just objectives now and mentions later without wiping anything.
function applyLessonSheetRows(lesson, rows) {
  const objectives = [];
  const mentions = [];
  const keyTerms = [];
  const inquiries = [];
  const timelineFocus = [];
  let timelineStartYear = null;
  let timelineEndYear = null;
  const readings = [];
  const videos = [];
  const images = [];
  const assessment = [];
  const presetLabels = [];
  const termGroups = {}; // key-term groups: lowercase name -> { name, members: [{ id, order, pos }] }
  const pinnedTerms = []; // terms the teacher pinned from the sheet (Key Term Pin column) -- shown in every resource popup for this lesson
  let termPos = 0;
  const pendingQuestions = []; // resolved to a reading or the standalone list after the main pass
  const imagesByGallery = {}; // keyed by Gallery Name, or a unique key per standalone image
  let standaloneImageCount = 0;
  let sourceOrderCounter = 0; // stamped onto each reading/video/image so the site can display them in the same order as your sheet's rows, not grouped by type

  const assessmentLinks = []; // "Assessment Link" rows: links to Hexagon Web, the Stock Market Game, etc.
  let notesLink = "", notesTitle = "";   // teacher-only "Notes Link" column
  const lessonSkills = [];   // "Lesson Skills" column: skills EVERYONE works on in this lesson
  rows.forEach(raw => {
    const r = normalizeRow(raw);
    String(r.lessonskills || r.coreskills || r.lessonskill || "").split(/[;,]/).map(x => x.trim()).filter(Boolean)
      .forEach(x => { if (!lessonSkills.some(y => y.toLowerCase() === x.toLowerCase())) lessonSkills.push(x); });
    if (!notesLink) { notesLink = (r.noteslink || "").trim(); notesTitle = (r.notestitle || "").trim(); }
    const aLink = (r.assessmentlink || "").trim();
    if (aLink) {
      // Assessments are separate from Check Your Understanding. Hidden from students unless "Assessment Show" is checked.
      assessmentLinks.push({
        title: (r.assessmenttitle || "").trim(),
        description: (r.assessmentdescription || "").trim(),
        link: aLink,
        linkLabel: (r.assessmentlabel || r.assessmentbutton || "").trim(),
        visible: isTruthy(r.assessmentshow || r.assessmentvisible || r.showassessment),
        doNow: isTruthy(r.assessmentdonow)
      });
    }
    const objectiveText = (r.objective || "").trim();
    if (objectiveText) {
      objectives.push({ id: `${lesson.id}-o${objectives.length + 1}`, text: objectiveText });
    }
    const entityId = (r.mention || "").trim();
    if (entityId) {
      mentions.push(entityId);
      if (isTruthy(r.keyterm)) keyTerms.push(entityId);
      // Key Term Pin: tick it on a term's row to pin that term for every
      // student on this lesson (the same "Pinned terms" panel students
      // already get when they pin one themselves, just set ahead of time).
      if (isTruthy(r.keytermpin || r.keytermpinned || r.pinkeyterm || r.pinterm || r.pinned || r.pin) && !pinnedTerms.includes(entityId)) pinnedTerms.push(entityId);

      // Key Term Group: put this term in one or more named groups (several
      // separated by ;). A reading/video/image then names a group in its
      // own "... Term Group" column to show it side by side in its popup.
      // Key Term Order (optional number) orders terms within a group.
      const termOrder = numberOrUndefined(r.keytermorder);
      splitList(r.keytermgroup).forEach(groupName => {
        const key = groupName.toLowerCase();
        if (!termGroups[key]) termGroups[key] = { name: groupName, members: [] };
        if (!termGroups[key].members.some(m => m.id === entityId)) {
          termGroups[key].members.push({ id: entityId, order: termOrder, pos: termPos++ });
        }
      });
    }
    if (isTruthy(r.include || r.inquiryused)) {
      const inquiryId = (r.inquiryid || "").trim();
      if (inquiryId) inquiries.push(inquiryId);
    }
    const timelineId = (r.timelinefocus || r.timelineid || "").trim();
    if (timelineId) timelineFocus.push(timelineId);
    const startYearRaw = (r.timelinestartyear || "").trim();
    if (startYearRaw && !timelineStartYear) timelineStartYear = Number(startYearRaw);
    const endYearRaw = (r.timelineendyear || "").trim();
    if (endYearRaw && !timelineEndYear) timelineEndYear = Number(endYearRaw);

    // One preset label per row that has one — students saving a
    // highlight on this lesson see these offered first, before any
    // labels they've made themselves on this device. Color is
    // optional; leave it blank and one gets assigned automatically.
    const presetLabelName = (r.presetlabel || "").trim();
    if (presetLabelName) {
      const presetLabelColor = (r.presetlabelcolor || "").trim().toLowerCase();
      presetLabels.push({ name: presetLabelName, color: presetLabelColor || null });
    }

    // Each of these three is a full row of related columns — only counted
    // as a real reading/video/image if its title cell has something in it.
    const readingTitle = (r.readingtitle || "").trim();
    if (readingTitle) {
      readings.push({
        title: readingTitle,
        source: (r.readingsource || "").trim(),
        note: (r.readingnote || "").trim() || undefined,
        text: (r.readingtext || "").trim().split(/\s*\|\|\|\s*/).join("\n\n"),
        image: (r.readingimage || "").trim() || undefined,
        embedUrl: (r.readingembedurl || "").trim() || undefined,
        set: (r.readingset || "").trim() || undefined,
        setOrder: numberOrUndefined(r.setorder),
        order: numberOrUndefined(r.readingorder),
        termGroup: splitList(r.readingtermgroup),
        teacherPinned: isTruthy(r.sourcepin || r.pinsource || r.pinnedsource) || undefined,
        _order: sourceOrderCounter++
      });
    }

    const videoTitle = (r.videotitle || "").trim();
    if (videoTitle) {
      videos.push({
        title: videoTitle,
        length: (r.videolength || "").trim() || undefined,
        note: (r.videonote || "").trim() || undefined,
        src: (r.videosrc || "").trim(),
        image: (r.videoimage || "").trim() || undefined,
        set: (r.videoset || "").trim() || undefined,
        setOrder: numberOrUndefined(r.setorder),
        order: numberOrUndefined(r.videoorder),
        termGroup: splitList(r.videotermgroup),
        teacherPinned: isTruthy(r.sourcepin || r.pinsource || r.pinnedsource) || undefined,
        _order: sourceOrderCounter++
      });
    }

    // Original style: one row = one image or gallery, with a comma-list of
    // URLs in "Image Files". Still fully supported.
    const imageTitle = (r.imagetitle || "").trim();
    const imageFilesRaw = (r.imagefiles || "").trim();
    if (imageFilesRaw) {
      images.push({
        title: imageTitle,
        note: (r.imagenote || "").trim() || undefined,
        files: imageFilesRaw.split(",").map(s => s.trim()).filter(Boolean),
        set: (r.imageset || "").trim() || undefined,
        setOrder: numberOrUndefined(r.setorder),
        order: numberOrUndefined(r.imageorder),
        termGroup: splitList(r.imagetermgroup),
        teacherPinned: isTruthy(r.sourcepin || r.pinsource || r.pinnedsource) || undefined,
        _order: sourceOrderCounter++
      });
    }

    // Newer style: one row = one image URL. Rows sharing the same "Gallery
    // Name" get grouped into a single gallery; a blank Gallery Name makes
    // that row its own standalone image. "Image Caption" is per-row, shown
    // under whichever image is currently displayed.
    const imageUrl = (r.imageurl || "").trim();
    if (imageUrl) {
      const galleryName = (r.galleryname || "").trim();
      const key = galleryName || `__standalone_${standaloneImageCount++}`;
      if (!imagesByGallery[key]) {
        imagesByGallery[key] = { title: galleryName || imageTitle, note: undefined, files: [], _order: sourceOrderCounter++ };
      }
      const group = imagesByGallery[key];
      const imageCaption = (r.imagecaption || "").trim();
      group.files.push(imageCaption ? { src: imageUrl, caption: imageCaption } : imageUrl);
      if (!group.title && imageTitle) group.title = imageTitle;
      const rowNote = (r.imagenote || "").trim();
      if (!group.note && rowNote) group.note = rowNote;
      const rowSet = (r.imageset || "").trim();
      if (!group.set && rowSet) group.set = rowSet;
      if (group.setOrder === undefined) group.setOrder = numberOrUndefined(r.setorder);
      if (group.order === undefined) group.order = numberOrUndefined(r.imageorder);
      const rowTermGroups = splitList(r.imagetermgroup);
      if (rowTermGroups.length && !group.termGroup) group.termGroup = rowTermGroups;
      if (isTruthy(r.sourcepin || r.pinsource || r.pinnedsource)) group.teacherPinned = true;

    }

    // A question — one row = one question, only counted if Question
    // Prompt has something in it. "Question Objectives" references
    // objectives by their POSITION in this same tab's Objective column
    // (e.g. "1, 3"), not their real id — same as the Lesson Builder tool,
    // since the real ids aren't visible here and aren't worth memorizing.
    //
    // To attach this question to something specific instead of the
    // standalone "Check Your Understanding" list, fill in exactly ONE of:
    //   - Question Reading (+ Question After Paragraph) — drops it inside
    //     that reading, after the given paragraph (0 = after the 1st).
    //   - Question Video — shows it below that video, once it's playing.
    //   - Question Gallery — shows it below that image/gallery.
    // Each must exactly match a Title from this same tab. Leave all three
    // blank for a standalone question at the end of the lesson, same as
    // before.
    //
    // "Question Group" is optional. Give two or more questions AT THE
    // SAME SPOT (same reading+paragraph, same video, same gallery, or
    // all marked Do Now) the same group name, and they're answered one
    // after another as a sequence instead of all appearing separately.
    // Any exact text works as a group name — it just has to match
    // across the rows you want grouped. Leave it blank and a question
    // behaves exactly as it does today, on its own.
    const questionPrompt = (r.questionprompt || "").trim();
    if (questionPrompt) {
      const type = (r.questiontype || "multiple_choice").trim().toLowerCase();
      const q = { type, prompt: questionPrompt };

      const objNums = (r.questionobjectives || "").split(",").map(s => s.trim()).filter(Boolean);
      if (objNums.length) q.objectiveIds = objNums.map(n => `${lesson.id}-o${n}`);

      const questionImage = (r.questionimage || "").trim();
      if (questionImage) q.image = questionImage;

      const questionTermGroup = (r.questiontermgroup || "").trim();
      if (questionTermGroup) q.termGroup = questionTermGroup;

      const questionSkill = (r.questionskill || "").trim();
      if (questionSkill) q.skill = questionSkill;

      // Short-answer only: hold every student's answer back from OTHER
      // students until the teacher approves it (Teacher View -> Answers).
      // The student who wrote it always sees their own answer right away.
      if (isTruthy(r.questionrequiresapproval)) q.requiresApproval = true;

      // Questions sharing the same (non-blank) group, at the same spot
      // (same reading+paragraph, same video, same gallery, or all Do
      // Now questions for this lesson), get answered one after another
      // as a sequence instead of all showing separately.
      const questionGroup = (r.questiongroup || "").trim();
      if (questionGroup) q.group = questionGroup;

      if (type === "link") {
        q.link = (r.questionlink || "").trim();
        q.linkLabel = (r.questionlinklabel || "").trim();
      } else if (type === "short_answer") {
        q.sampleAnswer = (r.questionsampleanswer || "").trim();
      } else {
        q.choices = (r.questionchoices || "").split(/[,;]/).map(s => s.trim()).filter(Boolean);
        q.correctIndex = Number(r.questioncorrectindex) || 0;
        const expl = (r.questionexplanation || "").trim();
        if (expl) q.explanation = expl;
      }

      if (isTruthy(r.donow)) {
        if (!lesson.doNow) lesson.doNow = [];
        lesson.doNow.push(q); // shown automatically when this lesson opens — see maybeShowDoNow(); answered as a sequence if there's more than one
      } else {
        const targetReadingTitle = (r.questionreading || "").trim();
        const targetVideoTitle = (r.questionvideo || "").trim();
        const targetGalleryTitle = (r.questiongallery || "").trim();
        const afterParagraphRaw = (r.questionafterparagraph || "").trim();
        pendingQuestions.push({
          readingTitle: targetReadingTitle,
          videoTitle: targetVideoTitle,
          galleryTitle: targetGalleryTitle,
          afterParagraph: afterParagraphRaw !== "" ? (Number(afterParagraphRaw) || 0) : 0,
          question: q
        });
      }
    }
  });

  Object.values(imagesByGallery).forEach(group => images.push(group));

  // Now that every reading/video/image in this tab has been collected,
  // resolve each pending question to its target (matched by title) or
  // drop it into the standalone list if it didn't specify one.
  pendingQuestions.forEach(({ readingTitle, videoTitle, galleryTitle, afterParagraph, question }) => {
    if (readingTitle) {
      const target = readings.find(r => r.title.trim().toLowerCase() === readingTitle.toLowerCase());
      if (target) {
        question.afterParagraph = afterParagraph;
        if (!target.questions) target.questions = [];
        target.questions.push(question);
        return;
      }
      console.warn(`A question's "Question Reading" ("${readingTitle}") doesn't match any Reading Title in this tab — adding it to Check Your Understanding instead.`);
    } else if (videoTitle) {
      const target = videos.find(v => v.title.trim().toLowerCase() === videoTitle.toLowerCase());
      if (target) {
        if (!target.questions) target.questions = [];
        target.questions.push(question);
        return;
      }
      console.warn(`A question's "Question Video" ("${videoTitle}") doesn't match any Video Title in this tab — adding it to Check Your Understanding instead.`);
    } else if (galleryTitle) {
      const target = images.find(i => (i.title || "").trim().toLowerCase() === galleryTitle.toLowerCase());
      if (target) {
        if (!target.questions) target.questions = [];
        target.questions.push(question);
        return;
      }
      console.warn(`A question's "Question Gallery" ("${galleryTitle}") doesn't match any Image/Gallery Title in this tab — adding it to Check Your Understanding instead.`);
    }
    assessment.push(question);
  });

  if (objectives.length) lesson.objectives = objectives;
  if (lessonSkills.length) lesson.skills = lessonSkills;
  if (notesLink) { lesson.notesLink = notesLink; if (notesTitle) lesson.notesTitle = notesTitle; }
  // Students see at most MAX_QUESTIONS_PER_SOURCE questions on any one reading / video / image.
  [...readings, ...videos, ...images].forEach(src => {
    if (src.questions && src.questions.length > 5) console.warn(`"${src.title}" has ${src.questions.length} questions attached; students will only see 5 of them (focus-skill questions first).`);
  });
  if (mentions.length) {
    lesson.mentions = mentions;
    lesson.keyTerms = keyTerms;
    lesson.pinnedTerms = pinnedTerms;
  }
  if (inquiries.length) lesson.inquiryFocus = inquiries;
  if (timelineFocus.length) {
    lesson.timelineFocus = timelineFocus;
  } else if (timelineStartYear !== null) {
    const endYear = timelineEndYear !== null ? timelineEndYear : timelineStartYear;
    const matches = COURSE_DATA.timeline
      .filter(t => {
        const year = extractYear(t.date);
        return year !== null && year >= timelineStartYear && year <= endYear;
      })
      .map(t => t.id);
    if (matches.length) lesson.timelineFocus = matches;
    else console.warn(`No timeline entries found between ${timelineStartYear} and ${endYear} for lesson "${lesson.id}".`);
  }
  if (readings.length) lesson.readings = readings;
  if (videos.length) lesson.videos = videos;
  if (images.length) lesson.images = images;
  if (assessmentLinks.length) lesson.assessments = assessmentLinks;
  if (assessment.length) lesson.assessment = assessment;
  if (presetLabels.length) lesson.presetLabels = presetLabels;
  const termGroupList = Object.values(termGroups);
  if (termGroupList.length) lesson.termGroups = termGroupList;
}

// Loads every lesson's dedicated tab listed in LESSON_SHEETS (js/sheets-config.js).
// Each is fetched and applied independently, so one bad/unreachable tab
// only affects that one lesson.
// Lesson content tabs load lazily, one at a time, instead of all of
// them up front — the first page load only needs the lesson actually
// being shown, so this is what keeps that fast even as more lesson
// tabs get added. loadedLessonSheets tracks which ones are already in
// (skip re-fetching); lessonSheetLoadPromises tracks ones currently in
// flight, so navigating to the same lesson twice quickly shares one
// fetch instead of starting a second.
const loadedLessonSheets = new Set();
const lessonSheetLoadPromises = {};

// Lesson JSON (made with lesson-composer.html): if LESSON_JSON_BASE_URL is set, a lesson's
// JSON file at <base>/<lesson id>.json is used first; the sheet tab is only the fallback.
async function loadLessonJson(lessonId) {
  if (typeof LESSON_JSON_BASE_URL === "undefined" || !LESSON_JSON_BASE_URL) return false;
  const lesson = findLessonById(lessonId);
  if (!lesson) return false;
  try {
    // Accepts 2-3.json, 2.3.json, or a file with no extension (2.3 / 2-3), so however the file was named it is found.
    const base = LESSON_JSON_BASE_URL.replace(/\/+$/, "");
    const dotted = String(lessonId).replace(/-/g, ".");
    const names = [lessonId + ".json", dotted + ".json", dotted, lessonId];
    let res = null;
    for (const n of names) {
      const r = await fetch(base + "/" + encodeURIComponent(n), { cache: "no-cache" });
      if (r.ok) { res = r; break; }
    }
    if (!res) return false; // no file for this lesson yet -> fall back to the sheet
    const j = await res.json();
    clearExampleContent(lesson);
    const skip = new Set(["schemaVersion", "id", "timelineStartYear", "timelineEndYear"]);
    Object.keys(j).forEach(k => { if (!skip.has(k)) lesson[k] = j[k]; });
    if (!lesson.timelineFocus && j.timelineStartYear != null) {
      const end = j.timelineEndYear != null ? j.timelineEndYear : j.timelineStartYear;
      const m = COURSE_DATA.timeline.filter(t => { const y = extractYear(t.date); return y !== null && y >= j.timelineStartYear && y <= end; }).map(t => t.id);
      if (m.length) lesson.timelineFocus = m;
    }
    return true;
  } catch (err) {
    console.warn(`Lesson JSON for "${lessonId}" couldn't be used, trying the sheet instead:`, err);
    return false;
  }
}

async function loadLessonSheet(lessonId) {
  if (typeof LESSON_SHEETS === "undefined") return;
  if (loadedLessonSheets.has(lessonId)) return;
  if (lessonSheetLoadPromises[lessonId]) return lessonSheetLoadPromises[lessonId];
  if (typeof LESSON_JSON_BASE_URL !== "undefined" && LESSON_JSON_BASE_URL) {
    lessonSheetLoadPromises[lessonId] = (async () => {
      try { if (await loadLessonJson(lessonId)) { loadedLessonSheets.add(lessonId); return; } }
      finally { delete lessonSheetLoadPromises[lessonId]; }
      return loadLessonSheetFromTab(lessonId);
    })();
    return lessonSheetLoadPromises[lessonId];
  }
  return loadLessonSheetFromTab(lessonId);
}

async function loadLessonSheetFromTab(lessonId) {
  if (typeof LESSON_SHEETS === "undefined") return;
  if (loadedLessonSheets.has(lessonId)) return;
  let url = LESSON_SHEETS[lessonId];
  if (!url) { // tolerate stray spaces / capitals / en-dash vs hyphen in the Sheet Index name
    const norm = x => String(x).trim().toLowerCase().replace(/[\u2010-\u2015]/g, "-").replace(/\s+/g, "");
    const k = Object.keys(LESSON_SHEETS).find(n => norm(n) === norm(lessonId));
    if (k) url = LESSON_SHEETS[k];
  }
  if (!url) { console.warn(`No Sheet Index row matches lesson "${lessonId}" — its tab can't load. Check the Name column spelling.`); return; } // nothing registered for this lesson — data.js defaults apply, nothing to fetch

  if (lessonSheetLoadPromises[lessonId]) return lessonSheetLoadPromises[lessonId];

  lessonSheetLoadPromises[lessonId] = (async () => {
    try {
      const rows = await fetchCsvRows(url);
      const lesson = findLessonById(lessonId);
      if (!lesson) {
        if (rows) console.warn(`LESSON_SHEETS has an entry for "${lessonId}", but no such lesson exists — skipping.`);
        return;
      }
      if (!rows) {
        // Unreachable: show an example of every content type instead of an empty lesson.
        if (SHOW_EXAMPLE_WHEN_UNREACHABLE && lessonHasNoContent(lesson)) applyExampleContent(lesson);
        return;
      }
      clearExampleContent(lesson); // a retry that worked: drop any example content first
      applyLessonSheetRows(lesson, rows);
      loadedLessonSheets.add(lessonId);
    } catch (err) {
      console.warn(`Could not load the sheet for lesson "${lessonId}", using data.js defaults instead:`, err);
    } finally {
      delete lessonSheetLoadPromises[lessonId];
    }
  })();

  return lessonSheetLoadPromises[lessonId];
}

function mergeInquiriesFromSheet(rows) {
  const parsed = rows
    .map(raw => {
      const r = normalizeRow(raw);
      const question = (r.question || r.inquiry || "").trim();
      return { id: (r.id || "").trim(), question };
    })
    .filter(r => r.id && r.question);
  if (parsed.length) COURSE_DATA.inquiries = parsed;
}

// Student ID -> Class Period, from the Roster tab.
function mergeRosterFromSheet(rows) {
  const roster = {};
  const rosterNames = {};
  const restrictedToPresetLabels = {};
  const rosterStarred = {};
  const rosterSkills = {};
  rows.forEach(raw => {
    const r = normalizeRow(raw);
    const studentId = (r.studentid || "").trim();
    if (!studentId) return;
    const classPeriod = (r.classperiod || "").trim();
    if (classPeriod) roster[studentId] = classPeriod;
    const name = (r.name || "").trim();
    if (name) rosterNames[studentId] = name;
    if (isTruthy(r.restricttopresetlabels)) restrictedToPresetLabels[studentId] = true;
    if (isTruthy(r.star) || isTruthy(r.starred)) rosterStarred[studentId] = true;
    // "Focus Skills": skills this student gets extra questions for (separate several with ; or ,)
    const focus = String(r.focusskills || r.focusskill || r.skills || "").split(/[;,]/).map(x => x.trim()).filter(Boolean);
    if (focus.length) rosterSkills[studentId] = focus;
  });
  COURSE_DATA.rosterSkills = rosterSkills;
  COURSE_DATA.roster = roster;
  COURSE_DATA.rosterNames = rosterNames;
  COURSE_DATA.restrictedToPresetLabels = restrictedToPresetLabels;
  COURSE_DATA.rosterStarred = rosterStarred;
}

// Class Period -> the lesson id that period is currently on, from the
// Class Schedule tab. A teacher updates this by hand as each period
// progresses; a student's roster lookup then points here to find which
// lesson to open automatically.
function mergeClassScheduleFromSheet(rows) {
  const schedule = {};
  rows.forEach(raw => {
    const r = normalizeRow(raw);
    const classPeriod = (r.classperiod || "").trim();
    const lessonId = (r.currentlessonid || "").trim();
    if (classPeriod && lessonId) schedule[classPeriod] = lessonId;
  });
  COURSE_DATA.classSchedule = schedule;
}

function mergeEntitiesFromSheet(rows) {
  const parsed = rows
    .map(raw => {
      const r = normalizeRow(raw);
      const image = (r.image || "").trim();
      // "Role" (for people, e.g. President, Muckraker) and "Type" (for
      // topics, e.g. Law, Event, Belief) are two column names for the
      // same idea — whichever one is filled in becomes this entity's
      // subcategory, used to keep quiz distractors sensible (a
      // president's wrong answers are other presidents, not muckrakers).
      const subcategory = (r.role || r.type || "").trim();
      const actionsRaw = (r.actions || "").trim();
      const actions = actionsRaw ? actionsRaw.split(/\s*\|\|\|\s*/).filter(Boolean) : [];
      return {
        id: (r.id || "").trim(),
        name: (r.name || "").trim(),
        category: (r.category || "").trim(),
        subcategory: subcategory || undefined,
        definition: (r.definition || "").trim(),
        actions,
        image: image || undefined
      };
    })
    .filter(r => r.id && r.name);
  if (parsed.length) COURSE_DATA.entities = parsed;
}

function mergeTimelineFromSheet(rows) {
  const parsed = rows
    .map(raw => {
      const r = normalizeRow(raw);
      // "Title" is the short label shown right on the timeline strip;
      // "Details" is the longer description, only shown once a student
      // clicks that entry. Falls back to the old "Event" column (used
      // as both title and details) for sheets that haven't switched
      // over yet, so nothing breaks if you leave it as-is.
      const title = (r.title || r.event || "").trim();
      const details = (r.details || r.event || "").trim();
      return {
        id: (r.id || "").trim(),
        date: (r.date || "").trim(),
        title,
        details,
        category: (r.category || "").trim() || undefined
      };
    })
    .filter(r => r.id && r.date && r.title);
  if (parsed.length) COURSE_DATA.timeline = parsed;
}

// Call this once, before renderIndex()/renderLesson(). Always resolves —
// never throws — so the page always ends up rendering either way.
// Matches a Sheet Index row's Name column (once lowercased and stripped
// of spaces, same as normalizeKey) to the SHEETS_CONFIG key it should
// update. Anything that doesn't match one of these is assumed to be a
// lesson id and goes into LESSON_SHEETS instead.
const SHEET_INDEX_GLOBAL_TABS = {
  units: "unitsCsvUrl",
  inquiries: "inquiriesCsvUrl",
  entities: "entitiesCsvUrl",
  lessons: "lessonsCsvUrl",
  timeline: "timelineCsvUrl",
  roster: "rosterCsvUrl",
  classschedule: "classScheduleCsvUrl",
  themes: "themesCsvUrl"
};

async function loadSheetIndex() {
  if (typeof SHEET_INDEX_GID === "undefined" || !SHEET_INDEX_GID) return;
  const rows = await fetchCsvRows(sheetUrl(SHEET_INDEX_GID));
  if (!rows) return;

  rows.forEach(raw => {
    const r = normalizeRow(raw);
    const name = (r.name || "").trim();
    const gid = (r.gid || "").trim();
    if (!name || !gid) return;

    // "Guess Who ..." rows belong to guess-who.html (each one is a
    // board), not to any lesson — skip them here so they're never
    // mistaken for a lesson id and fetched for nothing.
    if (normalizeKey(name).startsWith("guesswho")) return;

    // Same for "Propaganda ..." rows: each is a set of images for
    // propaganda-match.html, not a lesson.
    if (normalizeKey(name).startsWith("propaganda")) return;

    // The "Hexagons" tab belongs to hexagon-web.html, not to any lesson.
    if (normalizeKey(name).startsWith("hexagon") || normalizeKey(name).startsWith("hexweb")) return;

    const configKey = SHEET_INDEX_GLOBAL_TABS[normalizeKey(name)];
    if (configKey) {
      SHEETS_CONFIG[configKey] = sheetUrl(gid);
    } else {
      LESSON_SHEETS[name] = sheetUrl(gid); // treated as a lesson id, matched exactly as typed
    }
  });
}

async function loadFromSheets() {
  if (typeof SHEETS_CONFIG === "undefined") return;

  try { await loadSheetIndex(); } catch (err) { console.warn("Could not load the Sheet Index — falling back to hardcoded gids:", err); }

  const [unitsRows, inquiriesRows, entitiesRows, lessonsRows, timelineRows, rosterRows, classScheduleRows, themesRows] = await Promise.all([
    fetchCsvRows(SHEETS_CONFIG.unitsCsvUrl),
    fetchCsvRows(SHEETS_CONFIG.inquiriesCsvUrl),
    fetchCsvRows(SHEETS_CONFIG.entitiesCsvUrl),
    fetchCsvRows(SHEETS_CONFIG.lessonsCsvUrl),
    fetchCsvRows(SHEETS_CONFIG.timelineCsvUrl),
    fetchCsvRows(SHEETS_CONFIG.rosterCsvUrl),
    fetchCsvRows(SHEETS_CONFIG.classScheduleCsvUrl),
    fetchCsvRows(SHEETS_CONFIG.themesCsvUrl)
  ]);

  // Lessons first — it may create placeholder units for lessons whose unit
  // doesn't exist in data.js yet — then Units, so it can patch the real
  // number/title/era onto both existing AND any newly-created units.
  try { if (lessonsRows) mergeLessonsFromSheet(lessonsRows); } catch (err) { console.warn("Lessons sheet merge failed, using data.js defaults:", err); }
  try { if (unitsRows) mergeUnitsFromSheet(unitsRows); } catch (err) { console.warn("Units sheet merge failed, using data.js defaults:", err); }
  try { if (inquiriesRows) mergeInquiriesFromSheet(inquiriesRows); } catch (err) { console.warn("Inquiries sheet merge failed, using data.js defaults:", err); }
  try { if (entitiesRows) mergeEntitiesFromSheet(entitiesRows); } catch (err) { console.warn("Entities sheet merge failed, using data.js defaults:", err); }
  try { if (timelineRows) mergeTimelineFromSheet(timelineRows); } catch (err) { console.warn("Timeline sheet merge failed, using data.js defaults:", err); }
  try { if (rosterRows) mergeRosterFromSheet(rosterRows); } catch (err) { console.warn("Roster sheet merge failed:", err); }
  try { if (classScheduleRows) mergeClassScheduleFromSheet(classScheduleRows); } catch (err) { console.warn("Class Schedule sheet merge failed:", err); }

  try { if (themesRows) mergeThemesFromSheet(themesRows); } catch (err) { console.warn("Themes sheet merge failed:", err); }

  applyExampleLessonIfEmpty();
}

// Themes tab -> THEME_SETTINGS { themeId: { type, hidden, units:[], months:[1-12] } }.
// Only themes with a row are listed; the app falls back to built-in types for the rest.
var THEME_SETTINGS = (typeof DEFAULT_THEME_SETTINGS !== "undefined") ? JSON.parse(JSON.stringify(DEFAULT_THEME_SETTINGS)) : {};
const MONTH_NAMES = ["jan","feb","mar","apr","may","jun","jul","aug","sep","oct","nov","dec"];
function parseMonthToken(t) {
  t = String(t || "").trim().toLowerCase().replace(/\./g, "");
  if (!t) return 0;
  if (/^\d+$/.test(t)) { const n = parseInt(t, 10); return n >= 1 && n <= 12 ? n : 0; }
  const i = MONTH_NAMES.indexOf(t.slice(0, 3));
  return i >= 0 ? i + 1 : 0;
}
// "Oct", "Oct-Nov", "Dec-Jan", "10, 11", "October to November" -> [10], [10,11], [12,1] ...
function parseMonths(text) {
  const out = new Set();
  String(text || "").split(/[,;\/&]+|\band\b/i).forEach(part => {
    const range = part.split(/\s*(?:-|\u2013|\u2014|\bto\b|\bthrough\b)\s*/i).filter(Boolean);
    if (range.length >= 2) {
      const a = parseMonthToken(range[0]), b = parseMonthToken(range[range.length - 1]);
      if (a && b) { for (let m = a, n = 0; n < 12; n++, m = m % 12 + 1) { out.add(m); if (m === b) break; } }
    } else if (range.length === 1) {
      const m = parseMonthToken(range[0]);
      if (m) out.add(m);
    }
  });
  return Array.from(out);
}
function mergeThemesFromSheet(rows) {
  const norm = x => String(x || "").toLowerCase().replace(/[^a-z0-9]/g, "");
  const cat = (typeof SITE_THEMES !== "undefined") ? SITE_THEMES : {};
  const settings = {};
  rows.forEach(raw => {
    const r = normalizeRow(raw);
    const key = norm(r.id || r.name || r.theme);
    const keyAlt = norm(r.name);
    const id = Object.keys(cat).find(i => norm(i) === key || norm(cat[i].label) === key || norm(i) === keyAlt || norm(cat[i].label) === keyAlt);
    if (!id) return;
    const typeRaw = norm(r.type || r.kind || r.category);
    const type = typeRaw.startsWith("stud") ? "student" : typeRaw.startsWith("seas") ? "seasonal" : typeRaw.startsWith("unit") ? "unit" : "";
    const unitsText = String(r.units || r.unit || r.unitid || r.unitnumber || "").trim();
    settings[id] = {
      type,
      hidden: isTruthy(r.hidden || r.hide || r.hidefromstudents),
      units: unitsText ? unitsText.split(/[,;&]+/).map(x => x.trim().toLowerCase().replace(/^unit\s*/, "")).filter(Boolean) : [],
      months: parseMonths(r.months || r.month || r.when)
    };
  });
  THEME_SETTINGS = settings;
}

// ---------------------------------------------------------------------
// EXAMPLE CONTENT (shown when a spreadsheet can't be reached)
// ---------------------------------------------------------------------
// If a lesson's tab can't be fetched (offline, previewing inside Claude,
// Apps Script not set up yet...), that lesson is filled with one example
// of EVERY kind of content so you can see how everything looks. If the
// whole Lessons tab is unreachable, one example lesson is created.
// Everything here is self-contained: images are inline SVGs, so nothing
// depends on files existing next to the page. A lesson filled this way
// is flagged isExample, shows a notice, and never logs answers to
// Firebase or the spreadsheet. If the real tab loads later, the example
// content is wiped first so none of it lingers.
const SHOW_EXAMPLE_WHEN_UNREACHABLE = true;

function exampleImg(label, bg, fg) {
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="640" height="400" viewBox="0 0 640 400">` +
    `<rect width="640" height="400" fill="${bg}"/>` +
    `<rect x="14" y="14" width="612" height="372" fill="none" stroke="${fg}" stroke-width="4" stroke-dasharray="14 10"/>` +
    `<text x="320" y="210" text-anchor="middle" font-family="Georgia,serif" font-size="38" fill="${fg}">${label}</text></svg>`;
  return "data:image/svg+xml;utf8," + encodeURIComponent(svg);
}

function ensureExampleEntities() {
  const defs = [
    { id: "ex-person", name: "Example Person", category: "person", definition: "A sample person entry. Real ones come from your Entities tab.", image: exampleImg("Person", "#E8D9B5", "#8C3B2E") },
    { id: "ex-topic", name: "Example Topic", category: "topic", definition: "A sample topic entry, shown as a key term.", image: exampleImg("Topic", "#D5E3D8", "#3F5443") },
    { id: "ex-topic2", name: "Second Example Topic", category: "topic", definition: "Another topic, so the term group has more than one member.", image: exampleImg("Topic 2", "#D4E4EC", "#2E6E8E") },
    { id: "ex-event", name: "Example Event", category: "event", definition: "A sample event entry.", image: exampleImg("Event", "#EADBC0", "#8C6A2F") }
  ];
  defs.forEach(d => { if (!COURSE_DATA.entities.some(e => e.id === d.id)) COURSE_DATA.entities.push(d); });
}

function buildExampleLessonContent() {
  ensureExampleEntities();
  const gal = [
    { src: exampleImg("Gallery 1", "#E8D9B5", "#8C3B2E"), caption: "Caption for the first gallery image." },
    { src: exampleImg("Gallery 2", "#D5E3D8", "#3F5443"), caption: "Caption for the second gallery image." },
    { src: exampleImg("Gallery 3", "#D4E4EC", "#2E6E8E"), caption: "Caption for the third gallery image." }
  ];
  return {
    icon: exampleImg("Icon", "#E8D9B5", "#1B2430"),
    mentions: ["ex-person", "ex-topic", "ex-topic2", "ex-event"],
    keyTerms: ["ex-person", "ex-topic", "ex-topic2", "ex-event"],
    pinnedTerms: ["ex-topic"],
    termGroups: [{ name: "Example Term Group", members: [{ id: "ex-topic", pos: 0 }, { id: "ex-topic2", pos: 1 }] }],
    inquiryFocus: ["inq1", "inq2"],
    presetLabels: [{ name: "Cause", color: null }, { name: "Effect", color: null }],
    objectives: [
      { id: "ex-o1", text: "Example objective: explain how each type of content appears on the page." },
      { id: "ex-o2", text: "Example objective: try every question type below." }
    ],
    doNow: [
      { type: "multiple_choice", prompt: "Do Now example (multiple choice): which option is correct?", choices: ["This one", "Not this", "Nor this", "Or this"], correctIndex: 0, explanation: "Explanations appear after a student answers.", skill: "Comprehension", group: "Warm-up" },
      { type: "short_answer", prompt: "Do Now example (short answer, same group): what do you already know about this topic?", sampleAnswer: "A sample answer is revealed after the student submits.", skill: "Analysis", group: "Warm-up" }
    ],
    readings: [
      {
        title: "Example Reading (in a set)", source: "Example source", note: "Readings can have a note, an image, and questions inside the text.",
        set: "Example Set", setOrder: 1, order: 1, termGroup: ["Example Term Group"], image: exampleImg("Reading image", "#EADBC0", "#8C6A2F"),
        text: "# Heading 1\n\n## Heading 2\n\n### Heading 3\n\nThis is the first paragraph of an example reading. Students can highlight text and attach notes to it.\n\nA question appears after this paragraph, in the middle of the reading.\n\n> A block quote looks like this.\n\n^ The Whistle at Dawn\n\n~ The whistle blows before the sun,\n  the doors swing wide, the day begun;\nand down the street the workers go\nto where the silent engines glow.\n\n~ The shift is long, the pay is small,\nbut still they answer when they call.\n\n-- An original example verse\n\n! A callout box, for a note or a tip.\n\n- A bulleted list item\n- Another item\n- And a third\n\n---\n\nThis is the last paragraph. Real readings come from the Reading Text column, with ||| between blocks.",
        questions: [{ type: "multiple_choice", prompt: "In-reading question: where does this question appear?", choices: ["After paragraph 1", "At the very end", "Above the title"], correctIndex: 0, explanation: "Question After Paragraph controls this (the count includes headings and every other block).", skill: "Comprehension", afterParagraph: 3 }],
        _order: 0
      },
      {
