// Teacher View -> My Notes tab: the SAME body-builder as above, reused so
// the teacher's own saved highlights show up there instead of behind a
// second, redundant button just for them.
async function buildMyNotesSection() {
  let notes = await getNotes();
  const labels = await getLabels();

  let filterUnit = "";
  let filterLesson = "";
  let filterLabel = "";

  function option(value, text) { return el("option", { value }, text); }

  const unitSeen = [], lessonSeen = [], labelSeen = new Set();
  notes.forEach(n => {
    if (n.unitNumber && !unitSeen.some(u => u.num === n.unitNumber)) {
      unitSeen.push({ num: n.unitNumber, title: n.unitTitle });
    }
    if (n.lessonNumber && !lessonSeen.some(l => l.num === n.lessonNumber)) {
      lessonSeen.push({ num: n.lessonNumber, title: n.lessonTitle });
    }
    if (n.label) labelSeen.add(n.label);
  });

  const unitSelect = el("select", { class: "notes-filter" }, [
    option("", "All Units"),
    ...unitSeen.map(u => option(u.num, `Unit ${u.num}`))
  ]);
  const lessonSelect = el("select", { class: "notes-filter" }, [
    option("", "All Lessons"),
    ...lessonSeen.map(l => option(l.num, `Lesson ${l.num}`))
  ]);
  const labelSelect = el("select", { class: "notes-filter" }, [
    option("", "All Labels"),
    ...[...labelSeen].sort().map(l => option(l, l))
  ]);
  const clearBtn = el("button", { type: "button", class: "notes-filter-clear" }, "Clear");

  const listContainer = el("div", {});

  function applyFilters() {
    const filtered = notes.filter(n =>
      (!filterUnit || n.unitNumber === filterUnit) &&
      (!filterLesson || n.lessonNumber === filterLesson) &&
      (!filterLabel || n.label === filterLabel)
    );
    listContainer.innerHTML = "";
    if (!filtered.length) {
      listContainer.appendChild(el("p", { class: "empty-note" },
        notes.length
          ? "No notes match these filters."
          : 'No notes yet \u2014 select text inside a reading, then tap "Save to Notes."'
      ));
      return;
    }
    listContainer.appendChild(el("div", { class: "notes-list" },
      filtered.map(n => buildNoteItem(n, labels, handleRemoved))
    ));
  }

  function handleRemoved() {
    notes = notesCache; // removeNote() already updated notesCache; pick up the change
    applyFilters();
  }

  unitSelect.addEventListener("change", e => { filterUnit = e.target.value; applyFilters(); });
  lessonSelect.addEventListener("change", e => { filterLesson = e.target.value; applyFilters(); });
  labelSelect.addEventListener("change", e => { filterLabel = e.target.value; applyFilters(); });
  clearBtn.addEventListener("click", () => {
    filterUnit = filterLesson = filterLabel = "";
    unitSelect.value = ""; lessonSelect.value = ""; labelSelect.value = "";
    applyFilters();
  });

  applyFilters();

  return notes.length
    ? el("div", {}, [el("div", { class: "notes-filter-bar" }, [unitSelect, lessonSelect, labelSelect, clearBtn]), listContainer])
    : el("div", {}, [listContainer]);
}

function openTextModal(reading, glossaryTerms, lesson, unit) {
  closeModal();
  const windowKey = sourceWindowKey("Reading", lesson, reading.title);
  if (focusExistingSourceWindow(windowKey)) return; // already open (or minimized) -- just bring it forward

  const glossary = buildGlossary(glossaryTerms);
  const glossaryStrip = el("div", { class: "glossary-strip" }, "Tap any term this course covers for its definition — pin the ones you want to keep in view.");

  function showDefinition(termData) {
    if (!termData) return;
    glossaryStrip.classList.remove("loading");
    glossaryStrip.innerHTML = "";
    const shown = [termData];
    shown.forEach((t, i) => {
      const block = el("div", { class: "glossary-strip-block" });
      if (t.image) {
        block.appendChild(el("img", { class: "glossary-strip-img", src: t.image, alt: "" }));
      }
      block.appendChild(el("strong", {}, t.term));
      if (t.id) block.appendChild(buildPinButton(t.id));
      if (t.actions) {
        block.appendChild(el("ul", { class: "glossary-strip-actions" }, t.actions.map(a => el("li", {}, a))));
      } else {
        block.appendChild(el("span", {}, " — " + t.def));
      }
      glossaryStrip.appendChild(block);
    });
    glossaryStrip.classList.add("active");
  }

  const rawParagraphs = (reading.text || "").split(/\n\s*\n/).map(p => p.trim());
  const readingQuestions = questionsForStudent(reading.questions, lesson, { cap: true });
  const contentNodes = [];
  rawParagraphs.forEach((raw, i) => {
    const block = classifyReadingBlock(raw);
    if (block.kind === "divider") {
      contentNodes.push(el("hr", { class: block.cls }));
    } else if (block.kind === "list") {
      contentNodes.push(el(block.tag, { class: block.cls }, block.items.map(item => renderInteractiveParagraph(item, glossary, showDefinition, "li"))));
    } else {
      contentNodes.push(renderInteractiveParagraph(block.text, glossary, showDefinition, block.tag, block.cls));
    }
    groupQuestions(readingQuestions.filter(q => q.afterParagraph === i))
      .forEach(cluster => contentNodes.push(buildRevealableQuestion(cluster, lesson ? lesson.objectives : null, lesson ? lesson.id : null)));
  });

  const readingBody = el("div", { class: "modal-body reading-body" }, contentNodes);

  // Runs the same YouTube/Vimeo detection used for the Video Src column,
  // so a plain "youtube.com/watch?v=..." link works here too, not just
  // ones already in embed form. Falls back to the raw URL for anything
  // that isn't a recognized video link (a direct file, or any other
  // site), same as before.
  const resolvedEmbedUrl = reading.embedUrl ? (toEmbedVideoUrl(reading.embedUrl) || reading.embedUrl) : null;

  const embedFrame = reading.embedUrl
    ? el("div", { class: "reading-embed-wrap" }, [
        el("div", { class: "reading-embed-bar" }, [
          el("span", { class: "reading-embed-bar-label" }, "Embedded page"),
          el("a", { class: "reading-embed-open-btn", href: reading.embedUrl, target: "_blank", rel: "noopener noreferrer" }, "Open Site \u2197")
        ]),
        el("iframe", {
          class: "reading-embed",
          src: resolvedEmbedUrl,
          loading: "lazy",
          referrerpolicy: "no-referrer-when-downgrade",
          allowfullscreen: "true"
        })
      ])
    : null;

  // Re-apply any highlights from notes already saved on this reading —
  // matched by reading title + lesson, since the same reading title
  // could theoretically exist in more than one lesson.
  //
  // getNotes() here is async, so this can still be pending when the
  // student saves a NEW highlight (which applies its own mark right
  // away, synchronously, further down). Without appliedNoteQuotes, this
  // callback could then reapply that same quote a second time once it
  // finally resolves, doubling the mark. Whichever path gets to a quote
  // first claims it here; the other skips it.
  const appliedNoteQuotes = new Set();
  function reapplyAllHighlights() {
    getNotes().then(notes => {
      notes
        .filter(n => n.quote && n.readingTitle === reading.title && n.lessonNumber === (lesson ? lesson.number : undefined))
        .forEach(n => {
          if (appliedNoteQuotes.has(n.quote)) return;
          appliedNoteQuotes.add(n.quote);
          highlightTextInContainer(readingBody, n.quote, n.color);
        });
    });
  }
  reapplyAllHighlights();
  applyStudentHighlightsOverlay(readingBody, reading, lesson);
  const highlightScopeSelector = buildHighlightScopeSelector(readingBody, reading, lesson);

  const panelClass = "modal-panel modal-panel-reading" + (reading.embedUrl ? " modal-panel-embed" : "");
  const hasRealText = (reading.text || "").trim().length > 0;

  const pinnedPanel = buildPinnedTermsPanel(lesson, windowKey);
  const termGroupsPanel = buildTermGroupsPanel(lesson, reading);
  const panelBody = [];
  if (hasRealText) {
    // Both an embed and real text: nest the embed (and its scope
    // selector, for a teacher) INSIDE the scrollable reading body,
    // ahead of the actual text, so scrolling through the reading
    // scrolls the embed away with it — it's not a separate, pinned
    // sibling fighting the text for space.
    if (embedFrame) readingBody.insertBefore(embedFrame, readingBody.firstChild);
    if (highlightScopeSelector) readingBody.insertBefore(highlightScopeSelector, embedFrame ? embedFrame.nextSibling : readingBody.firstChild);
    if (termGroupsPanel) readingBody.insertBefore(termGroupsPanel, readingBody.firstChild);
    panelBody.push(readingBody);
  } else if (reading.embedUrl) {
    // Embed-only reading, no text at all — let it fill the available space, as before.
    panelBody.push(embedFrame);
    if (termGroupsPanel) panelBody.push(termGroupsPanel);
  } else {
    // No text and no embed: a "reading" that exists only to show a
    // key-term group (or just an image). Still needs its body on screen.
    if (termGroupsPanel) readingBody.insertBefore(termGroupsPanel, readingBody.firstChild);
    panelBody.push(readingBody);
  }
  if (pinnedPanel) panelBody.push(pinnedPanel);
  panelBody.push(glossaryStrip);

  const panel = el("div", { class: panelClass, role: "dialog", "aria-modal": "true", "aria-label": reading.title }, [
    el("div", { class: "modal-header" }, [
      el("div", {}, [
        el("h2", {}, reading.title),
        el("span", { class: "meta" }, [reading.source, reading.note].filter(Boolean).join(" · "))
      ]),
      el("button", { type: "button", class: "modal-close", "aria-label": "Close" }, "×")
    ]),
    ...panelBody
  ]);

  const sourceWin = registerSourceWindow({ key: windowKey, kind: "Reading", title: reading.title, panel, pin: sourcePinControls("Reading", lesson, reading) });

  // ---- highlight a phrase → "Save to Notes" ----
  const saveBtn = el("button", { type: "button", class: "save-note-btn" }, "+ Save to Notes");
  saveBtn.style.display = "none";
  document.body.appendChild(saveBtn);
  let pendingQuote = "";

  function updateSelectionPopover() {
    const sel = window.getSelection();
    if (!sel || sel.isCollapsed || !document.body.contains(readingBody)) {
      saveBtn.style.display = "none";
      return;
    }
    if (!readingBody.contains(sel.anchorNode) || !readingBody.contains(sel.focusNode)) {
      saveBtn.style.display = "none";
      return;
    }
    const text = sel.toString().trim();
    if (!text) {
      saveBtn.style.display = "none";
      return;
    }
    pendingQuote = text;
    let rect;
    try {
      rect = sel.getRangeAt(0).getBoundingClientRect();
    } catch {
      saveBtn.style.display = "none";
      return;
    }
    saveBtn.style.display = "block";
    saveBtn.style.top = Math.max(8, rect.top - 42) + "px";
    saveBtn.style.left = Math.min(Math.max(8, rect.left), window.innerWidth - 170) + "px";
  }

  document.addEventListener("selectionchange", updateSelectionPopover);

  saveBtn.addEventListener("click", () => {
    if (!pendingQuote) return;
    const quoteToSave = pendingQuote;
    saveBtn.style.display = "none";

    openSaveSheet(quoteToSave, async ({ label, color }) => {
      await addNote({
        id: `n${Date.now()}${Math.random().toString(36).slice(2, 7)}`,
        quote: quoteToSave,
        label,
        color,
        unitNumber: unit ? unit.number : "",
        unitTitle: unit ? unit.title : "",
        lessonNumber: lesson ? lesson.number : "",
        lessonTitle: lesson ? lesson.title : "",
        readingTitle: reading.title,
        savedAt: new Date().toISOString()
      });
      let applied = false;
      if (!appliedNoteQuotes.has(quoteToSave)) {
        appliedNoteQuotes.add(quoteToSave);
        applied = highlightTextInContainer(readingBody, quoteToSave, color);
        if (!applied) appliedNoteQuotes.delete(quoteToSave); // didn't actually apply — let a retry (or reapplyAllHighlights) have another go
      }
      if (!applied) reapplyAllHighlights(); // safety net — matches whatever "reopening the reading" already does successfully
      window.getSelection().removeAllRanges();
      flashSavedToast();
    }, lesson);
  });

  sourceWin.onClose = () => {
    document.removeEventListener("selectionchange", updateSelectionPopover);
    saveBtn.remove();
  };
}

// Detects a YouTube or Vimeo link and converts it to its embeddable
// form. For anything else, a direct video FILE (.mp4/.webm/etc.) still
// uses the native <video> player, but any other URL is assumed to be
// its own embeddable page (like nps.gov's video embed pages, or any
// other site with a dedicated "embed" URL) and gets put in an iframe
// as-is. Only the URL itself belongs in the Video Src column — if a
// site gives you a whole <iframe> snippet, just copy the "src" part.
// Google Drive file id from any normal share link (…/file/d/ID/view, open?id=ID, uc?id=ID), or null.
function driveFileId(url) {
  try {
    const u = new URL(url, window.location.href);
    if (u.hostname !== "drive.google.com") return null;
    const m = u.pathname.match(/\/file\/d\/([^/]+)/);
    return m ? m[1] : (u.searchParams.get("id") || null);
  } catch { return null; }
}
function toEmbedVideoUrl(url) {
  if (!url) return null;
  try {
    const u = new URL(url, window.location.href);
    const driveId = driveFileId(url);
    if (driveId) return `https://drive.google.com/file/d/${driveId}/preview`; // Drive's embeddable player (the file must be shared "Anyone with the link")
    if (u.hostname.includes("youtube.com") && u.searchParams.get("v")) {
      return `https://www.youtube.com/embed/${u.searchParams.get("v")}`;
    }
    if (u.hostname === "youtu.be") {
      return `https://www.youtube.com/embed/${u.pathname.slice(1)}`;
    }
    if (u.hostname.includes("vimeo.com")) {
      const id = u.pathname.split("/").filter(Boolean).pop();
      return `https://player.vimeo.com/video/${id}`;
    }
    const directFileExtensions = /\.(mp4|webm|ogg|ogv|mov|m4v)(\?|#|$)/i;
    if (directFileExtensions.test(u.pathname)) {
      return null; // a direct file — use the native <video> player instead
    }
    return url; // treat as its own embeddable page
  } catch {
    return null;
  }
}

function openVideoModal(video, lesson) {
  closeModal();
  const windowKey = sourceWindowKey("Video", lesson, video.title);
  if (focusExistingSourceWindow(windowKey)) return;

  const embedUrl = toEmbedVideoUrl(video.src);
  const mediaEl = embedUrl
    ? el("iframe", {
        class: "modal-video-embed",
        src: embedUrl,
        title: video.title,
        loading: "lazy",
        allow: "autoplay; fullscreen; picture-in-picture",
        allowfullscreen: "true"
      })
    : el("video", {
        class: "modal-video",
        controls: "true",
        preload: "metadata"
      }, el("source", { src: video.src, type: "video/mp4" }));

  const modalBodyChildren = [mediaEl];
  const pinnedPanel = buildPinnedTermsPanel(lesson, windowKey);
  const termGroupsPanel = buildTermGroupsPanel(lesson, video);
  if (termGroupsPanel) modalBodyChildren.push(termGroupsPanel);
  groupQuestions(questionsForStudent(video.questions, lesson, { cap: true })).forEach(cluster => modalBodyChildren.push(buildRevealableQuestion(cluster, null, lesson ? lesson.id : null)));

  const panel = el("div", { class: "modal-panel modal-panel-media", role: "dialog", "aria-modal": "true", "aria-label": video.title }, [
    el("div", { class: "modal-header" }, [
      el("div", {}, [
        el("h2", {}, video.title),
        el("span", { class: "meta" }, [video.length, video.note].filter(Boolean).join(" · "))
      ]),
      el("button", { type: "button", class: "modal-close", "aria-label": "Close" }, "×")
    ]),
    el("div", { class: "modal-body" }, modalBodyChildren),
    ...(pinnedPanel ? [pinnedPanel] : [])
  ]);

  registerSourceWindow({ key: windowKey, kind: "Video", title: video.title, panel, pin: sourcePinControls("Video", lesson, video) });
}

let activeModal = null;
// Set by renderStep() while the linear stepper (index.html) is driving the
// page, so the lesson picker can jump in place instead of navigating away.
// Left null on the standalone lesson.html page, where the picker falls
// back to a normal page navigation instead.
let currentGoToStep = null;
let currentLessonId = null;
let modalCleanup = null; // extra teardown for the currently open modal, if any

let activeZoomOverlay = null;

function closeImageZoomOverlay() {
  if (!activeZoomOverlay) return;
  activeZoomOverlay.overlay.remove();
  document.removeEventListener("keydown", activeZoomOverlay.onKey);
  activeZoomOverlay = null;
}

function openImageZoomOverlay(src, alt) {
  closeImageZoomOverlay();
  const overlay = el("div", { class: "zoom-overlay" }, [
    el("img", { class: "zoom-overlay-image", src, alt: alt || "" }),
    el("button", { type: "button", class: "zoom-overlay-close", "aria-label": "Close" }, "×")
  ]);
  overlay.addEventListener("click", closeImageZoomOverlay);
  function onKey(e) { if (e.key === "Escape") closeImageZoomOverlay(); }
  document.addEventListener("keydown", onKey);
  document.body.appendChild(overlay);
  activeZoomOverlay = { overlay, onKey };
}

function closeModal() {
  if (!activeModal) return;
  closeImageZoomOverlay();
  activeModal.remove();
  activeModal = null;
  sweepLiveWatchers();
  document.removeEventListener("keydown", onModalKeydown);
  if (modalCleanup) {
    modalCleanup();
    modalCleanup = null;
  }
}

function onModalKeydown(e) {
  if (activeZoomOverlay) return; // let the zoom overlay's own listener handle this
  if (e.key === "Escape") closeModal();
}

// ---------- source windows: readings / videos / images, up to 3 at a time ----------
// A reading, video or image opens in its own window. Each can be minimized
// (it drops into a tray at the bottom of the screen with everything still
// as you left it -- scroll spot, answers, highlights) and restored later,
// so up to MAX_SOURCE_WINDOWS can be open at once and shown side by side.
// Everything else (definitions, Do Now, notes...) is still the one-at-a-time
// modal above; those never touch these windows.
const MAX_SOURCE_WINDOWS = 3;
const sourceWindows = []; // { id, key, kind, title, panel, minimized, lastFocus, nav, onClose }
let sourceWorkspace = null; // dimmed backdrop holding the visible windows
let sourceWindowRow = null; // the row the visible windows are laid out in
let sourceTray = null;      // chips for minimized windows
let focusedSourceWindow = null;
let sourceWindowSeq = 0;
let sourceFocusClock = 0;

const SOURCE_KIND_ICONS = { Reading: "fa-book-open", Video: "fa-circle-play", Image: "fa-image" };

// How many windows fit side by side on this screen.
function maxVisibleSourceWindows() {
  const w = window.innerWidth;
  return w >= 1180 ? 3 : (w >= 800 ? 2 : 1);
}

function sourceWindowKey(kind, lesson, title) {
  return `${kind}:${lesson ? lesson.id : ""}:${title}`;
}

function ensureSourceWorkspace() {
  if (sourceWorkspace) return;
  sourceWindowRow = el("div", { class: "source-windows" });
  sourceWorkspace = el("div", { class: "source-workspace empty" }, sourceWindowRow);
  // Clicking the dimmed area around the windows minimizes them all, so you
  // are back on the page with everything still waiting in the tray.
  sourceWorkspace.addEventListener("click", (e) => {
    if (e.target === sourceWorkspace || e.target === sourceWindowRow) minimizeAllSourceWindows();
  });
  sourceTray = el("div", { class: "source-tray", role: "toolbar", "aria-label": "Minimized sources" });
  sourceTray.style.display = "none";
  document.body.appendChild(sourceWorkspace);
  document.body.appendChild(sourceTray);
  document.addEventListener("keydown", onSourceWindowKeydown);
  window.addEventListener("resize", layoutSourceWindows);
}

function teardownSourceWorkspace() {
  if (!sourceWorkspace) return;
  sourceWorkspace.remove();
  sourceTray.remove();
  sourceWorkspace = sourceWindowRow = sourceTray = null;
  document.body.classList.remove("source-windows-open");
  document.removeEventListener("keydown", onSourceWindowKeydown);
  window.removeEventListener("resize", layoutSourceWindows);
}

function onSourceWindowKeydown(e) {
  if (activeZoomOverlay) return; // the zoom overlay handles its own keys
  const win = focusedSourceWindow;
  if (!win || win.minimized) return;
  const typing = e.target && /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName || "") || (e.target && e.target.isContentEditable);
  if (e.key === "Escape") {
    // A single modal or the save-to-notes sheet sitting on top gets Esc first.
    if (activeModal || document.querySelector(".save-sheet-overlay")) return;
    closeSourceWindow(win);
  } else if (!typing && win.nav && e.key === "ArrowLeft") {
    win.nav.prev();
  } else if (!typing && win.nav && e.key === "ArrowRight") {
    win.nav.next();
  }
}

// If this source is already open (visible or minimized), bring that one to
// the front instead of opening a second copy. Returns true if it did.
function focusExistingSourceWindow(key) {
  const win = sourceWindows.find(w => w.key === key);
  if (!win) return false;
  restoreSourceWindow(win);
  return true;
}

function focusSourceWindow(win) {
  focusedSourceWindow = win;
  win.lastFocus = ++sourceFocusClock;
  sourceWindows.forEach(w => w.panel.classList.toggle("source-window-focused", w === win));
}

function registerSourceWindow({ key, kind, title, panel, nav, pin }) {
  ensureSourceWorkspace();

  // Over the limit: make room by closing the window used longest ago,
  // preferring one that's already minimized.
  while (sourceWindows.length >= MAX_SOURCE_WINDOWS) {
    const pool = sourceWindows.some(w => w.minimized) ? sourceWindows.filter(w => w.minimized) : sourceWindows;
    const victim = pool.reduce((a, b) => (a.lastFocus <= b.lastFocus ? a : b));
    closeSourceWindow(victim, { skipLayout: true });
    flashSavedToast(`Closed "${victim.title}" to make room \u2014 ${MAX_SOURCE_WINDOWS} sources at a time.`);
  }

  const win = { id: ++sourceWindowSeq, key, kind, title, panel, minimized: false, lastFocus: 0, nav: nav || null, onClose: null };

  // Minimize + close buttons, together on the right of the title bar.
  const header = panel.querySelector(".modal-header");
  const closeBtn = panel.querySelector(".modal-close");
  const minBtn = el("button", { type: "button", class: "modal-minimize", "aria-label": "Minimize", title: "Minimize \u2014 keep it open in the tray" }, [el("i", { class: "fa-solid fa-minus" })]);
  const actions = el("div", { class: "modal-header-actions" }, [pin ? buildHoverPinButton(pin, "source", "icon") : null, minBtn]);
  header.replaceChild(actions, closeBtn);
  actions.appendChild(closeBtn);
  minBtn.addEventListener("click", () => minimizeSourceWindow(win));
  closeBtn.addEventListener("click", () => closeSourceWindow(win));
  panel.addEventListener("pointerdown", () => { if (focusedSourceWindow !== win) { focusSourceWindow(win); } }, true);
  panel.addEventListener("focusin", () => { if (focusedSourceWindow !== win) focusSourceWindow(win); });
  panel.setAttribute("aria-modal", "false");

  sourceWindows.push(win);
  sourceWindowRow.appendChild(panel);
  focusSourceWindow(win);
  layoutSourceWindows();
  return win;
}

function minimizeSourceWindow(win) {
  if (win.minimized) return;
  win.minimized = true;
  if (focusedSourceWindow === win) {
    const next = sourceWindows.filter(w => !w.minimized).sort((a, b) => b.lastFocus - a.lastFocus)[0];
    if (next) focusSourceWindow(next); else focusedSourceWindow = null;
  }
  layoutSourceWindows();
}

function minimizeAllSourceWindows() {
  sourceWindows.forEach(w => { w.minimized = true; });
  focusedSourceWindow = null;
  layoutSourceWindows();
}

function restoreSourceWindow(win) {
  win.minimized = false;
  focusSourceWindow(win); // layout then minimizes the longest-unused one if the screen can't fit them all
  layoutSourceWindows();
}

function closeSourceWindow(win, opts = {}) {
  const i = sourceWindows.indexOf(win);
  if (i === -1) return;
  sourceWindows.splice(i, 1);
  if (win.onClose) { try { win.onClose(); } catch (err) { console.warn("Source window cleanup failed:", err); } }
  win.panel.remove();
  sweepLiveWatchers();
  if (focusedSourceWindow === win) {
    const next = sourceWindows.filter(w => !w.minimized).sort((a, b) => b.lastFocus - a.lastFocus)[0];
    if (next) focusSourceWindow(next); else focusedSourceWindow = null;
  }
  if (!opts.skipLayout) layoutSourceWindows();
}

function closeAllSourceWindows() {
  sourceWindows.slice().forEach(w => closeSourceWindow(w, { skipLayout: true }));
  teardownSourceWorkspace();
}

// Shows the non-minimized windows side by side (as many as the screen
// fits), and keeps the tray of minimized ones in step.
function layoutSourceWindows() {
  if (!sourceWorkspace) return;
  if (!sourceWindows.length) { teardownSourceWorkspace(); return; }

  // Too many visible for this screen? Minimize the longest-unused ones.
  const limit = maxVisibleSourceWindows();
  const visible = () => sourceWindows.filter(w => !w.minimized);
  while (visible().length > limit) {
    const victim = visible().filter(w => w !== focusedSourceWindow).reduce((a, b) => (a.lastFocus <= b.lastFocus ? a : b));
    victim.minimized = true;
  }

  const shown = visible();
  const minimized = sourceWindows.filter(w => w.minimized);
  sourceWindows.forEach(w => w.panel.classList.toggle("minimized", w.minimized));
  // A minimized video shouldn't keep playing out of sight. (Embedded players
  // like YouTube live in their own frame and can't be paused from here.)
  minimized.forEach(w => w.panel.querySelectorAll("video").forEach(v => { try { v.pause(); } catch { /* ignore */ } }));
  sourceWindowRow.className = "source-windows count-" + Math.max(shown.length, 1);
  sourceWorkspace.classList.toggle("empty", !shown.length);
  sourceWorkspace.classList.toggle("has-tray", minimized.length > 0);
  document.body.classList.toggle("source-windows-open", shown.length > 0);

  // Tray: one chip per minimized window -- tap to bring it back, x to close it.
  sourceTray.innerHTML = "";
  minimized.forEach(w => {
    const restore = el("button", { type: "button", class: "tray-restore", title: `Open "${w.title}"` }, [
      el("i", { class: "fa-solid " + (SOURCE_KIND_ICONS[w.kind] || "fa-window-restore") }),
      el("span", { class: "tray-title" }, w.title)
    ]);
    restore.addEventListener("click", () => restoreSourceWindow(w));
    const close = el("button", { type: "button", class: "tray-close", "aria-label": `Close ${w.title}`, title: "Close" }, "\u00d7");
    close.addEventListener("click", () => closeSourceWindow(w));
    sourceTray.appendChild(el("div", { class: "source-tray-chip" }, [restore, close]));
  });
  sourceTray.style.display = minimized.length ? "flex" : "none";
}

function openImageModal(item, lesson, unit) {
  closeModal();
  const windowKey = sourceWindowKey("Image", lesson, item.title);
  if (focusExistingSourceWindow(windowKey)) return;

  // Each entry can be a plain path/URL string, or { src, caption } for a
  // per-image caption. Normalize once so the rest of this function doesn't
  // need to care which shape it started as.
  const files = (item.files || []).map(f => (typeof f === "string" ? { src: f, caption: null } : f));
  let current = 0;
  const isGallery = files.length > 1;
  let windowNav = null; // arrow keys flip this window's gallery

  const img = el("img", { class: "modal-image", src: files[0].src, alt: item.title, draggable: "false" });
  const counter = el("span", { class: "gallery-count" }, isGallery ? `1 / ${files.length}` : "");
  const caption = el("p", { class: "image-caption" });

  function updateCaption() {
    const text = files[current].caption;
    caption.textContent = text || "";
    caption.style.display = text ? "block" : "none";
  }
  updateCaption();

  const prevBtn = isGallery ? el("button", { type: "button", class: "gallery-btn gallery-prev", "aria-label": "Previous image" }, "‹") : null;
  const nextBtn = isGallery ? el("button", { type: "button", class: "gallery-btn gallery-next", "aria-label": "Next image" }, "›") : null;

  function show(index) {
    current = (index + files.length) % files.length;
    img.setAttribute("src", files[current].src);
    counter.textContent = `${current + 1} / ${files.length}`;
    updateCaption();
    exitCropMode();
  }
  if (isGallery) {
    prevBtn.addEventListener("click", () => show(current - 1));
    nextBtn.addEventListener("click", () => show(current + 1));
    windowNav = { prev: () => show(current - 1), next: () => show(current + 1) };
  }

  // Click the image (outside of crop mode) to view it large, in our own
  // overlay — not the native Fullscreen API, since that requires a
  // permission ("allow=fullscreen") that a sandboxed embed (like Google
  // Sites' Embed code box) generally doesn't grant.
  img.style.cursor = "zoom-in";
  img.addEventListener("click", () => {
    if (cropMode) return;
    openImageZoomOverlay(files[current].src, item.title);
  });

  // ---- drag-to-select a region, then save just that crop to notes ----
  const cropWrap = el("div", { class: "crop-wrap" });
  cropWrap.appendChild(img);
  const cropOverlay = el("div", { class: "crop-overlay" });
  const selectionBox = el("div", { class: "crop-selection-box" });
  selectionBox.style.display = "none";
  cropOverlay.appendChild(selectionBox);
  cropWrap.appendChild(cropOverlay);

  const selectToggle = el("button", { type: "button", class: "crop-toggle" }, "Select Region");
  const saveSelectionBtn = el("button", { type: "button", class: "save-note-btn" }, "+ Save Selection");
  saveSelectionBtn.style.display = "none";
  document.body.appendChild(saveSelectionBtn);

  let cropMode = false;
  let dragStart = null;

  function enterCropMode() {
    cropMode = true;
    cropOverlay.classList.add("active");
    selectToggle.textContent = "Cancel Selecting";
    if (prevBtn) prevBtn.style.visibility = "hidden";
    if (nextBtn) nextBtn.style.visibility = "hidden";
  }
  function exitCropMode() {
    cropMode = false;
    cropOverlay.classList.remove("active");
    selectToggle.textContent = "Select Region";
    selectionBox.style.display = "none";
    saveSelectionBtn.style.display = "none";
    if (prevBtn) prevBtn.style.visibility = "visible";
    if (nextBtn) nextBtn.style.visibility = "visible";
  }
  selectToggle.addEventListener("click", () => { cropMode ? exitCropMode() : enterCropMode(); });

  cropOverlay.addEventListener("pointerdown", (e) => {
    if (!cropMode) return;
    e.preventDefault();
    const rect = cropOverlay.getBoundingClientRect();
    dragStart = { x: e.clientX - rect.left, y: e.clientY - rect.top };
    selectionBox.style.left = dragStart.x + "px";
    selectionBox.style.top = dragStart.y + "px";
    selectionBox.style.width = "0px";
    selectionBox.style.height = "0px";
    selectionBox.style.display = "block";
    saveSelectionBtn.style.display = "none";
    try { cropOverlay.setPointerCapture(e.pointerId); } catch {}
  });

  cropOverlay.addEventListener("pointermove", (e) => {
    if (!cropMode || !dragStart) return;
    const rect = cropOverlay.getBoundingClientRect();
    const curX = Math.min(Math.max(e.clientX - rect.left, 0), rect.width);
    const curY = Math.min(Math.max(e.clientY - rect.top, 0), rect.height);
    const left = Math.min(dragStart.x, curX);
    const top = Math.min(dragStart.y, curY);
    selectionBox.style.left = left + "px";
    selectionBox.style.top = top + "px";
    selectionBox.style.width = Math.abs(curX - dragStart.x) + "px";
    selectionBox.style.height = Math.abs(curY - dragStart.y) + "px";
  });

  function finishDrag() {
    if (!cropMode || !dragStart) return;
    dragStart = null;
    const w = parseFloat(selectionBox.style.width) || 0;
    const h = parseFloat(selectionBox.style.height) || 0;
    if (w < 10 || h < 10) { // too small to be an intentional selection
      selectionBox.style.display = "none";
      return;
    }
    const boxRect = selectionBox.getBoundingClientRect();
    saveSelectionBtn.style.display = "block";
    saveSelectionBtn.style.top = Math.max(8, boxRect.top - 42) + "px";
    saveSelectionBtn.style.left = Math.min(Math.max(8, boxRect.left), window.innerWidth - 190) + "px";
  }
  cropOverlay.addEventListener("pointerup", finishDrag);
  cropOverlay.addEventListener("pointercancel", finishDrag);

  saveSelectionBtn.addEventListener("click", async () => {
    saveSelectionBtn.disabled = true;
    saveSelectionBtn.textContent = "Preparing…";
    const dataUrl = await cropSelectionToDataUrl(img, selectionBox);
    saveSelectionBtn.disabled = false;
    saveSelectionBtn.textContent = "+ Save Selection";

    if (!dataUrl) {
      flashSavedToast("Couldn't save that selection — try a smaller area, or try again.");
      return;
    }

    openImageSaveSheet(dataUrl, (chosen) => {
      addNote({
        id: `n${Date.now()}${Math.random().toString(36).slice(2, 7)}`,
        imageData: dataUrl,
        label: chosen.label,
        color: chosen.color,
        unitNumber: unit ? unit.number : "",
        unitTitle: unit ? unit.title : "",
        lessonNumber: lesson ? lesson.number : "",
        lessonTitle: lesson ? lesson.title : "",
        sourceTitle: item.title,
        savedAt: new Date().toISOString()
      });
      flashSavedToast();
      exitCropMode();
    }, lesson);
  });

  const imageArea = el("div", { class: "modal-image-area" }, [prevBtn, cropWrap, nextBtn]);
  const questionNodes = groupQuestions(questionsForStudent(item.questions, lesson, { cap: true })).map(cluster => buildRevealableQuestion(cluster, null, lesson ? lesson.id : null));
  const pinnedPanel = buildPinnedTermsPanel(lesson, windowKey);
  const termGroupsPanel = buildTermGroupsPanel(lesson, item);
  const panel = el("div", { class: "modal-panel modal-panel-media", role: "dialog", "aria-modal": "true", "aria-label": item.title }, [
    el("div", { class: "modal-header" }, [
      el("h2", {}, item.title),
      el("button", { type: "button", class: "modal-close", "aria-label": "Close" }, "×")
    ]),
    el("div", { class: "modal-body image-body" }, imageArea),
    caption,
    el("div", { class: "crop-toolbar" }, [selectToggle]),
    el("div", { class: "modal-footer image-footer" }, [
      el("span", { class: "meta" }, item.note || ""),
      counter
    ]),
    ...(termGroupsPanel ? [termGroupsPanel] : []),
    ...(questionNodes.length ? [el("div", { class: "modal-body-questions" }, questionNodes)] : []),
    ...(pinnedPanel ? [pinnedPanel] : [])
  ]);

  const sourceWin = registerSourceWindow({ key: windowKey, kind: "Image", title: item.title, panel, nav: windowNav, pin: sourcePinControls("Image", lesson, item) });
  sourceWin.onClose = () => {
    saveSelectionBtn.remove();
  };
}

// Crops the currently-selected rectangle out of `img` at full source
// resolution, downscaling only if the crop is larger than a sensible cap
// (keeps saved notes small). Returns a JPEG data URL, or null if the image
// hasn't finished loading yet.
function drawCropToDataUrl(sourceImg, refImg, selectionBox) {
  if (!sourceImg.naturalWidth) return null;

  const rect = refImg.getBoundingClientRect();
  if (!rect.width || !rect.height) return null;

  const scaleX = sourceImg.naturalWidth / rect.width;
  const scaleY = sourceImg.naturalHeight / rect.height;

  const boxLeft = parseFloat(selectionBox.style.left) || 0;
  const boxTop = parseFloat(selectionBox.style.top) || 0;
  const boxW = parseFloat(selectionBox.style.width) || 0;
  const boxH = parseFloat(selectionBox.style.height) || 0;

  const sx = boxLeft * scaleX;
  const sy = boxTop * scaleY;
  const sw = boxW * scaleX;
  const sh = boxH * scaleY;
  if (sw < 1 || sh < 1) return null;

  const maxDim = 900;
  let outW = sw, outH = sh;
  if (outW > maxDim || outH > maxDim) {
    const scale = maxDim / Math.max(outW, outH);
    outW = Math.round(outW * scale);
    outH = Math.round(outH * scale);
  }

  const canvas = document.createElement("canvas");
  canvas.width = outW;
  canvas.height = outH;
  const ctx = canvas.getContext("2d");
  ctx.drawImage(sourceImg, sx, sy, sw, sh, 0, 0, outW, outH);
  return canvas.toDataURL("image/jpeg", 0.85); // throws if the canvas is tainted
}

// Crops the currently-selected rectangle out of `img` at full source
// resolution, downscaling only if the crop is larger than a sensible cap
// (keeps saved notes small). Tries the already-loaded <img> first; if the
// canvas comes back "tainted" (a cross-origin security restriction — this
// can happen inside a sandboxed preview even for images that are same-origin
// on the real hosted site), it retries once through a freshly-loaded
// CORS-enabled copy of the same image before giving up.
async function cropSelectionToDataUrl(img, selectionBox) {
  try {
    const direct = drawCropToDataUrl(img, img, selectionBox);
    if (direct) return direct;
  } catch (err) {
    console.warn("Direct crop failed, retrying with a CORS-enabled copy:", err);
  }

  try {
    const reloaded = await new Promise((resolve, reject) => {
      const fresh = new Image();
      fresh.crossOrigin = "anonymous";
      fresh.onload = () => resolve(fresh);
      fresh.onerror = reject;
      fresh.src = img.currentSrc || img.src;
    });
    return drawCropToDataUrl(reloaded, img, selectionBox);
  } catch (err) {
    console.warn("Could not crop this image — likely a cross-origin restriction:", err);
    return null;
  }
}

// Like openSaveSheet, but previews an image crop instead of a text quote.
function openImageSaveSheet(dataUrl, onSaved, lesson) {
  document.querySelectorAll(".save-sheet-overlay").forEach(e => e.remove());

  const preview = el("img", { class: "save-sheet-image-preview", src: dataUrl, alt: "Selected region" });

  let current = { label: "", color: "brass" };
  const cancelBtn = el("button", { type: "button", class: "sheet-btn sheet-cancel" }, "Cancel");
  const confirmBtn = el("button", { type: "button", class: "sheet-btn sheet-save" }, "Save to Notes");

  const sheet = el("div", { class: "save-sheet" }, [
    el("div", { class: "save-sheet-handle" }),
    preview,
    el("div", { class: "label-picker-slot" })
  ]);
  const overlay = el("div", { class: "save-sheet-overlay" }, sheet);
  overlay.addEventListener("click", (e) => { if (e.target === overlay) overlay.remove(); });
  cancelBtn.addEventListener("click", () => overlay.remove());
  document.body.appendChild(overlay);

  getLabels().then(labels => {
    const { labels: pickerLabels, allowNew } = labelPickerOptionsFor(labels, lesson);
    const picker = buildLabelPicker(pickerLabels, null, "brass", (sel) => { current = sel; }, allowNew);
    sheet.querySelector(".label-picker-slot").replaceWith(picker.container);
    sheet.appendChild(el("div", { class: "save-sheet-actions" }, [cancelBtn, confirmBtn]));
  });

  confirmBtn.addEventListener("click", async () => {
    if (current.label) {
      await upsertLabel(current.label, current.color);
    }
    onSaved(current);
    overlay.remove();
  });
}

function findLesson(id) {
  for (const unit of COURSE_DATA.units) {
    const lesson = unit.lessons.find(l => l.id === id);
    if (lesson) return { unit, lesson };
  }
  return null;
}

// Flat, ordered list of every lesson across every unit — defines the Next/Previous order.
function flatLessons() {
  const out = [];
  COURSE_DATA.units.forEach(unit => {
    unit.lessons.forEach(lesson => out.push({ unit, lesson }));
  });
  return out;
}

function section(title, items, renderFn, extra = null) {
  const has = items && items.length > 0;
  if (!has) return null; // nothing to show: leave the whole section out rather than an empty heading
  return el("div", {}, [
    el("div", { class: "section-title" }, title),
    extra,
    renderFn(items)
  ]);
}

// ---------- master timeline (same list every lesson, current era highlighted) ----------
// A small, fixed palette cycled through in the order categories are
// first encountered, so the same category always gets the same color
// within one timeline render, without needing categories to be known
// ahead of time.
const TIMELINE_CATEGORY_COLORS = ["var(--stamp)", "var(--forest)", "var(--brass)", "#6B4C9A", "#B5651D", "#2E5090"];

// Scans entities tagged with the "President" role for an action written
// like "President from 1881-1885" (dashes, en-dashes, or "to" all work,
// and it's not case-sensitive) and turns that into a lookup of which
// president was in office during any given year. An entity with no
// action matching that pattern is just skipped — nothing shows for it.
// Matches a year range anywhere in an action's text — "1869-1877",
// "Served 1869 to 1877", "18th President, 1869\u20131877", etc. Deliberately
// NOT requiring the exact phrase "President from", since the entity is
// already filtered to role "President" — the year range is the only
// part that actually matters, so this stays flexible about wording.
const PRESIDENT_TERM_PATTERN = /(\d{4})\s*(?:-|\u2013|\u2014|to)\s*(\d{4})/i;

function buildPresidentTimeline() {
  return COURSE_DATA.entities
    .filter(e => (e.subcategory || "").toLowerCase() === "president")
    .map(e => {
      const action = (e.actions || []).find(a => PRESIDENT_TERM_PATTERN.test(a));
      if (!action) return null;
      const match = action.match(PRESIDENT_TERM_PATTERN);
      return { name: e.name, image: e.image, start: Number(match[1]), end: Number(match[2]) };
    })
    .filter(Boolean);
}

// If two presidents' ranges overlap on a boundary year (e.g. one ends
// 1877 and the next starts 1877), prefer whichever started most
// recently — the incoming president is the more likely intent for that
// exact transition year than treating it as still the outgoing one's.
function presidentAtYear(year, presidentTimeline) {
  const matches = presidentTimeline.filter(p => year >= p.start && year <= p.end);
  if (!matches.length) return null;
  return matches.reduce((latest, p) => (p.start > latest.start ? p : latest));
}

function buildMasterTimeline(focusIds = [], lesson = null) {
  const focus = new Set(focusIds);
  const glossary = buildGlossary(resolveGlossaryForLesson(lesson || {}));
  const onTermClick = (termData) => {
    const entity = COURSE_DATA.entities.find(e => e.name === termData.term);
    if (entity) openEntityModal(entity);
  };
  const presidentTimeline = buildPresidentTimeline();

  const categoryColors = {};
  function colorForCategory(category) {
    if (!category) return null;
    if (!(category in categoryColors)) {
      categoryColors[category] = TIMELINE_CATEGORY_COLORS[Object.keys(categoryColors).length % TIMELINE_CATEGORY_COLORS.length];
    }
    return categoryColors[category];
  }

  // Everything is positioned along one shared year axis, so events and
  // president bands always line up — spanning from the earliest to the
  // latest year across BOTH the timeline entries and every president's
  // term (not just whichever's narrower), so nothing gets cut off.
  const eventYears = COURSE_DATA.timeline.map(t => extractYear(t.date)).filter(y => y !== null);
  const presidentYears = presidentTimeline.flatMap(p => [p.start, p.end]);
  const allYears = [...eventYears, ...presidentYears];
  const minYear = allYears.length ? Math.min(...allYears) : 1900;
  const maxYear = allYears.length ? Math.max(...allYears) : 2000;
  const PX_PER_YEAR = 26;
  const totalWidth = Math.max(700, (maxYear - minYear + 2) * PX_PER_YEAR);
  const yearToPx = year => (year - minYear) * PX_PER_YEAR;

  // Events are stacked into as many lanes as needed to avoid overlap.
  // A real timeline can have several entries sharing the same year, or
  // clustered close together — a fixed number of lanes isn't enough
  // once more than that many cluster at once. Each event goes in the
  // first lane whose last-placed event is far enough away; a lane
  // that's never reused stays empty, so this only scales up where a
  // cluster actually needs it.
  //
  // Non-focused entries render compact (just the dot and year — full
  // title on click) specifically so this stays manageable: a full
  // permanent label per entry needs ~160px of separation to avoid
  // overlapping its neighbor, which cascades into dozens of lanes once
  // a course has 100+ timeline entries with several sharing a year.
  // Compact entries only need enough room for the dot and short year
  // text, so far more of them can share a lane before a new one is
  // needed. Focused entries — few at a time — get the full label and
  // the wider spacing that needs.
  const COMPACT_GAP = 34;
  const FULL_GAP = 160;
  const laneLastPx = [];
  const laneLastGap = [];
  function assignLane(px, gap) {
    let lane = laneLastPx.findIndex((lastPx, i) => px - lastPx >= Math.max(gap, laneLastGap[i]));
    if (lane === -1) { lane = laneLastPx.length; laneLastPx.push(px); laneLastGap.push(gap); }
    else { laneLastPx[lane] = px; laneLastGap[lane] = gap; }
    return lane;
  }

  const NODE_LANE_HEIGHT = 3.6; // rem
  let maxLaneUsed = 0;
  const track = el("div", { class: "timeline-track" },
    COURSE_DATA.timeline.map(t => {
      const isActive = focus.has(t.id);
      const dotColor = colorForCategory(t.category);
      const dot = el("span", { class: "timeline-dot", "aria-hidden": "true" });
      if (dotColor) dot.style.background = dotColor;

      const year = extractYear(t.date);
      const hasDetails = t.details && t.details.trim() !== (t.title || "").trim();
      let node;

      if (isActive) {
        const children = [
          el("span", { class: "timeline-date" }, t.date),
          dot,
          renderInteractiveParagraph(t.title, glossary, onTermClick, "span", "timeline-event")
        ];
        if (hasDetails) {
          const infoBtn = el("button", { type: "button", class: "timeline-info-btn", "aria-label": "More detail" }, "\u24D8");
          infoBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            openTimelineDetailModal(t, glossary, onTermClick);
          });
          children.push(infoBtn);
        }
        node = el("div", { class: "timeline-node active" }, children);
      } else {
        node = el("div", { class: "timeline-node compact", title: `${t.date} \u2014 ${t.title}` }, [
          dot,
          el("span", { class: "timeline-date" }, year !== null ? String(year) : t.date)
        ]);
        node.addEventListener("click", () => openTimelineDetailModal(t, glossary, onTermClick));
      }

      const px = year !== null ? yearToPx(year) : 0;
      const lane = assignLane(px, isActive ? FULL_GAP : COMPACT_GAP);
      maxLaneUsed = Math.max(maxLaneUsed, lane);
      node.style.left = px + "px";
      if (lane > 0) node.style.top = (lane * NODE_LANE_HEIGHT) + "rem";
      return node;
    })
  );
  track.style.width = totalWidth + "px";
  track.style.minHeight = (6 + maxLaneUsed * NODE_LANE_HEIGHT) + "rem";
  track.style.paddingBottom = (4.4 + maxLaneUsed * NODE_LANE_HEIGHT) + "rem";

  // One band per president, spanning the actual width of their term —
  // shown for the whole course, not just this lesson, so switching
  // lessons doesn't change which presidents are visible. Bands
  // overlapping this lesson's focused years are highlighted, same idea
  // as the "active" events above.
  const focusedYears = new Set();
  COURSE_DATA.timeline.forEach(t => {
    if (!focus.has(t.id)) return;
    const year = extractYear(t.date);
    if (year !== null) focusedYears.add(year);
  });

  const presidentRow = presidentTimeline.length
    ? el("div", { class: "timeline-president-row" },
        presidentTimeline.map(p => {
          const isFocused = [...focusedYears].some(y => y >= p.start && y <= p.end);
          const band = el("div", { class: "timeline-president-band" + (isFocused ? " active" : "") }, [
            p.image ? el("img", { class: "timeline-president-band-img", src: p.image, alt: "" }) : null,
            el("span", { class: "timeline-president-band-name" }, p.name)
          ]);
          band.title = `${p.name} (${p.start}\u2013${p.end})`;
          band.style.left = yearToPx(p.start) + "px";
          band.style.width = Math.max(46, (p.end - p.start + 1) * PX_PER_YEAR) + "px";
          band.addEventListener("click", () => {
            const entity = COURSE_DATA.entities.find(e => e.name === p.name);
            if (entity) openEntityModal(entity);
          });
          return band;
        })
      )
    : null;
  if (presidentRow) presidentRow.style.width = totalWidth + "px";

  return el("div", { class: "master-timeline" }, presidentRow ? [track, presidentRow] : [track]);
}

// Shows a timeline entry's full details, since the strip itself only
// ever shows the short title to stay uncluttered.
function openTimelineDetailModal(t, glossary, onTermClick) {
  closeModal();

  const panel = el("div", { class: "modal-panel", role: "dialog", "aria-modal": "true", "aria-label": t.title }, [
    el("div", { class: "modal-header" }, [
      el("div", {}, [
        el("h2", {}, t.title),
        el("span", { class: "meta" }, [t.date, t.category].filter(Boolean).join(" \u2014 "))
      ]),
      el("button", { type: "button", class: "modal-close", "aria-label": "Close" }, "\u00d7")
    ]),
    el("div", { class: "modal-body mention-body" }, [
      renderInteractiveParagraph(t.details || t.title, glossary, onTermClick, "p", "reading-p")
    ])
  ]);

  const overlay = el("div", { class: "modal-overlay" }, panel);
  overlay.addEventListener("click", (e) => { if (e.target === overlay) closeModal(); });
  panel.querySelector(".modal-close").addEventListener("click", closeModal);

  document.body.appendChild(overlay);
  document.addEventListener("keydown", onModalKeydown);
  activeModal = overlay;
}

// After the timeline strip is in the DOM, scroll it so the active nodes are centered.
function centerTimeline(strip) {
  const activeNodes = strip.querySelectorAll(".timeline-node.active");
  if (!activeNodes.length) return;
  const first = activeNodes[0];
  const last = activeNodes[activeNodes.length - 1];
  const targetCenter = (first.offsetLeft + last.offsetLeft + last.offsetWidth) / 2;
  const scrollLeft = targetCenter - strip.clientWidth / 2;
  if (typeof strip.scrollTo === "function") {
    strip.scrollTo({ left: Math.max(0, scrollLeft), behavior: "smooth" });
  } else {
    strip.scrollLeft = Math.max(0, scrollLeft);
  }
}

// Builds the inner content of a lesson (need-to-know / readings / videos / timeline).
// Looks up this lesson's course-wide inquiries (by id, from COURSE_DATA.inquiries)
// and renders them. These replace the old per-lesson "essential question" —
// they're big questions the whole year keeps returning to, not something
// unique to one lesson, so several lessons across different units can (and
// usually do) point at the same inquiry.
// Jumps to another lesson the same way the lesson picker does -- in-place
// if this page has a stepper running, otherwise a normal page navigation.
function goToLesson(lessonId) {
  if (currentGoToStep) {
    const idx = flatLessons().findIndex(o => o.lesson.id === lessonId);
    if (idx >= 0) currentGoToStep(idx);
  } else {
    window.location.href = `lesson.html?id=${encodeURIComponent(lessonId)}`;
  }
}

// Every OTHER lesson (any unit) that shares this inquiry.
function lessonsForInquiry(inquiryId, excludeLessonId) {
  return flatLessons().filter(({ lesson }) =>
    lesson.id !== excludeLessonId && (lesson.inquiryFocus || []).includes(inquiryId)
  );
}

// Clicking a Course Inquiry question shows every other lesson (across
// every unit) that shares it, so a student can jump straight there.
function openInquiryJumpModal(inquiry, currentLessonId) {
  closeModal();
  const matches = lessonsForInquiry(inquiry.id, currentLessonId);
  const list = matches.length
    ? el("div", { class: "inquiry-jump-list" }, matches.map(({ unit, lesson }) => {
        const btn = el("button", { type: "button", class: "inquiry-jump-item" }, [
          lesson.icon ? el("img", { class: "lesson-picker-icon", src: lesson.icon, alt: "" }) : null,
          el("div", { class: "inquiry-jump-text" }, [
            el("span", { class: "inquiry-jump-unit" }, `Unit ${unit.number} — ${unit.title}`),
            el("span", { class: "inquiry-jump-lesson" }, `${lesson.number} — ${lesson.title}`)
          ])
        ]);
        btn.addEventListener("click", () => { closeModal(); goToLesson(lesson.id); });
        return btn;
      }))
    : el("p", { class: "empty-note" }, "No other lesson addresses this inquiry yet.");
  const panel = el("div", { class: "modal-panel", role: "dialog", "aria-modal": "true", "aria-label": "Course Inquiry" }, [
    el("div", { class: "modal-header" }, [
      el("div", {}, [
        el("h2", {}, "Course Inquiry"),
        el("span", { class: "meta" }, inquiry.question)
      ]),
      el("button", { type: "button", class: "modal-close", "aria-label": "Close" }, "×")
    ]),
    el("div", { class: "modal-body" }, [list])
  ]);
  const overlay = el("div", { class: "modal-overlay" }, panel);
  overlay.addEventListener("click", (e) => { if (e.target === overlay) closeModal(); });
  panel.querySelector(".modal-close").addEventListener("click", closeModal);
  document.body.appendChild(overlay);
  document.addEventListener("keydown", onModalKeydown);
  activeModal = overlay;
}

function buildInquiryBlock(lesson) {
  const ids = lesson.inquiryFocus || [];
  const inquiries = ids
    .map(id => COURSE_DATA.inquiries.find(i => i.id === id))
    .filter(Boolean);
  if (!inquiries.length) return null;

  // Each question is clickable -- opens the list of other lessons (any
  // unit) that share it, so a student can jump straight there.
  const questionBtn = (inq) => {
    const btn = el("button", { type: "button", class: "inquiry-jump-btn" }, inq.question);
    btn.addEventListener("click", (e) => { e.stopPropagation(); openInquiryJumpModal(inq, lesson.id); });
    return btn;
  };

  if (inquiries.length === 1) {
    return el("div", { class: "inquiry-block" }, [
      el("div", { class: "inquiry-kicker" }, "Course Inquiry"),
      el("p", { class: "inquiry-text" }, [questionBtn(inquiries[0])])
    ]);
  }
  return el("div", { class: "inquiry-block" }, [
    el("div", { class: "inquiry-kicker" }, "Course Inquiries"),
    el("ul", { class: "inquiry-list" }, inquiries.map(i => el("li", {}, [questionBtn(i)])))
  ]);
}

function extractYouTubeId(url) {
  if (!url) return null;
  try {
    const u = new URL(url, window.location.href);
    if (u.hostname.includes("youtube.com") && u.searchParams.get("v")) return u.searchParams.get("v");
    if (u.hostname === "youtu.be") return u.pathname.slice(1);
    return null;
  } catch {
    return null;
  }
}

// Picks an icon image for a source list item: an explicit image if the
// reading/video has one, a thumbnail auto-derived from a YouTube link if
// not, or — for an image/gallery source — its own first photo.
function resolveSourceIcon(kind, data) {
  if (kind === "Reading") return data.image || null;
  if (kind === "Video") {
    if (data.image) return data.image;
    const ytId = extractYouTubeId(data.src);
    if (ytId) return `https://img.youtube.com/vi/${ytId}/hqdefault.jpg`;
    const driveId = driveFileId(data.src);
    return driveId ? `https://drive.google.com/thumbnail?id=${driveId}&sz=w400` : null;
  }
  if (kind === "Image") {
    const first = (data.files || [])[0];
    if (!first) return null;
    return typeof first === "string" ? first : first.src;
  }
  return null;
}

// A "Rate This Lesson" widget — two 1-5 scales (interest, difficulty)
// that log through the exact same logAnswer pipeline as any other
// question, so ratings show up in Teacher View, Firebase, and the
// spreadsheet right alongside Check Your Understanding answers. Limited
// to once per student per lesson, checked against their locally
// recorded answers, same pattern as Do Now.
function buildLessonRatingWidget(lesson, opts = {}) {
  const openBtn = el("button", { type: "button", class: "rate-lesson-btn" }, [
    el("i", { class: "fa-solid fa-star" }),
    " Rate This Lesson"
  ]);
  if (opts.startOpen) openBtn.style.display = "none"; // the modal opening IS the "open" action — no toggle button needed

  let interestValue = null;
  let difficultyValue = null;
  const submitBtn = el("button", { type: "button", class: "rating-submit-btn", disabled: "disabled" }, "Submit Rating");

  function buildScale(label, onSelect) {
    const scaleWrap = el("div", { class: "rating-scale" });
    [1, 2, 3, 4, 5].forEach(n => {
      const btn = el("button", { type: "button", class: "rating-scale-btn" }, String(n));
      btn.addEventListener("click", () => {
        onSelect(n);
        scaleWrap.querySelectorAll(".rating-scale-btn").forEach(b => b.classList.remove("selected"));
        btn.classList.add("selected");
        submitBtn.disabled = !(interestValue && difficultyValue);
      });
      scaleWrap.appendChild(btn);
    });
    return el("div", { class: "rating-row" }, [
      el("span", { class: "rating-row-label" }, label),
      scaleWrap,
      el("div", { class: "rating-scale-caption" }, ["1 = not at all", "5 = very much"])
    ]);
  }

  const panel = el("div", { class: "rating-panel" }, [
    buildScale("How interesting was this topic?", v => { interestValue = v; }),
    buildScale("How easy was this to understand?", v => { difficultyValue = v; }),
    submitBtn
  ]);
  panel.style.display = opts.startOpen ? "block" : "none";

  const thanksMsg = el("p", { class: "rating-thanks" }, "Thanks for rating this lesson!");
  thanksMsg.style.display = "none";

  openBtn.addEventListener("click", () => {
    panel.style.display = panel.style.display === "none" ? "block" : "none";
  });

  submitBtn.addEventListener("click", async () => {
    submitBtn.disabled = true;
    await logAnswer({ lessonId: lesson.id, type: "rating", questionPrompt: "How interesting was this topic? (1-5, 5=very interesting)", answer: String(interestValue) });
    await logAnswer({ lessonId: lesson.id, type: "rating", questionPrompt: "How easy was this to understand? (1-5, 5=very easy)", answer: String(difficultyValue) });
    panel.style.display = "none";
    openBtn.style.display = "none";
    thanksMsg.style.display = "block";
    if (opts.onRated) opts.onRated();
  });

  const container = el("div", { class: "rating-widget" }, [openBtn, panel, thanksMsg]);

  // Once we know who's asking, check whether they've already rated this
  // lesson — if so, skip straight to the thanks message. Uses whatever
  // id is already stored, if any — never forces the ID gate open just
  // to check this.
  (async () => {
    const studentId = getStoredStudentId();
    if (!studentId) return; // no id yet — nothing to check against
    const responses = await getLocalResponses();
    const alreadyRated = responses.some(r => r.studentId === studentId && r.lessonId === lesson.id && r.type === "rating");
    if (alreadyRated) {
      openBtn.style.display = "none";
      panel.style.display = "none";
      thanksMsg.textContent = "You've already rated this lesson. Thanks!";
      thanksMsg.style.display = "block";
    }
  })();

  return container;
}

// Combines readings/videos/images into one list for the Sources section.
// If they were loaded from a lesson's own sheet tab, each carries an
// _order stamped by row position, so they display in the exact order
// they appear in the sheet — interleaved by type, not grouped. Items
// without an _order (written by hand in data.js) fall back to the
// original grouping: all readings, then all videos, then all images.
function buildOrderedSources(lesson) {
  const items = [
    ...lesson.readings.map(r => ({ kind: "Reading", data: r })),
    ...lesson.videos.map(v => ({ kind: "Video", data: v })),
    ...lesson.images.map(i => ({ kind: "Image", data: i }))
  ];
  const typeFallback = { Reading: 0, Video: 1000000, Image: 2000000 };
  return items
    .map((item, i) => ({ item, sortKey: item.data._order !== undefined ? item.data._order : typeFallback[item.kind] + i }))
    .sort((a, b) => a.sortKey - b.sortKey)
    .map(({ item }) => item);
}

function buildLessonContent(lesson, unit) {
  const orderedSources = buildOrderedSources(lesson);

  return [
    lesson.isExample
      ? el("div", { class: "example-notice" }, [
          el("i", { class: "fa-solid fa-flask" }),
          " Example content: this lesson's spreadsheet couldn't be reached, so one of each content type is shown. Answers here aren't saved."
        ])
      : null,
    // These two carry their title inside the toolbar with the view
    // buttons (one attached bar), so they skip section()'s own heading.
    (() => {
      const ents = keyTermSectionIds(lesson).map(id => COURSE_DATA.entities.find(e => e.id === id)).filter(Boolean);
      return ents.length ? buildTermsBox(lesson, ents) : null;
    })(),

    !orderedSources.length ? null : (items =>
      el("div", { class: "sources-box" }, [
        buildSourceViewToggle("Sources"),
        el("div", { class: "source-list" + (getSourceView() === "gallery" ? " gallery" : "") },
          groupSourcesIntoSets(items).map(entry =>
            entry.set
              ? buildSourceSet(entry.set, entry.items, lesson, unit)
              : buildSourceItem(entry.item.kind, entry.item.data, lesson, unit)
          )
        )
      ])
    )(orderedSources),

    buildAssessmentsBox(lesson),

    section("Check Your Understanding", lesson.assessment, items =>
      el("div", { class: "quiz-list" }, groupQuestions(items).map(cluster => buildRevealableQuestion(cluster, lesson.objectives, lesson.id)))
    ),

    buildLessonRatingWidget(lesson)
  ];
}

// ---------- sources: one item, and sets of items ----------
function buildSourceItem(kind, data, lesson, unit) {
  let btn, metaText;

  if (kind === "Reading") {
    btn = el("button", { type: "button", class: "open-link" }, data.title);
    btn.addEventListener("click", () => openTextModal(data, resolveGlossaryForLesson(lesson), lesson, unit));
    metaText = [data.source, data.note].filter(Boolean).join(" · ");
  } else if (kind === "Video") {
    btn = el("button", { type: "button", class: "open-link" }, data.title);
    btn.addEventListener("click", () => openVideoModal(data, lesson));
    metaText = [data.length, data.note].filter(Boolean).join(" · ");
  } else {
    const isGallery = (data.files || []).length > 1;
    btn = el("button", { type: "button", class: "open-link" }, [
      data.title,
      isGallery ? el("span", { class: "gallery-badge" }, `Gallery · ${data.files.length}`) : null
    ]);
    btn.addEventListener("click", () => openImageModal(data, lesson, unit));
    metaText = data.note || "";
  }

  const icon = resolveSourceIcon(kind, data);
  const card = el("div", { class: "source-item" }, [
    icon
      ? el("img", { class: "source-icon", src: icon, alt: "" })
      : el("div", { class: "source-icon-placeholder", "aria-hidden": "true" }, // only visible in gallery view
          el("i", { class: kind === "Reading" ? "fa-solid fa-book-open" : kind === "Video" ? "fa-solid fa-circle-play" : "fa-solid fa-image" })),
    el("div", { class: "source-item-text" }, [
      el("span", { class: "source-kind" }, kind),
      btn,
      el("span", { class: "meta" }, metaText)
    ])
  ]);
  // In gallery view the whole card (image included) should open the
  // resource, not just its title — a bigger, more obvious click target.
  // In list view this is harmless too, so it isn't scoped to that layout.
  card.addEventListener("click", (e) => {
    if (e.target === btn || btn.contains(e.target)) return; // the button's own listener already handles this click
    btn.click();
  });

  // Hover (or tab to) a source for Open and Pin buttons, so it can be
  // pinned without opening it first.
  const pinControls = sourcePinControls(kind, lesson, data);
  const openAction = el("button", { type: "button", class: "hover-open" }, [el("i", { class: "fa-solid fa-up-right-from-square" }), " Open"]);
  openAction.addEventListener("click", (e) => { e.stopPropagation(); btn.click(); });
  card.appendChild(el("div", { class: "hover-actions" }, [openAction, buildHoverPinButton(pinControls, "source")]));
  card.appendChild(el("i", { class: "fa-solid fa-thumbtack source-pin-badge", title: "Pinned" }));
  card.classList.add("pin-aware");
  card._paint = () => card.classList.toggle("pinned", pinControls.isPinned());
  card._paint();
  return card;
}

// Sorts by a number column: numbered entries first in number order, then
// anything without a number in its original (sheet) order.
function sortByOrderNumber(list, orderOf) {
  const rank = n => (typeof n === "number" ? n : Infinity);
  return list
    .map((entry, i) => ({ entry, i, o: rank(orderOf(entry)) }))
    .sort((a, b) => (a.o !== b.o ? (a.o < b.o ? -1 : 1) : a.i - b.i))
    .map(x => x.entry);
}

// Groups sources that share a "Set" name (Reading Set / Video Set /
// Image Set column) into one entry, then puts everything in order.
// Top level: a loose resource is ordered by its own Reading / Video /
// Image Order number, a set by its Set Order number. Inside a set, its
// resources are ordered by their own Order numbers. Anything without a
// number keeps its sheet order, after the numbered ones.
function groupSourcesIntoSets(items) {
  const out = [];
  const bySet = new Map();
  items.forEach(item => {
    const name = ((item.data && item.data.set) || "").trim();
    if (!name) { out.push({ item }); return; }
    const key = name.toLowerCase();
    if (!bySet.has(key)) {
      const entry = { set: name, items: [] };
      bySet.set(key, entry);
      out.push(entry);
    }
    bySet.get(key).items.push(item);
  });
  out.forEach(entry => {
    if (!entry.set) return;
    entry.order = (entry.items.map(it => it.data.setOrder).find(n => typeof n === "number"));
    entry.items = sortByOrderNumber(entry.items, it => it.data.order);
  });
  return sortByOrderNumber(out, e => (e.set ? e.order : e.item.data.order));
}

// ---------- sources layout: list or gallery ----------
// Each student picks how the Sources section is laid out — the usual
// vertical list, or a gallery of cards side by side (saves vertical room).
// Remembered on this device; it's a display choice only, so it works by
// switching a class on the list rather than rebuilding anything.
// ---------- key terms: List / Tabs view ----------
// Same idea as the Sources List/Gallery toggle: one remembered choice per
// device, applied live to every key-terms box on the page.
const TERMS_VIEW_KEY = "usHistoryTermsView";
function getTermsView() {
  // Tabs unless this device explicitly picked List.
  try { return localStorage.getItem(TERMS_VIEW_KEY) === "list" ? "list" : "tabs"; } catch { return "tabs"; }
}
function setTermsView(view) {
  try { localStorage.setItem(TERMS_VIEW_KEY, view); } catch { /* ignore */ }
  document.querySelectorAll(".terms-view-btn").forEach(b => {
    const on = b.getAttribute("data-view") === view;
    b.classList.toggle("active", on);
    b.setAttribute("aria-pressed", String(on));
  });
  document.querySelectorAll(".terms-box").forEach(box => { if (box._render) box._render(); });
}
// A small chevron at the end of a box's toolbar that minimizes the box down
// to just that toolbar (and expands it again).
function buildBoxCollapseButton(label) {
  const icon = el("i", { class: "fa-solid fa-chevron-up" });
  const btn = el("button", { type: "button", class: "box-collapse-btn", "aria-expanded": "true", "aria-label": `Minimize ${label}`, title: `Minimize ${label}` }, [icon]);
  btn.addEventListener("click", () => {
    const box = btn.closest(".sources-box");
    if (!box) return;
    const collapsed = box.classList.toggle("collapsed");
    btn.setAttribute("aria-expanded", String(!collapsed));
    const text = collapsed ? `Expand ${label}` : `Minimize ${label}`;
    btn.title = text;
    btn.setAttribute("aria-label", text);
    icon.className = "fa-solid " + (collapsed ? "fa-chevron-down" : "fa-chevron-up");
  });
  return btn;
}

function buildTermsViewToggle(title) {
  const view = getTermsView();
  const make = (v, icon, label) => {
    const btn = el("button", {
      type: "button",
      class: "terms-view-btn" + (v === view ? " active" : ""),
      "data-view": v,
      "aria-pressed": String(v === view)
    }, [el("i", { class: icon }), ` ${label}`]);
    btn.addEventListener("click", () => setTermsView(v));
    return btn;
  };
  return el("div", { class: "terms-view-toggle", role: "group", "aria-label": "Key terms layout" }, [
    title ? el("div", { class: "box-title" }, title) : null,
    make("list", "fa-solid fa-list", "List"),
    make("tabs", "fa-solid fa-folder-open", "Tabs"),
    buildBoxCollapseButton("key terms")
  ]);
}

// The key terms split into labeled groups: each Key Term Group first (in
// sheet order), then People / Topics / Events / Other. Both views draw
// from this same list, so they always show exactly the same terms.
function buildTermGroupModel(lesson, entities) {
  // A term in a Key Term Group lives in that group instead of the
  // People/Topics/Events lists.
  const termGroupBoxes = (lesson.termGroups || [])
    .map(g => resolveTermGroup(lesson, g.name))
    .filter(g => g && g.entities.length);
  const groupedIds = new Set(termGroupBoxes.flatMap(g => g.entities.map(e => e.id)));
  const ungrouped = entities.filter(e => !groupedIds.has(e.id));

  const categoryDefs = [
    { label: "People", match: e => (e.category || "").toLowerCase() === "person" },
    { label: "Topics", match: e => (e.category || "").toLowerCase() === "topic" },
    { label: "Events", match: e => (e.category || "").toLowerCase() === "event" }
  ];
  const categories = categoryDefs
    .map(g => ({ label: g.label, kind: "category", entities: ungrouped.filter(g.match) }))
    .filter(g => g.entities.length);

  // Anything with an unrecognized/missing category still shows up,
  // just under its own catch-all group instead of disappearing.
  const categorized = new Set(categories.flatMap(g => g.entities));
  const leftover = ungrouped.filter(e => !categorized.has(e));
  if (leftover.length) categories.push({ label: "Other", kind: "category", entities: leftover });

  return [
    ...termGroupBoxes.map(g => ({ label: g.name, kind: "key-term-group", entities: g.entities })),
    ...categories
  ];
}

function buildTermsListView(groups, lesson) {
  return el("div", { class: "mentions-groups" }, groups.map(g => {
    const chips = el("div", { class: "mentions-list" }, g.entities.map(ent => buildEntityChip(ent, true, isTeacherPinnedTerm(lesson, ent))));
    if (g.kind === "key-term-group") {
      return buildCollapsibleGroupBox(g.label, `${g.entities.length} key term${g.entities.length === 1 ? "" : "s"}`, [chips], "key-term-group");
    }
    return el("div", { class: "mentions-group" }, [el("div", { class: "mentions-group-label" }, g.label), chips]);
  }));
}

function buildTermsTabsView(groups, lesson, state) {
  if (!groups.length) return el("div", {});
  if (state.active >= groups.length) state.active = 0;
  const tabs = el("div", { class: "terms-tabs", role: "tablist" });
  const panel = el("div", { class: "terms-tab-panel", role: "tabpanel" });
  const paint = () => {
    [...tabs.children].forEach((t, i) => {
      const on = i === state.active;
      t.classList.toggle("active", on);
      t.setAttribute("aria-selected", String(on));
      t.tabIndex = on ? 0 : -1;
    });
    panel.innerHTML = "";
    panel.appendChild(el("div", { class: "mentions-list" },
      groups[state.active].entities.map(ent => buildEntityChip(ent, true, isTeacherPinnedTerm(lesson, ent)))));
  };
  groups.forEach((g, i) => {
    const tab = el("button", { type: "button", class: "terms-tab", role: "tab" }, [
      el("span", { class: "terms-tab-name" }, g.label),
      el("span", { class: "terms-tab-count" }, String(g.entities.length))
    ]);
    tab.addEventListener("click", () => { state.active = i; paint(); });
    tabs.appendChild(tab);
  });
  tabs.addEventListener("keydown", (e) => {
    if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
    e.preventDefault();
    state.active = (state.active + (e.key === "ArrowRight" ? 1 : groups.length - 1)) % groups.length;
    paint();
    tabs.children[state.active].focus();
  });
  paint();
  return el("div", { class: "terms-tabs-view" }, [tabs, panel]);
}

// The whole key-terms box: a toolbar with the List/Tabs toggle on top,
// the terms below -- laid out like the Sources box.
function buildTermsBox(lesson, entities) {
  const groups = buildTermGroupModel(lesson, entities);
  const state = { active: 0 };
  const body = el("div", { class: "terms-box-body" });
  const box = el("div", { class: "sources-box terms-box" }, [buildTermsViewToggle("People, Topics & Events"), body]);
  box._render = () => {
    body.innerHTML = "";
    body.appendChild(getTermsView() === "tabs" ? buildTermsTabsView(groups, lesson, state) : buildTermsListView(groups, lesson));
  };
  box._render();
  return box;
}

const SOURCE_VIEW_KEY = "usHistorySourceView";
function getSourceView() {
  // Gallery unless this device explicitly picked List.
  try { return localStorage.getItem(SOURCE_VIEW_KEY) === "list" ? "list" : "gallery"; } catch { return "gallery"; }
}
function setSourceView(view) {
  try { localStorage.setItem(SOURCE_VIEW_KEY, view); } catch { /* ignore */ }
  document.querySelectorAll(".source-list").forEach(l => l.classList.toggle("gallery", view === "gallery"));
  document.querySelectorAll(".source-view-btn").forEach(b => {
    const on = b.getAttribute("data-view") === view;
    b.classList.toggle("active", on);
    b.setAttribute("aria-pressed", String(on));
  });
}
function buildSourceViewToggle(title) {
  const view = getSourceView();
  const make = (v, icon, label) => {
    const btn = el("button", {
      type: "button",
      class: "source-view-btn" + (v === view ? " active" : ""),
      "data-view": v,
      "aria-pressed": String(v === view)
    }, [el("i", { class: icon }), ` ${label}`]);
    btn.addEventListener("click", () => setSourceView(v));
    return btn;
  };
  return el("div", { class: "source-view-toggle", role: "group", "aria-label": "Sources layout" }, [
    title ? el("div", { class: "box-title" }, title) : null,
    make("list", "fa-solid fa-list", "List"),
    make("gallery", "fa-solid fa-table-cells-large", "Gallery"),
    buildBoxCollapseButton("sources")
  ]);
}

// The collapsible box used for a resource set AND for a key-term group,
// so both look and behave exactly the same: name, count, chevron, and
// the items inside.
function buildCollapsibleGroupBox(name, countText, bodyChildren, extraClass) {
  const body = el("div", { class: "source-set-body" }, bodyChildren);
  const chevron = el("i", { class: "fa-solid fa-chevron-up" });
  const toggle = el("button", { type: "button", class: "source-set-toggle", "aria-expanded": "true" }, [
    el("span", { class: "source-set-name" }, name),
    el("span", { class: "source-set-count" }, countText),
    chevron
  ]);
  toggle.addEventListener("click", () => {
    const open = body.style.display !== "none";
    body.style.display = open ? "none" : "";
    toggle.setAttribute("aria-expanded", String(!open));
    chevron.className = open ? "fa-solid fa-chevron-down" : "fa-solid fa-chevron-up";
  });
  return el("div", { class: "source-set" + (extraClass ? " " + extraClass : "") }, [toggle, body]);
}

function buildSourceSet(name, items, lesson, unit) {
  return buildCollapsibleGroupBox(
    name,
    `${items.length} resource${items.length === 1 ? "" : "s"}`,
    items.map(({ kind, data }) => buildSourceItem(kind, data, lesson, unit))
  );
}

// A lesson's key terms for the "People, Topics & Events" section. Terms
// in a Key Term Group count even if their Key Term box wasn't ticked.
function keyTermSectionIds(lesson) {
  if (lesson.keyTerms && lesson.keyTerms.length) return lesson.keyTerms;
  return (lesson.termGroups || []).flatMap(g => g.members.map(m => m.id));
}

function updateUnitBanner(unit) {
  const banner = document.getElementById("unit-banner");
  if (!banner) return;
  banner.innerHTML = "";
  if (unit.icon) banner.appendChild(el("img", { class: "banner-icon", src: unit.icon, alt: "" }));
  banner.appendChild(document.createTextNode(`Unit: ${unit.number} — ${unit.title}`));
  if (unit.era) {
    banner.appendChild(el("span", { class: "unit-era" }, unit.era));
  }
}

function updateLessonBanner(lesson) {
  const banner = document.getElementById("lesson-banner");
  if (!banner) return;
  banner.innerHTML = "";
  if (lesson && lesson.icon) banner.appendChild(el("img", { class: "banner-icon", src: lesson.icon, alt: "" }));
  banner.appendChild(document.createTextNode(lesson ? `Lesson ${lesson.number} — ${lesson.title}` : ""));
}

// ---------- index page: a linear stepper ----------
// Starts on the first lesson. Prev/Next step through in order, or use
// "Change Lesson" in the masthead to jump straight to any lesson.
// Looks up which lesson a student should automatically land on, based
// on their class period (Roster tab) and that period's current lesson
// (Class Schedule tab). Returns -1 if either tab is empty/unset, the
// student isn't on the roster, or their period has no lesson assigned
// yet — any of which just falls back to the normal picker.
function findAssignedLessonIndex(ordered) {
  const studentId = getStoredStudentId();
  if (!studentId || studentId === TEACHER_VIEW_ID) return -1;
  const roster = COURSE_DATA.roster || {};
  const classSchedule = COURSE_DATA.classSchedule || {};
  const classPeriod = roster[studentId];
  if (!classPeriod) {
    console.warn(Object.keys(roster).length
      ? `Student ID ${studentId} isn't in the Roster tab, so there's no class period to look up a lesson for.`
      : "The Roster tab is empty or couldn't be read, so no student can be matched to a class period.");
    return -1;
  }
  const lessonId = lookupByPeriod(classSchedule, classPeriod);
  if (!lessonId) {
    console.warn(`${classPeriod} has no row in the Class Schedule tab. Periods there: ${Object.keys(classSchedule).join(", ") || "(none)"}`);
    return -1;
  }
  const index = findLessonIndexByScheduleValue(ordered, lessonId);
  if (index < 0) {
    console.warn(`Class Schedule says "${lessonId}" for ${classPeriod}, but no lesson has that ID or number. Lessons available: ` +
      ordered.map(o => `${o.lesson.number} (ID ${o.lesson.id})`).join(", "));
  }
  return index;
}

function renderIndex() {
  loadPinnedTerms();
  loadPinnedSources();
  initUnitThemes();
  initAnswerModeration();
  mountWideModeToggle();
  mountThemePicker();
  document.getElementById("course-title").textContent = COURSE_DATA.courseTitle;
  mountTeacherViewButton();
  mountChangeLessonButton();
  mountRateLessonButton();
  mountDoNowButton();
  mountMyAnswersButton();
  mountMyNotesButton();
  updateMastheadGroupDividers();

  const ordered = flatLessons();
  const root = document.getElementById("units");

  if (!ordered.length) {
    root.innerHTML = "";
    root.appendChild(el("div", { class: "case-file" }, [
      el("h1", {}, "No Lessons Yet"),
      el("p", {}, "Nothing's showing up from your spreadsheet right now, and there's no lesson content saved in this site's code either. Double-check your Lessons tab is published and reachable, then reload this page.")
    ]));
    return;
  }

  let stepsTaken = 0; // how many times a lesson has been shown (the first is the automatic one)
  async function renderStep(index, opts = {}) {
    if (index < 0 || index >= ordered.length) return;
    stepsTaken++;
    const { unit, lesson } = ordered[index];
    // Windows belong to the lesson they were opened from.
    if (currentLessonId !== lesson.id) closeAllSourceWindows();
    currentLessonId = lesson.id;

    root.innerHTML = "";
    root.appendChild(el("div", { class: "loading-spinner" }, [el("i", { class: "fa-solid fa-book-open-reader" }), " Loading lesson\u2026"]));

    await loadLessonSheet(lesson.id);
    // If the student navigated elsewhere while this lesson's sheet was
    // still loading, don't render it on top of whatever they're on now.
    if (currentLessonId !== lesson.id) return;

    root.innerHTML = "";

    const nav = el("div", { class: "lesson-nav" }, [
      el("button", {
        type: "button",
        class: "nav-btn nav-prev",
        disabled: index === 0 ? "disabled" : null
      }, "← Previous Lesson"),
      el("span", { class: "step-count" }, `${index + 1} of ${ordered.length}`),
      el("button", {
        type: "button",
        class: "nav-btn nav-next",
        disabled: index === ordered.length - 1 ? "disabled" : null
      }, "Next Lesson →")
    ]);

    let caseFile;
    try {
      caseFile = el("div", { class: "case-file" }, [
        ...buildLessonContent(lesson, unit),
        nav
      ]);
    } catch (err) {
      console.warn(`Lesson "${lesson.id}" failed to render — check its data:`, err);
      caseFile = el("div", { class: "case-file" }, [
        el("h1", {}, lesson.title || "This lesson has a content issue"),
        el("p", {}, "Something in this lesson's data didn't load correctly. If it's coming from a Sheet, double-check that row — everything else on the site is unaffected."),
        nav
      ]);
    }

    updateUnitBanner(unit);

    applyThemeForUnit(unit, lesson);
    updateLessonBanner(lesson);
    updateMastheadExpanded(lesson);
    mountMastheadCollapseListener();
    updateRateLessonButtonVisibility(lesson);
    updateDoNowButtonVisibility(lesson);
    updateLessonButtonGroupVisibility();
    root.appendChild(caseFile);

    nav.querySelector(".nav-prev").addEventListener("click", () => renderStep(index - 1));
    nav.querySelector(".nav-next").addEventListener("click", () => renderStep(index + 1));

    window.scrollTo({ top: 0, behavior: "smooth" });
    if (!opts.skipDoNow) maybeShowDoNow(lesson);
  }

  currentGoToStep = renderStep;
  const assignedIndex = findAssignedLessonIndex(ordered);

  // The student ID prompt and the spreadsheet load run side by side. On a
  // first visit (or a new device) the lesson is chosen BEFORE the student
  // has typed their ID, so nothing is assigned and lesson 1 shows behind the
  // picker. Once the ID is in, the page calls this: if the student hasn't
  // picked or stepped anywhere yet, take them to their class's lesson.
  window.goToAssignedLessonIfUnchosen = function () {
    if (assignedIndex >= 0 || stepsTaken !== 1) return false; // already assigned on load, or they've started navigating themselves
    const i = findAssignedLessonIndex(ordered);
    if (i < 0) return false;
    if (activeModal && activeModal.querySelector('[aria-label="Change Lesson"]')) { modalCleanup = null; closeModal(); } // the picker, without its "lesson 1 Do Now" fallback
    renderStep(i);
    return true;
  };

  if (assignedIndex >= 0) {
    renderStep(assignedIndex); // student's class period has a lesson assigned — jump straight there, no picker
  } else {
    renderStep(0, { skipDoNow: true }); // shows lesson 1 behind the picker, but holds off on Do Now
    openLessonPickerModal(() => maybeShowDoNow(ordered[0].lesson), true); // if they close without picking, lesson 1's Do Now still runs
  }
}

// ---------- standalone lesson page (lesson.html?id=...) — still available for direct links ----------
async function renderLesson() {
  loadPinnedTerms();
  loadPinnedSources();
  initUnitThemes();
  initAnswerModeration();
  mountWideModeToggle();
  mountThemePicker();
  mountTeacherViewButton();
  mountChangeLessonButton();
  mountRateLessonButton();
  mountDoNowButton();
  mountMyAnswersButton();
  mountMyNotesButton();
  updateMastheadGroupDividers();
  currentGoToStep = null; // no stepper here — the picker falls back to navigating by URL
  const params = new URLSearchParams(window.location.search);
  const id = params.get("id");
  const found = id ? findLesson(id) : null;

  const root = document.getElementById("lesson-root");
  root.innerHTML = "";

  if (!found) {
    root.appendChild(el("div", { class: "case-file" }, [
      el("h1", {}, "Lesson not found"),
      el("p", {}, "This lesson id doesn't match anything in data.js. Check the link, or go back to the index."),
      el("a", { class: "breadcrumb", href: "index.html" }, "← Back to all lessons")
    ]));
    return;
  }

  const { unit, lesson } = found;
  currentLessonId = lesson.id;
  document.title = `${lesson.title} — ${COURSE_DATA.courseTitle}`;
  const titleEl = document.getElementById("course-title");
  if (titleEl) titleEl.textContent = COURSE_DATA.courseTitle;
  updateUnitBanner(unit);
  applyThemeForUnit(unit, lesson);
  updateLessonBanner(lesson);
  updateMastheadExpanded(lesson);
  mountMastheadCollapseListener();
  updateRateLessonButtonVisibility(lesson);
  updateDoNowButtonVisibility(lesson);
  updateLessonButtonGroupVisibility();

  root.appendChild(el("div", { class: "loading-spinner" }, [el("i", { class: "fa-solid fa-book-open-reader" }), " Loading lesson\u2026"]));
  await loadLessonSheet(lesson.id);
  if (currentLessonId !== lesson.id) return; // navigated elsewhere while this was loading
  root.innerHTML = "";

  const ordered = flatLessons();
  const idx = ordered.findIndex(o => o.lesson.id === lesson.id);
  let caseFile;
  try {
    caseFile = el("div", { class: "case-file" }, [
      ...buildLessonContent(lesson, unit)
    ]);
  } catch (err) {
    console.warn(`Lesson "${lesson.id}" failed to render — check its data:`, err);
    caseFile = el("div", { class: "case-file" }, [
      el("h1", {}, lesson.title || "This lesson has a content issue"),
      el("p", {}, "Something in this lesson's data didn't load correctly. If it's coming from a Sheet, double-check that row.")
    ]);
  }

  root.appendChild(el("a", { class: "breadcrumb", href: "index.html" }, "← Back to all lessons"));
  root.appendChild(caseFile);

  maybeShowDoNow(lesson);
}

</script>
  <script>
/* =========================================================================
   PRINT PREVIEW
   -------------------------------------------------------------------------
   A "Print" button in the masthead opens a clean, white, paper-style view
   of the current lesson (or the whole unit) with options for what to
   include. Unit + lesson sit in a header that repeats at the top of every
   printed page (a table <thead>, which browsers repeat on each page).
   Nothing here touches Firebase or logs anything.
   Loaded after app.js; uses its helpers (el, findLesson, classifyReadingBlock,
   buildOrderedSources, groupSourcesIntoSets, ...).
   ========================================================================= */

const PRINT_OPTIONS_KEY = "usHistoryPrintOptions";
const PRINT_DEFAULTS = {
  scope: "lesson",       // "lesson" | "unit"
  objectives: true,
  terms: true,
  sources: true,         // the at-a-glance list of every source
  readings: true,        // full reading text
  images: true,
  questions: true,
  answerKey: false,
  writeLines: true,      // ruled lines under short-answer questions
  newPageEach: true,     // every source starts on a fresh page
  doubleSpace: true      // double-spaced reading text and questions
};

function loadPrintOptions() {
  try {
    const saved = JSON.parse(localStorage.getItem(PRINT_OPTIONS_KEY) || "null");
    return Object.assign({}, PRINT_DEFAULTS, saved || {});
  } catch { return Object.assign({}, PRINT_DEFAULTS); }
}
function savePrintOptions(opts) {
  try { localStorage.setItem(PRINT_OPTIONS_KEY, JSON.stringify(opts)); } catch { /* ignore */ }
}

// ---------- building one lesson's printable pages ----------
function printQuestion(q, n, opts) {
  const box = el("div", { class: "pv-question" });
  box.appendChild(el("p", { class: "pv-q-prompt" }, [el("span", { class: "pv-q-num" }, `${n}. `), q.prompt]));
  if (q.image) box.appendChild(el("img", { class: "pv-q-image", src: q.image, alt: "" }));
  if (q.termGroup) {
    const ents = (COURSE_DATA.entities || []).filter(e => (e.subcategory || "").toLowerCase() === q.termGroup.toLowerCase());
    if (ents.length) box.appendChild(el("p", { class: "pv-q-terms" }, ents.map(e => e.name).join(" · ")));
  }
  if (q.type === "short_answer") {
    if (opts.writeLines && !opts.answerKey) {
      box.appendChild(el("div", { class: "pv-lines" }, [el("div"), el("div"), el("div")]));
    }
    if (opts.answerKey && q.sampleAnswer) {
      box.appendChild(el("p", { class: "pv-key" }, [el("strong", {}, "Sample answer: "), q.sampleAnswer]));
    }
  } else {
    const letters = "ABCDEFGHIJ";
    box.appendChild(el("ol", { class: "pv-choices", type: "A" }, (q.choices || []).map((c, i) =>
      el("li", { class: opts.answerKey && i === q.correctIndex ? "pv-correct" : "" }, [
        c, opts.answerKey && i === q.correctIndex ? el("span", { class: "pv-check" }, " ✓") : null
      ])
    )));
    if (opts.answerKey) {
      const bits = [];
      if (q.correctIndex >= 0 && q.choices && q.choices[q.correctIndex] !== undefined) bits.push(el("strong", {}, `Answer: ${letters[q.correctIndex]}. `));
      if (q.explanation) bits.push(q.explanation);
      if (bits.length) box.appendChild(el("p", { class: "pv-key" }, bits));
    }
  }
  return box;
}

function printQuestionList(questions, counter, opts) {
  return (questions || []).map(q => printQuestion(q, ++counter.n, opts));
}

function printSourceMeta(kind, d) {
  if (kind === "Reading") return [d.source, d.note].filter(Boolean).join(" · ");
  if (kind === "Video") return [d.length, d.note].filter(Boolean).join(" · ");
  const count = (d.files || []).length;
  return [count > 1 ? `Gallery of ${count} images` : "", d.note].filter(Boolean).join(" · ");
}

function printReadingBody(reading, lesson, opts, counter) {
  const body = el("div", { class: "pv-reading" });
  const raws = (reading.text || "").split(/\n\s*\n/).map(p => p.trim());
  raws.forEach((raw, i) => {
    if (raw) {
      const b = classifyReadingBlock(raw);
      if (b.kind === "divider") body.appendChild(el("hr", { class: "pv-divider" }));
      else if (b.kind === "list") body.appendChild(el("ul", { class: "pv-list" }, b.items.map(it => el("li", {}, it))));
      else body.appendChild(el(b.tag, { class: "pv-" + (b.cls || "p") }, b.text));
    }
    if (opts.questions) {
      const qs = (reading.questions || []).filter(q => q.afterParagraph === i);
      printQuestionList(qs, counter, opts).forEach(n => body.appendChild(n));
    }
  });
  return body;
}

function buildPrintLesson(unit, lesson, opts) {
  const counter = { n: 0 };
  const head = el("thead", {}, el("tr", {}, el("th", { class: "pv-head" }, [
    el("div", { class: "pv-head-top" }, [
      el("span", { class: "pv-head-course" }, (COURSE_DATA.courseTitle || "")),
      el("span", { class: "pv-head-unit" }, `Unit ${unit.number}: ${unit.title}`)
    ]),
    el("div", { class: "pv-head-lesson" }, [el("span", { class: "pv-head-num" }, `Lesson ${lesson.number}`), " — ", lesson.title]),
    el("div", { class: "pv-head-fields" }, [el("span", {}, "Name: ______________________"), el("span", {}, "Date: ____________"), el("span", {}, "Period: ______")])
  ])));

  const content = el("div", { class: "pv-content" + (opts.doubleSpace ? " pv-double" : "") });

  // inquiry + objectives
  if (opts.objectives) {
    const inqs = (lesson.inquiryFocus || []).map(id => (COURSE_DATA.inquiries || []).find(i => i.id === id)).filter(Boolean);
    if (inqs.length || (lesson.objectives || []).length) {
      const box = el("div", { class: "pv-box pv-goals" });
      if (inqs.length) {
        box.appendChild(el("div", { class: "pv-h" }, "Course Inquiry"));
        box.appendChild(el("ul", {}, inqs.map(i => el("li", {}, i.question))));
      }
      if ((lesson.objectives || []).length) {
        box.appendChild(el("div", { class: "pv-h" }, "Learning Objectives"));
        box.appendChild(el("ul", {}, lesson.objectives.map(o => el("li", {}, o.text))));
      }
      content.appendChild(box);
    }
  }

  // vocabulary / key terms
  if (opts.terms) {
    const ents = keyTermSectionIds(lesson).map(id => COURSE_DATA.entities.find(e => e.id === id)).filter(Boolean);
    if (ents.length) {
      const groups = buildTermGroupModel(lesson, ents);
      const sec = el("div", { class: "pv-section" }, el("div", { class: "pv-h2" }, "Key Terms"));
      groups.forEach(g => {
        sec.appendChild(el("div", { class: "pv-h3" }, g.label));
        sec.appendChild(el("dl", { class: "pv-terms" }, g.entities.flatMap(e => [
          el("dt", {}, e.name),
          el("dd", {}, entityDescription(e, "; ") || "")
        ])));
      });
      content.appendChild(sec);
    }
  }

  const sources = buildOrderedSources(lesson);

  // at-a-glance list of sources
  if (opts.sources && sources.length) {
    const sec = el("div", { class: "pv-section" }, el("div", { class: "pv-h2" }, "Sources"));
    const list = el("ul", { class: "pv-sources" });
    groupSourcesIntoSets(sources).forEach(entry => {
      const rows = entry.set ? entry.items : [entry.item];
      if (entry.set) list.appendChild(el("li", { class: "pv-set-label" }, [el("strong", {}, entry.set), " (set)"]));
      rows.forEach(it => {
        list.appendChild(el("li", { class: entry.set ? "pv-in-set" : "" }, [
          el("span", { class: "pv-kind" }, it.kind), " ",
          el("strong", {}, it.data.title),
          printSourceMeta(it.kind, it.data) ? el("span", { class: "pv-meta" }, " — " + printSourceMeta(it.kind, it.data)) : null,
          it.kind === "Video" && it.data.src && /^https?:/i.test(it.data.src) ? el("div", { class: "pv-url" }, it.data.src) : null
        ]));
      });
    });
    sec.appendChild(list);
    content.appendChild(sec);
  }

  // each source in full
  sources.forEach(({ kind, data }) => {
    if (kind === "Reading" && opts.readings) {
      content.appendChild(el("div", { class: "pv-section pv-source" + (opts.newPageEach ? " pv-newpage" : "") }, [
        el("div", { class: "pv-h2" }, [el("span", { class: "pv-kind" }, "Reading"), " ", data.title]),
        printSourceMeta(kind, data) ? el("div", { class: "pv-byline" }, printSourceMeta(kind, data)) : null,
        printReadingBody(data, lesson, opts, counter)
      ]));
    } else if (kind === "Image" && opts.images) {
      const files = (data.files || []).map(f => (typeof f === "string" ? { src: f, caption: "" } : f));
      content.appendChild(el("div", { class: "pv-section pv-source" + (opts.newPageEach ? " pv-newpage" : "") }, [
        el("div", { class: "pv-h2" }, [el("span", { class: "pv-kind" }, "Image"), " ", data.title]),
        data.note ? el("div", { class: "pv-byline" }, data.note) : null,
        ...files.map(f => el("figure", { class: "pv-figure" }, [
          el("img", { src: f.src, alt: data.title }),
          f.caption ? el("figcaption", {}, f.caption) : null
        ])),
        ...(opts.questions ? printQuestionList(data.questions, counter, opts) : [])
      ]));
    } else if (kind === "Video" && opts.questions && (data.questions || []).length) {
      content.appendChild(el("div", { class: "pv-section pv-source" + (opts.newPageEach ? " pv-newpage" : "") }, [
        el("div", { class: "pv-h2" }, [el("span", { class: "pv-kind" }, "Video"), " ", data.title]),
        data.length ? el("div", { class: "pv-byline" }, data.length) : null,
        ...printQuestionList(data.questions, counter, opts)
      ]));
    }
  });

  // lesson-level questions
  if (opts.questions && (lesson.assessment || []).length) {
    content.appendChild(el("div", { class: "pv-section pv-source" + (opts.newPageEach ? " pv-newpage" : "") }, [
      el("div", { class: "pv-h2" }, "Check Your Understanding"),
      ...printQuestionList(lesson.assessment, counter, opts)
    ]));
  }

  return el("table", { class: "pv-lesson" }, [head, el("tbody", {}, el("tr", {}, el("td", {}, content)))]);
}

/* =========================================================================
   DOWNLOAD AS PDF
   -------------------------------------------------------------------------
   Browser printing is unreliable inside an embed (Google Sites blocks it, and
   Ctrl+P prints the whole Sites page). So this builds a real PDF file from the
   same content and options, and downloads it. Uses jsPDF, loaded on demand.
   ========================================================================= */
const JSPDF_URL = "https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js";

function loadJsPdf() {
  if (window.jspdf && window.jspdf.jsPDF) return Promise.resolve(window.jspdf.jsPDF);
  return new Promise((resolve, reject) => {
    const s = document.createElement("script");
    s.src = JSPDF_URL;
    s.onload = () => (window.jspdf && window.jspdf.jsPDF ? resolve(window.jspdf.jsPDF) : reject(new Error("PDF library didn't start")));
    s.onerror = () => reject(new Error("Couldn't load the PDF library (check your connection)"));
    document.head.appendChild(s);
  });
}

// jsPDF's built-in fonts only cover Western characters; anything else would print as garbage.
function pdfText(s) {
  return String(s == null ? "" : s)
    .replace(/\t/g, " ")
    .replace(/[‐‑−]/g, "-")
    .replace(/[′]/g, "'").replace(/[″]/g, '"')
    .replace(/[^\n -~ -ÿ‘’“”–—•…]/g, "");
}

function pdfImage(src) {
  return new Promise(resolve => {
    if (!src) return resolve(null);
    const im = new Image();
    im.crossOrigin = "anonymous";
    im.onload = () => {
      try {
        const w0 = im.naturalWidth || im.width || 800, h0 = im.naturalHeight || im.height || 600;
        const sc = Math.min(1, 1400 / w0);
        const c = document.createElement("canvas");
        c.width = Math.max(1, Math.round(w0 * sc)); c.height = Math.max(1, Math.round(h0 * sc));
        const g = c.getContext("2d");
        g.fillStyle = "#fff"; g.fillRect(0, 0, c.width, c.height);
        g.drawImage(im, 0, 0, c.width, c.height);
        resolve({ data: c.toDataURL("image/jpeg", 0.85), w: c.width, h: c.height });
      } catch (e) { resolve(null); } // a cross-origin image the browser won't let us read
    };
    im.onerror = () => resolve(null);
    im.src = src;
  });
}

function lessonImageSources(lesson, opts) {
  const out = [];
  if (opts.images) lesson.images.forEach(i => (i.files || []).forEach(f => out.push(typeof f === "string" ? f : f.src)));
  if (opts.questions) {
    const qs = [...(lesson.assessment || [])];
    lesson.readings.forEach(r => qs.push(...(r.questions || [])));
    lesson.videos.forEach(v => qs.push(...(v.questions || [])));
    lesson.images.forEach(i => qs.push(...(i.questions || [])));
    qs.forEach(q => { if (q.image) out.push(q.image); });
  }
  return out.filter(Boolean);
}

async function buildPdfDocument(targets, opts) {
  const JsPDF = await loadJsPdf();
  const imgs = {};
  const srcs = [...new Set(targets.flatMap(t => lessonImageSources(t.lesson, opts)))];
  await Promise.all(srcs.map(async s => { imgs[s] = await pdfImage(s); }));

  const doc = new JsPDF({ unit: "pt", format: "letter" });
  const PW = 612, PH = 792, M = 54, W = PW - 2 * M, BOTTOM = PH - 58;
  const dbl = !!opts.doubleSpace;
  let y = M, fresh = true, ctx = null;
  const step = (size, tight) => size * (dbl && !tight ? 2 : 1.4);

  function drawHeader() {
    const { unit, lesson } = ctx;
    doc.setTextColor(60); doc.setFont("helvetica", "bold"); doc.setFontSize(8.5);
    doc.text(pdfText(COURSE_DATA.courseTitle || "").toUpperCase(), M, M + 8);
    doc.text(pdfText(`Unit ${unit.number}: ${unit.title}`).toUpperCase(), M + W, M + 8, { align: "right" });
    doc.setTextColor(0); doc.setFont("times", "bold"); doc.setFontSize(16);
    const tl = doc.splitTextToSize(pdfText(`Lesson ${lesson.number} - ${lesson.title}`), W);
    let hy = M + 28;
    tl.forEach(l => { doc.text(l, M, hy); hy += 19; });
    doc.setFont("helvetica", "normal"); doc.setFontSize(9); doc.setTextColor(50);
    doc.text("Name: ______________________________", M, hy + 2);
    doc.text("Date: ______________", M + 235, hy + 2);
    doc.text("Period: _______", M + 390, hy + 2);
    doc.setTextColor(0); doc.setDrawColor(0); doc.setLineWidth(1.2);
    doc.line(M, hy + 10, M + W, hy + 10);
    y = hy + 24; fresh = true;
  }
  function newPage() { doc.addPage(); drawHeader(); }
  function ensure(h) { if (y + h > BOTTOM) newPage(); }
  function startSource() { if (opts.newPageEach && !fresh) newPage(); }

  // Draws wrapped text, flowing across pages. o: font style size indent align marker tight gap keep
  function para(text, o = {}) {
    const size = o.size || 11, font = o.font || "times", style = o.style || "normal";
    const indent = o.indent || 0, w = W - indent - (o.rightIndent || 0);
    doc.setFont(font, style); doc.setFontSize(size);
    const lines = doc.splitTextToSize(pdfText(text), w);
    const st = step(size, o.tight);
    if (o.keep) ensure(st * Math.min(lines.length, 2) + o.keep);
    lines.forEach((l, i) => {
      ensure(st);
      doc.setFont(font, style); doc.setFontSize(size); doc.setTextColor(o.gray ? 70 : 0);
      const base = y + (st - size) / 2 + size * 0.8;
      if (i === 0 && o.marker) doc.text(pdfText(o.marker), M + (o.markerX || 0), base);
      const x = o.align === "center" ? M + indent + w / 2 : o.align === "right" ? M + indent + w : M + indent;
      if (l.length) doc.text(l, x, base, o.align ? { align: o.align } : undefined);
      y += st; fresh = false;
    });
    doc.setTextColor(0);
    y += o.gap || 0;
  }
  function rule(width = W, x = M, weight = 0.6) { ensure(8); doc.setDrawColor(90); doc.setLineWidth(weight); doc.line(x, y + 2, x + width, y + 2); y += 8; fresh = false; }
  function heading(text) { para(text, { style: "bold", size: 14, tight: true, keep: 40 }); rule(); y += 2; }
  function subhead(text) { para(String(text).toUpperCase(), { font: "helvetica", style: "bold", size: 8.5, tight: true, keep: 24, gap: 2, gray: true }); }
  function bullet(text, indent = 6) { para(text, { indent: indent + 12, marker: "•", markerX: indent, tight: true, gap: 1 }); }
  function image(src, maxH = 280, maxFrac = 0.85) {
    const im = imgs[src]; if (!im) return false;
    let w = Math.min(W * maxFrac, im.w * 0.75), h = w * im.h / im.w;
    if (h > maxH) { h = maxH; w = h * im.w / im.h; }
    ensure(h + 6);
    doc.addImage(im.data, "JPEG", M + (W - w) / 2, y, w, h);
    y += h + 6; fresh = false; return true;
  }

  function question(q, n) {
    para(`${q.prompt}`, { style: "bold", indent: 18, marker: `${n}.`, markerX: 0, keep: 30 });
    if (q.image) image(q.image, 200, 0.6);
    if (q.termGroup) {
      const ents = (COURSE_DATA.entities || []).filter(e => (e.subcategory || "").toLowerCase() === q.termGroup.toLowerCase());
      if (ents.length) para(ents.map(e => e.name).join("  |  "), { indent: 18, size: 10, tight: true, gray: true });
    }
    if (q.type === "short_answer") {
      if (opts.answerKey) {
        if (q.sampleAnswer) para("Sample answer: " + q.sampleAnswer, { indent: 18, style: "italic", size: 10.5, tight: true });
      } else if (opts.writeLines) {
        const ls = dbl ? 26 : 21;
        for (let i = 0; i < 3; i++) { ensure(ls); doc.setDrawColor(70); doc.setLineWidth(0.6); doc.line(M + 18, y + ls - 3, M + W, y + ls - 3); y += ls; fresh = false; }
      }
    } else {
      const letters = "ABCDEFGHIJ";
      (q.choices || []).forEach((c, i) => {
        const right = opts.answerKey && i === q.correctIndex;
        para(c + (right ? "   (correct)" : ""), { indent: 40, marker: `${letters[i]}.`, markerX: 22, style: right ? "bold" : "normal", gap: 0 });
      });
      if (opts.answerKey && q.explanation) para(q.explanation, { indent: 18, style: "italic", size: 10.5, tight: true });
    }
    y += 8;
  }

  function readingBlocks(reading, counter) {
    const raws = (reading.text || "").split(/\n\s*\n/).map(p => p.trim());
    raws.forEach((raw, i) => {
      if (raw) {
        const b = classifyReadingBlock(raw);
        if (b.kind === "divider") { y += 4; rule(W * 0.3, M + W * 0.35); y += 4; }
        else if (b.kind === "list") b.items.forEach(it => bullet(it, 14));
        else if (b.cls === "reading-h1") para(b.text, { style: "bold", size: 15, keep: 30, tight: true, gap: 4 });
        else if (b.cls === "reading-h2") para(b.text, { style: "bold", size: 13, keep: 30, tight: true, gap: 3 });
        else if (b.cls === "reading-h3") para(b.text, { style: "italic", size: 11.5, keep: 30, tight: true, gap: 2 });
        else if (b.cls === "reading-blockquote") para(b.text, { style: "italic", indent: 28, rightIndent: 20, gap: 6 });
        else if (b.cls === "reading-poem") {
          const lines = String(b.text).split("\n");
          const pre = lines.length * step(11) <= 300 ? step(11) * Math.min(lines.length, 6) : step(11) * 2;
          ensure(pre);
          lines.forEach(l => para(l.trim(), { style: "italic", indent: 36 + (l.match(/^\s*/)[0].length ? 18 : 0) }));
          y += 6;
        }
        else if (b.cls === "reading-centered") para(b.text, { align: "center", gap: 6, style: "bold" });
        else if (b.cls === "reading-attribution") para(b.text, { align: "right", style: "italic", gap: 6 });
        else if (b.cls === "reading-callout") para(b.text, { indent: 14, rightIndent: 14, style: "bold", gap: 6 });
        else para(b.text, { gap: dbl ? 0 : 7, });
      }
      if (opts.questions) {
        const qs = (reading.questions || []).filter(q => q.afterParagraph === i);
        if (qs.length) { y += 4; qs.forEach(q => question(q, ++counter.n)); }
      }
    });
  }

  targets.forEach((t, ti) => {
    ctx = t;
    if (ti > 0) doc.addPage();
    drawHeader();
    const { unit, lesson } = t;
    const counter = { n: 0 };

    if (opts.objectives) {
      const inqs = (lesson.inquiryFocus || []).map(id => (COURSE_DATA.inquiries || []).find(i => i.id === id)).filter(Boolean);
      if (inqs.length) { subhead("Course Inquiry"); inqs.forEach(i => bullet(i.question)); y += 4; }
      if ((lesson.objectives || []).length) { subhead("Learning Objectives"); lesson.objectives.forEach(o => bullet(o.text)); y += 6; }
    }
    if (opts.terms) {
      const ents = keyTermSectionIds(lesson).map(id => COURSE_DATA.entities.find(e => e.id === id)).filter(Boolean);
      if (ents.length) {
        heading("Key Terms");
        buildTermGroupModel(lesson, ents).forEach(g => {
          subhead(g.label);
          g.entities.forEach(e => {
            para(e.name, { style: "bold", tight: true, keep: 16 });
            para(entityDescription(e, "; ") || "", { indent: 14, tight: true, gap: 3 });
          });
          y += 4;
        });
      }
    }
    const sources = buildOrderedSources(lesson);
    if (opts.sources && sources.length) {
      heading("Sources");
      groupSourcesIntoSets(sources).forEach(entry => {
        const rows = entry.set ? entry.items : [entry.item];
        if (entry.set) para(entry.set + " (set)", { style: "bold", tight: true });
        rows.forEach(it => {
          const meta = printSourceMeta(it.kind, it.data);
          para(it.data.title + (meta ? " - " + meta : ""), { indent: (entry.set ? 14 : 0) + 56, marker: it.kind.toUpperCase(), markerX: entry.set ? 14 : 0, tight: true, gap: 1 });
          if (it.kind === "Video" && it.data.src && /^https?:/i.test(it.data.src)) para(it.data.src, { indent: (entry.set ? 14 : 0) + 56, size: 8.5, font: "courier", tight: true, gray: true });
        });
      });
      y += 6;
    }

    sources.forEach(({ kind, data }) => {
      if (kind === "Reading" && opts.readings) {
        startSource();
        heading(`Reading: ${data.title}`);
        const meta = printSourceMeta(kind, data);
        if (meta) para(meta, { style: "italic", gray: true, tight: true, gap: 6 });
        readingBlocks(data, counter);
      } else if (kind === "Image" && opts.images) {
        startSource();
        heading(`Image: ${data.title}`);
        if (data.note) para(data.note, { style: "italic", gray: true, tight: true, gap: 4 });
        (data.files || []).map(f => (typeof f === "string" ? { src: f } : f)).forEach(f => {
          if (!image(f.src, 330)) para("[Image could not be included in the PDF]", { size: 9, tight: true, gray: true });
          if (f.caption) para(f.caption, { align: "center", style: "italic", size: 9.5, tight: true, gap: 8 });
        });
        if (opts.questions) (data.questions || []).forEach(q => question(q, ++counter.n));
      } else if (kind === "Video" && opts.questions && (data.questions || []).length) {
        startSource();
        heading(`Video: ${data.title}`);
        data.questions.forEach(q => question(q, ++counter.n));
      }
    });

    if (opts.questions && (lesson.assessment || []).length) {
      startSource();
      heading("Check Your Understanding");
      lesson.assessment.forEach(q => question(q, ++counter.n));
    }
  });

  const total = doc.getNumberOfPages();
  for (let i = 1; i <= total; i++) {
    doc.setPage(i);
    doc.setFont("helvetica", "normal"); doc.setFontSize(8.5); doc.setTextColor(100);
    doc.text(`Page ${i} of ${total}`, PW / 2, PH - 30, { align: "center" });
  }
  return doc;
}

function pdfFileName(targets, opts) {
  const clean = s => String(s).replace(/[^A-Za-z0-9._-]+/g, "-");
  if (!targets.length) return "lesson.pdf";
  const u = targets[0].unit, l = targets[0].lesson;
  return opts.scope === "unit" ? `Unit-${clean(u.number)}.pdf` : `Unit-${clean(u.number)}-Lesson-${clean(l.number)}.pdf`;
}

// ---------- the overlay ----------
let printOverlay = null;

function closePrintPreview() {
  if (!printOverlay) return;
  printOverlay.remove();
  printOverlay = null;
  document.body.classList.remove("pv-open");
}

async function openPrintPreview() {
  closePrintPreview();
  if (typeof closeModal === "function") { try { closeModal(); } catch { /* ignore */ } }
  const found = currentLessonId ? findLesson(currentLessonId) : null;
  const opts = loadPrintOptions();

  const paper = el("div", { class: "pv-paper" });
  const status = el("span", { class: "pv-status" });

  async function collectTargets() {
    const targets = [];
    if (found) {
      if (opts.scope === "unit") found.unit.lessons.forEach(l => targets.push({ unit: found.unit, lesson: l }));
      else targets.push(found);
    }
    for (const t of targets) { try { await loadLessonSheet(t.lesson.id); } catch { /* use what we have */ } }
    return targets;
  }

  async function render() {
    status.textContent = "Loading…";
    paper.innerHTML = "";
    const targets = await collectTargets();
    if (!printOverlay) return;
    if (!targets.length) {
      paper.appendChild(el("p", { class: "pv-empty" }, "Open a lesson first, then choose Print."));
    }
    targets.forEach((t, i) => {
      const node = buildPrintLesson(t.unit, t.lesson, opts);
      if (i > 0) node.classList.add("pv-newpage");
      paper.appendChild(node);
    });
    status.textContent = targets.length > 1 ? `${targets.length} lessons` : "";
  }

  function checkbox(key, label) {
    const input = el("input", { type: "checkbox" });
    input.checked = !!opts[key];
    input.addEventListener("change", () => { opts[key] = input.checked; savePrintOptions(opts); render(); });
    return el("label", { class: "pv-opt" }, [input, " " + label]);
  }
  const scopeSel = el("select", {}, [
    el("option", { value: "lesson" }, "This lesson"),
    el("option", { value: "unit" }, "Whole unit (one lesson per page set)")
  ]);
  scopeSel.value = opts.scope;
  scopeSel.addEventListener("change", () => { opts.scope = scopeSel.value; savePrintOptions(opts); render(); });

  const fallbackLink = el("a", { class: "pv-link", target: "_blank", rel: "noopener", style: "display:none" }, "Open the PDF in a new tab");
  const pdfBtn = el("button", { type: "button", class: "pv-btn pv-primary" }, [el("i", { class: "fa-solid fa-file-pdf" }), " Download PDF"]);
  pdfBtn.addEventListener("click", async () => {
    pdfBtn.disabled = true; fallbackLink.style.display = "none";
    status.textContent = "Making the PDF…";
    try {
      const targets = await collectTargets();
      const doc = await buildPdfDocument(targets, opts);
      const name = pdfFileName(targets, opts);
      const url = URL.createObjectURL(doc.output("blob"));
      const a = document.createElement("a");
      a.href = url; a.download = name; document.body.appendChild(a); a.click(); a.remove();
      fallbackLink.href = url; fallbackLink.style.display = "";
      status.textContent = `Saved ${name} (${doc.getNumberOfPages()} pages). If nothing downloaded: `;
    } catch (err) {
      console.warn("PDF failed", err);
      status.textContent = "Couldn't make the PDF: " + (err && err.message ? err.message : err);
    }
    pdfBtn.disabled = false;
  });
  const printBtn = el("button", { type: "button", class: "pv-btn", title: "Browser print (may not work inside Google Sites)" }, [el("i", { class: "fa-solid fa-print" }), " Print"]);
  printBtn.addEventListener("click", () => { try { window.print(); } catch (e) { status.textContent = "Printing is blocked here, use Download PDF."; } });
  const closeBtn = el("button", { type: "button", class: "pv-btn" }, "Close");
  closeBtn.addEventListener("click", closePrintPreview);

  const bar = el("div", { class: "pv-toolbar" }, [
    el("div", { class: "pv-toolbar-row" }, [
      el("strong", {}, "Print preview"), scopeSel, status, fallbackLink,
      el("span", { class: "pv-spacer" }), pdfBtn, printBtn, closeBtn
    ]),
    el("div", { class: "pv-toolbar-row pv-opts" }, [
      checkbox("objectives", "Inquiry & objectives"),
      checkbox("terms", "Key terms"),
      checkbox("sources", "Source list"),
      checkbox("readings", "Reading text"),
      checkbox("images", "Images"),
      checkbox("questions", "Questions"),
      checkbox("answerKey", "Answer key"),
      checkbox("writeLines", "Answer lines"),
      checkbox("newPageEach", "New page per source"),
      checkbox("doubleSpace", "Double-spaced")
    ])
  ]);

  printOverlay = el("div", { class: "pv-overlay", role: "dialog", "aria-label": "Print preview" }, [bar, paper]);
  document.body.appendChild(printOverlay);
  document.body.classList.add("pv-open");
  document.addEventListener("keydown", function esc(e) {
    if (e.key === "Escape" && printOverlay) closePrintPreview();
    if (!printOverlay) document.removeEventListener("keydown", esc);
  });
  await render();
}

function mountPrintButton() {
  if (document.getElementById("print-btn")) return;
  const group = document.getElementById("masthead-mystuff-group") || document.querySelector(".masthead-actions");
  if (!group) return;
  const btn = el("button", { type: "button", id: "print-btn", class: "masthead-btn print-masthead-btn", title: "Print preview" }, [
    el("i", { class: "fa-solid fa-print" }), " Print"
  ]);
  btn.addEventListener("click", openPrintPreview);
  group.appendChild(btn);
}

if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", mountPrintButton);
else mountPrintButton();

</script>
  <script>
    const lessonsReady = loadFromSheets().then(() => renderIndex());
    ensureStudentId().then(mountTeacherViewButton).then(() => lessonsReady).then(() => { if (window.goToAssignedLessonIfUnchosen) goToAssignedLessonIfUnchosen(); }); // rendering no longer waits on ensureStudentId() -- that prompt only resolves once someone types in an ID, which would otherwise block the whole page (including the unreachable-sheet fallback) from ever showing anything
  </script></body>
</html>
