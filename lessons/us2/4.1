  currentThemeLesson = lesson || null;
  applyTheme(themeIdForUnit(unit, lesson));
  try { refreshThemePicker(); } catch { /* picker not mounted yet */ }
  try { syncStudentTheme(); } catch { /* ignore */ }
}

function themeKeyFor(unitId) { return String(unitId).replace(/[.#$\[\]\/]/g, "_"); } // Firebase keys can't hold these

// If the Themes tab is open when a theme changes from somewhere else, bring
// its dropdowns and previews up to date instead of leaving them stale.
function syncThemeRows() {
  document.querySelectorAll(".theme-select").forEach(select => {
    const unit = COURSE_DATA.units.find(u => String(u.id) === select.getAttribute("data-unit"));
    if (!unit) return;
    select.value = resolveThemeId(unitThemeOverrides[unit.id]) || "";
    const slot = select.parentElement && select.parentElement.querySelector(".theme-swatch-slot");
    if (slot) {
      slot.innerHTML = "";
      slot.appendChild(buildThemeSwatches(themeIdForUnit(unit)));
    }
