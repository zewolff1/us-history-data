// Shared by the Answers and Annotations tabs in Teacher View: builds a
// Student + Class + Date range filter row. `items` is the FULL,
// unfiltered list (so the dropdowns don't shrink as filters narrow the
// results); `idPrefix` keeps element ids unique between the two tabs;
// `filters` is the current filter state; `onChange(partial)` is called
// whenever a control changes, expected to re-open the modal with the
// merged filter state.
function buildStudentClassDateFilterRow(idPrefix, items, filters, onChange) {
  const studentIds = [...new Set(items.map(i => i.studentId).filter(Boolean))];
  // Look up each display name ONCE, in this fixed array order, before
  // sorting — calling studentDisplayName() from inside the sort
  // comparator itself would assign anonymized "Student N" labels in
  // whatever order the sort algorithm happens to compare pairs in,
  // which isn't the original array order and isn't stable run to run.
  const displayNames = new Map(studentIds.map(id => [id, (isStarred(id) ? "\u2605 " : "") + studentDisplayName(id)]));
  studentIds.sort((a, b) => displayNames.get(a).localeCompare(displayNames.get(b)));
  const roster = COURSE_DATA.roster || {};
  // Every class period the teacher has set up — from the Roster tab and
  // the Class Schedule tab — plus any on screen, so a period with no
  // answers yet (or none in this filtered view) is still pickable.
  const classPeriods = [...new Set([
    ...Object.values(roster),
    ...Object.keys(COURSE_DATA.classSchedule || {}),
    ...studentIds.map(id => roster[id])
  ].filter(Boolean))].sort((a, b) => String(a).localeCompare(String(b), undefined, { numeric: true }));

  const studentSelect = el("select", { id: `${idPrefix}-student-filter` }, [
    el("option", { value: "" }, "All students"),
    ...studentIds.map(id => el("option", { value: id, selected: id === filters.studentId ? "selected" : null }, displayNames.get(id)))
  ]);
  studentSelect.value = filters.studentId || "";
  studentSelect.addEventListener("change", () => onChange({ studentId: studentSelect.value }));

  const classSelect = el("select", { id: `${idPrefix}-class-filter` }, [
    el("option", { value: "" }, "All classes"),
    ...classPeriods.map(cp => el("option", { value: cp, selected: cp === filters.classPeriod ? "selected" : null }, cp))
  ]);
  classSelect.value = filters.classPeriod || "";
  classSelect.addEventListener("change", () => onChange({ classPeriod: classSelect.value }));

  const dateFromInput = el("input", { type: "date", id: `${idPrefix}-date-from`, value: filters.dateFrom || "" });
  dateFromInput.addEventListener("change", () => onChange({ dateFrom: dateFromInput.value }));
  const dateToInput = el("input", { type: "date", id: `${idPrefix}-date-to`, value: filters.dateTo || "" });
  dateToInput.addEventListener("change", () => onChange({ dateTo: dateToInput.value }));

  const starredCb = el("input", { type: "checkbox", id: `${idPrefix}-starred-only` });
  starredCb.checked = !!filters.starredOnly;
  starredCb.addEventListener("change", () => onChange({ starredOnly: starredCb.checked }));
  const starredLabel = el("label", { class: "starred-only-label", for: `${idPrefix}-starred-only` }, [starredCb, " \u2605 Starred only"]);

  return el("div", { class: "annotation-filter-row annotation-filter-row-extra" }, [
    el("label", { for: `${idPrefix}-student-filter` }, "Student:"), studentSelect,
    el("label", { for: `${idPrefix}-class-filter` }, "Class:"), classSelect,
    el("label", { for: `${idPrefix}-date-from` }, "From:"), dateFromInput,
    el("label", { for: `${idPrefix}-date-to` }, "To:"), dateToInput,
    starredLabel
  ]);
}

// Applies student/class/date filters to a list of items (responses or
// notes). `dateField` names the ISO-timestamp property to filter on —
// "timestamp" for responses, "savedAt" for notes.
function applyStudentClassDateFilters(items, filters, dateField) {
  let filtered = items;
  const roster = COURSE_DATA.roster || {};
  if (filters.studentId) filtered = filtered.filter(i => i.studentId === filters.studentId);
  if (filters.starredOnly) filtered = filtered.filter(i => isStarred(i.studentId));
  if (filters.classPeriod) filtered = filtered.filter(i => roster[i.studentId] === filters.classPeriod);
  if (filters.dateFrom) filtered = filtered.filter(i => i[dateField] && i[dateField].slice(0, 10) >= filters.dateFrom);
  if (filters.dateTo) filtered = filtered.filter(i => i[dateField] && i[dateField].slice(0, 10) <= filters.dateTo);
  return filtered;
}

// Teacher-controlled privacy toggle — when on, every place that would
// show a student's name/id shows a consistent "Student N" label instead
// (same student always gets the same number, for the rest of the page
// session, so patterns are still visible without exposing who's who —
// useful when projecting Teacher View for the class to see).
let hideStudentIdentifiers = false;
let anonymizedStudentLabels = {};

// ---------- starred students (teacher only) ----------
// A ★ next to a student in Teacher View, so you can filter down to the
// students you're keeping an eye on. Kept in Firebase (so it follows you
// across devices) with a local copy as the fallback — never shown to
// students, since only Teacher View reads or draws it.
const STARRED_KEY = "usHistoryStarredStudents";
let starredStudents = new Set();
let starChangeHandler = null; // set by whichever Teacher View tab is open

// Two ways a student gets starred: the teacher taps the star on the site
// (saved in Firebase), or ticks "Star" on the Roster tab of the
// spreadsheet. A student starred either way counts everywhere (the ★,
// the "Starred only" filter, the highlight scope). Sheet stars are
// controlled from the sheet, so they can't be toggled on the site.
function isSheetStarred(id) { return !!(COURSE_DATA.rosterStarred || {})[id]; }
function isStarred(id) { return starredStudents.has(id) || isSheetStarred(id); }

async function loadStarredStudents() {
  let ids = null;
  if (ensureFirebase()) {
    try {
      const snap = await firebase.database().ref("starredStudents").once("value");
      const data = snap.val() || {};
      ids = new Set(Object.keys(data).filter(k => data[k]));
      await saveJSON(STARRED_KEY, [...ids]); // keep the local copy current
    } catch (err) {
      console.warn("Could not load starred students from Firebase:", err);
    }
  }
  if (!ids) ids = new Set(await loadJSON(STARRED_KEY, []));
  starredStudents = ids;
  return ids;
}

async function toggleStarredStudent(studentId) {
  const nowStarred = !starredStudents.has(studentId);
  if (nowStarred) starredStudents.add(studentId); else starredStudents.delete(studentId);
  await saveJSON(STARRED_KEY, [...starredStudents]);
  if (ensureFirebase()) {
    try {
      const ref = firebase.database().ref("starredStudents/" + studentId);
      if (nowStarred) await ref.set(true); else await ref.remove();
    } catch (err) {
      console.warn("Could not sync this star to Firebase:", err);
    }
  }
  return nowStarred;
}

function buildStarButton(studentId) {
  const fromSheet = isSheetStarred(studentId);
  const starred = isStarred(studentId);
  const btn = el("button", {
    type: "button",
    class: "star-btn" + (starred ? " starred" : "") + (fromSheet ? " sheet-starred" : ""),
    title: fromSheet ? "Starred on the Roster tab of your spreadsheet \u2014 untick it there to change" : "Star this student",
    "aria-label": fromSheet ? "Starred in the Roster sheet" : "Star this student",
    "aria-pressed": String(starred),
    "data-student": studentId,
    "data-sheet-star": fromSheet ? "1" : null
  }, starred ? "\u2605" : "\u2606");
  btn.addEventListener("click", async (e) => {
    e.stopPropagation();
    if (fromSheet) return; // controlled from the spreadsheet
    const nowStarred = await toggleStarredStudent(studentId);
    document.querySelectorAll(".star-btn").forEach(b => {
      if (b.getAttribute("data-student") !== studentId || b.getAttribute("data-sheet-star")) return;
      b.classList.toggle("starred", nowStarred);
      b.textContent = nowStarred ? "\u2605" : "\u2606";
      b.setAttribute("aria-pressed", String(nowStarred));
    });
    if (starChangeHandler) starChangeHandler();
  });
  return btn;
}

// Looks up a student's name from the Roster tab's optional "Name"
// column. Returns a friendly "Name (id)" label when known, or just the
// raw id when not (no roster loaded yet, or this student has no name
// filled in) — always safe to call. Returns an anonymized "Student N"
// label instead whenever hideStudentIdentifiers is on.
function studentDisplayName(studentId) {
  if (hideStudentIdentifiers) {
    if (!anonymizedStudentLabels[studentId]) {
      anonymizedStudentLabels[studentId] = `Student ${Object.keys(anonymizedStudentLabels).length + 1}`;
    }
    return anonymizedStudentLabels[studentId];
  }
  const name = (COURSE_DATA.rosterNames || {})[studentId];
  return name ? `${name} (${studentId})` : studentId;
}

async function buildAnswersSection(filters = {}) {
  const studentFilter = filters.studentId || "";
  const classFilter = filters.classPeriod || "";
  const dateFrom = filters.dateFrom || "";
  const dateTo = filters.dateTo || "";
  const starredOnly = !!filters.starredOnly;
  const hasAnyFilter = studentFilter || classFilter || dateFrom || dateTo || starredOnly;

  await loadStarredStudents();
  const firebaseResponses = await getFirebaseResponses();
  const isLive = firebaseResponses !== null;
  const allResponses = isLive ? firebaseResponses : await getLocalResponses();
  const responses = applyStudentClassDateFilters(allResponses, filters, "timestamp");

  function reopenWith(overrides) {
    closeModal();
    openTeacherViewModal("answers", { studentId: studentFilter, classPeriod: classFilter, dateFrom, dateTo, starredOnly, ...overrides });
  }
  starChangeHandler = () => { if (starredOnly) reopenWith({}); };

  const filterRow = buildStudentClassDateFilterRow("answers", allResponses, filters, reopenWith);

  const copyBtn = el("button", { type: "button", class: "sheet-btn sheet-save" }, "Copy for Spreadsheet");
  const refreshBtn = isLive ? el("button", { type: "button", class: "notes-filter-clear" }, "Refresh") : null;
  const clearBtn = el("button", { type: "button", class: "notes-filter-clear" }, hasAnyFilter ? "Clear Shown" : "Clear All");
  let clearArmed = false;

  copyBtn.addEventListener("click", async () => {
    const ok = await copyToClipboard(buildResponsesTsv(responses));
    flashSavedToast(ok ? "Copied — paste into your spreadsheet" : "Couldn't copy — try selecting the text manually");
  });

  if (refreshBtn) {
    refreshBtn.addEventListener("click", () => reopenWith({}));
  }

  clearBtn.addEventListener("click", async () => {
    if (!clearArmed) {
      clearArmed = true;
      clearBtn.textContent = isLive ? "Click again to confirm (clears for everyone)" : "Click again to confirm";
      return;
    }
    if (hasAnyFilter) {
      // Only remove the responses actually shown (matching the active filters), not everything
      const idsToRemove = new Set(responses.map(r => r.id).filter(Boolean));
      if (isLive) {
        clearBtn.disabled = true;
        clearBtn.textContent = "Clearing…";
        const ok = await removeFirebaseResponses(idsToRemove);
        if (!ok) {
          flashSavedToast("Couldn't clear Firebase — check your connection and try again.");
          clearBtn.disabled = false;
          clearArmed = false;
          clearBtn.textContent = "Clear Shown";
          return;
        }
      } else {
        const remaining = (await getLocalResponses()).filter(r => !idsToRemove.has(r.id));
        responsesCache = remaining;
        await saveJSON(RESPONSES_KEY, remaining);
      }
    } else if (isLive) {
      clearBtn.disabled = true;
      clearBtn.textContent = "Clearing…";
      const ok = await clearFirebaseResponses();
      if (!ok) {
        flashSavedToast("Couldn't clear Firebase — check your connection and try again.");
        clearBtn.disabled = false;
        clearArmed = false;
        clearBtn.textContent = "Clear All";
        return;
      }
    } else {
      await clearLocalResponses();
    }
    reopenWith({});
  });

  const sorted = responses.slice().sort((a, b) => (b.timestamp || "").localeCompare(a.timestamp || ""));
  const rows = sorted.length
    ? sorted.map(r => el("div", { class: "response-row" }, [
        el("span", { class: "response-student" }, [buildStarButton(r.studentId), el("span", { class: "response-student-name" }, studentDisplayName(r.studentId))]),
        el("span", { class: "response-lesson" }, r.lessonId),
        el("span", { class: "response-question" }, r.questionPrompt),
        el("span", { class: "response-answer" }, r.answer),
        el("span", { class: "response-skill" }, r.skill || ""),
        el("span", { class: "response-correct" + (r.correct === "Yes" ? " yes" : r.correct === "No" ? " no" : "") }, r.correct),
        buildModerationControls(r)
      ]))
    : [el("p", { class: "empty-note" }, hasAnyFilter
        ? "No answers match these filters."
        : (isLive ? "No answers recorded yet." : "No answers recorded on this device yet."))];

  const statusText = isLive
    ? `${responses.length} answer${responses.length === 1 ? "" : "s"} ${hasAnyFilter ? "matching these filters, " : ""}from every student, live from Firebase.`
    : `${responses.length} answer${responses.length === 1 ? "" : "s"} recorded on this device only — connect Firebase to see every student's answers here.`;

  return el("div", {}, [
    filterRow,
    el("p", { class: "meta" }, `${statusText} Copies with a header row — skip it if pasting into a sheet that already has one.`),
    el("div", { class: "save-sheet-actions" }, [clearBtn, refreshBtn, copyBtn].filter(Boolean)),
    el("div", { class: "response-list" }, rows)
  ]);
}

// Counts how often each value in a list appears, sorted most-common
// first — shared by the "Most Common Labels" and "Most Highlighted
// Quotes" summaries below.
function topCounts(values, limit) {
  const counts = new Map();
  values.forEach(v => {
    if (!v) return;
    counts.set(v, (counts.get(v) || 0) + 1);
  });
  return [...counts.entries()]
    .sort((a, b) => b[1] - a[1])
    .slice(0, limit);
}

