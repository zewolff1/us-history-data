// ---------- masthead's expanded lesson header (collapses on scroll) ----------
// The lesson number, title, course inquiry, and learning objectives now
// live INSIDE the sticky masthead itself, not the scrolling page body —
// shown in full at the top of a lesson, then collapsed down to just the
// compact "Lesson X.X — Title" line the moment the student scrolls, so it
// doesn't take up space while they're reading the actual lesson content.
let mastheadCollapsed = false;
let mastheadScrollBound = false;
// Two different thresholds, not one. Collapsing shrinks the header, which
// shifts the page up under the reader; with a single line, that shift alone
// could carry the scroll position back across it, so the header would
// collapse, re-expand, collapse... (the flicker). Collapse after a little
// scrolling, but only expand again once back near the very top.
const MASTHEAD_COLLAPSE_AT = 40;
const MASTHEAD_EXPAND_BELOW = 6;

// A page too short to keep scrolling after the header shrinks would get its
// scroll position clamped back to the top, re-expanding the header and
// starting the loop again -- so leave the header alone on pages like that.
function pageCanSpareMastheadHeight(y) {
  const root = document.documentElement;
  if (!root.scrollHeight) return true; // layout isn't measurable here
  const masthead = document.querySelector(".masthead");
  const shrinkBy = masthead ? masthead.offsetHeight : 0;
  return (root.scrollHeight - window.innerHeight) - shrinkBy >= y;
}

function updateMastheadCollapse() {
  const y = window.scrollY;
  let shouldCollapse = mastheadCollapsed ? y > MASTHEAD_EXPAND_BELOW : y > MASTHEAD_COLLAPSE_AT;
  if (shouldCollapse && !mastheadCollapsed && !pageCanSpareMastheadHeight(y)) shouldCollapse = false;
  if (shouldCollapse === mastheadCollapsed) return;
  mastheadCollapsed = shouldCollapse;
  document.querySelector(".masthead")?.classList.toggle("collapsed", shouldCollapse);
}
function mountMastheadCollapseListener() {
  if (mastheadScrollBound) return;
  mastheadScrollBound = true;
  window.addEventListener("scroll", updateMastheadCollapse, { passive: true });
}

function buildObjectivesBlock(lesson) {
  if (!lesson.objectives || !lesson.objectives.length) return null;
  return el("div", { class: "objectives-block" }, [
    el("div", { class: "section-title" }, "Learning Objectives"),
    el("ul", { class: "objectives-list" }, lesson.objectives.map(o => el("li", {}, o.text)))
  ]);
}

// The lesson title has a compact one-line version that lives in the
// masthead's top row (#lesson-banner) and only shows once collapsed --
// Course Inquiry / Learning Objectives get the same treatment here, via
// their own small strip (#masthead-row-inquiry) parallel to that title
// line. The full-size versions below (in .masthead-expanded) stay for
// the expanded view only; this keeps the collapsed masthead to one row
// instead of a title row plus a second, separate content row beneath it.
function updateMastheadExpanded(lesson) {
  const container = document.getElementById("masthead-expanded");
  const rowStrip = document.getElementById("masthead-row-inquiry");
  if (!container) return;
  container.innerHTML = "";
  if (rowStrip) rowStrip.innerHTML = "";
  mastheadCollapsed = false;
  document.querySelector(".masthead")?.classList.remove("collapsed"); // a freshly opened lesson always starts expanded, at the top of its own content
  if (!lesson) return;

  // Inquiries and objectives sit SIDE BY SIDE (not stacked) so this column
  // doesn't grow taller than it needs to. The column only appears at all
  // if there's something to put in it -- a lesson with neither just gets
  // the title column, full width.
  const rightCol = (buildInquiryBlock(lesson) || buildObjectivesBlock(lesson))
    ? el("div", { class: "masthead-expanded-right" }, [buildInquiryBlock(lesson), buildObjectivesBlock(lesson)])
    : null;
  container.appendChild(el("div", { class: "masthead-expanded-inner" }, [
    el("div", { class: "masthead-expanded-left" }, [
      lesson.icon ? el("img", { class: "lesson-title-icon", src: lesson.icon, alt: "" }) : null,
      el("div", { class: "masthead-expanded-titlewrap" }, [
        el("span", { class: "lesson-number" }, `LESSON ${lesson.number}`),
        el("h1", {}, lesson.title)
      ])
    ]),
    rightCol
  ]));

  // A second, independent copy for the compact row strip -- its own
  // DOM nodes since the same element can't live in two places at once.
  if (rowStrip) {
    const compactInquiry = buildInquiryBlock(lesson);
    const compactObjectives = buildObjectivesBlock(lesson);
    if (compactInquiry || compactObjectives) {
      rowStrip.appendChild(el("div", { class: "masthead-row-inquiry-inner" }, [compactInquiry, compactObjectives]));
    }
  }
}

// ---------- wide-screen mode ----------
// A manual, per-device toggle that widens the page and bumps the base
// font size — meant for large displays (a classroom smartboard/TV) where
// the normal reading-width layout leaves the screen mostly empty and text
// too small to read from across the room. Off by default; remembered
// locally so it doesn't need re-toggling every visit on the same device.
const WIDE_MODE_KEY = "usHistoryWideMode";
function isWideMode() {
  try { return localStorage.getItem(WIDE_MODE_KEY) === "1"; } catch { return false; }
}
function applyWideMode(on) {
  document.documentElement.setAttribute("data-wide", on ? "1" : "0");
  const btn = document.getElementById("wide-mode-toggle");
  if (btn) {
    btn.classList.toggle("active", on);
    btn.setAttribute("aria-pressed", String(on));
  }
}
let wideModeButtonBound = false;
function mountWideModeToggle() {
  if (!wideModeButtonBound) {
    wideModeButtonBound = true;
    const btn = el("button", {
      type: "button",
      id: "wide-mode-toggle",
      class: "wide-mode-toggle",
      "aria-pressed": "false",
      title: "Widen the page for a large screen or smartboard"
    }, [el("i", { class: "fa-solid fa-expand" }), " Wide Screen"]);
    btn.addEventListener("click", () => {
      const now = !isWideMode();
      try { localStorage.setItem(WIDE_MODE_KEY, now ? "1" : "0"); } catch { /* ignore */ }
      applyWideMode(now);
    });
    document.body.appendChild(btn);
  }
  applyWideMode(isWideMode()); // now safe to run on every call — the button above always exists by this point
}

// ---------- site themes ----------
// The whole site is drawn from CSS variables, so a theme is just a set of
// values for them (defined in SITE_THEMES in sheets-config.js). Each unit
// has its own theme: the Units tab's "Theme" column is the default, and
// the teacher can override it from Teacher View -> Themes. Overrides are
// kept in Firebase so every student sees them (live), with a local copy so
// the right look is there the instant a page opens.
const THEME_VAR_KEYS = ["--ink", "--ink-soft", "--parchment", "--parchment-dim", "--card", "--brass", "--brass-light",
  "--stamp", "--forest", "--rule", "--shadow", "--focus", "--font-display", "--font-heading", "--font-body",
  "--page-pattern", "--header-pattern", "--title-pattern", "--edge-pattern", "--edge-height", "--loading-glyph", "--loading-anim", "--loading-dur"];
const THEME_STORE_KEY = "usHistoryUnitThemes";
let unitThemeOverrides = {}; // unit id -> theme id, set by the teacher
let currentThemeUnit = null; // the unit whose look is on screen
let unitThemesStarted = false;
const loadedThemeFonts = new Set();

function themeCatalog() {
  return (typeof SITE_THEMES !== "undefined" && SITE_THEMES) ? SITE_THEMES : { classic: { label: "Classic Parchment", vars: {} } };
}
function defaultThemeId() {
  const cat = themeCatalog();
  return (typeof DEFAULT_THEME_ID !== "undefined" && cat[DEFAULT_THEME_ID]) ? DEFAULT_THEME_ID : Object.keys(cat)[0];
}
// "Navy & Brass", "navy" and "NAVY " all mean the same theme.
function resolveThemeId(value) {
  const norm = x => String(x || "").toLowerCase().replace(/[^a-z0-9]/g, "");
  const key = norm(value);
  if (!key) return null;
  const cat = themeCatalog();
  return Object.keys(cat).find(id => norm(id) === key || norm(cat[id].label) === key) || null;
}
// ---- theme settings (Themes tab; see THEME SETTINGS in sheets-config.js) ----
// Nothing is ever locked to one theme. Students can always pick any visible theme.
// The only restriction: a SENSITIVE lesson (checkbox on the Lessons/Units tab) doesn't allow Seasonal themes.
const STUDENT_THEME_KEY = "usHistoryStudentTheme";
function themeSettingFor(id) {
  return (typeof THEME_SETTINGS !== "undefined" && THEME_SETTINGS[id]) || {};
}
function themeTypeOf(id) {
  const t = themeSettingFor(id).type;
  if (t) return t;
  if (typeof STUDENT_THEME_IDS !== "undefined" && STUDENT_THEME_IDS.includes(id)) return "student";
  if (typeof SEASONAL_THEME_IDS !== "undefined" && SEASONAL_THEME_IDS.includes(id)) return "seasonal";
  return "unit";
}
function themeHiddenFromStudents(id) { return !!themeSettingFor(id).hidden; }
function currentMonthNumber() {
  try {
    const m = parseInt(new URLSearchParams(location.search).get("themeMonth"), 10); // handy for testing a season
    if (m >= 1 && m <= 12) return m;
  } catch { /* ignore */ }
  return new Date().getMonth() + 1;
}
function themeMatchesUnit(id, unit) {
  const units = themeSettingFor(id).units || [];
  if (!units.length) return true;
  if (!unit) return false;
  const keys = [unit.id, unit.number].map(x => String(x == null ? "" : x).trim().toLowerCase());
  return units.some(u => keys.includes(u));
}
function themeActiveThisMonth(id) {
  const months = themeSettingFor(id).months || [];
  return !months.length || months.includes(currentMonthNumber());
}
function lessonIsSensitive(unit, lesson) { return !!((lesson && lesson.lockTheme) || (unit && unit.lockTheme)); }
// May this theme be used here at all? Seasonal themes are off in sensitive lessons.
function themeAllowedHere(id, unit, lesson) {
  return !(themeTypeOf(id) === "seasonal" && lessonIsSensitive(unit, lesson));
}
// Themes a student can choose in the current lesson: visible, allowed, and (if seasonal) in season.
function selectableThemes(unit, lesson) {
  return Object.keys(themeCatalog()).filter(id =>
    !themeHiddenFromStudents(id) && themeAllowedHere(id, unit, lesson) &&
    (themeTypeOf(id) !== "seasonal" || themeActiveThisMonth(id)) && themeMatchesUnit(id, unit));
}
// A seasonal theme running right now (Months set on the Themes tab) — a default, not a lock.
function seasonalThemeFor(unit, lesson) {
  return Object.keys(themeCatalog()).find(id =>
    themeTypeOf(id) === "seasonal" && (themeSettingFor(id).months || []).length &&
    themeActiveThisMonth(id) && themeMatchesUnit(id, unit) && themeAllowedHere(id, unit, lesson)) || null;
}
// The Theme column on a lesson/unit, or a Themes-tab row whose Units match.
function sheetDefaultThemeFor(unit, lesson) {
  const ok = id => id && themeAllowedHere(id, unit, lesson) ? id : null;
  const own = ok(lesson && resolveThemeId(lesson.theme)) || ok(unit && resolveThemeId(unit.theme));
  if (own) return own;
  if (!unit) return null;
  return Object.keys(themeCatalog()).find(id =>
    (themeSettingFor(id).units || []).length && themeMatchesUnit(id, unit) && themeActiveThisMonth(id) && themeAllowedHere(id, unit, lesson)) || null;
}
// Saved per student in Firebase (studentThemes/{id}) so the pick follows them to any device/session;
// localStorage keeps a copy so the right look is there instantly on the next page open.
let themeSyncedFor = null;
function saveStudentThemePick(id) {
  const sid = getStoredStudentId();
  try {
    if (id) localStorage.setItem(STUDENT_THEME_KEY, id); else localStorage.removeItem(STUDENT_THEME_KEY);
    if (sid) localStorage.setItem(STUDENT_THEME_KEY + "Owner", sid);
  } catch { /* ignore */ }
  if (!sid || !ensureFirebase()) return;
  try {
    const ref = firebase.database().ref("studentThemes/" + sid);
    (id ? ref.set(id) : ref.remove()).catch(err => console.warn("Could not save your theme to Firebase:", err));
  } catch (err) { console.warn("Could not save your theme to Firebase:", err); }
}
async function syncStudentTheme() {
  const sid = getStoredStudentId();
  if (!sid || themeSyncedFor === sid || !ensureFirebase()) return;
  themeSyncedFor = sid;
  try {
    // A pick saved here by a different student ID isn't this student's — drop it.
    const owner = localStorage.getItem(STUDENT_THEME_KEY + "Owner");
    if (owner && owner !== sid) { localStorage.removeItem(STUDENT_THEME_KEY); applyThemeForUnit(currentThemeUnit, currentThemeLesson); }
  } catch { /* ignore */ }
  try {
    const snap = await firebase.database().ref("studentThemes/" + sid).once("value");
    const remote = resolveThemeId(snap.val());
    let local = null;
    try { local = resolveThemeId(localStorage.getItem(STUDENT_THEME_KEY)); } catch { /* ignore */ }
    if (remote) {
      try { localStorage.setItem(STUDENT_THEME_KEY + "Owner", sid); } catch { /* ignore */ }
      if (remote !== local) {
        try { localStorage.setItem(STUDENT_THEME_KEY, remote); } catch { /* ignore */ }
        applyThemeForUnit(currentThemeUnit, currentThemeLesson);
      }
    } else {
      let mine = null;
      try { mine = resolveThemeId(localStorage.getItem(STUDENT_THEME_KEY)); } catch { /* ignore */ }
      if (mine) firebase.database().ref("studentThemes/" + sid).set(mine).catch(err => console.warn("Could not save your theme to Firebase:", err));
    }
  } catch (err) {
    themeSyncedFor = null;
    console.warn("Could not load your saved theme from Firebase:", err);
  }
}
function studentThemePick(unit, lesson) {
  try {
    const id = resolveThemeId(localStorage.getItem(STUDENT_THEME_KEY));
    return id && selectableThemes(unit, lesson).includes(id) ? id : null;
  } catch { return null; }
}

// Which theme a lesson gets (everything but the student's pick is just a default):
//   1. the student's own pick
//   2. Teacher View's per-unit setting
//   3. the lesson's Theme, the unit's Theme, or a Themes-tab Units match (the unit's look)
//   4. the site default
// Seasonal themes are only ever a choice in the picker (in their Months) — never the default.
