// Loads the saved overrides and keeps listening, so a change the teacher
// makes shows up for students already on the site without a refresh.
function initUnitThemes() {
  if (unitThemesStarted) return;
  unitThemesStarted = true;
  try {
    const raw = localStorage.getItem(THEME_STORE_KEY);
    if (raw) unitThemeOverrides = JSON.parse(raw) || {};
  } catch { /* ignore */ }
  if (!ensureFirebase()) return;
  try {
    firebase.database().ref("unitThemes").on("value", snap => {
      const data = snap.val() || {};
      const next = {};
      COURSE_DATA.units.forEach(u => { const v = data[themeKeyFor(u.id)]; if (v) next[u.id] = v; });
      unitThemeOverrides = next;
      try { localStorage.setItem(THEME_STORE_KEY, JSON.stringify(next)); } catch { /* ignore */ }
      applyThemeForUnit(currentThemeUnit, currentThemeLesson);
      syncThemeRows();
    });
  } catch (err) {
    console.warn("Could not listen for unit themes:", err);
  }
}

// Teacher picks a theme for a unit ("" = back to the sheet's default).
// Returns true if it was saved for everyone, false if only on this device.
async function setUnitThemeOverride(unit, themeId) {
  if (themeId) unitThemeOverrides[unit.id] = themeId; else delete unitThemeOverrides[unit.id];
  try { localStorage.setItem(THEME_STORE_KEY, JSON.stringify(unitThemeOverrides)); } catch { /* ignore */ }
  applyThemeForUnit(currentThemeUnit, currentThemeLesson);
  if (!ensureFirebase()) return false;
  try {
    const ref = firebase.database().ref("unitThemes/" + themeKeyFor(unit.id));
    if (themeId) await ref.set(themeId); else await ref.remove();
    return true;
  } catch (err) {
    console.warn("Could not save this unit's theme to Firebase:", err);
    return false;
  }
}

// A tiny mock of the site in a theme (header bar, page, a card with text
// lines) next to its six main colors — so the teacher can see the actual
// color scheme before choosing it, not just a row of dots.
function buildThemeSwatches(themeId) {
  const theme = themeCatalog()[themeId] || {};
  const v = theme.vars || {};
  const paint = (node, prop, key) => { if (v[key]) node.style[prop] = v[key]; return node; };

  const bar = paint(el("span", { class: "theme-mini-bar" }), "background", "--stamp");
  const dot = paint(el("span", { class: "theme-mini-dot" }), "background", "--brass-light");
  bar.appendChild(dot);
  const line1 = paint(el("span", { class: "theme-mini-line" }), "background", "--ink");
  const line2 = paint(el("span", { class: "theme-mini-line short" }), "background", "--ink-soft");
  const tag = paint(el("span", { class: "theme-mini-tag" }), "background", "--forest");
  const card = el("span", { class: "theme-mini-card" }, [line1, line2, tag]);
  paint(card, "background", "--card");
  paint(card, "borderColor", "--ink");
  const mini = el("span", { class: "theme-mini" }, [bar, card]);
  paint(mini, "background", "--parchment");
  paint(mini, "borderColor", "--ink");

  const colors = ["--stamp", "--parchment", "--card", "--brass", "--forest", "--ink"].map(k => v[k] || "transparent");
  const dots = el("span", { class: "theme-swatches" }, colors.map(color => {
    const swatch = el("span", { class: "theme-swatch" });
    swatch.style.background = color;
    return swatch;
  }));
  return el("span", { class: "theme-preview", title: theme.label || "" }, [mini, dots]);
}

// Teacher View -> Themes: one dropdown per unit.
function buildThemesSection() {
  const cat = themeCatalog();
  const ids = Object.keys(cat);
  const rows = COURSE_DATA.units.map(unit => {
    const sheetTheme = resolveThemeId(unit.theme) || defaultThemeId();
    const select = el("select", { class: "theme-select", "data-unit": unit.id, "aria-label": `Theme for unit ${unit.number}` }, [
      el("option", { value: "" }, `Sheet default (${cat[sheetTheme].label})`),
      ...ids.map(id => el("option", { value: id }, cat[id].label))
    ]);
    select.value = resolveThemeId(unitThemeOverrides[unit.id]) || "";
    const swatchSlot = el("span", { class: "theme-swatch-slot" }, buildThemeSwatches(themeIdForUnit(unit)));
    const status = el("span", { class: "theme-status" }, "");
    select.addEventListener("change", async () => {
      status.textContent = "Saving\u2026";
      const savedForEveryone = await setUnitThemeOverride(unit, select.value);
      swatchSlot.innerHTML = "";
      swatchSlot.appendChild(buildThemeSwatches(themeIdForUnit(unit)));
      status.textContent = savedForEveryone
        ? "Saved for everyone \u2713"
        : "Saved on this device only \u2014 couldn't reach Firebase, so students won't see it yet.";
    });
    const viewing = currentThemeUnit && currentThemeUnit.id === unit.id;
    const lockedLessons = (unit.lessons || []).filter(l => l.lockTheme);
    const lockNote = unit.lockTheme ? "\u26a0 sensitive unit \u2014 no seasonal themes"
      : (lockedLessons.length ? `\u26a0 sensitive lessons (no seasonal themes): ${lockedLessons.map(l => `${l.number}${l.theme ? " (" + (cat[resolveThemeId(l.theme)] ? cat[resolveThemeId(l.theme)].label : l.theme) + ")" : ""}`).join(", ")}` : "");
    return el("div", { class: "theme-row" }, [
      el("div", { class: "theme-row-label" }, [`Unit ${unit.number} \u2014 ${unit.title}`, viewing ? el("small", {}, "viewing now") : null, lockNote ? el("small", { style: "display:block;margin:0.2rem 0 0;text-transform:none;letter-spacing:0;color:var(--ink-soft)" }, lockNote) : null]),
      select,
      swatchSlot,
      status
    ]);
  });
  return el("div", { class: "themes-section" }, [
    el("p", { class: "themes-intro" }, "Pick a look for each unit. It saves for everyone \u2014 students see it as soon as they open that unit (right away if they're already in it). \u201cSheet default\u201d uses the Theme column on your Lessons or Units tab, or the site default if that's blank. This is only a default \u2014 students can always pick their own look. Lessons marked Sensitive Lesson in the sheet never use seasonal themes. Hiding themes and setting seasonal months is done on the Themes tab of your spreadsheet."),
    ...rows
  ]);
}

async function openTeacherViewModal(initialTab = "answers", filters = {}) {
  closeModal();

  const tabAnswersBtn = el("button", { type: "button", class: "teacher-tab" + (initialTab === "answers" ? " active" : "") }, "Answers");
  const tabAnnotationsBtn = el("button", { type: "button", class: "teacher-tab" + (initialTab === "annotations" ? " active" : "") }, "Annotations");
  tabAnswersBtn.addEventListener("click", () => { closeModal(); openTeacherViewModal("answers"); });
  tabAnnotationsBtn.addEventListener("click", () => { closeModal(); openTeacherViewModal("annotations"); });
  const tabThemesBtn = el("button", { type: "button", class: "teacher-tab" + (initialTab === "themes" ? " active" : "") }, "Themes");
  tabThemesBtn.addEventListener("click", () => { closeModal(); openTeacherViewModal("themes"); });
  const tabNotesBtn = el("button", { type: "button", class: "teacher-tab" + (initialTab === "notes" ? " active" : "") }, "My Notes");
  tabNotesBtn.addEventListener("click", () => { closeModal(); openTeacherViewModal("notes"); });

  const privacyCheckbox = el("input", { type: "checkbox", id: "teacher-privacy-toggle" });
  privacyCheckbox.checked = hideStudentIdentifiers;
  privacyCheckbox.addEventListener("change", () => {
    hideStudentIdentifiers = privacyCheckbox.checked;
    closeModal();
    openTeacherViewModal(initialTab, filters); // re-render with the new setting, same tab and filters
  });
  const privacyRow = el("label", { class: "annotation-filter-row teacher-privacy-row", for: "teacher-privacy-toggle" }, [
    privacyCheckbox,
    " Hide student names/IDs (shows \u201cStudent 1\u201d, \u201cStudent 2\u201d, etc. \u2014 handy when projecting)"
  ]);

  const contentSlot = el("div", { class: "loading-spinner" }, [el("i", { class: "fa-solid fa-book-open-reader" }), " Loading\u2026"]);

  const panel = el("div", { class: "modal-panel", role: "dialog", "aria-modal": "true", "aria-label": "Teacher View" }, [
    el("div", { class: "modal-header" }, [
      el("h2", {}, "Teacher View"),
      el("button", { type: "button", class: "modal-close", "aria-label": "Close" }, "×")
    ]),
    el("div", { class: "modal-body notes-body" }, [
      buildTeacherToolsLinks(),
      privacyRow,
      el("div", { class: "teacher-tabs" }, [tabAnswersBtn, tabAnnotationsBtn, tabThemesBtn, tabNotesBtn]),
      contentSlot
    ])
  ]);

  const overlay = el("div", { class: "modal-overlay" }, panel);
  overlay.addEventListener("click", (e) => { if (e.target === overlay) closeModal(); });
  panel.querySelector(".modal-close").addEventListener("click", closeModal);

  document.body.appendChild(overlay);
  document.addEventListener("keydown", onModalKeydown);
  activeModal = overlay;

  const section = initialTab === "themes" ? buildThemesSection()
    : initialTab === "notes" ? await buildMyNotesSection()
    : initialTab === "annotations" ? await buildAnnotationsSection(filters)
    : await buildAnswersSection(filters);
  if (activeModal !== overlay) return; // closed while loading
  contentSlot.replaceWith(section);
}

const NOTE_COLORS = [
