const SHEETS_BASE_URL = "https://docs.google.com/spreadsheets/d/e/2PACX-1vRSDsUWVrsaCJCw_lZGAwcL96-QsCtY111YZsX6kAEQyy74aR1N5P_BhfeeGWRI3qiY4O9YZG51iEgQ/pub";

// Builds a tab's full CSV URL from just its gid. Also accepts a
// complete URL directly (anything starting with "http") unchanged, so
// existing full-URL entries — or a tab published under a totally
// different spreadsheet — still work without needing to be rewritten.
function sheetUrl(gidOrUrl) {
  const value = String(gidOrUrl);
  return value.startsWith("http") ? value : `${SHEETS_BASE_URL}?gid=${value}&single=true&output=csv`;
}

