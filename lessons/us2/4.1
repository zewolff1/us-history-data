        text: "A second reading in the same set. Sets appear as one collapsible box.\n\nIt has two short paragraphs and no questions.",
        _order: 1
      }
    ],
    videos: [{
      title: "Example Video", length: "0:30", note: "The video file lives in your project's videos folder; here only the poster shows.",
      src: "videos/sample-clip.mp4", image: exampleImg("Video poster", "#D4E4EC", "#2E6E8E"), order: 3, setOrder: 2, teacherPinned: true,
      questions: [{ type: "short_answer", prompt: "Under-video question: what stood out to you in the clip?", sampleAnswer: "Answers vary.", skill: "Analysis" }],
      _order: 2
    }],
    images: [
      { title: "Example Gallery", note: "Several images with captions, plus a question underneath.", files: gal, order: 4, setOrder: 3,
        questions: [{ type: "multiple_choice", prompt: "Under-gallery question: how many images are in this gallery?", choices: ["2", "3", "5"], correctIndex: 1, explanation: "Three.", skill: "Comprehension" }],
        _order: 3 },
      { title: "Example Single Image", note: "A standalone image.", files: [exampleImg("Single image", "#E8D9B5", "#8C3B2E")], order: 5, setOrder: 4, _order: 4 }
    ],
    assessment: [
      { type: "multiple_choice", prompt: "Check Your Understanding (multiple choice): pick the best answer.", choices: ["Best answer", "Plausible but wrong", "Clearly wrong"], correctIndex: 0, explanation: "This is how feedback looks.", skill: "Comprehension" },
      { type: "short_answer", prompt: "Check Your Understanding (short answer, requires approval): classmates only see answers you approve.", sampleAnswer: "A sample answer.", skill: "Analysis", requiresApproval: true },
      { type: "multiple_choice", prompt: "Grouped question 1 of 2: these are answered one after another.", choices: ["A", "B"], correctIndex: 0, skill: "Comprehension", group: "Example Sequence" },
      { type: "multiple_choice", prompt: "Grouped question 2 of 2.", choices: ["A", "B"], correctIndex: 1, skill: "Comprehension", group: "Example Sequence" }
    ]
  };
}

const EXAMPLE_FIELDS = ["icon", "mentions", "keyTerms", "pinnedTerms", "termGroups", "inquiryFocus", "presetLabels", "objectives", "doNow", "readings", "videos", "images", "assessment"];

function applyExampleContent(lesson) {
  Object.assign(lesson, buildExampleLessonContent());
  lesson.isExample = true;
}

function clearExampleContent(lesson) {
  if (!lesson.isExample) return;
  EXAMPLE_FIELDS.forEach(f => { delete lesson[f]; });
  delete lesson.isExample;
}

function lessonHasNoContent(lesson) {
  return !((lesson.readings || []).length || (lesson.videos || []).length || (lesson.images || []).length || (lesson.assessment || []).length || (lesson.doNow || []).length);
}

function isExampleLessonId(lessonId) {
  const l = typeof findLessonById === "function" ? findLessonById(lessonId) : null;
  return !!(l && l.isExample);
}

function applyExampleLessonIfEmpty() {
  if (!SHOW_EXAMPLE_WHEN_UNREACHABLE) return;
  const totalLessons = COURSE_DATA.units.reduce((n, u) => n + (u.lessons ? u.lessons.length : 0), 0);
  if (totalLessons > 0) return;
  const unit = COURSE_DATA.units[0];
  if (!unit) return;
  const lesson = { id: "example-1-1", number: "1.1", title: "Example Lesson (couldn't reach your spreadsheet)" };
  applyExampleContent(lesson);
  unit.icon = unit.icon || lesson.icon;
  unit.lessons = [lesson];
}

