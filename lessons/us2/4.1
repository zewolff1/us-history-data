// ---------- header banner (animated scene, only while scrolled to the very top) ----------
// A theme can add `banner: "snow"` (see BANNER_SCENES below for the choices) and/or
// `bannerImage: "https://.../your.gif"` in sheets-config.js. It fades in behind the header
// text while the page is at the very top and fades out (and pauses) as soon as you scroll.
function bannerRand(seed) { let t = seed * 9301 + 49297; t = (t * 233280) % 233280; return (t % 1000) / 1000; }
function bannerLeaf(color, size) { return `<svg viewBox="0 0 20 20" width="${size}" height="${size}"><path d="M10 1C15 4 18 9 15 15C13 18 10 19 10 19C10 19 7 18 5 15C2 9 5 4 10 1Z" fill="${color}"/><path d="M10 4V19" stroke="rgba(0,0,0,.28)" stroke-width="1" fill="none"/></svg>`; }
function bannerFlake(size, plain) {
  return plain ? `<svg viewBox="0 0 10 10" width="${size}" height="${size}"><circle cx="5" cy="5" r="4" fill="#fff"/></svg>`
    : `<svg viewBox="0 0 12 12" width="${size}" height="${size}"><path d="M6 0V12M0 6H12M1.8 1.8L10.2 10.2M10.2 1.8L1.8 10.2" stroke="#fff" stroke-width="1.3" stroke-linecap="round"/></svg>`;
}
const BANNER_BAT = `<svg viewBox="0 0 40 20" width="34" height="17"><path d="M20 6C17 6 17 2 15 3C13 4 12 7 8 7C5 7 3 4 0 5C3 7 3 11 6 13C8 11 10 11 12 13C14 12 16 12 17 15L20 19L23 15C24 12 26 12 28 13C30 11 32 11 34 13C37 11 37 7 40 5C37 4 35 7 32 7C28 7 27 4 25 3C23 2 23 6 20 6Z" fill="#0B0510"/></svg>`;
function bannerFalling(items, dur0, durSpan) {
  return items.map((svg, i) => {
    const r1 = bannerRand(i + 3), r2 = bannerRand(i * 7 + 11), r3 = bannerRand(i * 13 + 5);
    return `<span class="b-fall" style="left:${(4 + (i * 97 / items.length) + r1 * 6).toFixed(1)}%;--d:${(dur0 + r2 * durSpan).toFixed(1)}s;--delay:${(-r3 * (dur0 + durSpan)).toFixed(1)}s;--sway:${(r1 > .5 ? 1 : -1) * (20 + r2 * 50) | 0}px;--rot:${(r3 > .5 ? 1 : -1) * (180 + r1 * 300) | 0}deg">${svg}</span>`;
  }).join("");
}
const BANNER_SCENES = {
  // drifting autumn leaves
  leaves() {
    const cols = ["#C8501A", "#E08A1E", "#A62E12", "#D4A017", "#8C4A14"];
    return bannerFalling(Array.from({ length: 10 }, (_, i) => bannerLeaf(cols[i % cols.length], 16 + (i % 3) * 5)), 11, 7);
  },
  // gently falling snow
  snow() {
    return bannerFalling(Array.from({ length: 20 }, (_, i) => bannerFlake(7 + (i % 4) * 3, i % 3 === 0)), 9, 8).replace(/class="b-fall"/g, 'class="b-fall b-snow"');
  },
  // bats crossing a moon
  bats() {
    const bats = [0, 1, 2, 3].map(i => `<span class="b-bat" style="top:${(10 + bannerRand(i + 2) * 55) | 0}px;--d:${(16 + i * 4)}s;--delay:${(-i * 5.5).toFixed(1)}s;transform-origin:center"><span class="b-bob" style="--bd:${(1.2 + i * .3).toFixed(1)}s">${BANNER_BAT}</span></span>`).join("");
    return `<span class="b-moon"></span>` + bats;
  },
  // string of twinkling holiday lights, with a little snow
  lights() {
    const N = 15, w = 100 / N, cols = ["#E5383B", "#FFC53D", "#3DBE6B", "#4DA3FF"];
    let d = "M0 2"; for (let i = 0; i < N; i++) d += ` Q${((i + .5) * w).toFixed(2)} 11 ${((i + 1) * w).toFixed(2)} 2`;
    const bulbs = Array.from({ length: N }, (_, i) => `<span class="b-bulb" style="left:${((i + .5) * w).toFixed(2)}%;--c:${cols[i % 4]};--delay:${(-(i * .37) % 3).toFixed(2)}s"></span>`).join("");
    return `<svg class="b-wire" viewBox="0 0 100 12" preserveAspectRatio="none"><path d="${d}" fill="none" stroke="#0b1f14" stroke-opacity=".7" stroke-width=".9" vector-effect="non-scaling-stroke"/></svg>${bulbs}` +
      bannerFalling(Array.from({ length: 8 }, (_, i) => bannerFlake(7 + (i % 3) * 3, i % 2 === 0)), 10, 6).replace(/class="b-fall"/g, 'class="b-fall b-snow"');
