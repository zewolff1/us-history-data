  <script>
/* =========================================================================
   Student ID gate + answer logging.
   -------------------------------------------------------------------------
   Shows a one-time overlay asking for a 6-digit student ID, remembered in
   this browser after that (localStorage). Every answered question — both
   multiple choice and short answer — gets sent to RESPONSES_CONFIG's
   Apps Script endpoint (js/responses-config.js) tagged with that ID, the
   lesson, and the question. If submitUrl is blank, logging is a no-op:
   students can still answer everything normally, it just isn't recorded.
   ========================================================================= */

const STUDENT_ID_KEY = "usHistoryStudentId";
let cachedStudentId = null;
let studentIdPromise = null;

// ---- Teacher password ----------------------------------------------
// The teacher ID (123456) logs in like any other ID — the password is
// only asked for when you click "Teacher View", and that same unlock
// also turns on the other teacher-only views of student data (the
// highlight overlay and its by-student picker). Only a fingerprint of
// the password is stored here, not the password itself.
//
// To change it: open the site, open the browser console, run
//   hashTeacherPassword("your new password")
// and paste the result between the quotes below.
//
// Honest caveat: this keeps students out of Teacher View in practice,
// but it isn't real security — anyone who reads this site's code can
// find their way around it, and the answers/notes in Firebase aren't
// protected by it. Fine for a classroom; don't reuse a real password.
const TEACHER_PASSWORD_HASH = "a82e6f6cc4662";
const TEACHER_UNLOCK_KEY = "usHistoryTeacherUnlocked";

function hashTeacherPassword(str) {
  str = String(str);
  let h1 = 0xdeadbeef, h2 = 0x41c6ce57;
  for (let i = 0, ch; i < str.length; i++) {
    ch = str.charCodeAt(i);
    h1 = Math.imul(h1 ^ ch, 2654435761);
    h2 = Math.imul(h2 ^ ch, 1597334677);
  }
  h1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507) ^ Math.imul(h2 ^ (h2 >>> 13), 3266489909);
  h2 = Math.imul(h2 ^ (h2 >>> 16), 2246822507) ^ Math.imul(h1 ^ (h1 >>> 13), 3266489909);
  return (4294967296 * (2097151 & h2) + (h1 >>> 0)).toString(16);
}
function verifyTeacherPassword(pw) { return hashTeacherPassword(pw) === TEACHER_PASSWORD_HASH; }
// Unlocked only for this browser tab/session — closing it locks again.
function isTeacherUnlocked() {
  try { return sessionStorage.getItem(TEACHER_UNLOCK_KEY) === "1"; } catch { return false; }
}
// Logged in with the teacher ID (no password yet) — enough to see the
// Teacher View button and the plain teacher-tools links.
function isTeacherId() {
  return getStoredStudentId() === TEACHER_VIEW_ID;
}
// Teacher ID AND the password entered this session — required for
// anything that shows other students' data.
function isTeacherSession() {
  return isTeacherId() && isTeacherUnlocked();
}

// Asks for the password if it hasn't been entered this session.
// Resolves true once unlocked, false if cancelled.
function promptTeacherPassword() {
  if (isTeacherUnlocked()) return Promise.resolve(true);
  return new Promise(resolve => {
    const pwInput = el("input", { type: "password", class: "student-id-input", placeholder: "Password", autocomplete: "off" });
    const pwError = el("p", { class: "student-id-error" }, "");
    const unlockBtn = el("button", { type: "button", class: "student-id-submit" }, "Unlock");
    const cancelBtn = el("button", { type: "button", class: "student-id-back" }, "Cancel");
    const overlay = el("div", { class: "student-id-overlay" }, el("div", { class: "student-id-panel" }, [
      el("h2", {}, "Teacher Password"),
      el("p", {}, "Enter the teacher password to open Teacher View."),
      pwInput, pwError, unlockBtn, cancelBtn
    ]));
    function finish(ok) { overlay.remove(); resolve(ok); }
    function tryUnlock() {
      if (verifyTeacherPassword(pwInput.value)) {
        try { sessionStorage.setItem(TEACHER_UNLOCK_KEY, "1"); } catch { /* ignore */ }
        finish(true);
      } else {
        pwError.textContent = "Incorrect password.";
        pwInput.value = "";
        pwInput.focus();
      }
    }
    unlockBtn.addEventListener("click", tryUnlock);
    pwInput.addEventListener("keydown", e => { if (e.key === "Enter") tryUnlock(); else if (e.key === "Escape") finish(false); });
    cancelBtn.addEventListener("click", () => finish(false));
    document.body.appendChild(overlay);
    pwInput.focus();
  });
}

function getStoredStudentId() {
  try {
    return localStorage.getItem(STUDENT_ID_KEY);
  } catch {
    return null;
  }
}

function storeStudentId(id) {
  try {
    localStorage.setItem(STUDENT_ID_KEY, id);
  } catch {
    // localStorage unavailable — the id still works for this session via cachedStudentId
  }
}

// Resolves with the student's ID once one exists — shows the entry
// overlay if none is stored yet, otherwise resolves immediately. Safe to
// call more than once; concurrent calls share the same pending prompt.
function ensureStudentId() {
  if (cachedStudentId) return Promise.resolve(cachedStudentId);
  const stored = getStoredStudentId();
  if (stored) {
    cachedStudentId = stored;
    return Promise.resolve(stored);
  }
  if (studentIdPromise) return studentIdPromise;

  studentIdPromise = new Promise(resolve => {
    const input = el("input", {
      type: "text",
      inputmode: "numeric",
      maxlength: "6",
      class: "student-id-input",
      placeholder: "123456",
      autocomplete: "off"
    });
    const submitBtn = el("button", { type: "button", class: "student-id-submit", disabled: "disabled" }, "Continue");
    const errorMsg = el("p", { class: "student-id-error" }, "");

    input.addEventListener("input", () => {
      input.value = input.value.replace(/\D/g, "").slice(0, 6);
      submitBtn.disabled = input.value.length !== 6;
      errorMsg.textContent = "";
    });

    function submit() {
      const id = input.value.trim();
      if (id.length !== 6) {
        errorMsg.textContent = "Enter exactly 6 digits.";
        return;
      }
      storeStudentId(id);
      cachedStudentId = id;
      overlay.remove();
      resolve(id);
    }

    submitBtn.addEventListener("click", submit);
    input.addEventListener("keydown", e => { if (e.key === "Enter" && !submitBtn.disabled) submit(); });

    const panel = el("div", { class: "student-id-panel" }, [
      el("h2", {}, "Enter Your Student ID"),
      el("p", {}, "Type the 6-digit ID your teacher gave you. This is how your answers get recorded."),
      input,
      errorMsg,
      submitBtn
    ]);
    const overlay = el("div", { class: "student-id-overlay" }, panel);
    document.body.appendChild(overlay);
    input.focus();
  });

  return studentIdPromise;
}

const RESPONSES_KEY = "usHistoryResponses";
let responsesCache = null;
let responsesLoadPromise = null;

// Every answer is kept locally on this device regardless of whether a
// spreadsheet endpoint is configured or reachable — that's what makes
// Teacher View work even when sending to a spreadsheet automatically
// isn't possible (e.g. a school account blocking Apps Script deployments).
//
// Concurrent calls (two questions answered close together) share the
// same in-flight load rather than each independently re-reading storage
// — otherwise the second save could overwrite the first.
async function getLocalResponses() {
  if (responsesCache !== null) return responsesCache;
  if (!responsesLoadPromise) {
    responsesLoadPromise = (async () => {
      const local = await loadJSON(RESPONSES_KEY, []);
      responsesCache = local;

      // Local storage is the fast, offline-friendly copy, but it isn't
      // always reliable (browser settings, private browsing, switching
      // devices). If an answer made it to Firebase but isn't in the
      // local copy, pull it back in here and re-save locally — this is
      // what "already rated"/"already answered Do Now" checks and
      // Teacher View's local fallback rely on, so it needs to survive
      // local storage loss the same way notes already do.
      const studentId = getStoredStudentId();
      if (studentId && ensureFirebase()) {
        try {
          const firebaseResponses = await getFirebaseResponses();
          if (firebaseResponses) {
            const localIds = new Set(local.map(r => r.id));
            const missingFromLocal = firebaseResponses.filter(r => r.studentId === studentId && r.id && !localIds.has(r.id));
            if (missingFromLocal.length) {
              responsesCache = [...missingFromLocal, ...local];
              await saveJSON(RESPONSES_KEY, responsesCache);
            }
          }
        } catch (err) {
          console.warn("Could not merge in this student's Firebase responses:", err);
        }
      }

      return responsesCache;
    })();
  }
  return responsesLoadPromise;
}

async function clearLocalResponses() {
  responsesCache = [];
  responsesLoadPromise = Promise.resolve([]);
  await saveJSON(RESPONSES_KEY, []);
}

// Sends one answered question to the logging endpoint. Never throws —
// failures are just logged to the console, since a broken/missing
// endpoint should never stop a student from answering.
let firebaseInitialized = false;

// True once Firebase is ready to use. Silently returns false (never
// throws) if it's unconfigured, the SDK didn't load, or init fails —
// answers just aren't synced live in that case, everything else still
// works.
function ensureFirebase() {
  if (firebaseInitialized) return true;
  if (typeof FIREBASE_CONFIG === "undefined" || !FIREBASE_CONFIG.databaseURL) return false;
  if (typeof firebase === "undefined") return false;
  try {
    firebase.initializeApp(FIREBASE_CONFIG);
    firebaseInitialized = true;
    return true;
  } catch (err) {
    console.warn("Could not connect to Firebase:", err);
    return false;
  }
}

// One-time fetch of every response currently in Firebase — used by
// Teacher View so it shows every student's answers, not just this
// device's own. Returns null (not an empty array) if Firebase isn't
// configured/reachable, so the caller can tell "no data yet" apart from
// "can't check live data at all."
async function getFirebaseResponses() {
  if (!ensureFirebase()) return null;
  try {
    const snapshot = await firebase.database().ref("responses").once("value");
    const data = snapshot.val() || {};
    return Object.values(data);
  } catch (err) {
    console.warn("Could not fetch live responses from Firebase:", err);
    return null;
  }
}

// Wipes every response from Firebase — irreversible, only call this after
// the caller has already confirmed with the person (see the two-click
// confirm in openTeacherViewModal). Returns true on success so the UI
// can tell whether it actually worked.
async function clearFirebaseResponses() {
  if (!ensureFirebase()) return false;
  try {
    await firebase.database().ref("responses").remove();
    return true;
  } catch (err) {
    console.warn("Could not clear responses from Firebase:", err);
    return false;
  }
}

// Removes only the given responses (by their own "id" field, not
// Firebase's own push key) — used by "Clear Shown" when a filter is
// active, so clearing doesn't wipe every student's answers on every
// lesson. Mirrors removeFirebaseNotes.
async function removeFirebaseResponses(idsToRemove) {
  if (!ensureFirebase()) return false;
  try {
    const snapshot = await firebase.database().ref("responses").once("value");
    const data = snapshot.val() || {};
    const updates = {};
    Object.entries(data).forEach(([key, response]) => {
      if (response && idsToRemove.has(response.id)) updates[key] = null;
    });
    if (Object.keys(updates).length) {
      await firebase.database().ref("responses").update(updates);
    }
    return true;
  } catch (err) {
    console.warn("Could not remove the selected responses from Firebase:", err);
    return false;
  }
}

// `extra` is optional structured data to keep alongside the answer (the
// Propaganda Match game stores which techniques were picked). It rides along
// in Firebase and on this device; it can never replace the core fields.
async function logAnswer({ lessonId, type, questionPrompt, answer, correct, skill, extra }) {
  const studentId = await ensureStudentId();
  const record = {
    ...(extra || {}),
    id: `r${Date.now()}${Math.random().toString(36).slice(2, 7)}`,
    studentId,
    timestamp: new Date().toISOString(),
    lessonId: lessonId || "",
    type: type || "",
    questionPrompt: questionPrompt || "",
    answer: answer || "",
    correct: correct === true ? "Yes" : (correct === false ? "No" : ""),
    skill: skill || ""
  };

  const responses = await getLocalResponses();
  responses.push(record);
  responsesCache = responses;
  await saveJSON(RESPONSES_KEY, responses);

  // Example content (shown when a sheet can't be reached) is for looking
  // at, so it never reaches Firebase or the spreadsheet.
  if (typeof isExampleLessonId === "function" && isExampleLessonId(lessonId)) return record;

  if (ensureFirebase()) {
    try {
      await firebase.database().ref("responses").push(record);
    } catch (err) {
      console.warn("Could not sync this answer to Firebase:", err);
    }
  }

  if (typeof RESPONSES_CONFIG === "undefined" || !RESPONSES_CONFIG.submitUrl) return record;
  try {
    await fetch(RESPONSES_CONFIG.submitUrl, {
      method: "POST",
      mode: "no-cors", // Apps Script doesn't return browser-readable CORS headers by default
      headers: { "Content-Type": "text/plain" }, // avoids a CORS preflight that Apps Script can't answer
      body: JSON.stringify(record)
    });
  } catch (err) {
    console.warn("Could not send this answer to the spreadsheet endpoint:", err);
  }
  return record;
}

