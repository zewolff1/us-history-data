// Finds a saved note's quote inside a rendered container (a reading's
// text, which is a mix of plain text nodes and word/glossary-term
// buttons) and wraps the matching span in a <mark>, in the note's own
// color. Works across button boundaries since it walks every text node
// in the container and matches against their combined text, not any
// single element — the highlight can end up partly inside a term
// button without breaking that button's own click behavior. Silently
// does nothing if the quote can't be found (e.g. the reading's text
// changed since the note was saved).
// Core matching logic shared by highlightTextInContainer (a note's own
// highlight) and applyStudentHighlightsOverlay (the teacher's aggregate
// overlay): finds where `quoteText` occurs in `container`'s text —
// robust to whitespace differences and the gaps at block boundaries
// (see comments below) — and wraps the matched text using whatever
// `makeWrapper(matchedText)` returns. Returns true if a match was
// found and wrapped, false otherwise.
function wrapMatchingText(container, quoteText, makeWrapper, skipIfAlreadyClass) {
  const rawQuote = (quoteText || "").trim();
  if (!rawQuote) return false;

  function topLevelBlock(node) {
    let current = node;
    while (current.parentNode && current.parentNode !== container) {
      if (current.tagName === "LI") break; // each bullet counts as its own block, so a highlight across two bullets still matches
      current = current.parentNode;
    }
    return current;
  }

  const walker = document.createTreeWalker(container, NodeFilter.SHOW_TEXT, null);
  const textNodes = [];
  let fullText = "";
  let node;
  let prevBlock = null;
  while ((node = walker.nextNode())) {
    const block = topLevelBlock(node);
    // A selection spanning two separate top-level blocks (e.g. the end
    // of one paragraph into the start of the next) gets an implicit
    // space/newline in the browser's own selected text — but the raw
    // DOM has NOTHING between two separate <p> elements. Insert a
    // virtual space here (not tied to any text node) so matching still
    // works; it simply won't be claimed by any node if a match lands on
    // it, so nothing breaks in the highlight itself.
    if (prevBlock !== null && block !== prevBlock) fullText += " ";
    textNodes.push({ node, start: fullText.length, end: fullText.length + node.textContent.length });
    fullText += node.textContent;
    prevBlock = block;
  }

  // Match against a whitespace-collapsed version of the text, since a
  // browser selection spanning block-level boundaries (e.g. across two
  // paragraphs) can insert whitespace/newlines that raw DOM textContent
  // concatenation doesn't have — collapsing both sides the same way
  // keeps the match working regardless. indexMap[i] gives the position
  // in the ORIGINAL fullText that normalized position i came from, so
  // the real text nodes still get sliced at the right spot.
  let normalizedText = "";
  const indexMap = [];
  let lastWasSpace = true;
  for (let i = 0; i < fullText.length; i++) {
    const ch = fullText[i];
    if (/\s/.test(ch)) {
      if (!lastWasSpace) {
        normalizedText += " ";
        indexMap.push(i);
      }
      lastWasSpace = true;
    } else {
      normalizedText += ch;
      indexMap.push(i);
      lastWasSpace = false;
    }
  }
  const normalizedQuote = rawQuote.replace(/\s+/g, " ").trim();
  if (!normalizedQuote) return false;

  const normMatchStart = normalizedText.indexOf(normalizedQuote);
  if (normMatchStart === -1) return false;
  const normMatchEnd = normMatchStart + normalizedQuote.length;
  const matchStart = indexMap[normMatchStart];
  const matchEnd = indexMap[normMatchEnd - 1] + 1;

  const overlapping = textNodes.filter(({ start, end }) => !(end <= matchStart || start >= matchEnd));
  // Already wrapped this exact match in the SAME mark class? Two callers
  // can legitimately race for the same quote (the save flow applies it
  // synchronously; reapplyAllHighlights' getNotes() promise can resolve
  // after and see that same note) — whichever gets here first should win,
  // not both, or the quote ends up double-marked.
  if (skipIfAlreadyClass && overlapping.length && overlapping.every(({ node }) =>
    node.parentNode && node.parentNode.nodeType === 1 && node.parentNode.classList.contains(skipIfAlreadyClass)
  )) {
    return true; // effectively already applied — nothing to do
  }

  overlapping.forEach(({ node, start, end }) => {
    const overlapStart = Math.max(matchStart, start) - start;
    const overlapEnd = Math.min(matchEnd, end) - start;
    const text = node.textContent;
    const before = text.slice(0, overlapStart);
    const highlighted = text.slice(overlapStart, overlapEnd);
    const after = text.slice(overlapEnd);
    if (!highlighted) return;

    const frag = document.createDocumentFragment();
    if (before) frag.appendChild(document.createTextNode(before));
    frag.appendChild(makeWrapper(highlighted));
    if (after) frag.appendChild(document.createTextNode(after));

    node.parentNode.replaceChild(frag, node);
  });
  return true;
}

function highlightTextInContainer(container, quoteText, colorId) {
  return wrapMatchingText(container, quoteText, (text) => {
    const mark = el("mark", { class: "note-highlight" }, text);
    mark.style.backgroundColor = colorHex(colorId);
    return mark;
  }, "note-highlight");
}

// Clears any previously-applied aggregate overlay marks (but leaves the
// teacher's own personal notes/.note-highlight marks untouched) — used
// before re-applying with a different scope, so switching scopes
// doesn't stack marks on top of marks.
function removeStudentHighlightOverlay(container) {
  container.querySelectorAll(".student-highlight-overlay").forEach(mark => {
    const text = document.createTextNode(mark.textContent);
    mark.parentNode.replaceChild(text, mark);
  });
  container.normalize();
}

// Fetches and filters notes matching a specific reading — used by both
// applyStudentHighlightsOverlay and its scope selector, so both stay
// consistent without duplicating the fetch+filter logic.
async function getMatchingNotesForReading(reading, lesson) {
  const firebaseNotes = await getFirebaseNotes();
  const notes = firebaseNotes !== null ? firebaseNotes : await getNotes();
  return notes.filter(n =>
    n.quote && n.readingTitle === reading.title && n.lessonNumber === (lesson ? lesson.number : undefined)
  );
}

// Teacher-only: overlays a highlight over passages students have saved
// as notes on this reading, shaded darker the more students agree.
// `scope` narrows whose notes count:
//   { type: "all" }                — every student, 2+ agreement required
//   { type: "class", value: cp }   — only that class period, 2+ agreement
//   { type: "student", value: id } — just that one student, every quote
//                                     they saved, no agreement threshold
//                                     (reviewing one student isn't about
//                                     consensus)
// Never runs for a student — only ever called when the current page has
// identified as the teacher.
async function applyStudentHighlightsOverlay(readingBody, reading, lesson, scope = { type: "all" }) {
  if (!isTeacherSession()) return;
  if (!reading || !reading.title) return;

  removeStudentHighlightOverlay(readingBody);

  let matching = await getMatchingNotesForReading(reading, lesson);

  const roster = COURSE_DATA.roster || {};
  if (scope.type === "class" && scope.value) {
    matching = matching.filter(n => roster[n.studentId] === scope.value);
  } else if (scope.type === "student" && scope.value) {
    matching = matching.filter(n => n.studentId === scope.value);
  } else if (scope.type === "starred") {
    await loadStarredStudents();
    matching = matching.filter(n => isStarred(n.studentId));
  }
  if (!matching.length) return;

  if (scope.type === "student") {
    const seenQuotes = new Set();
    matching
      .filter(n => {
        if (seenQuotes.has(n.quote)) return false;
        seenQuotes.add(n.quote);
        return true;
      })
      .sort((a, b) => b.quote.length - a.quote.length)
      .forEach(n => {
        wrapMatchingText(readingBody, n.quote, (text) => {
          const mark = el("mark", {
            class: "student-highlight-overlay",
            title: `Highlighted by ${studentDisplayName(n.studentId)}`
          }, text);
          mark.style.backgroundColor = "rgba(46, 110, 142, 0.4)";
          return mark;
        });
      });
    return;
  }

  const studentsByQuote = new Map(); // quote text -> Set of studentIds
  matching.forEach(n => {
    if (!studentsByQuote.has(n.quote)) studentsByQuote.set(n.quote, new Set());
    studentsByQuote.get(n.quote).add(n.studentId || "");
  });

  const ranked = [...studentsByQuote.entries()]
    .map(([quote, students]) => ({ quote, count: students.size }))
    .filter(r => r.count >= (scope.type === "starred" ? 1 : 2)) // "most highlighted" means more than one student agreed (starred students: any of theirs count)
    .sort((a, b) => b.quote.length - a.quote.length);

  ranked.forEach(({ quote, count }) => {
    wrapMatchingText(readingBody, quote, (text) => {
      // Widened range so the difference between e.g. 2 and 4 students
      // is clearly visible, not just a subtle shift.
      const intensity = Math.max(0.12, Math.min(0.12 + (count - 2) * 0.15, 0.85));
      const mark = el("mark", {
        class: "student-highlight-overlay",
        title: `Highlighted by ${count} student${count === 1 ? "" : "s"}`
      }, text);
      mark.style.backgroundColor = `rgba(46, 110, 142, ${intensity})`;
      return mark;
    });
  });
}

// Teacher-only: builds the "All Classes / By Class / By Student"
// dropdown that controls applyStudentHighlightsOverlay's scope. Starts
// hidden and fills in once this reading's notes are fetched, since
// knowing which classes/students are worth listing requires that fetch
// — stays hidden if there's nothing to scope (no notes on this reading
// yet). Returns null outright for a student — this control only ever
// exists for the teacher.
function buildHighlightScopeSelector(readingBody, reading, lesson) {
  if (!isTeacherSession()) return null;

  const select = el("select", { class: "highlight-scope-select" }, [
    el("option", { value: "all" }, "Highlights: All Classes")
  ]);
  select.style.display = "none";

  select.addEventListener("change", () => {
    const [type, value] = select.value.split("::");
    const scope = type === "all" ? { type: "all" } : { type, value };
    applyStudentHighlightsOverlay(readingBody, reading, lesson, scope);
  });

  getMatchingNotesForReading(reading, lesson).then(async matching => {
    if (!matching.length) return; // nothing to scope — leave the selector hidden
    await loadStarredStudents();

    const roster = COURSE_DATA.roster || {};
    const classPeriods = [...new Set(matching.map(n => roster[n.studentId]).filter(Boolean))].sort();
    const studentIds = [...new Set(matching.map(n => n.studentId).filter(Boolean))]
      .sort((a, b) => studentDisplayName(a).localeCompare(studentDisplayName(b)));

    if (classPeriods.length) {
      const classGroup = el("optgroup", { label: "By Class" });
      classPeriods.forEach(cp => classGroup.appendChild(el("option", { value: `class::${cp}` }, cp)));
      select.appendChild(classGroup);
    }
    if (studentIds.length) {
      const studentGroup = el("optgroup", { label: "By Student" });
      studentIds.forEach(id => studentGroup.appendChild(el("option", { value: `student::${id}` }, studentDisplayName(id))));
      select.appendChild(studentGroup);
    }

    if (matching.some(n => isStarred(n.studentId))) {
      select.insertBefore(el("option", { value: "starred::" }, "\u2605 Starred students"), select.children[1] || null);
    }

    select.style.display = "";
  });

  return select;
}

// Builds one note card: quote, a label picker (existing labels or create
// new), source, and a remove button. `n` is the actual object living
// inside notesCache, so editing its fields here and persisting is all
// that's needed — no separate lookup/update step. `labels` is the current
// label registry, fetched once by the caller and shared across all items.
function buildNoteItem(n, labels, onRemoved) {
  const item = el("div", { class: "note-item" });
  item.style.borderLeftColor = colorHex(n.color);

  const labelRow = el("div", { class: "note-label-row" });
  const editSlot = el("div", { class: "note-label-edit-slot" });
  editSlot.style.display = "none";

  function renderLabelTitle() {
    labelRow.innerHTML = "";
    labelRow.style.display = "flex";
    editSlot.style.display = "none";

    const titleEl = n.label
      ? el("span", { class: "note-label-title", style: `color:${colorHex(n.color)};` }, n.label)
      : el("span", { class: "note-label-title empty" }, "No label");
    const editBtn = el("button", { type: "button", class: "note-label-edit-btn" }, n.label ? "Edit" : "+ Add label");
    editBtn.addEventListener("click", openEditor);

    labelRow.appendChild(titleEl);
    labelRow.appendChild(editBtn);
  }

  function openEditor() {
    labelRow.style.display = "none";
    editSlot.style.display = "block";
    editSlot.innerHTML = "";

    const picker = buildLabelPicker(labels, n.label, n.color, async (sel) => {
      if (sel.isNew) {
        await upsertLabel(sel.label, sel.color);
      }
      n.label = sel.label;
      n.color = sel.color;
      item.style.borderLeftColor = colorHex(sel.color);
      saveNotesToStorage(notesCache);
      renderLabelTitle(); // back to the title view once a choice is made
    });
    editSlot.appendChild(picker.container);
  }

  renderLabelTitle();

  const removeBtn = el("button", { type: "button", class: "note-remove" }, "Remove");
  removeBtn.addEventListener("click", async () => {
    await removeNote(n.id);
    if (onRemoved) onRemoved();
  });

  const metaText = [
    n.unitNumber ? `Unit ${n.unitNumber}` : null,
    n.lessonNumber ? `Lesson ${n.lessonNumber}` : null,
    n.readingTitle || n.sourceTitle
  ].filter(Boolean).join(" · ");

  const contentEl = n.imageData
    ? el("img", { class: "note-image-thumb", src: n.imageData, alt: n.label || "Saved image" })
    : el("p", { class: "note-quote" }, `"${n.quote}"`);

  item.appendChild(labelRow);
  item.appendChild(editSlot);
  item.appendChild(contentEl);
  item.appendChild(el("span", { class: "meta" }, metaText));
  item.appendChild(removeBtn);
  return item;
}

// A compact chip showing just an icon + category + name. The definition
// only shows once tapped, in openEntityModal — used identically for both
// "What You Need to Know" and "People, Topics & Events" so both sections
// behave the same way.
// A key-term chip. Click it to read the definition. Hover (or tab to) it
// and two buttons appear: Open (same as clicking) and Pin -- so a term can
// be pinned without opening it first. A thumbtack marks pinned terms.
function buildEntityChip(ent, featured, teacherPinned) {
  const chip = el("button", {
    type: "button",
    class: "mention-chip" + (featured ? " featured" : "")
  }, [
    ent.image ? el("img", { class: "entity-icon-sm", src: ent.image, alt: "" }) : null,
    el("span", { class: "mention-name" }, ent.name)
  ]);
  chip.addEventListener("click", () => openEntityModal(ent));

  const openBtn = el("button", { type: "button", class: "hover-open" }, [el("i", { class: "fa-solid fa-up-right-from-square" }), " Open"]);
  openBtn.addEventListener("click", (e) => { e.stopPropagation(); openEntityModal(ent); });
  const pinBtn = buildHoverPinButton({
    isPinned: () => !!teacherPinned || isTermPinned(ent.id),
    isLocked: () => !!teacherPinned,
    toggle: () => setTermPinned(ent.id, !isTermPinned(ent.id))
  }, "term");

  const wrap = el("span", { class: "chip-wrap pin-aware" }, [chip, el("span", { class: "hover-actions" }, [openBtn, pinBtn])]);
  wrap._paint = () => {
    const pinned = !!teacherPinned || isTermPinned(ent.id);
    let tack = chip.querySelector(".chip-pin");
    if (pinned && !tack) { tack = el("i", { class: "fa-solid fa-thumbtack chip-pin" }); chip.appendChild(tack); }
    if (!pinned && tack) tack.remove();
    if (tack) tack.title = teacherPinned ? "Pinned by your teacher" : "Pinned";
  };
  wrap._paint();
  return wrap;
}

// The Do Now popup itself. Any answers this student already gave come
// back on screen (their choice, whether it was right, the explanation or
// sample answer, and classmates' answers) — so it can be reopened later
// from the masthead's Do Now button.
function openDoNowModal(lesson) {
  if (!lesson) return;
  const doNowQs = lesson.doNow ? questionsForStudent(lesson.doNow, lesson) : [];
  const doNowAs = doNowAssessments(lesson);
  if (!doNowQs.length && !doNowAs.length) return;
  closeModal();
  const widget = el("div", {}, [
    doNowQs.length > 1 ? buildQuestionSequence(doNowQs, lesson.objectives, lesson.id)
      : doNowQs.length ? buildQuestionWidget(doNowQs[0], lesson.objectives, lesson.id) : null,
    ...doNowAs.map(a => buildAssessmentCard(a, lesson.id, true))
  ]);

  const panel = el("div", { class: "modal-panel", role: "dialog", "aria-modal": "true", "aria-label": "Do Now" }, [
    el("div", { class: "modal-header" }, [
      el("div", {}, [
        el("h2", {}, "Do Now"),
        el("span", { class: "do-now-lesson-tag" }, lesson.number)
      ]),
      el("button", { type: "button", class: "modal-close", "aria-label": "Close" }, "×")
    ]),
    el("div", { class: "modal-body notes-body" }, widget)
  ]);

  const overlay = el("div", { class: "modal-overlay" }, panel);
  overlay.addEventListener("click", (e) => { if (e.target === overlay) closeModal(); });
  panel.querySelector(".modal-close").addEventListener("click", closeModal);

  document.body.appendChild(overlay);
  document.addEventListener("keydown", onModalKeydown);
  activeModal = overlay;
}

// Shows a lesson's Do Now question (if it has one) automatically, the
// moment the lesson opens — unless this student's ID has already
// answered it before (on this device, or on another one with the same ID).
function doNowAssessments(lesson) {
  return assessmentsForViewer(lesson).filter(a => a.doNow);
}
async function maybeShowDoNow(lesson) {
  if (!lesson) return;
  const myDoNow = lesson.doNow ? questionsForStudent(lesson.doNow, lesson) : [];
  if (!myDoNow.length) { // an assessment-only Do Now: open it once per device
    if (!doNowAssessments(lesson).length) return;
    let seen = false; const key = "doNowAssessSeen:" + lesson.id;
    try { seen = !!localStorage.getItem(key); localStorage.setItem(key, "1"); } catch (e) {}
    if (!seen) openDoNowModal(lesson);
    return;
  }

  const studentId = await ensureStudentId();
  const responses = await getLocalResponses();
  const alreadyAnswered = responses.some(r =>
    r.studentId === studentId && r.lessonId === lesson.id && r.questionPrompt === myDoNow[0].prompt
  );
  if (alreadyAnswered) return;
  openDoNowModal(lesson);
}

// Masthead "Do Now" button: shown only on a lesson that has one, and
// opens it again at any time.
let doNowButtonBound = false;
function mountDoNowButton() {
  if (doNowButtonBound) return;
  const btn = document.getElementById("do-now-btn");
  if (!btn) return;
  doNowButtonBound = true;
  btn.addEventListener("click", () => {
    const found = flatLessons().find(o => o.lesson.id === currentLessonId);
    if (found) openDoNowModal(found.lesson);
  });
}
// "Hexagons" button: opens the Hexagon Web page already filtered to this lesson.
function updateHexagonButton(lesson) {
  const a = document.getElementById("hexagon-btn");
  if (!a) return;
  const base = (typeof HEXAGON_WEB_URL !== "undefined" && HEXAGON_WEB_URL) || "";
  if (!base || !lesson) { a.style.display = "none"; return; }
  a.href = base + (base.includes("?") ? "&" : "?") + "lesson=" + encodeURIComponent(lesson.id);
  a.style.display = "";
}
// Teacher-only "Notes" button: opens the lesson's Notes Link (lesson-tab column).
function updateNotesButton(lesson) {
  const a = document.getElementById("notes-link-btn");
  if (!a) return;
  const show = !!(lesson && lesson.notesLink) && typeof isTeacherId === "function" && isTeacherId();
  if (!show) { a.style.display = "none"; return; }
  a.href = lesson.notesLink;
  a.title = lesson.notesTitle || "Teacher notes";
  a.style.display = "";
  if (!a._gated) {
    a._gated = true;
    a.addEventListener("click", async e => {
      if (typeof isTeacherUnlocked === "function" && !isTeacherUnlocked()) {
        e.preventDefault();
        if (await promptTeacherPassword()) window.open(a.href, "_blank", "noopener");
      }
    });
  }
}
function updateDoNowButtonVisibility(lesson) {
  updateHexagonButton(lesson);
  updateNotesButton(lesson);
  const btn = document.getElementById("do-now-btn");
  if (!btn) return;
  btn.style.display = (lesson && ((lesson.doNow && questionsForStudent(lesson.doNow, lesson).length) || doNowAssessments(lesson).length)) ? "" : "none";
}

// Shows one person/topic/event's description, plus every lesson across the
// whole course that mentions it (found by scanning all units/lessons for
// this entity's id in their `mentions` array — no separate index to keep
// in sync, it's just derived on the fly).
// Builds the body of an entity popup section: image, description, and
// which lessons mention it.
function buildEntityDetailNodes(entity, showName) {
  const matches = [];
  COURSE_DATA.units.forEach(unit => {
    unit.lessons.forEach(lesson => {
      if ((lesson.mentions || []).includes(entity.id)) matches.push({ unit, lesson });
    });
  });
  const list = matches.length
    ? el("ul", { class: "mention-lessons-list" },
        matches.map(({ unit, lesson }) =>
          el("li", {}, `Unit ${unit.number} · Lesson ${lesson.number} — ${lesson.title}`)
        )
      )
    : el("p", { class: "empty-note" }, "Not linked to any lessons yet.");
  return [
    showName ? el("h3", { class: "mention-member-name" }, entity.name) : null,
    entity.image ? el("img", { class: "mention-image", src: entity.image, alt: entity.name }) : null,
    buildPinButton(entity.id),
    entity.definition
      ? el("p", { class: "mention-description" }, entity.definition)
      : entity.actions && entity.actions.length > 1
        ? el("ul", { class: "mention-description-list" }, entity.actions.map(a => el("li", {}, a)))
        : entityDescription(entity)
          ? el("p", { class: "mention-description" }, entityDescription(entity))
          : null,
    el("div", { class: "section-title" }, "Appears In"),
    list
  ];
}

// One entity, or several merged into a single popup (pass an array and
// an optional shared title).
function openEntityModal(entityOrList, groupTitle) {
  closeModal();
  const entities = Array.isArray(entityOrList) ? entityOrList : [entityOrList];
  const multi = entities.length > 1;

  const panel = el("div", { class: "modal-panel", role: "dialog", "aria-modal": "true", "aria-label": groupTitle || entities[0].name }, [
    el("div", { class: "modal-header" }, [
      el("div", {}, [
        el("h2", {}, groupTitle || entities[0].name),
        el("span", { class: "meta" }, multi ? entities.map(e => e.name).join(" · ") : entities[0].category)
      ]),
      el("button", { type: "button", class: "modal-close", "aria-label": "Close" }, "×")
    ]),
    el("div", { class: "modal-body mention-body" }, entities.flatMap(e => buildEntityDetailNodes(e, multi)))
  ]);

  const overlay = el("div", { class: "modal-overlay" }, panel);
  overlay.addEventListener("click", (e) => { if (e.target === overlay) closeModal(); });
  panel.querySelector(".modal-close").addEventListener("click", closeModal);

  document.body.appendChild(overlay);
  document.addEventListener("keydown", onModalKeydown);
  activeModal = overlay;
}

// ---------- "My Notes" ----------
// A student's own saved highlights. For the teacher account this lives as
// a tab inside Teacher View instead (see buildMyNotesSection below) — but
// for everyone else it's still its own masthead button + standalone modal,
// same as it always was.
let myNotesButtonBound = false;
function mountMyNotesButton() {
  if (myNotesButtonBound) return;
