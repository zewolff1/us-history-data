<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>United States History II</title>
  <style>
@import url('https://fonts.googleapis.com/css2?family=Anton&family=Oswald:wght@500;600;700&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap');

:root {
  --ink: #1A1512;
  --ink-soft: #4A4038;
  --parchment: #F2E4C4;
  --parchment-dim: #E8D2A0;
  --card: #FAF1DC;
  --brass: #D9A62E;
  --brass-light: #E8C368;
  --stamp: #C1272D;
  --forest: #1B6B73;
  --rule: rgba(26, 21, 18, 0.2); --rule: color-mix(in srgb, var(--ink) 20%, transparent);
  --shadow: rgba(26, 21, 18, 0.3); --shadow: color-mix(in srgb, var(--ink) 30%, transparent);
  --focus: #1D3557;
  --font-display: 'Anton', sans-serif;
  --font-heading: 'Oswald', sans-serif;
  --font-body: 'Source Serif 4', Georgia, serif;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; overflow-anchor: none; }

body {
  margin: 0;
  background-color: var(--parchment);
  background-image: var(--page-pattern, none);
  color: var(--ink);
  font-family: var(--font-body);
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

a { color: var(--focus); }
a:focus-visible, button:focus-visible, [tabindex]:focus-visible {
  outline: 3px solid var(--focus);
  outline-offset: 2px;
}

.label {
  font-family: var(--font-heading);
  text-transform: uppercase;
  letter-spacing: 0.09em;
  font-size: 0.72rem;
  font-weight: 600;
}

/* ---------- Header / masthead ---------- */
.masthead {
  border-bottom: 4px solid var(--ink);
  padding: 0.45rem 1.2rem;
  background-color: var(--stamp);
  background-image: var(--header-pattern, none);
  position: relative; /* not sticky: scrolls away so it doesn't eat screen space */
  z-index: 500;
}
.masthead-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-start;
  gap: 1.8rem;
  max-width: 1100px;
  margin: 0 auto;
}
.masthead-titles {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
  min-width: 0;
  cursor: pointer;
  border: none;
  background: none;
  text-align: left;
  padding: 0.2rem 0.3rem;
  margin: -0.2rem -0.3rem;
  border-radius: 4px;
}
.masthead-titles:hover, .masthead-titles:focus-visible { background: rgba(255, 255, 255, 0.12); }
.masthead-titles:focus-visible { outline: 2px solid var(--brass-light); outline-offset: 1px; }
.masthead-titles-hint {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.66rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 0.1rem;
}
.teacher-page-badge {
  display: inline-block;
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--ink);
  background: var(--brass-light);
  padding: 0.15rem 0.5rem;
  border-radius: 3px;
  width: fit-content;
}
.masthead-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  flex-shrink: 0; /* never give up its spot on the row -- the inquiry strip beside it shrinks/wraps instead */
  gap: 0.7rem;
  flex: 0 0 auto;
}
.masthead-btn-group {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.4rem;
  padding-left: 0.5rem;
  border-left: 2px solid rgba(255, 255, 255, 0.35);
}
.masthead-btn-group-leading { padding-left: 0; border-left: none; }
.masthead-btn-group:empty { display: none; }
.masthead-btn {
  display: flex;
  align-items: center;
  gap: 0.3rem;
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.6rem;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  background: var(--card);
  color: var(--ink);
  border: 2px solid var(--ink);
  padding: 0.32rem 0.5rem;
  border-radius: 3px;
  cursor: pointer;
  white-space: nowrap;
}
.masthead-btn:hover { background: var(--brass-light); }
.change-lesson-btn i { color: var(--stamp); }
.masthead h1 {
  font-family: var(--font-display);
  font-weight: 400;
  font-size: 1.35rem;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  margin: 0;
  color: var(--card);
}
.unit-banner {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.82rem;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  color: var(--brass-light);
}
.unit-banner .unit-era {
  color: var(--parchment-dim);
  margin-left: 0.4rem;
  font-weight: 500;
}
.lesson-banner {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.9rem;
  color: var(--card);
  opacity: 0;
  max-height: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  transition: opacity 0.2s ease, max-height 0.2s ease;
}
.lesson-banner .banner-icon { flex: 0 0 auto; width: 32px; height: 32px; margin-right: 0.5rem; }
.lesson-banner:empty { display: none; }
/* Shown once the masthead has collapsed (see .masthead-expanded below) --
   avoids showing the same lesson title twice at once at the top of a
   lesson, where the expanded version is already visible. Also takes zero
   space (not just invisible) until then, so it doesn't add a wasted line
   of height while the big title is on screen. */
.masthead.collapsed .lesson-banner { opacity: 1; max-height: 3rem; }

main {
  max-width: 920px;
  margin: 0 auto;
  padding: 2rem 1.5rem 5rem;
}

/* ---------- Unit folder tabs (index page) ---------- */
.unit {
  margin-bottom: 2.4rem;
}
.unit-tab {
  display: flex;
  align-items: baseline;
  gap: 0.9rem;
  background: var(--ink);
  color: var(--parchment);
  padding: 0.65rem 1.1rem;
  position: relative;
  margin-bottom: 0;
  border-left: 6px solid var(--brass);
}
.unit-tab .unit-number {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.8rem;
  color: var(--brass-light);
}
.unit-tab h2 {
  font-family: var(--font-display);
  font-weight: 400;
  text-transform: uppercase;
  letter-spacing: 0.02em;
  font-size: 1.25rem;
  margin: 0;
  flex: 1;
}
.unit-tab .era {
  font-family: var(--font-heading);
  font-size: 0.75rem;
  color: var(--parchment-dim);
}

.case-file > .lesson-number {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.72rem;
  color: var(--stamp);
  letter-spacing: 0.06em;
  display: block;
  margin-bottom: 0.3rem;
  text-transform: uppercase;
}

/* ---------- Lesson page ---------- */
.breadcrumb {
  font-family: var(--font-heading);
  font-size: 0.78rem;
  color: var(--ink-soft);
  text-decoration: none;
  display: inline-block;
  margin-bottom: 1.2rem;
}
.breadcrumb:hover { color: var(--stamp); }

.case-file {
  background: var(--card);
  border: 3px solid var(--ink);
  box-shadow: 6px 6px 0 var(--stamp);
  padding: 1.8rem 1.8rem 2.2rem;
  position: relative;
}
.case-file h1 {
  font-family: var(--font-display);
  font-weight: 400;
  text-transform: uppercase;
  letter-spacing: 0.01em;
  font-size: clamp(1.5rem, 3.4vw, 2.3rem);
  margin: 0 0 0.4rem;
  max-width: 90%;
  line-height: 1.1;
}
.inquiry-block {
  border-left: 4px solid var(--forest);
  padding-left: 0.9rem;
  margin: 0.9rem 0 1.8rem;
}
.inquiry-kicker {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--forest);
  margin-bottom: 0.3rem;
}
.inquiry-text {
  font-style: italic;
  color: var(--ink-soft);
  margin: 0;
}
.inquiry-list {
  margin: 0;
  padding-left: 1.1rem;
  color: var(--ink-soft);
  font-style: italic;
}
.inquiry-list li { margin-bottom: 0.3rem; }

.section-title {
  display: inline-block;
  font-family: var(--font-heading);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  font-weight: 700;
  font-size: 0.8rem;
  color: var(--card);
  background-color: var(--ink);
  background-image: var(--title-pattern, none);
  padding: 0.3rem 0.8rem;
  margin: 2rem 0 1rem;
}

.objectives-list {
  margin: 0;
  padding-left: 0;
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.objectives-list li {
  position: relative;
  padding-left: 1.5rem;
  line-height: 1.5;
}
.objectives-list li::before {
  content: "▸";
  position: absolute;
  left: 0;
  top: 0;
  font-size: 1rem;
  color: var(--stamp);
  font-weight: 700;
}

.entity-icon {
  flex: 0 0 auto;
  width: 2.4rem;
  height: 2.4rem;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid var(--ink);
}
.entity-icon-sm {
  flex: 0 0 auto;
  width: 2.2rem;
  height: 2.2rem;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid var(--ink);
}
.mention-image {
  display: block;
  width: auto;
  max-width: 140px;
  max-height: 140px;
  border-radius: 50%;
  object-fit: cover;
  border: 3px solid var(--ink);
  margin: 0 auto 1rem;
}

/* ---------- People, Topics & Events ---------- */
.mentions-groups {
  display: flex;
  flex-direction: column;
  gap: 0.9rem;
}
.mentions-group-label {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--brass);
  margin-bottom: 0.4rem;
}
.mentions-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
}
.mention-chip {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: var(--card);
  border: 2px solid var(--ink);
  border-radius: 999px;
  padding: 0.35rem 0.9rem 0.35rem 0.6rem;
  cursor: pointer;
  font: inherit;
}
.mention-chip:hover { background: var(--brass-light); }
.mention-chip.featured {
  border: 2px solid var(--stamp);
  background: var(--parchment-dim);
}
.mention-chip.featured .mention-name { font-weight: 700; }
.mention-name {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.9rem;
  color: var(--ink);
}
.mention-body { padding: 1.2rem 1.6rem 1.6rem; }
.mention-description {
  margin: 0 0 1rem;
  line-height: 1.55;
}
.mention-description-list {
  margin: 0 0 1rem;
  padding-left: 1.2rem;
  line-height: 1.5;
}
.mention-description-list li { margin-bottom: 0.4rem; }
.mention-lessons-list {
  margin: 0.6rem 0 0;
  padding-left: 1.1rem;
}
.mention-lessons-list li {
  margin-bottom: 0.4rem;
  font-family: var(--font-heading);
  font-size: 0.85rem;
}

.reading-item, .video-item, .source-item {
  padding: 0.8rem 0;
  border-bottom: 2px dashed var(--rule);
}
.source-item {
  display: flex;
  align-items: flex-start;
  gap: 0.8rem;
}
.source-icon {
  flex: 0 0 auto;
  width: 2.4rem;
  height: 2.4rem;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid var(--ink);
  margin-top: 0.1rem;
}
.source-item-text {
  flex: 1;
  min-width: 0;
}
.reading-item:last-child, .video-item:last-child, .source-item:last-child { border-bottom: none; }
.source-kind {
  display: block;
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.62rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--stamp);
  margin-bottom: 0.15rem;
}
.open-link {
  display: block;
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 1.05rem;
  color: var(--focus);
  background: none;
  border: none;
  padding: 0;
  text-align: left;
  cursor: pointer;
  font: inherit;
  font-weight: 600;
  color: var(--focus);
}
.open-link:hover { text-decoration: underline; text-decoration-color: var(--stamp); }
.meta {
  display: block;
  font-family: var(--font-heading);
  font-size: 0.72rem;
  color: var(--ink-soft);
  margin-top: 0.2rem;
}
.note {
  font-size: 0.9rem;
  color: var(--ink-soft);
  margin: 0.2rem 0 0;
}

.gallery-badge {
  display: inline-block;
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.65rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--card);
  background: var(--forest);
  border-radius: 2px;
  padding: 0.05rem 0.4rem;
  margin-left: 0.5rem;
  vertical-align: middle;
}

.modal-body.image-body {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  background: var(--ink);
  padding: 0;
}
.modal-image-area {
  position: relative;
  width: 100%;
  display: flex;
  align-items: flex-start;
  justify-content: center;
}
.modal-image {
  max-width: 100%;
  max-height: 65vh;
  display: block;
  object-fit: contain;
  -webkit-user-drag: none;
  user-select: none;
  -webkit-touch-callout: none;
}
.gallery-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(26, 21, 18, 0.6); background: color-mix(in srgb, var(--ink) 60%, transparent);
  color: var(--parchment);
  border: 2px solid var(--card);
  width: 2.4rem;
  height: 2.4rem;
  font-size: 1.5rem;
  line-height: 1;
  cursor: pointer;
  border-radius: 50%;
}
.gallery-btn:hover { background: var(--stamp); border-color: var(--stamp); }
.gallery-prev { left: 0.6rem; }
.gallery-next { right: 0.6rem; }
.image-footer {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
}
.gallery-count {
  font-family: var(--font-heading);
  font-size: 0.72rem;
  color: var(--ink-soft);
  white-space: nowrap;
}
.image-caption {
  margin: 0;
  padding: 0.6rem 1rem;
  background: var(--parchment-dim);
  font-size: 0.85rem;
  font-style: italic;
  color: var(--ink-soft);
  text-align: center;
}

/* ---------- Image zoom overlay (custom, doesn't need Fullscreen API) ---------- */
.zoom-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.9);
  z-index: 1400;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: zoom-out;
}
.zoom-overlay-image {
  max-width: 95vw;
  max-height: 95vh;
  object-fit: contain;
  cursor: zoom-out;
}
.zoom-overlay-close {
  position: fixed;
  top: 1rem;
  right: 1.2rem;
  background: none;
  border: none;
  color: var(--card);
  font-size: 2.2rem;
  line-height: 1;
  cursor: pointer;
}

/* ---------- Drag-to-select image crop ---------- */
.crop-wrap {
  position: relative;
  display: inline-block;
  max-width: 100%;
  line-height: 0;
}
.crop-overlay {
  position: absolute;
  inset: 0;
  display: none;
  touch-action: none;
}
.crop-overlay.active {
  display: block;
  cursor: crosshair;
}
.crop-selection-box {
  position: absolute;
  border: 2px dashed var(--stamp);
  background: rgba(193, 39, 45, 0.2); background: color-mix(in srgb, var(--stamp) 20%, transparent);
  pointer-events: none;
}
.crop-toolbar {
  display: flex;
  justify-content: center;
  padding: 0.6rem 0;
  background: var(--ink);
}
.crop-toggle {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  background: none;
  border: 2px solid var(--brass);
  color: var(--parchment);
  padding: 0.4rem 0.8rem;
  border-radius: 3px;
  cursor: pointer;
}
.crop-toggle:hover { background: var(--stamp); border-color: var(--stamp); }

.note-image-thumb {
  display: block;
  max-width: 100%;
  max-height: 220px;
  border: 2px solid var(--ink);
  margin-bottom: 0.5rem;
  object-fit: contain;
  background: var(--ink);
}
.save-sheet-image-preview {
  display: block;
  max-width: 100%;
  max-height: 220px;
  margin: 0 auto 0.9rem;
  border: 2px solid var(--ink);
  object-fit: contain;
}

/* ---------- In-site popup viewer ---------- */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(26, 21, 18, 0.68); background: color-mix(in srgb, var(--ink) 68%, transparent);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  z-index: 1000;
}
.modal-panel {
  background: var(--card);
  width: min(760px, 100%);
  max-height: min(88vh, 720px);
  display: flex;
  flex-direction: column;
  box-shadow: 8px 8px 0 var(--ink);
  border: 3px solid var(--ink);
}
.modal-panel-reading {
  width: min(1000px, 96vw);
  max-height: min(94vh, 960px);
}
.modal-panel-embed {
  width: 98vw;
  height: 96vh;
  max-height: 96vh;
}
.modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  padding: 1rem 1.2rem;
  border-bottom: 2px solid var(--ink);
  background: var(--parchment-dim);
}
.modal-header h2 {
  font-family: var(--font-display);
  font-weight: 400;
  text-transform: uppercase;
  letter-spacing: 0.01em;
  font-size: 1.15rem;
  margin: 0 0 0.2rem;
}
.do-now-lesson-tag {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  color: var(--stamp);
}
.modal-close {
  background: none;
  border: none;
  font-size: 1.6rem;
  line-height: 1;
  color: var(--ink-soft);
  cursor: pointer;
  padding: 0.1rem 0.3rem;
}
.modal-close:hover { color: var(--stamp); }
.modal-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
}
.modal-body.reading-body {
  padding: 1.4rem 1.6rem 1.8rem;
  background: var(--card);
}
.modal-body.reading-body p {
  margin: 0 0 1rem;
  font-size: 1.02rem;
  line-height: 1.65;
}
.modal-body.reading-body p:last-child { margin-bottom: 0; }
.reading-h1 {
  font-family: var(--font-display);
  font-weight: 400;
  text-transform: uppercase;
  letter-spacing: 0.01em;
  font-size: 1.35rem;
  margin: 1.6rem 0 0.8rem;
}
.reading-h1:first-child { margin-top: 0; }
.reading-h2 {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 1.05rem;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  color: var(--stamp);
  margin: 1.4rem 0 0.6rem;
}
.reading-h2:first-child { margin-top: 0; }
.reading-h3 {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.9rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--ink-soft);
  margin: 1.2rem 0 0.4rem;
}
.reading-h3:first-child { margin-top: 0; }
.modal-body.reading-body .reading-poem {
  white-space: pre-wrap;
  font-style: italic;
  line-height: 1.55;
  margin: 1.1rem 0 1.1rem 1.4rem;
  padding-left: 1rem;
  border-left: 3px solid var(--brass);
}
.modal-body.reading-body .reading-centered {
  text-align: center;
  font-family: var(--font-heading);
  font-weight: 600;
  letter-spacing: 0.02em;
  margin: 1.2rem 0;
}
.modal-body.reading-body .reading-attribution {
  text-align: right;
  font-family: var(--font-heading);
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--ink-soft);
  margin: -0.4rem 0 1.2rem;
}
.modal-body.reading-body .reading-callout {
  border: 2px solid var(--ink);
  border-left-width: 6px;
  border-left-color: var(--focus);
  background: var(--parchment-dim);
  border-radius: 3px;
  padding: 0.7rem 1rem;
  margin: 1.1rem 0;
}
.modal-body.reading-body .reading-list {
  margin: 0 0 1rem;
  padding-left: 1.5rem;
}
.modal-body.reading-body .reading-list li {
  margin: 0 0 0.35rem;
  font-size: 1.02rem;
  line-height: 1.55;
}
.modal-body.reading-body .reading-divider {
  border: none;
  border-top: 2px dashed var(--rule);
  margin: 1.5rem 0;
}
.reading-blockquote {
  margin: 1.1rem 0;
  padding: 0.7rem 1.2rem;
  border-left: 4px solid var(--brass);
  background: var(--parchment-dim);
  font-style: italic;
  color: var(--ink-soft);
}

.note-highlight {
  padding: 0.05em 0.1em;
  border-radius: 2px;
  color: var(--ink);
}

.student-highlight-overlay {
  padding: 0.05em 0.1em;
  border-radius: 2px;
  border-bottom: 2px dotted var(--focus);
  color: var(--ink);
  cursor: help;
}

.highlight-scope-select {
  display: block;
  margin: 0.8rem 1.6rem 0;
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.8rem;
  padding: 0.4rem 0.6rem;
  border: 2px solid var(--focus);
  border-radius: 3px;
  background: var(--card);
  color: var(--ink);
  cursor: pointer;
}

.glossary-term {
  font: inherit;
  color: inherit;
  background: rgba(217, 166, 46, 0.28); background: color-mix(in srgb, var(--brass) 28%, transparent);
  border: none;
  border-bottom: 2px solid var(--brass);
  padding: 0 0.1rem;
  cursor: pointer;
  border-radius: 2px;
  user-select: text;
  -webkit-user-select: text;
}
.glossary-term:hover { background: rgba(217, 166, 46, 0.45); background: color-mix(in srgb, var(--brass) 45%, transparent); }

.word-term {
  font: inherit;
  color: inherit;
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  cursor: pointer;
  user-select: text;
  -webkit-user-select: text;
  text-decoration: underline dotted;
  text-decoration-color: var(--ink-soft);
  text-underline-offset: 2px;
}
.word-term:hover, .word-term:focus-visible {
  text-decoration-color: var(--forest);
  color: var(--forest);
}

.glossary-strip {
  border-top: 2px solid var(--ink);
  padding: 0.8rem 1.6rem;
  font-size: 0.9rem;
  color: var(--ink-soft);
  font-style: italic;
  background: var(--parchment-dim);
}
.glossary-strip.active {
  font-style: normal;
  color: var(--ink);
  display: flex;
  align-items: center;
  gap: 0.8rem;
}
.glossary-strip-img {
  width: 3rem;
  height: 3rem;
  object-fit: cover;
  border: 2px solid var(--ink);
  border-radius: 3px;
  flex: 0 0 auto;
}
.glossary-strip.loading { font-style: italic; }
.glossary-strip-actions {
  margin: 0.4rem 0 0;
  padding-left: 1.2rem;
  font-style: normal;
}
.glossary-strip-actions li { margin-bottom: 0.25rem; }
.glossary-strip strong {
  font-family: var(--font-heading);
  font-weight: 700;
  color: var(--stamp);
  font-style: normal;
}
.glossary-strip .pos {
  font-family: var(--font-heading);
  font-size: 0.75rem;
  color: var(--forest);
  font-style: normal;
}

.modal-video {
  width: 100%;
  max-height: 65vh;
  display: block;
  background: #000;
}
.modal-video-embed {
  width: 100%;
  aspect-ratio: 16 / 9;
  max-height: 65vh;
  display: block;
  border: 0;
  background: #000;
}
.modal-footer {
  padding: 0.6rem 1.2rem;
  border-top: 2px solid var(--ink);
  font-family: var(--font-heading);
  font-size: 0.75rem;
}
.modal-footer a { color: var(--ink-soft); }
.modal-body-questions {
  padding: 0 1.6rem 1.2rem;
  border-top: 2px solid var(--ink);
}
.modal-body-questions .quiz-question:first-child { margin-top: 1rem; }
.modal-footer a:hover { color: var(--stamp); }

/* ---------- Master timeline (horizontal, shared across all lessons) ---------- */
.master-timeline {
  overflow-x: auto;
  overflow-y: hidden;
  padding: 0.6rem 0 1rem;
  margin: 0 -0.4rem;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
}
.timeline-track {
  position: relative;
  padding: 0.4rem 0.4rem 4.4rem;
  min-height: 6rem;
}
.timeline-track::before {
  content: "";
  position: absolute;
  left: 0.4rem;
  right: 0.4rem;
  top: 1.95rem;
  height: 3px;
  background: var(--brass);
}
.timeline-node {
  position: absolute;
  width: 150px;
  padding: 0 0.6rem;
  opacity: 0.45;
  transition: opacity 0.2s ease;
}
.timeline-node.active {
  opacity: 1;
}
.timeline-node.compact {
  width: auto;
  padding: 0;
  margin-top: 1.15rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.25rem;
  cursor: pointer;
  opacity: 0.55;
}
.timeline-node.compact:hover { opacity: 1; }
.timeline-node.compact .timeline-date {
  font-size: 0.62rem;
  margin: 0;
  white-space: nowrap;
}
.timeline-node .timeline-date {
  display: block;
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.72rem;
  color: var(--ink-soft);
  margin-bottom: 0.35rem;
}
.timeline-node.active .timeline-date {
  color: var(--stamp);
  font-weight: 700;
}
.timeline-node .timeline-dot {
  display: block;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--brass);
  border: 2px solid var(--ink);
  margin-bottom: 0.5rem;
  position: relative;
  z-index: 1;
}
.timeline-node.active .timeline-dot {
  background: var(--stamp);
  width: 14px;
  height: 14px;
  box-shadow: 0 0 0 4px rgba(193, 39, 45, 0.2); box-shadow: 0 0 0 4px color-mix(in srgb, var(--stamp) 20%, transparent);
}
.timeline-node .timeline-event {
  display: block;
  font-size: 0.82rem;
  line-height: 1.4;
  color: var(--ink-soft);
}
.timeline-node.active .timeline-event {
  color: var(--ink);
}
.timeline-president-row {
  position: relative;
  height: 2.6rem;
  margin-top: 0.6rem;
  border-top: 2px dashed var(--ink-soft);
  padding-top: 0.5rem;
}
.timeline-president-band {
  position: absolute;
  top: 0.5rem;
  height: 1.9rem;
  display: flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0 0.5rem;
  background: var(--parchment-dim);
  border: 2px solid var(--ink-soft);
  border-radius: 3px;
  overflow: hidden;
  white-space: nowrap;
  cursor: pointer;
  opacity: 0.6;
  transition: opacity 0.2s ease, background 0.2s ease;
}
.timeline-president-band:hover { opacity: 1; background: var(--brass-light); }
.timeline-president-band.active {
  opacity: 1;
  background: var(--stamp);
  border-color: var(--stamp);
}
.timeline-president-band-img {
  width: 1.4rem;
  height: 1.4rem;
  object-fit: cover;
  border-radius: 50%;
  border: 1px solid var(--ink);
  flex: 0 0 auto;
}
.timeline-president-band-name {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.68rem;
  color: var(--ink-soft);
  overflow: hidden;
  text-overflow: ellipsis;
}
.timeline-president-band.active .timeline-president-band-name { color: var(--card); }
.timeline-info-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 0.35rem;
  width: 1.2rem;
  height: 1.2rem;
  border-radius: 50%;
  border: 2px solid var(--ink-soft);
  background: none;
  color: var(--ink-soft);
  font-size: 0.7rem;
  line-height: 1;
  cursor: pointer;
  padding: 0;
}
.timeline-info-btn:hover { border-color: var(--stamp); color: var(--stamp); }
.timeline-node.active .timeline-info-btn { border-color: var(--stamp); color: var(--stamp); }

.empty-note {
  color: var(--ink-soft);
  font-style: italic;
  font-size: 0.9rem;
}

/* ---------- Assessment / self-check questions ---------- */
.quiz-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.quiz-question {
  background: var(--parchment-dim);
  border: 2px solid var(--ink);
  border-left: 6px solid var(--forest);
  padding: 0.9rem 1.1rem 1.1rem;
  margin: 1.2rem 0;
}
.quiz-sequence-progress {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--stamp);
  margin-bottom: 0.4rem;
}
.quiz-sequence-next {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  background: var(--ink);
  color: var(--parchment);
  border: none;
  padding: 0.5rem 0.9rem;
  border-radius: 3px;
  cursor: pointer;
  margin-top: 0.2rem;
}
.quiz-sequence-next:hover { background: var(--stamp); }
.reading-embed-wrap {
  border: 2px solid var(--ink);
  border-radius: 4px;
  overflow: hidden;
  background: var(--parchment-dim);
  display: flex;
  flex-direction: column;
}
/* Embed-only reading (no text at all) — let it fill the whole modal, as before. */
.modal-panel-embed > .reading-embed-wrap {
  margin: 0 1.6rem 1rem;
  flex: 3 1 auto;
  min-height: 0;
}
/* Embed alongside real reading text — fixed, reasonable height so it
   doesn't dominate the modal; being INSIDE the scrollable reading body
   (not a separate sibling) means it scrolls away with the rest of the
   reading instead of staying pinned above it. */
.reading-body .reading-embed-wrap {
  margin: 0 0 1.2rem;
  height: min(50vh, 420px);
  flex-shrink: 0;
}
.reading-embed-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.5rem 0.8rem;
  background: var(--card);
  border-bottom: 2px solid var(--ink);
}
.reading-embed-bar-label {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  color: var(--ink-soft);
}
.reading-embed-open-btn {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.78rem;
  color: var(--card);
  background: var(--stamp);
  border: 2px solid var(--ink);
  border-radius: 3px;
  padding: 0.35rem 0.7rem;
  text-decoration: none;
  cursor: pointer;
}
.reading-embed-open-btn:hover { background: var(--forest); }
.reading-embed {
  display: block;
  width: 100%;
  flex: 1 1 auto;
  min-height: 320px;
  border: none;
}
.reading-body .quiz-question {
  margin: 1.6rem 0;
}
.quiz-kicker {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--forest);
  margin-bottom: 0.4rem;
}
.quiz-prompt {
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 1.05rem;
  margin: 0 0 0.8rem;
}
.quiz-image {
  display: block;
  max-width: 100%;
  max-height: 260px;
  object-fit: contain;
  border: 2px solid var(--ink);
  margin: 0 0 0.9rem;
}
.quiz-term-group {
  display: flex;
  flex-wrap: wrap;
  gap: 0.8rem;
  margin: 0 0 0.9rem;
}
.quiz-term-card {
  display: flex;
  gap: 0.7rem;
  padding: 0.7rem;
  background: var(--parchment-dim);
  border: 2px solid var(--ink);
  border-radius: 4px;
  flex: 1 1 220px;
  max-width: 300px;
}
.quiz-term-card-img {
  width: 4.2rem;
  height: 4.2rem;
  object-fit: cover;
  border: 2px solid var(--ink);
  border-radius: 3px;
  flex: 0 0 auto;
}
.quiz-term-card-body { flex: 1; min-width: 0; }
.quiz-term-card-name {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.85rem;
  margin-bottom: 0.25rem;
}
.quiz-term-card-actions {
  margin: 0;
  padding-left: 1.1rem;
  font-size: 0.78rem;
  color: var(--ink-soft);
}
.quiz-term-card-actions li { margin-bottom: 0.15rem; }
.quiz-objective-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-bottom: 0.6rem;
}
.quiz-objective-tag {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.65rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--card);
  background: var(--forest);
  border-radius: 2px;
  padding: 0.1rem 0.4rem;
}
.quiz-skill-tag { background: var(--stamp); }
.quiz-choices {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.quiz-choice {
  text-align: left;
  font: inherit;
  font-size: 0.94rem;
  background: var(--card);
  border: 2px solid var(--ink);
  border-radius: 3px;
  padding: 0.55rem 0.8rem;
  cursor: pointer;
}
.quiz-choice:hover:not(:disabled) { background: var(--brass-light); }
.quiz-choice:disabled { cursor: default; }
.quiz-choice.correct {
  background: var(--forest);
  border-color: var(--ink);
  color: var(--card);
  font-weight: 700;
}
.quiz-choice.incorrect {
  background: var(--stamp);
  border-color: var(--ink);
  color: var(--card);
}
.quiz-explanation {
  margin: 0.8rem 0 0;
  font-size: 0.9rem;
  font-style: italic;
  color: var(--ink-soft);
}
.quiz-reveal-btn {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  background: var(--ink);
  color: var(--parchment);
  border: none;
  padding: 0.45rem 0.8rem;
  border-radius: 3px;
  cursor: pointer;
}
.quiz-reveal-btn:hover { background: var(--stamp); }

.quiz-answer-input {
  display: block;
  width: 100%;
  font: inherit;
  font-family: var(--font-body);
  font-size: 0.95rem;
  color: var(--ink);
  background: var(--card);
  border: 2px solid var(--ink);
  border-radius: 3px;
  padding: 0.6rem 0.8rem;
  margin-bottom: 0.6rem;
  resize: vertical;
}
.quiz-answer-input:focus { outline: 2px solid var(--focus); outline-offset: 1px; }
.quiz-answer-input:disabled { opacity: 0.6; }

/* ---------- Student ID gate ---------- */
.student-id-overlay {
  position: fixed;
  inset: 0;
  background: var(--ink);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
}
.student-id-panel {
  background: var(--card);
  border: 3px solid var(--ink);
  box-shadow: 6px 6px 0 var(--stamp);
  padding: 2rem 1.8rem;
  max-width: 380px;
  width: 100%;
  text-align: center;
}
.student-id-panel h2 {
  font-family: var(--font-display);
  font-weight: 400;
  text-transform: uppercase;
  font-size: 1.3rem;
  margin: 0 0 0.7rem;
}
.student-id-panel p {
  font-size: 0.9rem;
  color: var(--ink-soft);
  margin: 0 0 1.2rem;
}
.student-id-input {
  display: block;
  width: 100%;
  font-family: var(--font-heading);
  font-size: 1.6rem;
  letter-spacing: 0.4rem;
  text-align: center;
  color: var(--ink);
  background: var(--parchment);
  border: 2px solid var(--ink);
  border-radius: 3px;
  padding: 0.7rem;
  margin-bottom: 0.6rem;
}
.student-id-input:focus { outline: 2px solid var(--focus); outline-offset: 1px; }
.student-id-error {
  color: var(--stamp);
  font-size: 0.8rem;
  min-height: 1.1rem;
  margin: 0 0 0.8rem !important;
}
.student-id-submit {
  width: 100%;
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.9rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  background: var(--stamp);
  color: var(--card);
  border: none;
  padding: 0.7rem;
  border-radius: 3px;
  cursor: pointer;
}
.student-id-submit:hover:not(:disabled) { background: var(--forest); }
.student-id-submit:disabled { opacity: 0.4; cursor: default; }

.quiz-reveal-wrap { margin: 1.2rem 0; }

/* ---------- Rate This Lesson ---------- */
.rating-widget { margin: 2.2rem 0 0.5rem; }
.rate-lesson-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  background: var(--brass);
  color: var(--ink);
  border: 2px solid var(--ink);
  padding: 0.65rem 1rem;
  border-radius: 3px;
  cursor: pointer;
}
.rate-lesson-btn:hover { background: var(--brass-light); }
.rate-lesson-btn i { color: var(--stamp); }
.rating-panel {
  margin-top: 1rem;
  padding: 1.1rem 1.2rem;
  background: var(--parchment-dim);
  border: 2px dashed var(--stamp);
}
.rating-row { margin-bottom: 1.1rem; }
.rating-row:last-of-type { margin-bottom: 0.8rem; }
.rating-row-label {
  display: block;
  font-family: var(--font-body);
  font-weight: 600;
  margin-bottom: 0.5rem;
}
.rating-scale { display: flex; gap: 0.5rem; }
.rating-scale-btn {
  width: 2.4rem;
  height: 2.4rem;
  border-radius: 50%;
  border: 2px solid var(--ink);
  background: var(--card);
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.95rem;
  cursor: pointer;
}
.rating-scale-btn:hover { background: var(--brass-light); }
.rating-scale-btn.selected { background: var(--stamp); border-color: var(--stamp); color: var(--card); }
.rating-scale-caption {
  display: flex;
  justify-content: space-between;
  max-width: 14.5rem;
  margin-top: 0.3rem;
  font-family: var(--font-heading);
  font-size: 0.65rem;
  color: var(--ink-soft);
  text-transform: uppercase;
  letter-spacing: 0.03em;
}
.rating-submit-btn {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  background: var(--ink);
  color: var(--parchment);
  border: none;
  padding: 0.55rem 1rem;
  border-radius: 3px;
  cursor: pointer;
}
.rating-submit-btn:hover:not(:disabled) { background: var(--stamp); }
.rating-submit-btn:disabled { opacity: 0.4; cursor: default; }
.rating-thanks {
  font-style: italic;
  color: var(--forest);
  font-size: 0.9rem;
}

.reading-body .quiz-reveal-wrap { margin: 1.6rem 0; }
.quiz-reveal-question-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  background: var(--parchment-dim);
  color: var(--ink);
  border: 2px dashed var(--stamp);
  padding: 0.65rem 1rem;
  border-radius: 3px;
  cursor: pointer;
  width: 100%;
  text-align: left;
}
.quiz-reveal-question-btn:hover { background: var(--brass-light); }
.quiz-reveal-question-btn i { color: var(--stamp); font-size: 1.1rem; }

/* ---------- My Notes ---------- */
.notes-toggle {
  background: var(--ink);
  color: var(--parchment);
  border: 2px solid var(--ink);
}
.notes-toggle:hover { background: var(--stamp); }
.teacher-view-toggle {
  background: var(--forest);
  border-color: var(--forest);
}
.teacher-view-toggle:hover { background: var(--stamp); border-color: var(--stamp); }
.notes-badge {
  display: none;
  background: var(--brass);
  color: var(--ink);
  border-radius: 999px;
  padding: 0.05rem 0.4rem;
  margin-left: 0.4rem;
  font-size: 0.68rem;
  font-weight: 700;
}

.response-list {
  display: flex;
  flex-direction: column;
  margin-top: 1rem;
}
.response-row {
  display: grid;
  grid-template-columns: 6.5rem 4rem 1fr 1fr 5rem 3rem;
  gap: 0.6rem;
  align-items: start;
  padding: 0.6rem 0;
  border-bottom: 1px dashed var(--rule);
  font-size: 0.82rem;
}
.response-row:last-child { border-bottom: none; }
.response-skill {
  font-family: var(--font-heading);
  font-size: 0.7rem;
  color: var(--stamp);
  text-transform: uppercase;
  letter-spacing: 0.03em;
}
.response-student, .response-lesson {
  font-family: var(--font-heading);
  font-weight: 700;
  color: var(--ink-soft);
}
.response-correct { font-family: var(--font-heading); font-weight: 700; text-align: right; }
.response-correct.yes { color: var(--forest); }
.response-correct.no { color: var(--stamp); }

.save-note-btn {
  position: fixed;
  z-index: 1100;
  background: var(--stamp);
  color: var(--card);
  border: 2px solid var(--ink);
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.72rem;
  padding: 0.45rem 0.7rem;
  border-radius: 3px;
  cursor: pointer;
  box-shadow: 3px 3px 0 var(--ink);
}
.save-note-btn:hover { background: var(--forest); }

.notes-list {
  display: flex;
  flex-direction: column;
}
.note-item {
  padding: 0.9rem 0 0.9rem 0.8rem;
  border-bottom: 2px dashed var(--rule);
  border-left: 5px solid var(--brass);
}
.note-item:last-child { border-bottom: none; }
.note-quote {
  font-family: var(--font-body);
  font-style: italic;
  font-size: 1rem;
  margin: 0 0 0.5rem;
}
.note-label-input {
  display: block;
  width: 100%;
  font: inherit;
  font-family: var(--font-heading);
  font-size: 0.78rem;
  color: var(--ink);
  background: var(--parchment);
  border: 2px solid var(--ink);
  border-radius: 2px;
  padding: 0.3rem 0.5rem;
  margin-bottom: 0.5rem;
}
.note-label-input:focus {
  outline: 2px solid var(--focus);
  outline-offset: 1px;
}
.note-swatches {
  display: flex;
  gap: 0.4rem;
  margin-bottom: 0.5rem;
}
.note-swatch {
  width: 1.2rem;
  height: 1.2rem;
  border-radius: 50%;
  border: 2px solid var(--ink);
  cursor: pointer;
  padding: 0;
}
.note-swatch.selected {
  box-shadow: 0 0 0 2px var(--card), 0 0 0 4px var(--ink);
}
.note-remove {
  margin-top: 0.4rem;
  background: none;
  border: none;
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--stamp);
  cursor: pointer;
  padding: 0;
}
.note-remove:hover { text-decoration: underline; }
.notes-body { padding: 1.2rem 1.6rem 1.6rem; }

.teacher-tabs {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 1rem;
  border-bottom: 2px solid var(--rule);
}
.teacher-tab {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  background: none;
  border: none;
  padding: 0.6rem 0.3rem;
  cursor: pointer;
  color: var(--ink-soft);
  border-bottom: 3px solid transparent;
  margin-bottom: -2px;
}
.teacher-tab:hover { color: var(--ink); }
.teacher-tab.active { color: var(--stamp); border-bottom-color: var(--stamp); }

.picker-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 1.2rem;
  border-bottom: 2px solid var(--rule);
}
.picker-tab {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  background: none;
  border: none;
  padding: 0.6rem 0.3rem;
  cursor: pointer;
  color: var(--ink-soft);
  border-bottom: 3px solid transparent;
  margin-bottom: -2px;
}
.picker-tab:hover { color: var(--ink); }
.picker-tab.active { color: var(--stamp); border-bottom-color: var(--stamp); }

.annotation-filter-row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-heading);
  font-size: 0.82rem;
  color: var(--ink-soft);
  cursor: pointer;
  margin-bottom: 0.6rem;
}
.annotation-filter-row input[type="checkbox"] {
  width: 1.1rem;
  height: 1.1rem;
  accent-color: var(--stamp);
  cursor: pointer;
}
.annotation-filter-row input[type="checkbox"]:disabled { cursor: default; opacity: 0.5; }

.annotation-filter-row-extra {
  flex-wrap: wrap;
  cursor: default;
  margin-bottom: 1rem;
  padding-bottom: 0.8rem;
  border-bottom: 2px dashed var(--ink-soft);
}
.annotation-filter-row-extra label {
  font-weight: 600;
}
.annotation-filter-row-extra select,
.annotation-filter-row-extra input[type="date"] {
  font-family: var(--font-heading);
  font-size: 0.8rem;
  padding: 0.3rem 0.5rem;
  border: 2px solid var(--ink);
  border-radius: 3px;
  background: var(--parchment);
  color: var(--ink);
}
.teacher-privacy-row {
  padding-bottom: 0.8rem;
  margin-bottom: 1rem;
  border-bottom: 2px dashed var(--ink-soft);
}

.annotation-summary {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin: 0.8rem 0 1.2rem;
  padding: 0.9rem 1rem;
  background: var(--parchment-dim);
  border: 2px solid var(--ink);
  border-radius: 4px;
}
.annotation-summary-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 0.4rem;
}
.annotation-summary-chip {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-family: var(--font-heading);
  font-size: 0.78rem;
  font-weight: 600;
  background: var(--card);
  border: 2px solid var(--ink);
  border-radius: 20px;
  padding: 0.25rem 0.7rem;
}
.annotation-summary-count {
  font-weight: 700;
  color: var(--stamp);
}
.annotation-summary-quotes {
  margin: 0.4rem 0 0;
  padding-left: 1.2rem;
  font-size: 0.85rem;
  line-height: 1.5;
}
.annotation-summary-quotes li { margin-bottom: 0.4rem; font-style: italic; }
.annotation-summary-quotes .annotation-summary-count { font-style: normal; margin-right: 0.2rem; }

.annotation-row { grid-template-columns: 6.5rem 3.2rem 6rem 1fr; }
.annotation-label-chip {
  font-family: var(--font-heading);
  font-size: 0.68rem;
  font-weight: 700;
  color: var(--card);
  padding: 0.15rem 0.5rem;
  border-radius: 3px;
  align-self: start;
  text-align: center;
}
.annotation-thumb {
  max-width: 100%;
  max-height: 3.6rem;
  border: 2px solid var(--ink);
  border-radius: 3px;
}

/* ---------- Change Lesson picker ---------- */
.lesson-picker-unit { margin-bottom: 1.3rem; }
.lesson-picker-unit:last-child { margin-bottom: 0; }
.lesson-picker-teacher-tools {
  margin-bottom: 0.4rem;
}
.teacher-tools-links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  margin-bottom: 1.2rem;
  padding-bottom: 1rem;
  border-bottom: 3px double var(--ink);
}
.teacher-tool-link {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  background: var(--forest);
  color: var(--card);
  border: none;
  padding: 0.6rem 1rem;
  border-radius: 3px;
  text-decoration: none;
  display: inline-block;
}
.teacher-tool-link:hover { background: var(--stamp); }

.lesson-picker-unit-title {
  font-family: var(--font-display);
  font-weight: 400;
  text-transform: uppercase;
  font-size: 0.95rem;
  color: var(--stamp);
  border-bottom: 2px solid var(--rule);
  padding-bottom: 0.4rem;
  margin-bottom: 0.6rem;
}
.lesson-picker-lessons {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}
.lesson-picker-item {
  display: flex;
  align-items: baseline;
  gap: 0.7rem;
  width: 100%;
  text-align: left;
  background: none;
  border: none;
  border-radius: 3px;
  padding: 0.5rem 0.6rem;
  cursor: pointer;
  font: inherit;
}
.lesson-picker-item:hover { background: var(--parchment-dim); }
.lesson-picker-item.active { background: rgba(193, 39, 45, 0.12); background: color-mix(in srgb, var(--stamp) 12%, transparent); }
.lesson-picker-number {
  flex: 0 0 auto;
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.78rem;
  color: var(--brass);
  min-width: 2.4rem;
}
.lesson-picker-title {
  font-family: var(--font-body);
  font-size: 0.95rem;
}
.lesson-picker-item.active .lesson-picker-title { font-weight: 600; }

.hidden { display: none; }


.save-toast {
  position: fixed;
  bottom: 1.2rem;
  left: 50%;
  transform: translateX(-50%) translateY(10px);
  background: var(--ink);
  color: var(--parchment);
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.78rem;
  padding: 0.5rem 0.9rem;
  border-radius: 3px;
  opacity: 0;
  transition: opacity 0.2s ease, transform 0.2s ease;
  z-index: 1200;
}
.save-toast.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

/* ---------- Save-to-notes bottom sheet ---------- */
.save-sheet-overlay {
  position: fixed;
  inset: 0;
  background: rgba(26, 21, 18, 0.62); background: color-mix(in srgb, var(--ink) 62%, transparent);
  z-index: 1300;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0;
}
.save-sheet {
  background: var(--card);
  width: 100%;
  max-width: 480px;
  border-radius: 12px 12px 0 0;
  padding: 0.8rem 1.2rem 1.4rem;
  border-top: 4px solid var(--ink);
  box-shadow: 0 -6px 0 var(--rule);
}
.save-sheet-handle {
  width: 40px;
  height: 4px;
  background: var(--rule);
  border-radius: 2px;
  margin: 0 auto 0.9rem;
}
.save-sheet-quote {
  font-family: var(--font-body);
  font-style: italic;
  font-size: 0.95rem;
  color: var(--ink-soft);
  margin: 0 0 0.9rem;
}
.save-sheet .note-label-input { margin-bottom: 0.7rem; }
.save-sheet-actions {
  display: flex;
  justify-content: flex-end;
  gap: 0.6rem;
  margin-top: 0.9rem;
}
.sheet-btn {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  padding: 0.55rem 1rem;
  border: none;
  border-radius: 3px;
  cursor: pointer;
}
.sheet-cancel { background: none; color: var(--ink-soft); }
.sheet-cancel:hover { color: var(--ink); }
.sheet-save { background: var(--stamp); color: var(--card); }
.sheet-save:hover { background: var(--forest); }

/* ---------- Notes filter bar ---------- */
.notes-filter-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  padding-bottom: 1rem;
  margin-bottom: 0.4rem;
  border-bottom: 2px solid var(--ink);
}
.notes-filter {
  font-family: var(--font-heading);
  font-size: 0.75rem;
  color: var(--ink);
  background: var(--parchment);
  border: 2px solid var(--ink);
  border-radius: 2px;
  padding: 0.35rem 0.5rem;
}
.notes-filter-clear {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.75rem;
  color: var(--stamp);
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.35rem 0.2rem;
}
.notes-filter-clear:hover { text-decoration: underline; }
.notes-filter-clear:disabled { opacity: 0.5; cursor: default; text-decoration: none; }

/* ---------- Label picker (used in save sheet + My Notes editing) ---------- */
.label-picker {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 0.6rem;
}
.label-picker-select {
  font-family: var(--font-heading);
  font-size: 0.78rem;
  color: var(--ink);
  background: var(--parchment);
  border: 2px solid var(--ink);
  border-radius: 2px;
  padding: 0.35rem 0.5rem;
}
.label-color-preview {
  display: inline-block;
  width: 1.1rem;
  height: 1.1rem;
  border-radius: 50%;
  border: 2px solid var(--ink);
  vertical-align: middle;
}
.label-picker .note-label-input {
  flex: 1 1 140px;
  margin-bottom: 0;
}
.label-picker .note-swatches {
  margin-bottom: 0;
}

.note-label-row {
  display: flex;
  align-items: baseline;
  gap: 0.6rem;
  margin-bottom: 0.45rem;
}
.note-label-title {
  font-family: var(--font-heading);
  font-size: 0.76rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  font-weight: 700;
  color: var(--stamp);
}
.note-label-title.empty {
  color: var(--ink-soft);
  font-style: italic;
  text-transform: none;
  font-weight: 400;
  letter-spacing: normal;
}
.note-label-edit-btn {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  background: none;
  border: none;
  color: var(--focus);
  cursor: pointer;
  padding: 0;
}
.note-label-edit-btn:hover { text-decoration: underline; }
.note-label-edit-slot { margin-bottom: 0.6rem; }

/* ---------- Lesson nav (Previous / Next) ---------- */
.lesson-nav {
  display: flex;
  justify-content: space-between;
  gap: 0.8rem;
  margin-top: 2.2rem;
  padding-top: 1.2rem;
  border-top: 3px solid var(--ink);
}
.nav-btn {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  background: var(--ink);
  color: var(--parchment);
  border: 2px solid var(--ink);
  padding: 0.6rem 1rem;
  cursor: pointer;
  border-radius: 2px;
  box-shadow: 3px 3px 0 var(--brass);
}
.nav-btn:hover:not(:disabled) { background: var(--stamp); box-shadow: 3px 3px 0 var(--ink); }
.nav-btn:disabled {
  opacity: 0.35;
  cursor: default;
  box-shadow: none;
}
.nav-prev { margin-right: auto; }
.nav-next { margin-left: auto; }
.step-count {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.78rem;
  color: var(--ink-soft);
  align-self: center;
}

.loading-spinner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  padding: 4rem 1rem;
  font-family: var(--font-heading);
  font-size: 0.9rem;
  color: var(--ink-soft);
}
.loading-spinner i {
  font-size: 1.3rem;
  color: var(--stamp);
  animation: var(--loading-anim, loading-pageflip) var(--loading-dur, 1.1s) ease-in-out infinite;
  display: inline-block;
}
.loading-spinner i::before { content: var(--loading-glyph, "\f5da"); }
@keyframes loading-pageflip {
  0%, 100% { transform: scale(1) rotate(0deg); opacity: 0.75; }
  50% { transform: scale(1.12) rotate(-4deg); opacity: 1; }
}

@media (max-width: 480px) {
  .case-file h1 { max-width: 100%; }
}


/* ---------- icons on units and lessons ---------- */
.lesson-picker-icon { width: 64px; height: 64px; object-fit: cover; border-radius: 10px; border: 2px solid var(--ink); flex: 0 0 auto; margin-right: 0.6rem; }
.picker-unit-icon { width: 48px; height: 48px; object-fit: cover; border-radius: 8px; border: 2px solid var(--ink); vertical-align: middle; margin-right: 0.5rem; }
.picker-tab-icon { width: 32px; height: 32px; object-fit: cover; border-radius: 6px; vertical-align: middle; margin-right: 0.3rem; }
.banner-icon { width: 36px; height: 36px; object-fit: cover; border-radius: 6px; vertical-align: middle; margin-right: 0.4rem; }
.lesson-title-icon { display: block; width: 104px; height: 104px; object-fit: cover; border-radius: 14px; border: 3px solid var(--ink); margin-bottom: 0.5rem; }

/* ---------- pinned + merged key terms ---------- */
.pinned-terms { flex: 0 0 auto; border-top: 2px solid var(--ink); background: var(--parchment-dim); }
.pinned-terms-toggle { width: 100%; text-align: left; font-family: var(--font-heading); font-weight: 700; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; background: none; border: none; padding: 0.55rem 1rem; cursor: pointer; color: var(--stamp); }
.pinned-terms-body { max-height: 30vh; overflow-y: auto; padding: 0 1rem 0.8rem; display: flex; flex-direction: column; gap: 0.6rem; }
.term-card { background: var(--card); border: 2px solid var(--ink); border-left: 6px solid var(--brass); padding: 0.6rem 0.8rem; }
.term-card-member { display: flex; gap: 0.7rem; align-items: flex-start; }
.term-card-member + .term-card-member { margin-top: 0.6rem; padding-top: 0.6rem; border-top: 1px dashed var(--ink-soft); }
.term-card-img { width: 48px; height: 48px; object-fit: cover; border-radius: 6px; border: 2px solid var(--ink); flex: 0 0 auto; }
.term-card-name { font-family: var(--font-heading); font-size: 0.9rem; }
.term-card-desc, .term-card-list { margin: 0.2rem 0 0; font-size: 0.88rem; line-height: 1.45; }
.term-card-list { padding-left: 1.1rem; }
.mention-member-name { font-family: var(--font-heading); margin: 1.2rem 0 0.4rem; padding-top: 0.8rem; border-top: 2px solid var(--ink); }
.mention-member-name:first-child { border-top: none; padding-top: 0; margin-top: 0; }
.glossary-strip-block + .glossary-strip-block { margin-top: 0.6rem; padding-top: 0.6rem; border-top: 1px dashed var(--ink-soft); }

/* ---------- resource sets ---------- */
.source-set { border: 2px solid var(--ink); border-radius: 4px; background: var(--parchment-dim); margin: 0.6rem 0; }
.source-set-toggle { width: 100%; display: flex; align-items: center; gap: 0.7rem; text-align: left; background: var(--card); border: none; border-bottom: 2px solid var(--ink); padding: 0.6rem 0.9rem; cursor: pointer; font-family: var(--font-heading); }
.source-set-name { font-weight: 700; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.03em; flex: 1; }
.source-set-count { font-size: 0.72rem; color: var(--ink-soft); }
.source-set-body { padding: 0.4rem 0.8rem 0.6rem; }

/* ---------- starred students (Teacher View) ---------- */
.star-btn { background: none; border: none; cursor: pointer; font-size: 1.05rem; line-height: 1; padding: 0 0.25rem 0 0; color: var(--ink-soft); }
.star-btn.starred { color: var(--brass); text-shadow: 0 0 0 var(--ink); }
.star-btn:hover { color: var(--brass); }
.starred-only-label { display: inline-flex; align-items: center; gap: 0.3rem; cursor: pointer; }

/* teacher password step reuses the student-id panel */
.student-id-back { display: block; margin: 0.6rem auto 0; background: none; border: none; text-decoration: underline; cursor: pointer; font-family: var(--font-heading); color: var(--ink-soft); }

/* ---------- student pin buttons ---------- */
.pin-btn { display: inline-flex; align-items: center; gap: 0.25rem; margin-left: 0.5rem; font-family: var(--font-heading); font-weight: 600; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.03em; background: var(--card); color: var(--ink-soft); border: 2px solid var(--ink-soft); border-radius: 14px; padding: 0.15rem 0.6rem; cursor: pointer; vertical-align: middle; }
.pin-btn:hover { border-color: var(--stamp); color: var(--stamp); }
.pin-btn.pinned { background: var(--stamp); border-color: var(--stamp); color: var(--card); }
.mention-body .pin-btn { display: flex; margin: 0.6rem 0; width: fit-content; }
.term-card { position: relative; }
.term-card-unpin { position: absolute; top: 0.3rem; right: 0.4rem; background: none; border: none; cursor: pointer; font-size: 0.9rem; color: var(--ink-soft); line-height: 1; padding: 0.2rem; }
.term-card-unpin:hover { color: var(--stamp); }

/* ---------- classmates' answers + reactions ---------- */
.classmate-answers { margin-top: 1rem; border-top: 2px dashed var(--ink-soft); padding-top: 0.8rem; }
.classmate-answers-title { font-family: var(--font-heading); font-weight: 700; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--forest); margin-bottom: 0.5rem; }
.classmate-empty { font-size: 0.85rem; color: var(--ink-soft); margin: 0; }
.classmate-answer { background: var(--parchment-dim); border: 2px solid var(--ink); border-left: 6px solid var(--forest); padding: 0.6rem 0.8rem; margin-bottom: 0.6rem; }
.classmate-answer-text { margin: 0 0 0.5rem; line-height: 1.45; white-space: pre-wrap; }
.classmate-reactions { display: flex; flex-wrap: wrap; gap: 0.4rem; }
.reaction-btn { font-family: var(--font-heading); font-size: 0.75rem; background: var(--card); border: 2px solid var(--ink-soft); border-radius: 14px; padding: 0.2rem 0.7rem; cursor: pointer; color: var(--ink); }
.reaction-btn:hover { border-color: var(--forest); }
.reaction-btn.active { background: var(--forest); border-color: var(--forest); color: var(--card); }
.star-btn.sheet-starred { cursor: default; }

/* ---------- key-term groups: side by side in a resource popup ---------- */
.term-groups { margin: 0 0 1rem; }
.modal-panel > .term-groups { flex: 0 0 auto; max-height: 34vh; overflow-y: auto; margin: 0; padding: 0.6rem 1rem 0; border-top: 2px solid var(--ink); }
.term-group { border: 2px solid var(--ink); background: var(--parchment-dim); margin-bottom: 0.7rem; }
.term-group-toggle { width: 100%; display: flex; align-items: center; gap: 0.7rem; text-align: left; background: var(--card); border: none; border-bottom: 2px solid var(--ink); padding: 0.5rem 0.8rem; cursor: pointer; font-family: var(--font-heading); }
.term-group-name { font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--forest); flex: 1; }
.term-group-count { font-size: 0.72rem; color: var(--ink-soft); }
.term-group-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 0.6rem; padding: 0.6rem; }
.term-group-card { background: var(--card); border: 2px solid var(--ink); border-top: 5px solid var(--forest); padding: 0.6rem 0.7rem; }
.term-group-card .pin-btn { margin: 0.5rem 0 0; }

.term-group-warning { background: #fff3cd; border: 2px solid var(--brass); color: var(--ink); font-size: 0.82rem; padding: 0.5rem 0.7rem; margin-bottom: 0.7rem; line-height: 1.4; }

/* larger icons stay reasonable on small phones */
@media (max-width: 480px) {
  .lesson-picker-icon { width: 52px; height: 52px; }
  .picker-unit-icon { width: 40px; height: 40px; }
  .lesson-title-icon { width: 84px; height: 84px; }
}
.lesson-picker-item.has-icon { align-items: center; }
.picker-tab { display: inline-flex; align-items: center; }

/* ---------- Sources layout toggle: list / gallery ---------- */
.source-view-toggle { display: inline-flex; border: 2px solid var(--ink); border-radius: 4px; overflow: hidden; margin: 0.6rem 0 1rem; }
.sources-box > .source-view-toggle { display: flex; width: 100%; margin: 0; border: none; border-radius: 0; border-bottom: 2px solid var(--ink); background: var(--parchment-dim); }
.sources-box > .source-view-toggle .source-view-btn { flex: 1; background: transparent; }
.sources-box > .source-view-toggle .source-view-btn.active { background: var(--ink); }
.source-view-btn { font-family: var(--font-heading); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; padding: 0.3rem 0.8rem; background: var(--card); color: var(--ink-soft); border: none; cursor: pointer; }
.source-view-btn + .source-view-btn { border-left: 2px solid var(--ink); }
.source-view-btn.active { background: var(--ink); color: var(--card); }
.sources-box {
  border: 2px solid var(--ink);
  border-radius: 4px;
  background: var(--card);
  overflow: hidden;
  margin-top: 2rem;
}
.sources-box .source-list { padding: 0.9rem 1rem 0.2rem; }
.sources-box .source-list.gallery { padding: 0.9rem; }
.sources-box .source-item:last-child { border-bottom: none; }
.source-icon-placeholder { display: none; }

.source-list.gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 0.8rem; }
.source-list.gallery .source-item { flex-direction: column; align-items: stretch; gap: 0.5rem; padding: 0; background: var(--card); border: 2px solid var(--ink); cursor: pointer; }
.source-list.gallery .source-item:hover { box-shadow: 0 0 0 2px var(--brass) inset; }
.source-list.gallery .source-item:last-child { border-bottom: 2px solid var(--ink); }
.source-list.gallery .source-icon { width: 100%; height: 100px; border-radius: 0; border: none; border-bottom: 2px solid var(--ink); margin: 0; object-fit: contain; background: var(--ink); }
.source-list.gallery .source-icon-placeholder { display: flex; align-items: center; justify-content: center; height: 100px; font-size: 1.8rem; color: var(--ink-soft); background: var(--parchment-dim); border-bottom: 2px solid var(--ink); }
.source-list.gallery .source-item-text { padding: 0 0.6rem 0.6rem; }
.source-list.gallery .source-set { grid-column: 1 / -1; margin: 0; }
.source-list.gallery .source-set-body { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 0.8rem; padding: 0.8rem; }

.do-now-masthead-btn i { color: var(--stamp); }

/* ---------- Teacher View: Themes tab ---------- */
.themes-section { display: flex; flex-direction: column; gap: 0.7rem; }
.themes-intro { font-size: 0.88rem; color: var(--ink-soft); margin: 0 0 0.3rem; line-height: 1.45; }
.theme-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 0.9rem; padding: 0.6rem 0.8rem; background: var(--parchment-dim); border: 2px solid var(--ink); }
.theme-row-label { font-family: var(--font-heading); font-weight: 700; font-size: 0.85rem; flex: 1 1 14rem; }
.theme-row-label small { font-weight: 500; color: var(--stamp); margin-left: 0.4rem; text-transform: uppercase; letter-spacing: 0.04em; }
.theme-select { font: inherit; font-size: 0.85rem; padding: 0.3rem 0.5rem; border: 2px solid var(--ink); background: var(--card); color: var(--ink); }
.theme-swatches { display: inline-flex; border: 2px solid var(--ink); }
.theme-swatch { width: 18px; height: 22px; display: inline-block; }
.theme-status { font-size: 0.75rem; color: var(--forest); flex: 1 1 100%; min-height: 1em; }

.theme-preview { display: inline-flex; align-items: center; gap: 0.6rem; }
.theme-mini { display: inline-flex; flex-direction: column; width: 86px; height: 56px; border: 2px solid var(--ink); overflow: hidden; }
.theme-mini-bar { display: flex; align-items: center; justify-content: flex-end; height: 14px; padding: 0 4px; }
.theme-mini-dot { width: 6px; height: 6px; border-radius: 50%; }
.theme-mini-card { display: flex; flex-direction: column; gap: 3px; margin: 5px 6px; padding: 4px 5px; border: 1.5px solid var(--ink); flex: 1; }
.theme-mini-line { height: 3px; width: 100%; }
.theme-mini-line.short { width: 60%; }
.theme-mini-tag { height: 5px; width: 22px; }

/* ---------- reactions to my own answers + My Answers ---------- */
.my-answer-reactions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; margin: 0.4rem 0 0.7rem; font-size: 0.82rem; }
.my-reaction-label { font-family: var(--font-heading); font-weight: 600; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--forest); }
.my-reaction-chip { background: var(--forest); color: var(--card); border-radius: 14px; padding: 0.15rem 0.7rem; font-family: var(--font-heading); font-size: 0.75rem; }
.my-reaction-none { color: var(--ink-soft); font-size: 0.8rem; }
.my-answers-intro { font-size: 0.88rem; color: var(--ink-soft); margin: 0 0 1rem; }
.my-answers-lesson { margin-bottom: 1.4rem; }
.my-answers-lesson-title { font-family: var(--font-heading); font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.03em; color: var(--stamp); border-bottom: 2px solid var(--rule); padding-bottom: 0.3rem; margin: 0 0 0.6rem; }
.my-answer-item { background: var(--parchment-dim); border: 2px solid var(--ink); border-left: 6px solid var(--forest); padding: 0.6rem 0.8rem; margin-bottom: 0.6rem; }
.my-answer-prompt { font-weight: 600; margin: 0 0 0.3rem; }
.my-answer-text { margin: 0 0 0.3rem; white-space: pre-wrap; line-height: 1.45; }
.my-answers-masthead-btn i { color: var(--forest); }

/* ---------- answer moderation: hide / require approval ---------- */
.moderation-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; grid-column: 1 / -1; margin-top: 0.3rem; }
.moderation-btn { font-family: var(--font-heading); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.03em; background: var(--card); border: 2px solid var(--ink-soft); border-radius: 14px; padding: 0.15rem 0.65rem; cursor: pointer; color: var(--ink); }
.moderation-btn:hover { border-color: var(--stamp); }
.moderation-btn.active { background: var(--stamp); border-color: var(--stamp); color: var(--card); }
.moderation-badge { font-family: var(--font-heading); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.03em; border-radius: 14px; padding: 0.15rem 0.65rem; }
.moderation-badge.pending { background: #fff3cd; color: #7a5a00; border: 2px solid var(--brass); }
.moderation-badge.approved { background: var(--forest); color: var(--card); }
.my-reaction-note { color: var(--ink-soft); font-size: 0.8rem; font-style: italic; }

/* ---------- wide-screen mode (large displays / smartboards) ---------- */
[data-wide="1"] .masthead-row { max-width: 1700px; }
[data-wide="1"] main { max-width: 1500px; font-size: 1.12rem; }
[data-wide="1"] .case-file h1 { font-size: 2.5rem; }

.wide-mode-toggle {
  position: fixed;
  right: 1rem;
  bottom: 1rem;
  z-index: 500;
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-family: var(--font-heading);
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  background: var(--ink);
  color: var(--card);
  border: 2px solid var(--card);
  border-radius: 20px;
  padding: 0.45rem 0.9rem;
  cursor: pointer;
  box-shadow: 0 2px 8px var(--shadow);
}
.wide-mode-toggle:hover { background: var(--stamp); }
.wide-mode-toggle.active { background: var(--forest); }
@media (max-width: 700px) {
  .wide-mode-toggle { display: none; } /* a phone or tablet screen is never the "wide display" case this is for */
}

/* ---------- masthead's expanded lesson header ---------- */
.masthead-expanded {
  max-width: 1100px;
  margin: 0.5rem auto 0;
  transition: margin-top 0.3s ease;
}
.masthead-expanded:empty { display: none; margin-top: 0; }
.masthead.collapsed .masthead-expanded { margin-top: 0.3rem; }
.masthead-expanded-inner {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 2.2rem;
}
/* Neither column grows to fill leftover space -- each just takes its own
   natural content width (shrinking if needed on a narrower screen), so
   they sit close together instead of being stretched to opposite ends of
   the row. This also fixes the collapsed state: once the left column's
   VISIBLE content shrinks to nothing (see the max-height rules below), it
   no longer drags the right column along with it to a distant edge. */
.masthead-expanded-left {
  flex: 0 1 auto;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 1.1rem;
}
.masthead-expanded-titlewrap { min-width: 0; }
.masthead-expanded-right {
  flex: 0 1 560px;
  max-width: 560px;
  min-width: 0;
  display: flex;
  gap: 1.3rem;
}
.masthead-expanded-right .inquiry-block,
.masthead-expanded-right .objectives-block {
  flex: 1 1 0;
  min-width: 0;
}
@media (max-width: 800px) {
  .masthead-expanded-inner { flex-direction: column; gap: 0.4rem; }
  .masthead-expanded-right { max-width: 100%; }
}
@media (max-width: 560px) {
  .masthead-expanded-right { flex-direction: column; gap: 0.4rem; } /* even side by side gets too tight below this */
}

/* Icon, lesson number, and the big title fade/shrink away on collapse --
   each has its own small, close-to-actual-content max-height (not one
   oversized guess for the whole block), so the transition covers only
   real, visible height and reads as smooth rather than snapping shut. */
.masthead-expanded .lesson-title-icon,
.masthead-expanded .lesson-number,
.masthead-expanded h1 {
  overflow: hidden;
  transition: max-height 0.3s ease, opacity 0.25s ease, margin 0.3s ease;
}
.masthead-expanded .lesson-title-icon { max-height: 140px; }
.masthead-expanded .lesson-number { max-height: 2rem; }
.masthead-expanded h1 { max-height: 6.5rem; }
.masthead.collapsed .masthead-expanded .lesson-title-icon,
.masthead.collapsed .masthead-expanded .lesson-number,
.masthead.collapsed .masthead-expanded h1 {
  max-height: 0;
  opacity: 0;
  margin: 0;
  pointer-events: none;
}

.masthead-expanded .lesson-number {
  display: block;
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.74rem;
  letter-spacing: 0.05em;
  color: var(--brass-light);
  margin-bottom: 0.1rem;
}
.masthead-expanded h1 {
  font-family: var(--font-display);
  font-weight: 400;
  text-transform: uppercase;
  letter-spacing: 0.01em;
  font-size: clamp(1.5rem, 3vw, 2.4rem);
  color: var(--card);
  margin: 0;
  line-height: 1.08;
}
.masthead-expanded .lesson-title-icon { width: clamp(76px, 11vw, 132px); height: clamp(76px, 11vw, 132px); object-fit: cover; border-radius: 12px; border-color: var(--card); margin-bottom: 0; flex: 0 0 auto; }

/* Course Inquiry and Learning Objectives stay visible when collapsed --
   just smaller, so the student never loses that context while reading. */
.masthead-expanded .inquiry-block {
  border-left-color: var(--brass-light);
  margin: 0;
  padding-left: 0.7rem;
  transition: margin 0.25s ease, padding-left 0.25s ease, border-left-width 0.25s ease;
}
.masthead-expanded .inquiry-kicker {
  color: var(--brass-light);
  transition: font-size 0.25s ease, margin-bottom 0.25s ease;
}
.masthead-expanded .inquiry-text, .masthead-expanded .inquiry-list {
  color: rgba(255, 255, 255, 0.88);
  font-size: 1rem;
  transition: font-size 0.25s ease;
}
.masthead-expanded .section-title {
  margin: 0 0 0.4rem;
  font-size: 0.8rem;
  padding: 0.3rem 0.8rem;
  transition: font-size 0.25s ease, padding 0.25s ease, margin 0.25s ease;
}
.masthead-expanded .objectives-list {
  color: var(--card);
  gap: 0.3rem;
  transition: gap 0.25s ease;
}
.masthead-expanded .objectives-list li {
  font-size: 1rem;
  transition: font-size 0.25s ease, padding-left 0.25s ease;
}
.masthead-expanded .objectives-list li::before { color: var(--brass-light); }

/* The inquiry/objectives column now fully hides on collapse, matching
   the title column beside it -- its job is taken over by the compact
   row-strip version below, which sits parallel to the compact title
   instead of in a separate block underneath it. */
.masthead-expanded-right {
  overflow: hidden;
  max-height: 10rem;
  opacity: 1;
  transition: max-height 0.3s ease, opacity 0.25s ease;
}
.masthead.collapsed .masthead-expanded-right {
  max-height: 0;
  opacity: 0;
  pointer-events: none;
}

/* ---------- compact inquiry/objectives strip (collapsed state only) ---------- */
/* Lives in the masthead's top row, parallel to the compact lesson title
   (#lesson-banner) -- hidden while expanded (the full version below
   handles that), shown as one short row once collapsed. */
.masthead-row-inquiry {
  flex: 1 1 0;
  min-width: 0;
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transition: max-height 0.3s ease, opacity 0.2s ease;
}
.masthead.collapsed .masthead-row-inquiry { max-height: 8rem; opacity: 1; }
.masthead-row-inquiry-inner { display: flex; gap: 1.1rem; align-items: baseline; }
.masthead-row-inquiry .inquiry-block,
.masthead-row-inquiry .objectives-block {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 0.35rem;
  flex: 1 1 0;
  min-width: 0;
  padding-left: 0.5rem;
  border-left: 2px solid var(--brass-light);
}
.masthead-row-inquiry .inquiry-kicker,
.masthead-row-inquiry .section-title {
  flex: 0 0 auto;
  font-size: 0.62rem;
  margin: 0;
  padding: 0;
  background: none; /* the black "tab" look is for the full-page body; inline here it's just a label */
  color: var(--brass-light);
}
.masthead-row-inquiry .inquiry-text,
.masthead-row-inquiry .inquiry-list,
.masthead-row-inquiry .objectives-list {
  flex: 1 1 auto;
  min-width: 0;
  margin: 0;
  gap: 0;
  display: block;
}
.masthead-row-inquiry .inquiry-text,
.masthead-row-inquiry .inquiry-list li,
.masthead-row-inquiry .objectives-list li {
  font-size: 0.76rem;
  color: rgba(255, 255, 255, 0.88);
  padding-left: 0; /* no bullet marker needed inline */
}
.masthead-row-inquiry .inquiry-list li::before,
.masthead-row-inquiry .objectives-list li::before { display: none; }
/* Only the first inquiry/objective shows -- the point is a single line
   each, parallel to the compact title; the full lists are one scroll
   back to the top away. */
.masthead-row-inquiry .inquiry-list li:not(:first-child),
.masthead-row-inquiry .objectives-list li:not(:first-child) { display: none; }
@media (max-width: 900px) {
  .masthead-row-inquiry { display: none; } /* no room for a third item on this row below this width -- the expanded view (scroll to top) still has it in full */
}

/* ---------- clickable Course Inquiry -> jump to other lessons ---------- */
.inquiry-jump-btn {
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  font: inherit;
  color: inherit;
  text-align: left;
  cursor: pointer;
  text-decoration: underline;
  text-decoration-color: transparent;
  text-underline-offset: 2px;
  transition: text-decoration-color 0.15s ease;
}
.inquiry-jump-btn:hover, .inquiry-jump-btn:focus-visible { text-decoration-color: currentColor; }
.inquiry-jump-list { display: flex; flex-direction: column; gap: 0.7rem; }
.inquiry-jump-item {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  width: 100%;
  text-align: left;
  background: var(--parchment-dim);
  border: 2px solid var(--ink);
  border-left: 6px solid var(--forest);
  padding: 0.6rem 0.8rem;
  cursor: pointer;
  font: inherit;
  color: inherit;
}
.inquiry-jump-item:hover { background: var(--card); }
.inquiry-jump-text { display: flex; flex-direction: column; gap: 0.15rem; }
.inquiry-jump-unit { font-family: var(--font-heading); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--forest); }
.inquiry-jump-lesson { font-family: var(--font-heading); font-weight: 600; font-size: 0.95rem; }


/* ---------- key terms: List / Tabs ---------- */
.terms-view-toggle { display: flex; width: 100%; border-bottom: 2px solid var(--ink); background: var(--parchment-dim); }
.terms-view-btn { flex: 1; font-family: var(--font-heading); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; padding: 0.3rem 0.8rem; background: transparent; color: var(--ink-soft); border: none; cursor: pointer; }
.terms-view-btn + .terms-view-btn { border-left: 2px solid var(--ink); }
.terms-view-btn.active { background: var(--ink); color: var(--card); }
.terms-box .terms-box-body { padding: 0.9rem 1rem 1rem; }
.terms-tabs { display: flex; flex-wrap: wrap; gap: 0.3rem; border-bottom: 2px solid var(--ink); margin-bottom: 0.9rem; }
.terms-tab {
  font-family: var(--font-heading); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em;
  padding: 0.4rem 0.8rem; background: var(--parchment-dim); color: var(--ink-soft);
  border: 2px solid var(--ink); border-bottom: none; border-radius: 4px 4px 0 0;
  cursor: pointer; margin-bottom: -2px;
}
.terms-tab:hover { background: var(--brass-light); color: var(--ink); }
.terms-tab.active { background: var(--card); color: var(--ink); border-bottom: 2px solid var(--card); font-weight: 700; }
.terms-tab-count { margin-left: 0.45rem; font-size: 0.68rem; background: var(--ink); color: var(--card); border-radius: 999px; padding: 0.05rem 0.45rem; }
.mention-chip .chip-pin { margin-left: 0.4rem; font-size: 0.75em; color: var(--stamp); }
.term-card-locked { border-left-color: var(--stamp); }
.term-card-pinned-by { display: block; font-family: var(--font-heading); font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--stamp); margin-bottom: 0.3rem; }


/* ---------- pinned terms in popups: buttons, definition one at a time ---------- */
.pinned-terms-body { gap: 0.5rem; }
.pinned-term-buttons { display: flex; flex-wrap: wrap; gap: 0.4rem; }
.pinned-term-btn {
  font-family: var(--font-heading); font-size: 0.8rem; font-weight: 700;
  padding: 0.3rem 0.7rem; background: var(--card); color: var(--ink);
  border: 2px solid var(--ink); border-radius: 999px; cursor: pointer;
}
.pinned-term-btn i { font-size: 0.7em; color: var(--stamp); margin-right: 0.15rem; }
.pinned-term-btn:hover { background: var(--brass-light); }
.pinned-term-btn.active { background: var(--ink); color: var(--card); }
.pinned-term-btn.active i { color: var(--brass-light); }
.pinned-term-hint { font-size: 0.78rem; color: var(--ink-soft); font-style: italic; }
.pinned-term-detail-card { padding-right: 0.8rem; }
.pinned-term-by { display: block; margin-top: 0.5rem; font-family: var(--font-heading); font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--stamp); }
.pinned-term-unpin { margin-top: 0.5rem; font-family: var(--font-heading); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.04em; background: none; border: 1px solid var(--ink-soft); color: var(--ink-soft); border-radius: 4px; padding: 0.2rem 0.55rem; cursor: pointer; }
.pinned-term-unpin:hover { color: var(--stamp); border-color: var(--stamp); }


/* ---------- image & video popups: the picture/video never gets squeezed ----------
   The media sits in the one part of the popup that was allowed to shrink,
   while the pinned terms, term groups and questions below it refuse to --
   so whenever they took room (a pinned definition open, say) the image's
   frame got squeezed and the picture was cut off. Now the media keeps its
   full size and the popup scrolls as a whole instead; the title bar stays
   put so the close button is always reachable. */
.modal-panel-media { overflow-y: auto; }
.modal-panel-media > * { flex-shrink: 0; }
.modal-panel-media > .modal-header { position: sticky; top: 0; z-index: 3; }
.modal-panel-media > .modal-body { flex: 0 0 auto; overflow: visible; }
.modal-panel-media > .term-groups { max-height: none; overflow: visible; }
.modal-panel-media .pinned-terms-body { max-height: none; overflow: visible; }

/* ---------- source windows: readings / videos / images, up to 3 at a time ---------- */
.source-workspace {
  position: fixed;
  inset: 0;
  background: rgba(26, 21, 18, 0.68); background: color-mix(in srgb, var(--ink) 68%, transparent);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  z-index: 1000;
}
.source-workspace.empty { display: none; }
.source-workspace.has-tray { padding-bottom: 4.2rem; } /* room for the tray of minimized windows */
.source-windows {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  width: 100%;
}
.source-windows > .modal-panel.minimized { display: none; }

/* Two or three side by side share the width equally, all the same height. */
.source-windows.count-2 > .modal-panel,
.source-windows.count-3 > .modal-panel {
  width: auto;
  flex: 1 1 0;
  min-width: 0;
  max-width: none;
  height: min(90vh, 900px);
  max-height: min(90vh, 900px);
}
.source-workspace.has-tray .source-windows.count-2 > .modal-panel,
.source-workspace.has-tray .source-windows.count-3 > .modal-panel {
  height: min(calc(100vh - 6rem), 900px);
  max-height: min(calc(100vh - 6rem), 900px);
}
/* On their own they keep the sizes they always had, minus the tray's room. */
.source-workspace.has-tray .source-windows.count-1 > .modal-panel { max-height: min(88vh, 720px, calc(100vh - 6rem)); }
.source-workspace.has-tray .source-windows.count-1 > .modal-panel-reading { max-height: min(94vh, 960px, calc(100vh - 6rem)); }
.source-workspace.has-tray .source-windows.count-1 > .modal-panel-embed { height: calc(100vh - 6rem); max-height: calc(100vh - 6rem); }

.source-windows.count-2 > .modal-panel-embed,
.source-windows.count-3 > .modal-panel-embed { width: auto; }
.source-windows.count-2 > .modal-panel,
.source-windows.count-3 > .modal-panel { box-shadow: 5px 5px 0 var(--ink); }
.source-windows.count-2 > .modal-panel.source-window-focused,
.source-windows.count-3 > .modal-panel.source-window-focused { outline: 3px solid var(--brass-light); outline-offset: 2px; }
.source-windows.count-3 .modal-header h2 { font-size: 0.95rem; }

/* title bar buttons: minimize + close together */
.modal-header-actions { display: flex; align-items: center; gap: 0.2rem; flex: 0 0 auto; }
.modal-minimize {
  background: none; border: none; cursor: pointer;
  font-size: 0.95rem; line-height: 1; color: var(--ink-soft);
  padding: 0.35rem 0.5rem;
}
.modal-minimize:hover { color: var(--stamp); }

/* the tray of minimized windows */
.source-tray {
  position: fixed;
  left: 1rem;
  bottom: 1rem;
  right: 6rem; /* keeps clear of the wide-screen toggle */
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  z-index: 999; /* above the page, below any popup... */
}
body.source-windows-open .source-tray { z-index: 1002; } /* ...but above the windows while they're showing, so you can swap one in */
.source-tray-chip {
  display: inline-flex;
  align-items: stretch;
  max-width: 17rem;
  background: var(--card);
  border: 2px solid var(--ink);
  border-radius: 4px;
  box-shadow: 3px 3px 0 var(--ink);
}
.tray-restore, .tray-close { background: none; border: none; cursor: pointer; font-family: var(--font-heading); color: var(--ink); }
.tray-restore { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.78rem; font-weight: 700; padding: 0.4rem 0.4rem 0.4rem 0.7rem; min-width: 0; }
.tray-restore i { color: var(--stamp); font-size: 0.85em; }
.tray-restore:hover { background: var(--brass-light); }
.tray-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tray-close { font-size: 1.1rem; line-height: 1; padding: 0 0.55rem; color: var(--ink-soft); border-left: 1px solid var(--ink-soft); }
.tray-close:hover { color: var(--stamp); }

/* minimizing the Sources / key-terms boxes down to their toolbar */
.box-collapse-btn { flex: 0 0 auto; background: transparent; border: none; border-left: 2px solid var(--ink); cursor: pointer; color: var(--ink-soft); padding: 0.3rem 0.8rem; }
.box-collapse-btn:hover { color: var(--stamp); }
.sources-box.collapsed > :not(.source-view-toggle):not(.terms-view-toggle) { display: none; }
.sources-box.collapsed > .source-view-toggle,
.sources-box.collapsed > .terms-view-toggle { border-bottom: none; }


/* ---------- title attached to the view buttons (one bar) ---------- */
.box-title {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  font-family: var(--font-heading);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  font-weight: 700;
  font-size: 0.8rem;
  color: var(--card);
  background: var(--ink);
  padding: 0.3rem 0.9rem;
}
.source-view-toggle .box-title + .source-view-btn,
.terms-view-toggle .box-title + .terms-view-btn { border-left: none; }
.sources-box > .source-view-toggle, .sources-box > .terms-view-toggle { align-items: stretch; }

/* ---------- hover: Open / Pin on sources and key terms ---------- */
.hover-actions { display: none; gap: 0.35rem; }
.hover-open, .hover-pin {
  font-family: var(--font-heading); font-size: 0.72rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.04em;
  background: var(--card); color: var(--ink);
  border: 2px solid var(--ink); border-radius: 4px;
  padding: 0.25rem 0.6rem; cursor: pointer; white-space: nowrap;
}
.hover-open:hover, .hover-pin:hover:not(:disabled) { background: var(--brass-light); }
.hover-pin.pinned { background: var(--ink); color: var(--card); }
.hover-pin.pinned:hover:not(:disabled) { background: var(--stamp); }
.hover-pin:disabled { opacity: 0.85; cursor: default; }
.hover-pin i, .hover-open i { color: var(--stamp); margin-right: 0.1rem; }
.hover-pin.pinned i { color: var(--brass-light); }

/* key-term chips: the buttons drop in just under the chip */
.chip-wrap { position: relative; display: inline-block; }
.chip-wrap .hover-actions {
  position: absolute; left: 0; top: 100%; z-index: 30;
  padding-top: 0.15rem; /* touches the chip, so the pointer never leaves it on the way down */
}
.chip-wrap:hover .hover-actions, .chip-wrap:focus-within .hover-actions { display: flex; }

/* source cards */
.source-item { position: relative; }
.source-item:hover .hover-actions, .source-item:focus-within .hover-actions { display: flex; }
.source-list:not(.gallery) .source-item .hover-actions { position: absolute; right: 0.4rem; top: 50%; transform: translateY(-50%); }
.source-list.gallery .source-item .hover-actions {
  position: absolute; inset: 0; z-index: 2;
  align-items: center; justify-content: center; flex-wrap: wrap;
  background: rgba(26, 21, 18, 0.62); background: color-mix(in srgb, var(--ink) 62%, transparent);
}
.source-pin-badge { display: none; position: absolute; top: 0.35rem; right: 0.4rem; z-index: 1; font-size: 0.8rem; color: var(--stamp); }
.source-item.pinned .source-pin-badge { display: block; }
.source-list.gallery .source-item.pinned .source-pin-badge { background: var(--card); border: 2px solid var(--ink); border-radius: 50%; padding: 0.25rem; font-size: 0.7rem; }
/* no hover on a touch screen: keep a small always-there Pin button instead */
@media (hover: none) {
  .chip-wrap .hover-actions, .source-item .hover-actions { display: flex; }
  .hover-actions .hover-open { display: none; }
  .chip-wrap .hover-actions { position: static; padding: 0; margin-left: 0.2rem; }
  .source-list:not(.gallery) .source-item .hover-actions { right: 0.4rem; }
  .source-list.gallery .source-item .hover-actions { inset: auto; top: 0.35rem; right: 0.35rem; left: auto; bottom: auto; background: none; }
  .chip-wrap { display: inline-flex; align-items: center; }
}

/* pin button in a source window's title bar */
.modal-pin { background: none; border: none; cursor: pointer; font-size: 0.95rem; line-height: 1; color: var(--ink-soft); padding: 0.35rem 0.5rem; }
.modal-pin:hover:not(:disabled) { color: var(--stamp); }
.modal-pin.pinned { color: var(--stamp); }
.modal-pin:disabled { cursor: default; }

/* pinned panel: terms and sources */
.pinned-group-label { font-family: var(--font-heading); font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-soft); margin-top: 0.2rem; }
.pinned-source-buttons { display: flex; flex-wrap: wrap; gap: 0.4rem; }
.pinned-source-btn {
  font-family: var(--font-heading); font-size: 0.8rem; font-weight: 700;
  padding: 0.3rem 0.7rem; background: var(--card); color: var(--ink);
  border: 2px solid var(--ink); border-radius: 4px; cursor: pointer; max-width: 100%;
}
.pinned-source-btn:hover { background: var(--brass-light); }
.pinned-source-btn > i:first-child { color: var(--stamp); margin-right: 0.15rem; }
.pinned-source-open { font-size: 0.7em; color: var(--ink-soft); }

.example-notice {
  border: 2px dashed var(--brass);
  background: var(--parchment-dim);
  color: var(--ink);
  border-radius: 4px;
  padding: 0.55rem 0.8rem;
  margin: 0 0 1rem;
  font-family: var(--font-heading);
  font-size: 0.82rem;
}
.example-notice i { color: var(--brass); margin-right: 0.3rem; }

/* =========================================================================
   PRINT PREVIEW (js/print-view.js)
   ========================================================================= */
.pv-overlay { position: fixed; inset: 0; z-index: 5000; background: #5b5b5b; overflow: auto; font-family: Georgia, "Times New Roman", serif; }
.pv-toolbar { position: sticky; top: 0; z-index: 2; background: #fff; border-bottom: 1px solid #bbb; padding: 10px 16px; font-family: system-ui, sans-serif; font-size: 14px; color: #222; box-shadow: 0 2px 6px rgba(0,0,0,.2); }
.pv-toolbar-row { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; }
.pv-toolbar-row + .pv-toolbar-row { margin-top: 8px; }
.pv-spacer { flex: 1; }
.pv-opt { white-space: nowrap; cursor: pointer; }
.pv-status { color: #777; }
.pv-btn { font: inherit; padding: 6px 14px; border: 1px solid #999; border-radius: 6px; background: #f4f4f4; cursor: pointer; }
.pv-link { color: #2b5d8a; }
.pv-btn:disabled { opacity: .6; cursor: wait; }
.pv-btn.pv-primary { background: #2b5d8a; color: #fff; border-color: #2b5d8a; }
.pv-paper { background: #fff; color: #000; width: 8.5in; max-width: calc(100% - 24px); margin: 18px auto 40px; padding: 0.6in; box-shadow: 0 2px 12px rgba(0,0,0,.4); box-sizing: border-box; font-size: 11.5pt; line-height: 1.45; }
.pv-empty { font-family: system-ui, sans-serif; color: #555; }
table.pv-lesson { width: 100%; border-collapse: collapse; }
table.pv-lesson + table.pv-lesson { margin-top: 36px; border-top: 2px dashed #bbb; padding-top: 24px; }
.pv-lesson td, .pv-lesson th { padding: 0; text-align: left; font-weight: normal; vertical-align: top; }
.pv-head { border-bottom: 2px solid #000; padding-bottom: 6px !important; }
.pv-head-top { display: flex; justify-content: space-between; gap: 12px; font: 600 9.5pt system-ui, sans-serif; text-transform: uppercase; letter-spacing: .06em; color: #444; }
.pv-head-lesson { font-size: 17pt; font-weight: bold; margin: 2px 0 4px; }
.pv-head-num { color: #555; }
.pv-head-fields { display: flex; gap: 24px; font: 9.5pt system-ui, sans-serif; color: #333; margin-top: 4px; }
.pv-content { padding-top: 12px; }
.pv-section { margin-bottom: 18px; }
.pv-source { break-inside: auto; }
.pv-h { font: 700 9.5pt system-ui, sans-serif; text-transform: uppercase; letter-spacing: .06em; color: #333; margin: 6px 0 2px; }
.pv-h2 { font-size: 14pt; font-weight: bold; border-bottom: 1px solid #888; margin: 0 0 6px; padding-bottom: 2px; break-after: avoid; }
.pv-h3 { font: 700 10pt system-ui, sans-serif; text-transform: uppercase; letter-spacing: .05em; color: #444; margin: 8px 0 3px; break-after: avoid; }
.pv-kind { font: 700 8.5pt system-ui, sans-serif; text-transform: uppercase; letter-spacing: .06em; color: #fff; background: #555; border-radius: 3px; padding: 1px 6px; vertical-align: middle; }
.pv-byline { font-style: italic; color: #444; margin-bottom: 8px; }
.pv-box { border: 1px solid #888; border-radius: 4px; padding: 6px 12px 8px; margin-bottom: 16px; break-inside: avoid; }
.pv-box ul { margin: 2px 0 4px; padding-left: 20px; }
.pv-terms { margin: 0; display: grid; grid-template-columns: max-content 1fr; gap: 2px 14px; }
.pv-terms dt { font-weight: bold; break-after: avoid; }
.pv-terms dd { margin: 0; }
.pv-terms dt, .pv-terms dd { break-inside: avoid; }
.pv-sources { margin: 0; padding-left: 0; list-style: none; }
.pv-sources li { margin-bottom: 3px; break-inside: avoid; }
.pv-sources .pv-in-set { margin-left: 14px; }
.pv-meta { color: #444; }
.pv-url { font: 8.5pt monospace; color: #444; word-break: break-all; }
.pv-reading p, .pv-reading .pv-p { margin: 0 0 9px; }
.pv-reading-h1 { font-size: 15pt; margin: 14px 0 6px; break-after: avoid; }
.pv-reading-h2 { font-size: 13pt; margin: 12px 0 5px; break-after: avoid; }
.pv-reading-h3 { font-size: 11.5pt; font-style: italic; margin: 10px 0 4px; break-after: avoid; }
.pv-reading-blockquote { margin: 8px 24px; padding-left: 12px; border-left: 3px solid #888; font-style: italic; }
.pv-reading-poem { margin: 10px 0 12px 32px; white-space: pre-line; font-style: italic; line-height: 1.5; break-inside: avoid; }
.pv-reading-centered { text-align: center; }
.pv-reading-attribution { text-align: right; font-style: italic; color: #333; }
.pv-reading-callout { border: 1px solid #666; background: #f1f1f1; padding: 6px 10px; border-radius: 4px; }
.pv-list { margin: 0 0 9px; padding-left: 24px; }
.pv-divider { border: 0; border-top: 1px solid #888; margin: 12px 30%; }
.pv-figure { margin: 8px 0; break-inside: avoid; text-align: center; }
.pv-figure img { max-width: 100%; max-height: 4.4in; }
.pv-figure figcaption { font-size: 9.5pt; font-style: italic; color: #444; }
.pv-question { margin: 10px 0 12px; padding: 6px 10px; border: 1px solid #aaa; border-radius: 4px; break-inside: avoid; }
.pv-q-prompt { margin: 0 0 4px; font-weight: 600; }
.pv-q-num { font-family: system-ui, sans-serif; }
.pv-q-image { max-width: 60%; max-height: 3in; display: block; margin: 4px 0; }
.pv-q-terms { font-size: 10pt; color: #444; margin: 0 0 4px; }
.pv-choices { margin: 2px 0 0; padding-left: 26px; list-style-type: upper-alpha; }
.pv-correct { font-weight: bold; }
.pv-key { margin: 6px 0 0; font-size: 10.5pt; color: #222; border-top: 1px dotted #888; padding-top: 4px; }
.pv-lines div { border-bottom: 1px solid #555; height: 0.32in; }
/* double spacing: reading text, questions and key-term definitions (the page header stays tight) */
.pv-double .pv-reading, .pv-double .pv-question { line-height: 2; }
.pv-double .pv-reading p, .pv-double .pv-reading .pv-p { margin-bottom: 0; }
.pv-double .pv-reading-poem { line-height: 2; }
.pv-double .pv-lines div { height: 0.4in; }
.pv-double .pv-choices li { margin-bottom: 2px; }
@media print {
  @page { margin: 0.6in; }
  body.pv-open > *:not(.pv-overlay) { display: none !important; }
  body.pv-open { background: #fff !important; }
  .pv-overlay { position: static; overflow: visible; background: #fff; }
  .pv-toolbar { display: none !important; }
  .pv-paper { width: auto; max-width: none; margin: 0; padding: 0; box-shadow: none; font-size: 11pt; }
  .pv-newpage { break-before: page; }
  table.pv-lesson + table.pv-lesson { margin-top: 0; border-top: 0; padding-top: 0; }
  .pv-lesson thead { display: table-header-group; }
  .pv-kind { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
}
@media (max-width: 640px) { .pv-paper { padding: 14px; } }


/* ---------- Theme textures (subtle; each theme supplies its own patterns) ---------- */
.masthead::after {
  content: "";
  position: absolute;
  left: 0; right: 0; top: 100%;
  height: var(--edge-height, 0px);
  margin-top: 4px; /* sits below the masthead's 4px bottom border */
  background-image: var(--edge-pattern, none);
  background-repeat: repeat-x;
  background-position: center top;
  pointer-events: none;
}
.masthead { box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06) inset; }
@media print { .masthead::after { display: none; } body { background-image: none !important; } }


/* ---------- Header banner (animated, only while the page is scrolled to the very top) ---------- */
#theme-banner {
  position: absolute; inset: 0; z-index: -1; /* behind the header's text, above its color */
  overflow: hidden; pointer-events: none;
  opacity: 0; transition: opacity 0.4s ease;
}
body.at-top #theme-banner { opacity: 1; }
body:not(.at-top) #theme-banner * { animation-play-state: paused !important; }
#theme-banner .b-image { position: absolute; right: 0; top: 0; height: 100%; max-width: 45%; object-fit: contain; }
.b-fall { position: absolute; top: -26px; opacity: 0.55; animation: b-fall var(--d, 12s) linear var(--delay, 0s) infinite; will-change: transform; }
.b-fall svg { display: block; }
.b-snow { opacity: 0.7; }
@keyframes b-fall {
  0% { transform: translate(0, 0) rotate(0deg); }
  50% { transform: translate(calc(var(--sway, 30px) * 0.5), 150px) rotate(calc(var(--rot, 300deg) * 0.5)); }
  100% { transform: translate(var(--sway, 30px), 320px) rotate(var(--rot, 300deg)); }
}
.b-moon { position: absolute; right: 7%; top: 12px; width: 62px; height: 62px; border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #fff4cf, #f0c96a 70%); opacity: 0.45; box-shadow: 0 0 40px 12px rgba(255, 220, 130, 0.25); }
.b-bat { position: absolute; left: -60px; opacity: 0.8; animation: b-fly var(--d, 18s) linear var(--delay, 0s) infinite; }
.b-bob { display: block; animation: b-bob var(--bd, 1.4s) ease-in-out infinite alternate; }
@keyframes b-fly { from { transform: translateX(0); } to { transform: translateX(calc(100vw + 120px)); } }
@keyframes b-bob { from { transform: translateY(-7px) scaleY(1); } to { transform: translateY(7px) scaleY(0.72); } }
.b-wire { position: absolute; left: 0; top: 0; width: 100%; height: 14px; }
.b-bulb { position: absolute; top: 9px; width: 8px; height: 11px; margin-left: -4px; border-radius: 50% 50% 45% 45%;
  background: var(--c, #ffc53d); box-shadow: 0 0 9px 3px var(--c, #ffc53d); animation: b-twinkle 2.6s ease-in-out var(--delay, 0s) infinite; }
@keyframes b-twinkle { 0%, 100% { opacity: 0.95; } 50% { opacity: 0.35; } }
.b-flag { position: absolute; top: 4px; margin-left: -15px; transform-origin: 50% 0; animation: b-sway 3.2s ease-in-out var(--delay, 0s) infinite alternate; opacity: 0.85; }
@keyframes b-sway { from { transform: rotate(-7deg); } to { transform: rotate(7deg); } }
@media (prefers-reduced-motion: reduce) { #theme-banner * { animation: none !important; } .b-fall { top: 20px; } }
@media print { #theme-banner { display: none; } }


/* ---------- Themed loading icons (each theme picks a glyph and one of these motions) ---------- */
@keyframes loading-bob { 0%, 100% { transform: translateY(2px); } 50% { transform: translateY(-7px) rotate(-5deg); } }
@keyframes loading-bounce { 0%, 100% { transform: translateY(0) scale(1, 1); } 40% { transform: translateY(-9px) scale(0.96, 1.06); } 70% { transform: translateY(0) scale(1.08, 0.92); } }
@keyframes loading-pulse { 0%, 100% { transform: scale(0.9); opacity: 0.7; } 50% { transform: scale(1.22); opacity: 1; } }
@keyframes loading-swing { 0%, 100% { transform: rotate(-24deg); } 50% { transform: rotate(24deg) translateY(3px); } }
@keyframes loading-spin { to { transform: rotate(360deg); } }
@keyframes loading-spin-slow { to { transform: rotate(360deg); } }
@keyframes loading-wobble { 0%, 100% { transform: rotate(-14deg); } 50% { transform: rotate(14deg) scale(1.08); } }
@keyframes loading-fly { 0% { transform: translate(-14px, 4px) rotate(-8deg); opacity: 0.3; } 50% { transform: translate(0, -2px) rotate(0deg); opacity: 1; } 100% { transform: translate(14px, 4px) rotate(8deg); opacity: 0.3; } }
@keyframes loading-orbit { 0% { transform: rotate(0deg) translateX(7px) rotate(0deg); } 100% { transform: rotate(360deg) translateX(7px) rotate(-360deg); } }
@keyframes loading-blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0.15; } }
.loading-spinner i[style], .loading-spinner i { transform-origin: 50% 50%; }
@media (prefers-reduced-motion: reduce) { .loading-spinner i { animation: none !important; } }

/* ---------- student theme picker ---------- */
.theme-picker-btn {
  position: fixed; right: 1rem; bottom: 3.6rem; z-index: 500;
  display: inline-flex; align-items: center; gap: 0.4rem;
  font-family: var(--font-heading); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.03em;
  background: var(--card); color: var(--ink); border: 2px solid var(--ink); border-radius: 20px;
  padding: 0.45rem 0.9rem; cursor: pointer; box-shadow: 0 2px 8px var(--shadow);
}
.theme-picker-btn:hover { background: var(--parchment-dim); }
.theme-picker-btn.locked { background: var(--parchment-dim); }
.theme-picker-panel {
  position: fixed; right: 1rem; bottom: 6.6rem; z-index: 501; width: min(320px, calc(100vw - 2rem));
  max-height: 60vh; overflow: auto; background: var(--card); color: var(--ink);
  border: 2px solid var(--ink); border-radius: 8px; padding: 0.7rem; box-shadow: 4px 4px 0 var(--stamp);
}
.theme-picker-panel[hidden] { display: none; }
.tp-title { font-family: var(--font-heading); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 0.5rem; }
.tp-note { font-size: 0.85rem; margin: 0.3rem 0; color: var(--ink-soft); }
.tp-note.small { font-size: 0.78rem; }
.tp-current { display: flex; align-items: center; gap: 0.6rem; margin-top: 0.4rem; font-weight: 600; }
.tp-option {
  display: flex; align-items: center; gap: 0.6rem; width: 100%; text-align: left; margin: 0.25rem 0;
  background: var(--parchment); color: var(--ink); border: 2px solid var(--rule); border-radius: 6px;
  padding: 0.35rem 0.5rem; cursor: pointer; font: inherit;
}
.tp-option:hover { border-color: var(--ink); }
.tp-option.selected { border-color: var(--stamp); background: var(--card); }
.tp-option .tp-name { flex: 1; font-weight: 600; }
@media (max-width: 700px) { .theme-picker-btn { bottom: 1rem; } .theme-picker-panel { bottom: 4rem; } }
@media print { .theme-picker-btn, .theme-picker-panel { display: none !important; } }

.tp-group { font-family: var(--font-heading); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-soft); margin: 0.6rem 0 0.15rem; }
.tp-reset { display: block; width: 100%; margin: 0.2rem 0 0.3rem; font: inherit; font-size: 0.8rem; background: none; color: var(--focus); border: 0; text-align: left; cursor: pointer; text-decoration: underline; padding: 0; }

/* link-type "questions": a card that opens an assessment / game in a new tab */
.quiz-link-card .quiz-link-btn { display:inline-flex; align-items:center; gap:.4rem; margin-top:.4rem; padding:.5rem .9rem; font-family:var(--font-heading); font-weight:700; background:var(--stamp); color:#fff; border:2px solid var(--ink); border-radius:4px; text-decoration:none; }
.quiz-link-card .quiz-link-btn:hover { background:var(--brass-light); color:var(--ink); }
.quiz-link-card .quiz-link-missing { color:#a33; font-size:.85rem; }
.notes-masthead-btn { text-decoration:none; }

/* Assessments: source-like cards, but a dashed brass-edged panel with a stamp header so they read as different */
.assessments-box { margin: 1.2rem 0; border: 3px dashed var(--stamp); border-radius: 6px; background: var(--card); overflow: hidden; }
.assessments-header { display:flex; align-items:center; gap:.5rem; padding:.5rem 1rem; background: var(--stamp); color:#fff; font-family:var(--font-heading); font-weight:700; text-transform:uppercase; letter-spacing:.05em; font-size:.8rem; }
.assessment-teacher-note { margin-left:auto; font-weight:400; text-transform:none; letter-spacing:0; font-size:.7rem; opacity:.85; }
.assessments-list { padding:.4rem 1rem; }
