  <script>
// ---------- helpers ----------
function el(tag, attrs = {}, children = []) {
  const node = document.createElement(tag);
  for (const [k, v] of Object.entries(attrs)) {
    if (v === null || v === undefined) continue;
    if (k === "class") node.className = v;
    else if (k === "html") node.innerHTML = v;
    else node.setAttribute(k, v);
  }
  (Array.isArray(children) ? children : [children]).flat(Infinity).forEach(c => {
    if (c === null || c === undefined) return;
    node.appendChild(typeof c === "string" ? document.createTextNode(c) : c);
  });
  return node;
}

// ---------- in-site popup viewer ----------
// Readings show their own text (stored in data.js). Videos play a local
// video file (stored in the videos/ folder). Images show inline, with
// Prev/Next for multi-file galleries. Nothing is embedded from another
// website.

function escapeRegExp(s) {
  return s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

// Builds a regex that matches ANY entity's name from the whole course
// (not just this lesson's curated key terms) inside a block of reading
// text, plus a lookup from matched text to its {term, def, featured}.
// Longer terms are tried first so "Freedmen's Bureau" wins over a
// shorter overlapping term, if any. "featured" marks whether that
// entity is specifically a key term for THIS lesson (gets the bold
// highlighted style) versus just any other entity the course defines
// (clickable, but styled plainly).
// Description text for an entity, for anywhere on the site that shows
// one (glossary popups, the entity modal). Prefers the Definition
// column, but falls back to the Actions list joined into one paragraph
// so entities that only have actions filled in still show something.
function entityDescription(entity, separator = " ") {
  if (entity.definition) return entity.definition;
  if (entity.actions && entity.actions.length) return entity.actions.join(separator);
  return "";
}

function resolveGlossaryForLesson(lesson) {
  const keyTermSet = new Set((lesson && lesson.keyTerms) || []);
  const entries = COURSE_DATA.entities
    .filter(ent => ent.name && entityDescription(ent))
    .map(ent => ({
      id: ent.id,
      term: ent.name,
      def: entityDescription(ent),
      image: ent.image,
      actions: !ent.definition && ent.actions && ent.actions.length > 1 ? ent.actions : null,
      featured: keyTermSet.has(ent.id)
    }));
  return entries;
}

// ---------- pinned + merged key terms ----------
function findEntityByNameOrId(key) {
  const k = String(key || "").trim().toLowerCase();
  if (!k) return null;
  return COURSE_DATA.entities.find(e => String(e.id).toLowerCase() === k)
    || COURSE_DATA.entities.find(e => (e.name || "").toLowerCase() === k)
    || null;
}

// ---------- student-pinned key terms ----------
// Any term can be pinned by the student (from the definition strip in a
// reading, or from a key-term popup). Pinned terms then sit in a
// "Pinned terms" panel at the bottom of every reading, video and image
// popup, for that student, until they unpin them. Kept per student ID on
// this device, and synced to Firebase (best-effort) so they follow the
// student across devices.
const PINNED_TERMS_KEY = "usHistoryPinnedTerms";
let pinnedTermList = []; // entity ids, in the order they were pinned
const livePinnedPanels = new Set();

function pinnedKeyFor(studentId) { return `${PINNED_TERMS_KEY}:${studentId}`; }
function isTermPinned(id) { return pinnedTermList.includes(id); }

async function loadPinnedTerms() {
  const sid = getStoredStudentId();
  if (!sid) { pinnedTermList = []; refreshPinnedUI(); return; }
  const ids = [...(await loadJSON(pinnedKeyFor(sid), []))];
  if (ensureFirebase()) {
    try {
      const snap = await firebase.database().ref(`pinnedTerms/${sid}`).once("value");
      const data = snap.val() || {};
      Object.entries(data)
        .filter(([, when]) => when)
        .sort((x, y) => (Number(x[1]) || 0) - (Number(y[1]) || 0))
        .forEach(([id]) => { if (!ids.includes(id)) ids.push(id); });
      await saveJSON(pinnedKeyFor(sid), ids);
    } catch (err) {
      console.warn("Could not load pinned terms from Firebase:", err);
    }
  }
  pinnedTermList = ids;
  refreshPinnedUI();
}

async function setTermPinned(id, pinned) {
  if (pinned && !pinnedTermList.includes(id)) pinnedTermList.push(id);
  if (!pinned) pinnedTermList = pinnedTermList.filter(x => x !== id);
  refreshPinnedUI(); // screen first, saving after
  const sid = getStoredStudentId();
  if (!sid) return;
  await saveJSON(pinnedKeyFor(sid), pinnedTermList);
  if (ensureFirebase()) {
    try {
      const ref = firebase.database().ref(`pinnedTerms/${sid}/${id}`);
      if (pinned) await ref.set(Date.now()); else await ref.remove();
    } catch (err) {
      console.warn("Could not sync this pin to Firebase:", err);
    }
  }
}

// Repaints every pin button and open pinned panel after a change.
function refreshPinnedUI() {
  document.querySelectorAll(".pin-btn, .pin-aware").forEach(b => { if (b._paint) b._paint(); });
  livePinnedPanels.forEach(panel => {
    if (!panel.isConnected) livePinnedPanels.delete(panel);
    else panel._render();
  });
}

function buildPinButton(entityId) {
  const btn = el("button", { type: "button", class: "pin-btn", "data-term": entityId }, "");
  btn._paint = () => {
    const pinned = isTermPinned(entityId);
    btn.classList.toggle("pinned", pinned);
    btn.setAttribute("aria-pressed", String(pinned));
    btn.title = pinned ? "Unpin this term" : "Pin this term so it stays in view when you open resources";
    btn.innerHTML = "";
    btn.appendChild(el("i", { class: "fa-solid fa-thumbtack" }));
    btn.appendChild(document.createTextNode(pinned ? " Pinned" : " Pin"));
  };
  btn._paint();
  btn.addEventListener("click", (e) => {
    e.stopPropagation();
    setTermPinned(entityId, !isTermPinned(entityId));
  });
  return btn;
}

// ---------- pinned sources ----------
// Readings, videos and images can be pinned just like terms: from the Pin
// button that shows when you hover a source (or tap the thumbtack in its
// window). Pinned sources of the lesson you're in sit in the same panel at
// the bottom of every popup, and tapping one opens it BESIDE what you're
// reading -- the shared, side-by-side view. The teacher can pin sources for
// everyone from the sheet ("Source Pin" column). Saved per student ID, the
// same way term pins are.
const PINNED_SOURCES_KEY = "usHistoryPinnedSources";
let pinnedSourceList = []; // source pin ids, in the order pinned

function pinSlug(s) { return String(s || "").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, ""); }
// A key made only of characters that are safe in Firebase paths, built from
// the lesson, kind and title (plus a short hash so near-identical titles
// can't collide).
function sourcePinId(kind, lesson, title) {
  const t = String(title || "");
  let h = 5381;
  for (let i = 0; i < t.length; i++) h = ((h << 5) + h + t.charCodeAt(i)) | 0;
  return [pinSlug(lesson && lesson.id) || "x", pinSlug(kind), pinSlug(t).slice(0, 40) || "untitled", (h >>> 0).toString(36)].join("~");
}
function isTeacherPinnedSource(data) { return !!(data && data.teacherPinned); }
function isStudentPinnedSource(id) { return pinnedSourceList.includes(id); }
function isSourcePinned(kind, lesson, data) {
  return isTeacherPinnedSource(data) || isStudentPinnedSource(sourcePinId(kind, lesson, data.title));
}
function pinnedSourcesKeyFor(studentId) { return `${PINNED_SOURCES_KEY}:${studentId}`; }

async function loadPinnedSources() {
  const sid = getStoredStudentId();
  if (!sid) { pinnedSourceList = []; refreshPinnedUI(); return; }
  const ids = [...(await loadJSON(pinnedSourcesKeyFor(sid), []))];
  if (ensureFirebase()) {
    try {
      const snap = await firebase.database().ref(`pinnedSources/${sid}`).once("value");
      const data = snap.val() || {};
      Object.entries(data)
        .filter(([, when]) => when)
        .sort((x, y) => (Number(x[1]) || 0) - (Number(y[1]) || 0))
        .forEach(([id]) => { if (!ids.includes(id)) ids.push(id); });
      await saveJSON(pinnedSourcesKeyFor(sid), ids);
    } catch (err) {
      console.warn("Could not load pinned sources from Firebase:", err);
    }
  }
  pinnedSourceList = ids;
  refreshPinnedUI();
}

async function setSourcePinned(id, pinned) {
  if (pinned && !pinnedSourceList.includes(id)) pinnedSourceList.push(id);
  if (!pinned) pinnedSourceList = pinnedSourceList.filter(x => x !== id);
  refreshPinnedUI(); // screen first, saving after
  const sid = getStoredStudentId();
  if (!sid) return;
  await saveJSON(pinnedSourcesKeyFor(sid), pinnedSourceList);
  if (ensureFirebase()) {
    try {
      const ref = firebase.database().ref(`pinnedSources/${sid}/${id}`);
      if (pinned) await ref.set(Date.now()); else await ref.remove();
    } catch (err) {
      console.warn("Could not sync this pin to Firebase:", err);
    }
  }
}

// What a source's pin buttons need to know and do.
function sourcePinControls(kind, lesson, data) {
  const id = sourcePinId(kind, lesson, data.title);
  return {
    isPinned: () => isSourcePinned(kind, lesson, data),
    isLocked: () => isTeacherPinnedSource(data),
    toggle: () => setSourcePinned(id, !isStudentPinnedSource(id))
  };
}

// The Pin / Unpin button shown on hover (and in a source window's title
// bar, as an icon-only version). Repaints itself whenever any pin changes.
// A pin the teacher set from the sheet shows as "Pinned" and can't be undone.
function buildHoverPinButton(controls, noun, variant) {
  const iconOnly = variant === "icon";
  const btn = el("button", { type: "button", class: (iconOnly ? "modal-pin" : "hover-pin") + " pin-aware" });
  btn._paint = () => {
    const pinned = controls.isPinned();
    const locked = controls.isLocked();
    btn.classList.toggle("pinned", pinned);
    btn.disabled = locked;
    btn.setAttribute("aria-pressed", String(pinned));
    const label = locked ? "Pinned by your teacher" : pinned ? `Unpin this ${noun}` : `Pin this ${noun}`;
    btn.title = label;
    btn.setAttribute("aria-label", label);
    btn.innerHTML = "";
    btn.appendChild(el("i", { class: "fa-solid fa-thumbtack" }));
    if (!iconOnly) btn.appendChild(document.createTextNode(locked ? " Pinned" : pinned ? " Unpin" : " Pin"));
  };
  btn._paint();
  btn.addEventListener("click", (e) => { e.stopPropagation(); if (!controls.isLocked()) controls.toggle(); });
  return btn;
}

// One term as a compact card body: picture, name, and its definition.
function buildTermCardMember(ent) {
  return el("div", { class: "term-card-member" }, [
    ent.image ? el("img", { class: "term-card-img", src: ent.image, alt: "" }) : null,
    el("div", { class: "term-card-text" }, [
      el("strong", { class: "term-card-name" }, ent.name),
      ent.definition
        ? el("p", { class: "term-card-desc" }, ent.definition)
        : (ent.actions && ent.actions.length > 1)
          ? el("ul", { class: "term-card-list" }, ent.actions.map(a => el("li", {}, a)))
          : (entityDescription(ent) ? el("p", { class: "term-card-desc" }, entityDescription(ent)) : null)
    ])
  ]);
}

// Entities the teacher pinned for this lesson (Key Term Pin column).
function teacherPinnedEntities(lesson) {
  const seen = new Set();
  return ((lesson && lesson.pinnedTerms) || [])
    .map(findEntityByNameOrId)
    .filter(ent => ent && !seen.has(ent.id) && seen.add(ent.id));
}
function isTeacherPinnedTerm(lesson, ent) {
  return teacherPinnedEntities(lesson).some(e => e.id === ent.id);
}

// The "Pinned terms" panel at the bottom of a resource popup: just a row
// of buttons, one per pinned term. Tap one to read its definition (one at
// a time -- tapping another swaps it, tapping the same one closes it).
// Always created, and repaints itself live when the student pins/unpins
// while the popup is open; hides itself when nothing is pinned.
// Pinned sources for this lesson (the student's own pins plus any the
// teacher pinned), leaving out the one whose window this panel is in.
function pinnedSourcesFor(lesson, exceptKey) {
  if (!lesson || !lesson.readings || !lesson.videos || !lesson.images) return [];
  return buildOrderedSources(lesson)
    .filter(it => isSourcePinned(it.kind, lesson, it.data) && sourceWindowKey(it.kind, lesson, it.data.title) !== exceptKey)
    .map(it => ({ kind: it.kind, data: it.data, locked: isTeacherPinnedSource(it.data) }));
}

// Opens a pinned source in a window of its own. If another popup is
// already showing, the two sit side by side (the shared view) -- or, on a
// screen too narrow for that, the new one takes over and the other waits in
// the tray.
function openPinnedSource(entry, lesson) {
  const unit = COURSE_DATA.units.find(u => (u.lessons || []).includes(lesson)) || null;
  if (entry.kind === "Reading") openTextModal(entry.data, resolveGlossaryForLesson(lesson), lesson, unit);
  else if (entry.kind === "Video") openVideoModal(entry.data, lesson);
  else openImageModal(entry.data, lesson, unit);
}

function buildPinnedTermsPanel(lesson, selfKey) {
  const panel = el("div", { class: "pinned-terms" });
  let collapsed = false;
  let selectedId = null; // the one term whose definition is showing
  panel._render = () => {
    panel.innerHTML = "";
    const teacherEnts = teacherPinnedEntities(lesson);
    const teacherIds = new Set(teacherEnts.map(e => e.id));
    const studentEnts = pinnedTermList.map(findEntityByNameOrId).filter(ent => ent && !teacherIds.has(ent.id));
    const pinned = [...teacherEnts.map(ent => ({ ent, locked: true })), ...studentEnts.map(ent => ({ ent, locked: false }))];
    const srcPins = pinnedSourcesFor(lesson, selfKey);
    const total = pinned.length + srcPins.length;
    if (!total) { panel.style.display = "none"; return; }
    panel.style.display = "";
    if (selectedId && !pinned.some(p => p.ent.id === selectedId)) selectedId = null; // it was just unpinned

    const buttons = el("div", { class: "pinned-term-buttons" });
    const hint = el("div", { class: "pinned-term-hint" }, "Tap a term to see its definition.");
    const detail = el("div", { class: "pinned-term-detail" });

    const paint = () => {
      buttons.querySelectorAll(".pinned-term-btn").forEach(b => {
        const on = b.getAttribute("data-term") === selectedId;
        b.classList.toggle("active", on);
        b.setAttribute("aria-pressed", String(on));
      });
      const sel = pinned.find(p => p.ent.id === selectedId);
      hint.style.display = (sel || !pinned.length) ? "none" : "";
      detail.style.display = sel ? "" : "none";
      detail.innerHTML = "";
      if (!sel) return;
      let footer;
      if (sel.locked) {
        // Pinned from the teacher's sheet -- students can't unpin these.
        footer = el("span", { class: "pinned-term-by" }, [el("i", { class: "fa-solid fa-thumbtack" }), " Pinned by your teacher"]);
      } else {
        footer = el("button", { type: "button", class: "pinned-term-unpin" }, [el("i", { class: "fa-solid fa-xmark" }), " Unpin this term"]);
        footer.addEventListener("click", () => setTermPinned(sel.ent.id, false));
      }
      detail.appendChild(el("div", { class: "term-card pinned-term-detail-card" + (sel.locked ? " term-card-locked" : "") }, [
        buildTermCardMember(sel.ent),
        footer
      ]));
    };

    const sourceButtons = el("div", { class: "pinned-source-buttons" });
    srcPins.forEach(it => {
      const b = el("button", { type: "button", class: "pinned-source-btn" + (it.locked ? " locked" : ""), title: `Open "${it.data.title}" beside what you're reading` }, [
        el("i", { class: "fa-solid " + (SOURCE_KIND_ICONS[it.kind] || "fa-file") }),
        ` ${it.data.title} `,
        el("i", { class: "fa-solid fa-up-right-from-square pinned-source-open" })
      ]);
      b.addEventListener("click", () => openPinnedSource(it, lesson));
      sourceButtons.appendChild(b);
    });

    pinned.forEach(p => {
      const btn = el("button", { type: "button", class: "pinned-term-btn" + (p.locked ? " locked" : ""), "data-term": p.ent.id, "aria-pressed": "false" }, [
        el("i", { class: "fa-solid fa-thumbtack" }),
        ` ${p.ent.name}`
      ]);
      btn.addEventListener("click", () => {
        selectedId = selectedId === p.ent.id ? null : p.ent.id;
        paint();
        // In an image/video popup the whole popup scrolls, so a definition
        // opening below the buttons could land off-screen -- bring it into view.
        if (selectedId && detail.scrollIntoView) detail.scrollIntoView({ block: "nearest", behavior: "smooth" });
      });
      buttons.appendChild(btn);
    });

    const both = pinned.length > 0 && srcPins.length > 0;
    if (!pinned.length) { hint.style.display = "none"; }
    const body = el("div", { class: "pinned-terms-body" }, [
      pinned.length ? [both ? el("div", { class: "pinned-group-label" }, "Terms") : null, buttons] : null,
      srcPins.length ? [both ? el("div", { class: "pinned-group-label" }, "Sources \u2014 opens beside this one") : null, sourceButtons] : null,
      pinned.length ? hint : null,
      detail
    ].flat());
    body.style.display = collapsed ? "none" : "";
    const toggle = el("button", { type: "button", class: "pinned-terms-toggle", "aria-expanded": String(!collapsed) }, [
      el("i", { class: "fa-solid fa-thumbtack" }),
      ` Pinned (${total})`
    ]);
    toggle.addEventListener("click", () => {
      collapsed = !collapsed;
      body.style.display = collapsed ? "none" : "";
      toggle.setAttribute("aria-expanded", String(!collapsed));
    });
    panel.appendChild(toggle);
    panel.appendChild(body);
    paint();
  };
  livePinnedPanels.add(panel);
  panel._render();
  return panel;
}

// ---------- key-term groups: terms shown side by side in a popup ----------
// Set up in the sheet: a term's row says which group(s) it belongs to
// ("Key Term Group", ordered by "Key Term Order"), and each reading /
// video / image names the group(s) its popup should show ("Reading Term
// Group", "Video Term Group", "Image Term Group"). Separate from
// resource sets, which group the resources themselves.
function resolveTermGroup(lesson, name) {
  const key = String(name || "").trim().toLowerCase();
  const group = ((lesson && lesson.termGroups) || []).find(g => g.name.toLowerCase() === key);
  if (!group) return null;
  const rank = m => (m.order === undefined ? Infinity : m.order);
  const members = group.members.slice().sort((a, b) => (rank(a) !== rank(b) ? (rank(a) < rank(b) ? -1 : 1) : a.pos - b.pos));
  const entities = [];
  const missing = [];
  members.forEach(m => {
    const ent = findEntityByNameOrId(m.id);
    if (ent) entities.push(ent); else missing.push(m.id);
  });
  return { name: group.name, entities, missing };
}

// Returns null if this resource names no group (or none that exist).
function buildTermGroupsPanel(lesson, resource) {
  const names = (resource && resource.termGroup) || [];
  if (!names.length) return null;

  const groups = [];
  const problems = []; // shown to the teacher only, so a setup mistake is visible
  names.forEach(n => {
    const g = resolveTermGroup(lesson, n);
    if (!g) {
      problems.push(`No key-term group named "${n}" on this lesson \u2014 check it's spelled exactly the same in the "Key Term Group" column.`);
      return;
    }
    if (g.missing.length) problems.push(`Group "${g.name}": couldn't find ${g.missing.join(", ")} on your Entities tab.`);
    if (g.entities.length) groups.push(g);
  });
  const warning = (problems.length && isTeacherSession())
    ? el("div", { class: "term-group-warning" }, [el("strong", {}, "Setup check (only you see this): "), ...problems.map(t => el("div", {}, t))])
    : null;
  if (!groups.length) return warning ? el("div", { class: "term-groups" }, [warning]) : null;

  return el("div", { class: "term-groups" }, [warning, ...groups.map(g => {
    const cards = el("div", { class: "term-group-cards" }, g.entities.map(ent =>
      el("div", { class: "term-group-card" }, [buildTermCardMember(ent), buildPinButton(ent.id)])
    ));
    const chevron = el("i", { class: "fa-solid fa-chevron-up" });
    const toggle = el("button", { type: "button", class: "term-group-toggle", "aria-expanded": "true" }, [
      el("span", { class: "term-group-name" }, g.name),
      el("span", { class: "term-group-count" }, `${g.entities.length} key term${g.entities.length === 1 ? "" : "s"}`),
      chevron
    ]);
    toggle.addEventListener("click", () => {
      const open = cards.style.display !== "none";
      cards.style.display = open ? "none" : "";
      toggle.setAttribute("aria-expanded", String(!open));
      chevron.className = open ? "fa-solid fa-chevron-down" : "fa-solid fa-chevron-up";
    });
    return el("div", { class: "term-group" }, [toggle, cards]);
  })]);
}

function buildGlossary(terms) {
  if (!terms || !terms.length) return null;
  const sorted = [...terms].sort((a, b) => b.term.length - a.term.length);
  const pattern = sorted.map(t => escapeRegExp(t.term)).join("|");
  const lookup = new Map(sorted.map(t => [t.term.toLowerCase(), t]));
  return { regex: new RegExp(`\\b(${pattern})\\b`, "gi"), lookup };
}

// Builds one self-check question card. Works two places: inline inside a
// reading (dropped between paragraphs) and standalone in a lesson's "Check
// Your Understanding" section. Multiple-choice gives immediate right/wrong
// feedback; short-answer reveals a sample answer on request. Nothing here
// is graded or stored — it's formative, not a gradebook.
// Resolves a question's objectiveIds (e.g. ["o1","o3"]) into display labels
// ("Objective 1", "Objective 3") based on that lesson's objectives array —
// the number is just its position in the list, not a stored field.
function resolveObjectiveTags(objectiveIds, objectives) {
  if (!objectiveIds || !objectiveIds.length || !objectives || !objectives.length) return [];
  return objectiveIds
    .map(id => {
      const idx = objectives.findIndex(o => o.id === id);
      return idx >= 0 ? `Objective ${idx + 1}` : null;
    })
    .filter(Boolean);
}

// ---------- classmates' answers to short-answer questions ----------
// After a student has answered a short-answer question, they can read
// what others in THEIR class period answered (never the names or IDs)
// and react to it. Class membership comes from the Roster tab.
const CLASSMATE_REACTIONS = [
  { id: "up", emoji: "\u{1F44D}", label: "Thumbs up" },
  { id: "interesting", emoji: "\u{1F4A1}", label: "Interesting" },
  { id: "agree", emoji: "\u2714\uFE0F", label: "I agree" }
];

// A student's own most recent answer to a question, if they've answered
// it before — on this device, or (same student ID) on another one, since
// getLocalResponses pulls a student's answers back from Firebase.
async function findMyPreviousAnswer(lessonId, prompt, type) {
  const myId = getStoredStudentId();
  if (!myId) return null;
  const all = await getLocalResponses();
  return all
    .filter(r => r.studentId === myId && r.lessonId === (lessonId || "") && r.questionPrompt === prompt && r.type === type)
    .sort((a, b) => String(a.timestamp).localeCompare(String(b.timestamp)))
    .pop() || null;
}

// Why there's nothing to show, or null if classmates can be shown. Said
// out loud in the panel so it never just sits blank.
function classmateProblemFor(myId) {
  const isTeacher = myId === TEACHER_VIEW_ID;
  if (isTeacher && !isTeacherUnlocked()) {
    return "You're logged in as the teacher. Click Teacher View and enter your password, then reload this page \u2014 you'll see every class's answers here. (Students only see their own class.)";
  }
  if (!isTeacher && !(COURSE_DATA.roster || {})[myId]) {
    return "Your teacher hasn't added you to a class period yet, so classmates' answers can't be shown.";
  }
  return null;
}

// From the raw responses for one question, the answers this student may
// see: same class period (the teacher sees every class), latest per
// student, never their own. Only { id, answer } is returned — no student
// ID or name is ever handed to the screen.
function pickClassmateAnswers(all, lessonId, prompt, myId) {
  const roster = COURSE_DATA.roster || {};
  const isTeacher = myId === TEACHER_VIEW_ID;
  const myClass = roster[myId];
  const requiresApproval = questionRequiresApproval(lessonId, prompt);
  const latestPerStudent = new Map();
  all.filter(r => r && r.type === "short_answer" && r.lessonId === (lessonId || "") &&
      r.questionPrompt === prompt && r.studentId !== myId &&
      (isTeacher || roster[r.studentId] === myClass) && String(r.answer || "").trim() &&
      !hiddenAnswerIds.has(r.id) && (!requiresApproval || approvedAnswerIds.has(r.id)))
    .sort((a, b) => String(a.timestamp).localeCompare(String(b.timestamp)))
    .forEach(r => latestPerStudent.set(r.studentId, r));
  return [...latestPerStudent.values()].map(r => ({ id: r.id, answer: r.answer }));
}

// ---- live listening: a classmate's new answer or reaction shows up
// without anyone refreshing. Each returns a function that stops listening,
// or null if Firebase isn't available.
function watchResponsesFor(prompt, callback) {
  if (!ensureFirebase()) return null;
  try {
    const base = firebase.database().ref("responses");
    // Ask Firebase for just this question's answers when it can (fast with
    // ".indexOn": ["questionPrompt"] in the database rules); otherwise
    // listen to all of them and filter here.
    const query = typeof base.orderByChild === "function" ? base.orderByChild("questionPrompt").equalTo(prompt) : base;
    const handler = snap => callback(Object.values(snap.val() || {}));
    query.on("value", handler, err => console.warn("Live answers stopped:", err));
    return () => query.off("value", handler);
  } catch (err) {
    console.warn("Could not listen for classmates' answers:", err);
    return null;
  }
}

function watchReactionsFor(answerId, callback) {
  if (!ensureFirebase()) return null;
  try {
    const ref = firebase.database().ref(`reactions/${answerId}`);
    const handler = snap => callback(snap.val() || {});
    ref.on("value", handler);
    return () => ref.off("value", handler);
  } catch (err) {
    console.warn("Could not listen for reactions:", err);
    return null;
  }
}

async function setMyReaction(answerId, myId, reactionId) {
  if (!ensureFirebase()) return;
  try {
    const ref = firebase.database().ref(`reactions/${answerId}/${myId}`);
    if (reactionId) await ref.set(reactionId); else await ref.remove();
  } catch (err) {
    console.warn("Could not save your reaction:", err);
  }
}

// ---------- answer moderation: hide from classmates / require approval ----------
// Two independent teacher controls over a short-answer response, kept in
// Firebase so they're shared and live for everyone:
//   hiddenAnswers/{responseId}   -- this ONE answer is hidden from classmates
//   approvedAnswers/{responseId} -- this ONE answer has been approved (only
//                                   matters for a question marked "Question
//                                   Requires Approval" in the sheet)
// A hidden answer stays hidden regardless of approval. The student who
// wrote it always sees it for themselves (with a note explaining why
// classmates can't), everywhere it would otherwise show.
let hiddenAnswerIds = new Set();
let approvedAnswerIds = new Set();
let moderationStarted = false;

// Anything on screen whose look depends on hidden/approved state registers
// itself here with a repaint function; swept the same way livePinnedPanels
// is, by checking node.isConnected, so nothing needs to unregister by hand.
const moderationAwareNodes = new Set();
function registerModerationAware(node, render) {
  moderationAwareNodes.add({ node, render });
  render();
}
function refreshModerationUI() {
  moderationAwareNodes.forEach(m => {
    if (!m.node.isConnected) moderationAwareNodes.delete(m);
    else m.render();
  });
}

function initAnswerModeration() {
  if (moderationStarted) return;
  moderationStarted = true;
  if (!ensureFirebase()) return;
  try {
    firebase.database().ref("hiddenAnswers").on("value", snap => {
      const data = snap.val() || {};
      hiddenAnswerIds = new Set(Object.keys(data).filter(k => data[k]));
      refreshModerationUI();
    });
    firebase.database().ref("approvedAnswers").on("value", snap => {
      const data = snap.val() || {};
      approvedAnswerIds = new Set(Object.keys(data).filter(k => data[k]));
      refreshModerationUI();
    });
  } catch (err) {
    console.warn("Could not listen for answer moderation:", err);
  }
}

async function setAnswerHidden(id, hidden) {
  if (hidden) hiddenAnswerIds.add(id); else hiddenAnswerIds.delete(id);
  refreshModerationUI();
  if (!ensureFirebase()) return false;
  try {
    const ref = firebase.database().ref("hiddenAnswers/" + id);
    if (hidden) await ref.set(true); else await ref.remove();
    return true;
  } catch (err) {
    console.warn("Could not save this to Firebase:", err);
    return false;
  }
}

async function setAnswerApproved(id, approved) {
  if (approved) approvedAnswerIds.add(id); else approvedAnswerIds.delete(id);
  refreshModerationUI();
  if (!ensureFirebase()) return false;
  try {
    const ref = firebase.database().ref("approvedAnswers/" + id);
    if (approved) await ref.set(true); else await ref.remove();
    return true;
  } catch (err) {
    console.warn("Could not save this to Firebase:", err);
    return false;
  }
}

// ---------- skills: shared lesson skills + per-student focus skills ----------
// A lesson's "Lesson Skills" (lesson tab) are what EVERYONE practices. A student's "Focus Skills"
// (Roster tab) add extra questions only they see. A question with no skill is always shown. If a
// lesson lists no Lesson Skills, everyone sees every question (as before). No reading / video /
// image ever shows a student more than MAX_QUESTIONS_PER_SOURCE questions; when there are more,
// the student's own focus-skill questions are kept first.
const MAX_QUESTIONS_PER_SOURCE = 5;
function normSkill(s) { return String(s || "").toLowerCase().replace(/[^a-z0-9]/g, ""); }
function myFocusSkills() {
  const sid = getStoredStudentId();
  const list = (sid && COURSE_DATA.rosterSkills && COURSE_DATA.rosterSkills[sid]) || [];
  return new Set(list.map(normSkill));
}
function questionsForStudent(list, lesson, opts = {}) {
  const all = list || [];
  if (isTeacherId()) return all; // the teacher sees every question, to check them
  const core = new Set(((lesson && lesson.skills) || []).map(normSkill));
  const mine = myFocusSkills();
  const gated = core.size
    ? all.filter(q => !q.skill || core.has(normSkill(q.skill)) || mine.has(normSkill(q.skill)))
    : all;
  if (!opts.cap || gated.length <= MAX_QUESTIONS_PER_SOURCE) return gated;
  const isMine = q => q.skill && mine.has(normSkill(q.skill)) ? 0 : 1;
  const keep = new Set(gated.map((q, i) => ({ q, i })).sort((a, b) => isMine(a.q) - isMine(b.q) || a.i - b.i)
    .slice(0, MAX_QUESTIONS_PER_SOURCE).map(x => x.q));
  return gated.filter(q => keep.has(q));
}

// Every question object in a lesson (Do Now, standalone, and any attached
// to a reading/video/image) — derived on the fly, no separate index kept.
function allQuestionsForLesson(lesson) {
  const out = [...(lesson.doNow || []), ...(lesson.assessment || [])];
  [...(lesson.readings || []), ...(lesson.videos || []), ...(lesson.images || [])]
    .forEach(res => { if (res.questions) out.push(...res.questions); });
  return out;
}
function questionRequiresApproval(lessonId, prompt) {
  const found = flatLessons().find(o => o.lesson.id === lessonId);
  if (!found) return false;
  const q = allQuestionsForLesson(found.lesson).find(q => q.prompt === prompt);
  return !!(q && q.requiresApproval);
}

// One response's moderation controls for Teacher View's Answers tab. null
// for anything but a short answer — nothing else is ever shown to classmates.
function buildModerationControls(r) {
  if (r.type !== "short_answer") return null;
  const wrap = el("span", { class: "moderation-controls" });
  const render = () => {
    wrap.innerHTML = "";
    const hidden = hiddenAnswerIds.has(r.id);
    const hideBtn = el("button", { type: "button", class: "moderation-btn" + (hidden ? " active" : "") }, hidden ? "Unhide" : "Hide from classmates");
    hideBtn.addEventListener("click", () => setAnswerHidden(r.id, !hidden));
    wrap.appendChild(hideBtn);
    if (questionRequiresApproval(r.lessonId, r.questionPrompt)) {
      const approved = approvedAnswerIds.has(r.id);
      wrap.appendChild(el("span", { class: "moderation-badge" + (approved ? " approved" : " pending") }, approved ? "Approved" : "Pending approval"));
      if (!hidden) {
        const approveBtn = el("button", { type: "button", class: "moderation-btn" + (approved ? " active" : "") }, approved ? "Unapprove" : "Approve");
        approveBtn.addEventListener("click", () => setAnswerApproved(r.id, !approved));
        wrap.appendChild(approveBtn);
      }
    }
  };
  registerModerationAware(wrap, render);
  return wrap;
}

// ---------- reactions to a student's OWN answers ----------
// Live listeners that stop themselves once the thing showing them has left
// the page (popup closed, question replaced) — so they never pile up.
const liveWatchers = new Set();
function registerLiveWatcher(node, stop) { liveWatchers.add({ node, stop }); }
function sweepLiveWatchers() {
  liveWatchers.forEach(w => { if (!w.node.isConnected) { w.stop(); liveWatchers.delete(w); } });
}

function tallyReactions(map, exceptId) {
  const counts = { up: 0, interesting: 0, agree: 0 };
  Object.entries(map || {}).forEach(([who, v]) => {
    if (who !== exceptId && counts[v] !== undefined) counts[v]++;
  });
  return counts;
}

// "Reactions to your answer: 👍 Thumbs up · 2  💡 Interesting · 1" — updates
// live as classmates react. Anonymous: only the counts, never who.
function buildMyReactionsBadge(answerId, lessonId, prompt) {
  const myId = getStoredStudentId();
  const badge = el("div", { class: "my-answer-reactions" });
  let latestReactions = {};

  function paintNote(text) {
    badge.innerHTML = "";
    badge.appendChild(el("span", { class: "my-reaction-note" }, text));
  }
  function paintTally() {
    const counts = tallyReactions(latestReactions, myId);
    badge.innerHTML = "";
    const chips = CLASSMATE_REACTIONS
      .filter(rx => counts[rx.id] > 0)
      .map(rx => el("span", { class: "my-reaction-chip" }, `${rx.emoji} ${rx.label} \u00b7 ${counts[rx.id]}`));
    if (!chips.length) {
      badge.appendChild(el("span", { class: "my-reaction-none" }, "No reactions yet \u2014 when classmates react to your answer, it shows up here."));
      return;
    }
    badge.appendChild(el("span", { class: "my-reaction-label" }, "Reactions to your answer:"));
    chips.forEach(c => badge.appendChild(c));
  }
  // Whether classmates can even see this answer changes what to show: a
  // hidden answer never has reactions to display, and a not-yet-approved
  // one has none YET — either way, showing an empty tally would be
  // confusing, so this explains why instead.
  function render() {
    if (hiddenAnswerIds.has(answerId)) { paintNote("Your teacher has hidden this answer from classmates."); return; }
    if (questionRequiresApproval(lessonId, prompt) && !approvedAnswerIds.has(answerId)) {
      paintNote("Waiting for your teacher to approve this before classmates can see it.");
      return;
    }
    paintTally();
  }
  registerModerationAware(badge, render);

  let seenOnScreen = false;
  const attachDeadline = Date.now() + 5000;
  let stop = null;
  stop = watchReactionsFor(answerId, map => {
    if (badge.isConnected) seenOnScreen = true;
    else if (seenOnScreen || Date.now() > attachDeadline) { if (stop) stop(); return; } // was showing (or never attached), now gone
    latestReactions = map;
    render();
  });
  if (stop) registerLiveWatcher(badge, stop);
  return badge;
}

// Puts the tally directly under the student's answer box, once.
function attachMyReactions(anchor, answerId, lessonId, prompt) {
  if (!answerId || !anchor.parentElement) return;
  if ([...anchor.parentElement.children].some(c => c.classList.contains("my-answer-reactions"))) return;
  anchor.insertAdjacentElement("afterend", buildMyReactionsBadge(answerId, lessonId, prompt));
}

// "My Answers": every short answer this student has given, across all
// lessons (newest lesson first), each with how classmates reacted to it.
async function openMyAnswersModal() {
  closeModal();
  const myId = await ensureStudentId();
  const all = await getLocalResponses();
  const latest = new Map(); // one entry per question: their most recent answer
  all.filter(r => r.studentId === myId && r.type === "short_answer" && String(r.answer || "").trim())
    .sort((a, b) => String(a.timestamp).localeCompare(String(b.timestamp)))
    .forEach(r => latest.set(`${r.lessonId}\u0001${r.questionPrompt}`, r));
  const byLesson = new Map();
  [...latest.values()].forEach(r => {
    if (!byLesson.has(r.lessonId)) byLesson.set(r.lessonId, []);
    byLesson.get(r.lessonId).push(r);
  });
  const lastStamp = list => list.reduce((m, r) => (String(r.timestamp) > m ? String(r.timestamp) : m), "");
  const groups = [...byLesson.entries()].sort((a, b) => lastStamp(b[1]).localeCompare(lastStamp(a[1])));
  const lookup = new Map(flatLessons().map(o => [o.lesson.id, o]));

  const body = groups.length
    ? groups.map(([lessonId, records]) => {
        const found = lookup.get(lessonId);
        const title = found ? `Unit ${found.unit.number} \u00b7 Lesson ${found.lesson.number} \u2014 ${found.lesson.title}` : (/^\d/.test(lessonId || "") ? `Lesson ${lessonId}` : (lessonId || "Lesson ?"));
        return el("div", { class: "my-answers-lesson" }, [
          el("h3", { class: "my-answers-lesson-title" }, title),
          ...records.map(r => el("div", { class: "my-answer-item" }, [
            el("p", { class: "my-answer-prompt" }, r.questionPrompt),
            el("p", { class: "my-answer-text" }, r.answer),
            buildMyReactionsBadge(r.id, r.lessonId, r.questionPrompt)
          ]))
        ]);
      })
    : [el("p", { class: "empty-note" }, "You haven't answered any short-answer questions yet. When you do, they'll show up here along with how your classmates reacted.")];

  const panel = el("div", { class: "modal-panel", role: "dialog", "aria-modal": "true", "aria-label": "My Answers" }, [
    el("div", { class: "modal-header" }, [
      el("h2", {}, "My Answers"),
      el("button", { type: "button", class: "modal-close", "aria-label": "Close" }, "\u00d7")
    ]),
    el("div", { class: "modal-body notes-body" }, [
      groups.length ? el("p", { class: "my-answers-intro" }, "Your short answers from every lesson, with your classmates' reactions (they update live).") : null,
      ...body
    ])
  ]);
  const overlay = el("div", { class: "modal-overlay" }, panel);
  overlay.addEventListener("click", (e) => { if (e.target === overlay) closeModal(); });
  panel.querySelector(".modal-close").addEventListener("click", closeModal);
  document.body.appendChild(overlay);
  document.addEventListener("keydown", onModalKeydown);
  activeModal = overlay;
}

let myAnswersButtonBound = false;
function mountMyAnswersButton() {
  if (myAnswersButtonBound) return;
  const btn = document.getElementById("my-answers-btn");
  if (!btn) return;
  myAnswersButtonBound = true;
  btn.addEventListener("click", () => openMyAnswersModal());
}

// One classmate's answer with its reaction buttons. Reaction counts update
// live from Firebase.
function buildClassmateCard(answer, myId, life) {
  let state = {}; // reactor -> reaction id
  const bar = el("div", { class: "classmate-reactions" });
  function paint() {
    bar.innerHTML = "";
    CLASSMATE_REACTIONS.forEach(rx => {
      const count = Object.values(state).filter(v => v === rx.id).length;
      const mine = state[myId] === rx.id;
      const btn = el("button", {
        type: "button",
        class: "reaction-btn" + (mine ? " active" : ""),
        "aria-pressed": String(mine),
        "data-reaction": rx.id
      }, `${rx.emoji} ${rx.label}` + (count ? ` \u00b7 ${count}` : ""));
      btn.addEventListener("click", () => {
        if (mine) delete state[myId]; else state[myId] = rx.id;
        paint();
        setMyReaction(answer.id, myId, mine ? null : rx.id);
      });
      bar.appendChild(btn);
    });
  }
  paint();
  const stop = watchReactionsFor(answer.id, map => {
    if (!life.alive()) return;
    state = { ...map };
    paint();
  });
  const card = el("div", { class: "classmate-answer" }, [
    el("p", { class: "classmate-answer-text" }, answer.answer),
    bar
  ]);
  return { card, stop: () => { if (stop) stop(); } };
}

async function buildClassmateAnswersPanel(lessonId, prompt) {
  const myId = await ensureStudentId();
  const isTeacher = myId === TEACHER_VIEW_ID && isTeacherUnlocked();
  const panel = el("div", { class: "classmate-answers" }, [
    el("div", { class: "classmate-answers-title" }, isTeacher ? "What classmates said (teacher preview \u2014 all classes)" : "What your classmates said")
  ]);
  const showNote = text => panel.appendChild(el("p", { class: "classmate-empty" }, text));

  const problem = classmateProblemFor(myId);
  if (problem) { showNote(problem); return panel; }

  const list = el("div", { class: "classmate-list" });
  const emptyNote = el("p", { class: "classmate-empty" }, "No one else in your class has answered this yet.");
  panel.appendChild(list);
  panel.appendChild(emptyNote);

  // Stop listening once this panel has been on screen and then removed
  // (popup closed, lesson changed) — otherwise listeners would pile up.
  const cards = new Map(); // answer id -> { card, stop }
  let stopResponses = null;
  let seenOnScreen = false;
  let dead = false;
  const attachDeadline = Date.now() + 5000; // a panel is attached right after it's built; past this, "not on screen" means it was removed
  const life = {
    alive() {
      if (dead) return false;
      if (panel.isConnected) { seenOnScreen = true; return true; }
      if (!seenOnScreen && Date.now() < attachDeadline) return true; // not attached yet
      dead = true;
      if (stopResponses) stopResponses();
      cards.forEach(c => c.stop());
      return false;
    }
  };

  panel._markAttached = () => { seenOnScreen = true; }; // called the moment the panel is put on the page
  let latestAll = [];
  const recompute = () => {
    if (!life.alive()) return;
    const answers = pickClassmateAnswers(latestAll, lessonId, prompt, myId);
    answers.forEach(a => {
      if (cards.has(a.id)) return;
      const c = buildClassmateCard(a, myId, life);
      cards.set(a.id, c);
      list.appendChild(c.card);
    });
    [...cards.keys()].forEach(id => {
      if (answers.some(a => a.id === id)) return;
      const c = cards.get(id);
      c.card.remove();
      c.stop();
      cards.delete(id);
    });
    emptyNote.style.display = cards.size ? "none" : "";
  };
  registerModerationAware(panel, recompute); // a teacher hiding/approving an answer updates this panel too, live
  stopResponses = watchResponsesFor(prompt, all => { latestAll = all; recompute(); });
  if (!stopResponses) {
    emptyNote.textContent = "Couldn't load classmates' answers right now.";
  }
  return panel;
}

async function showClassmateAnswers(wrap, lessonId, prompt) {
  try {
    const panel = await buildClassmateAnswersPanel(lessonId, prompt);
    if (panel) {
      wrap.appendChild(panel);
      if (panel._markAttached) panel._markAttached();
    }
  } catch (err) {
    console.warn("Could not show classmates' answers:", err);
  }
}

// Resolves a link-question's address: a shortcut name from ASSESSMENT_LINKS, or a full URL.
function resolveAssessmentLink(q, lessonId) {
  const raw = (q.link || "").trim();
  const table = (typeof ASSESSMENT_LINKS !== "undefined") ? ASSESSMENT_LINKS : {};
  const key = raw.toLowerCase().replace(/[^a-z]/g, "");
  const hit = table[key] || Object.entries(table).find(([k]) => k.toLowerCase() === key)?.[1];
  const fill = u => String(u || "").replace(/\{lesson\}/g, encodeURIComponent(lessonId || ""));
  if (hit) return { url: fill(hit.url), label: q.linkLabel || hit.label || "Open" };
  return { url: fill(raw), label: q.linkLabel || "Open assessment" };
}

// ---------- Assessments: linked activities (Hexagon Web, Stock Market Game...) ----------
// Hidden from students by default; the teacher always sees them (tagged when hidden).
function assessmentsForViewer(lesson) {
  const all = (lesson && lesson.assessments) || [];
  return isTeacherId() ? all : all.filter(a => a.visible);
}
function buildAssessmentCard(a, lessonId, compact) {
  const { url, label } = resolveAssessmentLink({ link: a.link, linkLabel: a.linkLabel }, lessonId);
  const ok = /^(https?:\/\/|[\w.\-\/]+\.html?)/i.test(url);
  return el("div", { class: "assessment-card" + (compact ? " compact" : "") }, [
    el("div", { class: "assessment-icon", "aria-hidden": "true" }, el("i", { class: "fa-solid fa-clipboard-check" })),
    el("div", { class: "assessment-text" }, [
      el("span", { class: "assessment-kind" }, [
        "Assessment",
        (!a.visible && isTeacherId()) ? el("span", { class: "assessment-hidden-tag" }, [el("i", { class: "fa-solid fa-eye-slash" }), " Hidden from students"]) : null
      ]),
      el("div", { class: "assessment-title" }, a.title || label),
      a.description ? el("p", { class: "assessment-desc" }, a.description) : null,
      ok
        ? el("a", { class: "assessment-btn", href: url, target: "_blank", rel: "noopener" }, [el("i", { class: "fa-solid fa-arrow-up-right-from-square" }), " " + label])
        : el("p", { class: "quiz-link-missing" }, "This link isn't set up yet (check Assessment Link or ASSESSMENT_LINKS).")
    ])
  ]);
}
function buildAssessmentsBox(lesson) {
  const items = assessmentsForViewer(lesson);
  if (!items.length) return null;
  return el("div", { class: "assessments-box" }, [
    el("div", { class: "assessments-header" }, [el("i", { class: "fa-solid fa-clipboard-check" }), " Assessments", isTeacherId() ? el("span", { class: "assessment-teacher-note" }, "teacher view shows hidden ones too") : null]),
    el("div", { class: "assessments-list" }, items.map(a => buildAssessmentCard(a, lesson.id, false)))
  ]);
}

function buildLinkQuestion(q, lessonId) {
  const { url, label } = resolveAssessmentLink(q, lessonId);
  const wrap = el("div", { class: "quiz-question quiz-link-card" });
  wrap.appendChild(el("div", { class: "quiz-kicker" }, "Check Your Understanding"));
  wrap.appendChild(el("p", { class: "quiz-prompt" }, q.prompt));
  if (/^(https?:\/\/|[\w.\-\/]+\.html?)/i.test(url)) {
    wrap.appendChild(el("a", { class: "quiz-link-btn", href: url, target: "_blank", rel: "noopener" }, [
      el("i", { class: "fa-solid fa-arrow-up-right-from-square" }), " " + label
    ]));
  } else {
    wrap.appendChild(el("p", { class: "quiz-link-missing" }, "This link isn't set up yet (check the Question Link column or ASSESSMENT_LINKS)."));
  }
  return wrap;
}

function buildQuestionWidget(q, objectives, lessonId, onAnswered) {
  if (q.type === "link") return buildLinkQuestion(q, lessonId);
  const wrap = el("div", { class: "quiz-question" });
  wrap.appendChild(el("div", { class: "quiz-kicker" }, "Check Your Understanding"));

  const tags = resolveObjectiveTags(q.objectiveIds, objectives);
  if (tags.length || q.skill) {
    wrap.appendChild(el("div", { class: "quiz-objective-tags" }, [
      q.skill ? el("span", { class: "quiz-objective-tag quiz-skill-tag" }, q.skill) : null,
      ...tags.map(t => el("span", { class: "quiz-objective-tag" }, t))
    ]));
  }

  wrap.appendChild(el("p", { class: "quiz-prompt" }, q.prompt));

  if (q.image) {
    const quizImage = el("img", { class: "quiz-image", src: q.image, alt: "" });
    quizImage.style.cursor = "zoom-in";
    quizImage.addEventListener("click", () => openImageZoomOverlay(q.image, q.prompt));
    wrap.appendChild(quizImage);
  }

  if (q.termGroup) {
    const matches = COURSE_DATA.entities.filter(e => (e.subcategory || "").toLowerCase() === q.termGroup.toLowerCase());
    if (matches.length) {
      wrap.appendChild(el("div", { class: "quiz-term-group" },
        matches.map(e => el("div", { class: "quiz-term-card" }, [
          e.image ? el("img", { class: "quiz-term-card-img", src: e.image, alt: "" }) : null,
          el("div", { class: "quiz-term-card-body" }, [
            el("div", { class: "quiz-term-card-name" }, e.name),
            e.actions && e.actions.length
              ? el("ul", { class: "quiz-term-card-actions" }, e.actions.map(a => el("li", {}, a)))
              : null
          ])
        ]))
      ));
    }
  }

  if (q.type === "short_answer") {
    const textarea = el("textarea", { class: "quiz-answer-input", rows: "3", placeholder: "Type your answer…" });
    const submitBtn = el("button", { type: "button", class: "quiz-reveal-btn" }, "Submit Answer");
    const answerEl = el("p", { class: "quiz-explanation" }, q.sampleAnswer ? `Sample answer: ${q.sampleAnswer}` : "");
    answerEl.style.display = "none";

    submitBtn.addEventListener("click", () => {
      const value = textarea.value.trim();
      if (!value) return;
      textarea.disabled = true;
      submitBtn.style.display = "none";
      if (answerEl.textContent) answerEl.style.display = "block";
      logAnswer({ lessonId, type: "short_answer", questionPrompt: q.prompt, answer: value, correct: null, skill: q.skill })
        .then(rec => { if (rec) attachMyReactions(textarea, rec.id, lessonId, q.prompt); });
      showClassmateAnswers(wrap, lessonId, q.prompt);
      if (onAnswered) onAnswered();
    });

    wrap.appendChild(textarea);
    wrap.appendChild(submitBtn);
    wrap.appendChild(answerEl);

    // A student who already answered this on an earlier visit gets their
    // answer back (locked), plus the classmates' answers — they shouldn't
    // have to answer twice to see them.
    (async () => {
      const myId = getStoredStudentId();
      if (!myId) return;
      const mine = await findMyPreviousAnswer(lessonId, q.prompt, "short_answer");
      if (!mine || textarea.disabled || textarea.value.trim()) return;
      textarea.value = mine.answer;
      textarea.disabled = true;
      submitBtn.style.display = "none";
      if (answerEl.textContent) answerEl.style.display = "block";
      attachMyReactions(textarea, mine.id, lessonId, q.prompt);
      showClassmateAnswers(wrap, lessonId, q.prompt);
      if (onAnswered) onAnswered();
    })();

    return wrap;
  }

  // multiple_choice (default)
  let answered = false;
  const choicesWrap = el("div", { class: "quiz-choices" });

  // Marks the chosen answer right/wrong, shows the right one, locks the
  // choices and shows the explanation. Used both when a student answers
  // and when an earlier answer is put back on screen.
  function showChoiceResult(chosenIndex) {
    const isCorrect = chosenIndex === q.correctIndex;
    const chosenBtn = choicesWrap.children[chosenIndex];
    if (chosenBtn) chosenBtn.classList.add(isCorrect ? "correct" : "incorrect");
    if (!isCorrect) {
      const correctBtn = choicesWrap.children[q.correctIndex];
      if (correctBtn) correctBtn.classList.add("correct");
    }
    [...choicesWrap.children].forEach(c => { c.disabled = true; });
    if (q.explanation) {
      wrap.appendChild(el("p", { class: "quiz-explanation" }, q.explanation));
    }
    return isCorrect;
  }

  (q.choices || []).forEach((choice, i) => {
    const btn = el("button", { type: "button", class: "quiz-choice" }, choice);
    btn.addEventListener("click", () => {
      if (answered) return;
      answered = true;
      const isCorrect = showChoiceResult(i);
      logAnswer({ lessonId, type: "multiple_choice", questionPrompt: q.prompt, answer: choice, correct: isCorrect, skill: q.skill });
      if (onAnswered) onAnswered();
    });
    choicesWrap.appendChild(btn);
  });
  wrap.appendChild(choicesWrap);

  // Already answered this one (earlier visit, or another device with the
  // same student ID)? Show that answer instead of a blank question.
  (async () => {
    const mine = await findMyPreviousAnswer(lessonId, q.prompt, "multiple_choice");
    if (!mine || answered) return;
    const idx = (q.choices || []).indexOf(mine.answer);
    if (idx < 0) return; // the choices were edited since — start fresh
    answered = true;
    showChoiceResult(idx);
    if (onAnswered) onAnswered();
  })();

  return wrap;
}

// Wraps a question widget so it starts hidden behind a "Show Question"
// button — used everywhere a question can appear (inline in a reading,
// below a video, below an image/gallery, and in the standalone "Check
// Your Understanding" list), so nothing tips off the answer or even the
// question itself until someone chooses to look.
// Renders two or more questions as a one-at-a-time sequence: answer the
// first, a "Next Question" button appears, which swaps in the next —
// same shape as a mini quiz, rather than showing every question in the
// group at once. Used wherever two+ questions share a "group" name.
function buildQuestionSequence(questions, objectives, lessonId) {
  const container = el("div", { class: "quiz-sequence" });
  const progress = el("div", { class: "quiz-sequence-progress" }, "");
  container.appendChild(progress);

  let index = 0;

  function showCurrent() {
    [...container.querySelectorAll(".quiz-question, .quiz-sequence-next")].forEach(n => n.remove());
    progress.textContent = `Question ${index + 1} of ${questions.length}`;
    const widget = buildQuestionWidget(questions[index], objectives, lessonId, onAnswered);
    container.appendChild(widget);
  }

  function onAnswered() {
    if (index >= questions.length - 1) return; // last one answered, sequence complete
    const nextBtn = el("button", { type: "button", class: "quiz-sequence-next" }, "Next Question \u2192");
    nextBtn.addEventListener("click", () => { index++; showCurrent(); });
    container.appendChild(nextBtn);
  }

  showCurrent();
  return container;
}

// Splits a list of questions (already filtered to one spot — one
// paragraph, one video, one gallery, or all of a lesson's Do Now
// questions) into clusters: questions sharing the same non-blank
// "group" become one cluster to be answered as a sequence; anything
// without a group (or a group unique to itself) stays its own
// single-question cluster, rendered exactly as before.
function groupQuestions(questions) {
  const clusters = [];
  const byGroup = new Map();
  questions.forEach(q => {
    if (q.group) {
      if (byGroup.has(q.group)) {
        byGroup.get(q.group).push(q);
      } else {
        const cluster = [q];
        byGroup.set(q.group, cluster);
        clusters.push(cluster);
      }
    } else {
      clusters.push([q]);
    }
  });
  return clusters;
}

// Wraps a question widget (or, for a group of 2+, a sequence) so it
// starts hidden behind a "Show Question(s)" button — used everywhere a
// question can appear (inline in a reading, below a video, below an
// image/gallery, and in the standalone "Check Your Understanding"
// list), so nothing tips off the answer or even the question itself
// until someone chooses to look.
function buildRevealableQuestion(qOrGroup, objectives, lessonId) {
  const isGroup = Array.isArray(qOrGroup) && qOrGroup.length > 1;
  const single = Array.isArray(qOrGroup) ? qOrGroup[0] : qOrGroup;
  if (!isGroup && single.type === "link") return buildLinkQuestion(single, lessonId); // no reveal step needed
  const widget = isGroup
    ? buildQuestionSequence(qOrGroup, objectives, lessonId)
    : buildQuestionWidget(single, objectives, lessonId);
  widget.style.display = "none";

  const revealBtn = el("button", { type: "button", class: "quiz-reveal-question-btn" }, [
    el("i", { class: "fa-solid fa-circle-question" }),
    isGroup ? ` Show Questions (${qOrGroup.length})` : " Show Question"
  ]);
  revealBtn.addEventListener("click", () => {
    widget.style.display = "";
    revealBtn.remove();
  });

  return el("div", { class: "quiz-reveal-wrap" }, [revealBtn, widget]);
}

// Renders one paragraph, wrapping any curated "What You Need to Know" term
// as a clickable glossary button (instant, local lookup). Every other word
// is plain text — a live dictionary lookup for arbitrary words used to sit
// here too, but was removed since the free API it depended on wasn't
// reliably reachable.
// Recognizes a small set of prefixes at the start of a block of reading
// text (blocks are separated by a blank line, or by ||| in the sheet), so a
// reading can mix headings, poems, lists and so on in with regular
// paragraphs -- easy to type directly into a spreadsheet cell.
//   # Text         -> Heading 1
//   ## Text        -> Heading 2
//   ### Text       -> Heading 3 (a small subheading)
//   > Text         -> Block quote
//   ~ line // line -> Poem / verse: one stanza, line breaks kept
//   ^ Text         -> Centered text (a poem's title, an epigraph)
//   -- Text        -> Attribution, right-aligned, with a dash in front
//   - item // item -> Bulleted list
//   ! Text         -> Callout / note box
//   ---            -> A divider line
//   (anything else) -> a regular paragraph
// Line breaks inside a poem or a list are written as " // " (works in a
// one-line cell) or as a real line break (Alt+Enter in a Sheets cell).
function splitBlockLines(text) {
  return String(text).split(/\r?\n|[ \t]+\/\/(?=[ \t]|$)[ \t]?/).map(l => l.replace(/\s+$/, "")).filter(l => l.trim() !== "");
}
function classifyReadingBlock(raw) {
  const trimmed = raw.trim();
  if (/^-{3,}$/.test(trimmed)) return { kind: "divider", tag: "hr", cls: "reading-divider", text: "" };
  if (trimmed.startsWith("### ")) return { kind: "text", tag: "h5", cls: "reading-h3", text: trimmed.slice(4).trim() };
  if (trimmed.startsWith("## ")) return { kind: "text", tag: "h4", cls: "reading-h2", text: trimmed.slice(3).trim() };
  if (trimmed.startsWith("# ")) return { kind: "text", tag: "h3", cls: "reading-h1", text: trimmed.slice(2).trim() };
  if (trimmed.startsWith("> ")) return { kind: "text", tag: "blockquote", cls: "reading-blockquote", text: trimmed.slice(2).trim() };
  if (trimmed.startsWith("~ ")) return { kind: "text", tag: "p", cls: "reading-poem", text: splitBlockLines(trimmed.slice(2).replace(/^\s+/, "")).join("\n") };
  if (trimmed.startsWith("^ ")) return { kind: "text", tag: "p", cls: "reading-centered", text: trimmed.slice(2).trim() };
  if (trimmed.startsWith("-- ")) return { kind: "text", tag: "p", cls: "reading-attribution", text: "— " + trimmed.slice(3).trim() };
  if (trimmed.startsWith("- ")) {
    const items = splitBlockLines(trimmed).map(l => l.trim().replace(/^-\s+/, "")).filter(Boolean);
    return { kind: "list", tag: "ul", cls: "reading-list", items, text: items.join("\n") };
  }
  if (trimmed.startsWith("! ")) return { kind: "text", tag: "p", cls: "reading-callout", text: trimmed.slice(2).trim() };
  return { kind: "text", tag: "p", cls: null, text: trimmed };
}

// Renders one paragraph, wrapping any curated "What You Need to Know" term
// as a glossary button (instant, local lookup) and every other word as a
// dictionary-lookup button (looked up live via a free dictionary API).
// Renders one paragraph. Any span matching an entity from COURSE_DATA.entities
// (not just this lesson's curated key terms) becomes clickable and shows
// that entity's own definition — styled boldly if it's a key term for THIS
// lesson, plainly (just a dotted underline on hover) otherwise. Ordinary
// text that doesn't match any entity is just plain, non-interactive text —
// there's no live dictionary lookup for arbitrary words.
function renderInteractiveParagraph(text, glossary, onGlossaryClick, tag = "p", cls = null) {
  const p = el(tag, cls ? { class: cls } : {});
  if (!glossary) {
    p.appendChild(document.createTextNode(text));
    return p;
  }

  const { regex, lookup } = glossary;
  let lastIndex = 0;
  regex.lastIndex = 0;
  let match;
  while ((match = regex.exec(text)) !== null) {
    if (match.index > lastIndex) {
      p.appendChild(document.createTextNode(text.slice(lastIndex, match.index)));
    }
    const matched = match[0];
    const termData = lookup.get(matched.toLowerCase());
    const btn = el("button", { type: "button", class: termData.featured ? "glossary-term" : "word-term" }, matched);
    btn.addEventListener("click", () => onGlossaryClick(termData));
    p.appendChild(btn);
    lastIndex = match.index + matched.length;
  }
  if (lastIndex < text.length) p.appendChild(document.createTextNode(text.slice(lastIndex)));

  return p;
}

// ---------- My Notes storage ----------
// Works three ways, most-preferred first, with no extra setup needed:
//  1. Inside Claude's canvas/artifact preview, window.storage — if it's
//     working. That bridge occasionally errors out ("Unexpected response
//     type"), so every call is guarded and falls through rather than
//     losing data.
//  2. Plain localStorage, in the visitor's own browser — this is what the
//     real, hosted site always uses (window.storage doesn't exist there).
//  3. In-memory only, for the current session, if both of the above throw —
//     things still work while you're on the page, they just won't survive
//     a reload.
const NOTES_KEY = "usHistoryNotes";
const LABELS_KEY = "usHistoryLabels"; // [{ name, color }] — created once per label, reused by notes

async function loadJSON(key, fallback) {
  try {
    const raw = localStorage.getItem(key);
    return raw ? JSON.parse(raw) : fallback;
  } catch {
    return fallback;
  }
}

async function saveJSON(key, value) {
  try {
    localStorage.setItem(key, JSON.stringify(value));
  } catch (err) {
    console.warn(`localStorage unavailable for ${key} — data will only last this session:`, err);
  }
}

let notesCache = null;

async function getNotes() {
  if (notesCache === null) {
    const local = await loadJSON(NOTES_KEY, []);
    notesCache = local;

    // Local storage is the fast, offline-friendly copy, but it isn't
    // always reliable (browser settings, private browsing, switching
    // devices). If a note made it to Firebase but isn't in the local
    // copy, pull it back in here and re-save locally so this student
    // sees their own notes/highlights even when local storage dropped
    // them — Firebase is the more durable record once something's
    // synced there at all.
    const studentId = getStoredStudentId();
    if (studentId && ensureFirebase()) {
      try {
        const firebaseNotes = await getFirebaseNotes();
        if (firebaseNotes) {
          const localIds = new Set(local.map(n => n.id));
          const missingFromLocal = firebaseNotes.filter(n => n.studentId === studentId && n.id && !localIds.has(n.id));
          if (missingFromLocal.length) {
            notesCache = [...missingFromLocal, ...local];
            await saveJSON(NOTES_KEY, notesCache);
          }
        }
      } catch (err) {
        console.warn("Could not merge in this student's Firebase notes:", err);
      }
    }
  }
  return notesCache;
}

async function addNote(note) {
  note.studentId = await ensureStudentId();

  const notes = await getNotes();
  notes.unshift(note);
  notesCache = notes;
  await saveJSON(NOTES_KEY, notes);
  updateNotesBadge();

  if (ensureFirebase()) {
    try {
      await firebase.database().ref("notes").push(note);
    } catch (err) {
      console.warn("Could not sync this note to Firebase:", err);
    }
  }
}

// One-time fetch of every annotation currently in Firebase — used by
// Teacher View so it shows every student's notes, not just this
// device's own. Returns null (not an empty array) if Firebase isn't
// configured/reachable, mirroring getFirebaseResponses().
async function getFirebaseNotes() {
  if (!ensureFirebase()) return null;
  try {
    const snapshot = await firebase.database().ref("notes").once("value");
    const data = snapshot.val() || {};
    return Object.values(data);
  } catch (err) {
    console.warn("Could not fetch live notes from Firebase:", err);
    return null;
  }
}

// Wipes every annotation from Firebase — irreversible, only called after
// the two-click confirm in the Teacher View annotations tab.
async function clearFirebaseNotes() {
  if (!ensureFirebase()) return false;
  try {
    await firebase.database().ref("notes").remove();
    return true;
  } catch (err) {
    console.warn("Could not clear notes from Firebase:", err);
    return false;
  }
}

// Removes only the given notes (by their own "id" field, not Firebase's
// own push key) from Firebase — used by "Clear Shown" when a lesson
// filter is active, so clearing doesn't wipe every student's annotation
// on every lesson. Firebase's own keys aren't the same as note.id, so
// this reads the current data first to map id -> Firebase key, then
// removes just those keys in one multi-path update.
async function removeFirebaseNotes(idsToRemove) {
  if (!ensureFirebase()) return false;
  try {
    const snapshot = await firebase.database().ref("notes").once("value");
    const data = snapshot.val() || {};
    const updates = {};
    Object.entries(data).forEach(([key, note]) => {
      if (note && idsToRemove.has(note.id)) updates[key] = null;
    });
    if (Object.keys(updates).length) {
      await firebase.database().ref("notes").update(updates);
    }
    return true;
  } catch (err) {
    console.warn("Could not remove the selected notes from Firebase:", err);
    return false;
  }
}

async function removeNote(id) {
  const notes = await getNotes();
  notesCache = notes.filter(n => n.id !== id);
  await saveJSON(NOTES_KEY, notesCache);
  updateNotesBadge();
}

async function saveNotesToStorage(notes) {
  await saveJSON(NOTES_KEY, notes);
}

// ---------- Label registry (each label is created once, with one color) ----------
let labelsCache = null;

async function getLabels() {
  if (labelsCache === null) labelsCache = await loadJSON(LABELS_KEY, []);
  return labelsCache;
}

// Creates the label if it's new, or updates its color if it already exists.
async function upsertLabel(name, color) {
  const labels = await getLabels();
  const existing = labels.find(l => l.name.toLowerCase() === name.toLowerCase());
  if (existing) {
    existing.color = color;
  } else {
    labels.push({ name, color });
  }
  labelsCache = labels;
  await saveJSON(LABELS_KEY, labels);
}

function flashSavedToast(message = "Saved to notes") {
  const toast = el("div", { class: "save-toast" }, message);
  document.body.appendChild(toast);
  requestAnimationFrame(() => toast.classList.add("show"));
  const displayTime = message.length > 30 ? 2600 : 1200;
  setTimeout(() => {
    toast.classList.remove("show");
    setTimeout(() => toast.remove(), 300);
  }, displayTime);
}

// Bottom-sheet picker shown right after "+ Save to Notes" is tapped, so the
// label and color are chosen at save time. Calls onConfirm({label, color})
// only if the person actually taps Save; Cancel just dismisses it.
// Reusable widget: a dropdown of already-created labels, plus "+ New label…".
// Color swatches only appear while creating a new label — picking an
// existing label locks the color to whatever that label was created with.
// onApply(...) fires whenever a concrete choice is made (an existing label
// picked, or a new label's name is confirmed), NOT on every keystroke.
function buildLabelPicker(labels, currentLabel, currentColor, onApply, allowNew = true) {
  let selectedColor = currentColor || "brass";
  let initialized = false;
  const sortedLabels = labels.slice().sort((a, b) => a.name.localeCompare(b.name));
  const currentIsExisting = currentLabel && sortedLabels.some(l => l.name.toLowerCase() === currentLabel.toLowerCase());
  // With no "+ New label…" option to fall back to, something still
  // needs to be selected by default — the first available label.
  const defaultExistingSelection = (!currentIsExisting && !allowNew && sortedLabels.length) ? sortedLabels[0].name : null;

  const select = el("select", { class: "label-picker-select" }, [
    ...sortedLabels.map(l =>
      el("option", {
        value: l.name,
        selected: ((currentIsExisting && l.name === currentLabel) || l.name === defaultExistingSelection) ? "true" : null
      }, l.name)
    ),
    allowNew ? el("option", { value: "__new__", selected: !currentIsExisting ? "true" : null }, "+ New label…") : null
  ].filter(Boolean));

  const newNameInput = el("input", {
    type: "text",
    class: "note-label-input",
    placeholder: "New label name",
    value: (!currentIsExisting && currentLabel) ? currentLabel : ""
  });

  const colorPreview = el("span", { class: "label-color-preview" });

  const swatches = el("div", { class: "note-swatches" },
    NOTE_COLORS.map(c => {
      const dot = el("button", {
        type: "button",
        class: "note-swatch" + (c.id === selectedColor ? " selected" : ""),
        style: `background:${c.hex};`,
        "aria-label": `Set color to ${c.id}`
      });
      dot.addEventListener("click", () => {
        selectedColor = c.id;
        swatches.querySelectorAll(".note-swatch").forEach(s => s.classList.remove("selected"));
        dot.classList.add("selected");
        maybeApplyNew();
      });
      return dot;
    })
  );

  function maybeApplyNew() {
    const name = newNameInput.value.trim();
    if (name) onApply({ label: name, color: selectedColor, isNew: true });
  }

  function refreshMode() {
    const isNew = allowNew && select.value === "__new__";
    newNameInput.style.display = isNew ? "block" : "none";
    swatches.style.display = isNew ? "flex" : "none";
    colorPreview.style.display = isNew ? "none" : "inline-block";
    if (!isNew) {
      const found = sortedLabels.find(l => l.name === select.value);
      selectedColor = found ? found.color : "brass";
      colorPreview.style.background = colorHex(selectedColor);
      // Normally the initial selection doesn't fire onApply (nothing's
      // been chosen yet) — but with no "+ New label…" to fall back to,
      // the pre-selected default IS the choice, so it needs to count
      // immediately rather than waiting for a change that may never come.
      if (initialized || !allowNew) onApply({ label: select.value, color: selectedColor, isNew: false });
    }
  }

  select.addEventListener("change", refreshMode);
  newNameInput.addEventListener("blur", maybeApplyNew);

  refreshMode();
  initialized = true;

  const container = el("div", { class: "label-picker" }, [select, colorPreview, newNameInput, swatches]);
  return { container };
}

// Resolves a lesson's raw preset labels (name + optional color from the
// sheet) into a list with every color filled in — any preset left
// without one gets one assigned automatically, cycling through the
// palette by position. Shared by mergePresetLabels and the "restricted"
// path in openSaveSheet/openImageSaveSheet.
function resolvedPresetLabels(lesson) {
  const presetLabels = (lesson && lesson.presetLabels) || [];
  const validColorIds = NOTE_COLORS.map(c => c.id);
  return presetLabels.map((p, i) => ({
    name: p.name,
    color: (p.color && validColorIds.includes(p.color)) ? p.color : NOTE_COLORS[i % NOTE_COLORS.length].id
  }));
}

// Merges a lesson's preset labels (from its sheet) with whatever labels
// the student has already made themselves on this device — a preset
// takes priority if its name collides with one the student made
// locally (the sheet's choice wins). Shared by openSaveSheet and
// openImageSaveSheet so both offer the same presets.
function mergePresetLabels(localLabels, lesson) {
  const presetsWithColor = resolvedPresetLabels(lesson);
  const presetNamesLower = new Set(presetsWithColor.map(p => p.name.toLowerCase()));
  return [...presetsWithColor, ...localLabels.filter(l => !presetNamesLower.has(l.name.toLowerCase()))];
}

// True if this student's Roster row has "Restrict to Preset Labels"
// checked — meaning, for any lesson that actually has presets defined,
// they only ever see THAT lesson's presets: never their own
// previously-made labels, and no way to invent a new one. A lesson
// with no presets falls back to the normal experience instead of
// leaving them with nothing to pick.
function isStudentRestrictedToPresets() {
  const studentId = getStoredStudentId();
  return !!(studentId && (COURSE_DATA.restrictedToPresetLabels || {})[studentId]);
}

// Decides what a save-sheet's label picker should offer for this
// lesson: if the current student is restricted AND this lesson has
// presets defined, only those presets, with no way to add a new one;
// otherwise the normal merged set (presets + the student's own local
// labels), with the ability to create new ones, same as always.
function labelPickerOptionsFor(localLabels, lesson) {
  const presets = resolvedPresetLabels(lesson);
  if (isStudentRestrictedToPresets() && presets.length) {
    return { labels: presets, allowNew: false };
  }
  return { labels: mergePresetLabels(localLabels, lesson), allowNew: true };
}

function openSaveSheet(quote, onSaved, lesson) {
  document.querySelectorAll(".save-sheet-overlay").forEach(e => e.remove());

  const preview = el("p", { class: "save-sheet-quote" },
    quote.length > 160 ? quote.slice(0, 160) + "…" : quote
  );

  let current = { label: "", color: "brass" };

  const cancelBtn = el("button", { type: "button", class: "sheet-btn sheet-cancel" }, "Cancel");
  const confirmBtn = el("button", { type: "button", class: "sheet-btn sheet-save" }, "Save to Notes");

  const sheet = el("div", { class: "save-sheet" }, [
    el("div", { class: "save-sheet-handle" }),
    preview,
    el("div", { class: "label-picker-slot" }) // filled in once labels have loaded
  ]);
  const overlay = el("div", { class: "save-sheet-overlay" }, sheet);
  overlay.addEventListener("click", (e) => { if (e.target === overlay) overlay.remove(); });
  cancelBtn.addEventListener("click", () => overlay.remove());
  document.body.appendChild(overlay);

  getLabels().then(labels => {
    const { labels: pickerLabels, allowNew } = labelPickerOptionsFor(labels, lesson);
    const picker = buildLabelPicker(pickerLabels, null, "brass", (sel) => { current = sel; }, allowNew);
    const slot = sheet.querySelector(".label-picker-slot");
    slot.replaceWith(picker.container);
    sheet.appendChild(el("div", { class: "save-sheet-actions" }, [cancelBtn, confirmBtn]));
  });

  confirmBtn.addEventListener("click", async () => {
    if (current.label) {
      await upsertLabel(current.label, current.color);
    }
    onSaved(current);
    overlay.remove();
  });
}

