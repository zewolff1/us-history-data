// Do Now and Rate Lesson share one group in the masthead, with a divider
// on either side; if a lesson has neither to offer, the group (and its
// dividers) disappears instead of leaving an empty gap.
function updateLessonButtonGroupVisibility() {
  const group = document.getElementById("masthead-lesson-group");
  if (group) {
    const doNowBtn = document.getElementById("do-now-btn");
    const hexBtn = document.getElementById("hexagon-btn");
    const notesBtn = document.getElementById("notes-link-btn");
    const vis = b => b && b.style.display !== "none";
    group.style.display = (vis(doNowBtn) || vis(hexBtn) || vis(notesBtn)) ? "" : "none";
  }
  updateMastheadGroupDividers();
}

// A group's divider only makes sense if something visible comes before
// it. Since a group can be hidden entirely (Do Now, or Teacher View for a
// non-teacher), :first-child alone isn't reliable -- the first DOM group
// can be the hidden one, which would leave the next visible group with a
// stray leading divider. Re-run this whenever a group's visibility
// might have changed, and the right group gets flagged as the true first
// one on screen.
function updateMastheadGroupDividers() {
  const groups = [...document.querySelectorAll(".masthead-btn-group")];
  let seenVisible = false;
  groups.forEach(g => {
    const visible = g.style.display !== "none" && g.children.length > 0;
    g.classList.toggle("masthead-btn-group-leading", visible && !seenVisible);
    if (visible) seenVisible = true;
  });
}

// Unlike the other masthead buttons (bound once, never change), this
// one's visibility depends on the CURRENT lesson and whether this
// student has already rated it — so it's re-checked every time a
// lesson renders, not just once at page load.
async function updateRateLessonButtonVisibility(lesson) {
  const btn = document.getElementById("rate-lesson-btn");
  if (!btn) return;
  btn.style.display = "none"; // hidden while checking, so it never flashes on before we know
  const studentId = getStoredStudentId();
  if (!studentId || !lesson) return;
  const responses = await getLocalResponses();
  const alreadyRated = responses.some(r => r.studentId === studentId && r.lessonId === lesson.id && r.type === "rating");
  if (!alreadyRated) btn.style.display = "";
}

