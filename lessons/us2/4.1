async function copyToClipboard(text) {
  try {
    await navigator.clipboard.writeText(text);
    return true;
  } catch {
    return false;
  }
}

function buildResponsesTsv(responses) {
  const header = ["Timestamp", "Student ID", "Student Name", "Lesson ID", "Type", "Question", "Answer", "Correct", "Skill"].join("\t");
  const rows = responses.map(r =>
    [r.timestamp, r.studentId, (COURSE_DATA.rosterNames || {})[r.studentId] || "", r.lessonId, r.type, r.questionPrompt, r.answer, r.correct, r.skill]
      .map(v => String(v || "").replace(/\t/g, " ").replace(/\n/g, " "))
      .join("\t")
  );
  return [header, ...rows].join("\n");
}

function buildNotesTsv(notes) {
  const header = ["Saved At", "Student ID", "Student Name", "Unit", "Lesson", "Reading", "Label", "Quote"].join("\t");
  const rows = notes.map(n =>
    [n.savedAt, n.studentId, (COURSE_DATA.rosterNames || {})[n.studentId] || "", n.unitTitle, n.lessonTitle, n.readingTitle || "", n.label || "", n.quote || (n.imageData ? "[Image annotation]" : "")]
      .map(v => String(v || "").replace(/\t/g, " ").replace(/\n/g, " "))
      .join("\t")
  );
  return [header, ...rows].join("\n");
}

// Lets a student jump straight to any lesson in any unit, not just step
// through with Prev/Next. On the linear stepper (index.html), this jumps
// in place via currentGoToStep — set by renderStep() — so Prev/Next still
// works normally afterward. On the standalone lesson page, where there's
// no stepper to jump within, it just navigates to that lesson's URL.
// Shared by both places teacher tools show up: the lesson picker (only
// on the very first, automatic page-load open) and the Teacher View
// modal (every time, since only a teacher ID ever reaches that modal).
function buildTeacherToolsLinks() {
  return el("div", { class: "teacher-tools-links" }, [
    el("a", { class: "teacher-tool-link", href: "https://sites.google.com/nplainfield.org/us2sources/make-readings", target: "_blank", rel: "noopener noreferrer" }, "Make Readings"),
    el("a", { class: "teacher-tool-link", href: "https://sites.google.com/nplainfield.org/us2sources/make-formative-questions", target: "_blank", rel: "noopener noreferrer" }, "Make Formative Questions")
  ]);
}

function openLessonPickerModal(onDismiss, showTeacherTools = false) {
  closeModal();
  let selected = false;

  const isTeacher = isTeacherId();
  const teacherToolsSection = (isTeacher && showTeacherTools)
    ? el("div", { class: "lesson-picker-teacher-tools" }, [
        el("div", { class: "lesson-picker-unit-title" }, "Teacher Tools"),
        buildTeacherToolsLinks()
      ])
    : null;

  const unitsWithLessons = COURSE_DATA.units.filter(unit => unit.lessons.length);

  // Defaults to whichever unit contains the lesson currently being
  // viewed, so switching units to browse doesn't also lose your place.
  let activeUnitIndex = unitsWithLessons.findIndex(unit => unit.lessons.some(l => l.id === currentLessonId));
  if (activeUnitIndex < 0) activeUnitIndex = 0;

  function makeLessonButton(lsn) {
    const btn = el("button", {
      type: "button",
      class: "lesson-picker-item" + (lsn.id === currentLessonId ? " active" : "") + (lsn.icon ? " has-icon" : "")
    }, [
      lsn.icon ? el("img", { class: "lesson-picker-icon", src: lsn.icon, alt: "" }) : null,
      el("span", { class: "lesson-picker-number" }, lsn.number),
      el("span", { class: "lesson-picker-title" }, lsn.title)
    ]);
    btn.addEventListener("click", () => {
      selected = true;
      closeModal();
      goToLesson(lsn.id);
    });
    return btn;
  }

  const unitPanels = unitsWithLessons.map((unit, i) => {
    const panel = el("div", { class: "lesson-picker-unit" }, [
      el("div", { class: "lesson-picker-unit-title" }, [unit.icon ? el("img", { class: "picker-unit-icon", src: unit.icon, alt: "" }) : null, `Unit ${unit.number} \u2014 ${unit.title}`]),
      el("div", { class: "lesson-picker-lessons" }, unit.lessons.map(makeLessonButton))
    ]);
    panel.style.display = i === activeUnitIndex ? "" : "none";
    return panel;
  });

  const unitTabs = unitsWithLessons.map((unit, i) =>
    el("button", { type: "button", class: "picker-tab" + (i === activeUnitIndex ? " active" : "") }, [unit.icon ? el("img", { class: "picker-tab-icon", src: unit.icon, alt: "" }) : null, `Unit ${unit.number}`])
  );
  unitTabs.forEach((tabBtn, i) => {
    tabBtn.addEventListener("click", () => {
      unitTabs.forEach((b, j) => b.classList.toggle("active", j === i));
      unitPanels.forEach((p, j) => { p.style.display = j === i ? "" : "none"; });
    });
  });
  const tabRow = unitTabs.length > 1 ? el("div", { class: "picker-tabs" }, unitTabs) : null;

  const panel = el("div", { class: "modal-panel", role: "dialog", "aria-modal": "true", "aria-label": "Change Lesson" }, [
    el("div", { class: "modal-header" }, [
      el("h2", {}, "Change Lesson"),
      el("button", { type: "button", class: "modal-close", "aria-label": "Close" }, "×")
    ]),
    el("div", { class: "modal-body notes-body" }, [
      teacherToolsSection,
      tabRow,
      ...(unitPanels.length ? unitPanels : [el("p", { class: "empty-note" }, "No lessons yet.")])
    ].filter(Boolean))
  ]);

  const overlay = el("div", { class: "modal-overlay" }, panel);
  overlay.addEventListener("click", (e) => { if (e.target === overlay) closeModal(); });
  panel.querySelector(".modal-close").addEventListener("click", closeModal);

  document.body.appendChild(overlay);
  document.addEventListener("keydown", onModalKeydown);
  activeModal = overlay;

  if (onDismiss) {
    modalCleanup = () => { if (!selected) onDismiss(); };
  }
}

