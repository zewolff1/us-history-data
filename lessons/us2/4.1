    { id: "e3", name: "Andrew Carnegie", category: "person", definition: "Steel magnate who pioneered vertical integration and authored \"The Gospel of Wealth.\"", image: "images/andrew-carnegie.jpg" },
    { id: "e4", name: "John D. Rockefeller", category: "person", definition: "Founder of Standard Oil; used horizontal integration to dominate the oil refining industry.", image: "images/john-d-rockefeller.jpg" },
    { id: "e5", name: "Reconstruction", category: "topic", definition: "The 1865–1877 period during which the federal government set the terms for readmitting the former Confederate states.", image: "images/reconstruction-term.jpg" },
    { id: "e6", name: "Radical Republicans", category: "topic", definition: "A faction of Congress that pushed for aggressive federal intervention to secure Black civil rights in the South.", image: "images/radical-republicans-term.jpg" },
    { id: "e7", name: "Black Codes", category: "topic", definition: "Laws passed by Southern states in 1865–66 to restrict the freedom and labor of formerly enslaved people.", image: "images/black-codes-term.jpg" },
    { id: "e8", name: "Sharecropping", category: "topic", definition: "A farming system where landless farmers worked land for a share of the crop, often trapping them in debt.", image: "images/sharecropping-term.jpg" },
    { id: "e9", name: "40 Acres and a Mule", category: "topic", definition: "Special Field Order No. 15 (1865), a promise of land redistribution that was later revoked.", image: "images/forty-acres-term.jpg" },
    { id: "e10", name: "Vertical Integration", category: "topic", definition: "Controlling every stage of production, from raw materials to finished product (Carnegie's steel model).", image: "images/vertical-integration-term.jpg" },
    { id: "e11", name: "Horizontal Integration", category: "topic", definition: "Buying out competitors in the same industry to control the market (Rockefeller's oil trusts).", image: "images/horizontal-integration-term.jpg" },
    { id: "e12", name: "Social Darwinism", category: "topic", definition: "The application of 'survival of the fittest' to justify economic inequality.", image: "images/social-darwinism-term.jpg" }
  ],

  // ---- Course inquiries: big questions the whole year returns to ---------
  // (these replace per-lesson "essential questions" — see inquiryFocus below)
  inquiries: [
    { id: "inq1", question: "What impacts do new technologies have on people's lives?" },
    { id: "inq2", question: "How does racism and discrimination impact marginalized people?" },
    { id: "inq3", question: "How do people use protest and resistance to create change?" },
    { id: "inq4", question: "What impacts people's support for a war?" },
    { id: "inq5", question: "To what extent is the American Dream achievable?" }
  ],

  // ---- Master timeline: every event in the whole course, in order -------
  timeline: [
    { id: "t1", date: "Jan 1865", title: "Special Field Order No. 15", details: "Special Field Order No. 15 sets aside land for freed families." },
    { id: "t2", date: "Apr 1865", title: "Lincoln Assassinated", details: "Lincoln assassinated; Andrew Johnson becomes president." },
    { id: "t3", date: "Dec 1865", title: "13th Amendment Ratified", details: "13th Amendment ratified, abolishing slavery." },
    { id: "t4", date: "1866", title: "Black Codes Begin", details: "Southern states begin passing Black Codes." },
    { id: "t5", date: "1866", title: "Special Field Order No. 15 Revoked", details: "Special Field Order No. 15 revoked; land returned to former owners." },
    { id: "t6", date: "Mar 1867", title: "Reconstruction Acts Passed", details: "Congress passes the Reconstruction Acts over Johnson's veto." },
    { id: "t7", date: "1870", title: "Standard Oil Founded", details: "Standard Oil founded by John D. Rockefeller." },
