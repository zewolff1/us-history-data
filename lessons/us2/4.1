      "--title-pattern": 'url("data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2714%27 height=%2714%27%3E%3Ccircle cx=%277%27 cy=%277%27 r=%271.1%27 fill=%27%23fff%27 fill-opacity=%270.2%27/%3E%3C/svg%3E")',
      "--edge-pattern": 'url("data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2736%27 height=%2714%27%3E%3Cpath d=%27M0 0H36L33 6L30 0L26 12L22 0L17 8L13 0L8 14L4 0Z%27 fill=%27%23BBD9F4%27 stroke=%27%231F4E79%27 stroke-opacity=%27.45%27 stroke-width=%27.7%27/%3E%3C/svg%3E")',
