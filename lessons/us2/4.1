      "--card": "#F6FAFD", "--brass": "#7FB2E5", "--brass-light": "#BBD9F4", "--stamp": "#1F4E79",
      "--forest": "#2E7D9A", "--rule": "rgba(11, 26, 42, 0.2)", "--shadow": "rgba(11, 26, 42, 0.3)", "--focus": "#1D5FA8",
      "--font-display": "'Comfortaa', Georgia, sans-serif",
      "--page-pattern": 'url("data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2760%27 height=%2760%27%3E%3Cg stroke=%27%231F4E79%27 stroke-opacity=%27.08%27 stroke-width=%271.2%27 stroke-linecap=%27round%27 fill=%27none%27%3E%3Cpath d=%27M30 14V46M16 22L44 38M44 22L16 38%27/%3E%3Cpath d=%27M26 17L30 21L34 17M26 43L30 39L34 43%27/%3E%3C/g%3E%3Ccircle cx=%275%27 cy=%275%27 r=%271.3%27 fill=%27%231F4E79%27 fill-opacity=%27.1%27/%3E%3Ccircle cx=%2755%27 cy=%2755%27 r=%271.3%27 fill=%27%231F4E79%27 fill-opacity=%27.1%27/%3E%3C/svg%3E")',
