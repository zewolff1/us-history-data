    h("div",{},"URL for the Lessons List tab: ",h("code",{style:"word-break:break-all"},url))));
  return box;}
async function loadLessonsList(){
  try{const r=await fetch(LESSONS_LIST_URL);if(!r.ok)throw 0;const rows=parseCsv(await r.text()).map(normalizeRow);
    LESSONS.length=0;rows.forEach(r=>{const id=(r.lesson||r.lessonid||r.id||"").trim();if(!id)return;
      const un=(r.unitnumber||"").trim()||((r.unit||"").match(/\d+/)||[""])[0];
      LESSONS.push({id,number:(r.number||"").trim(),title:(r.title||"").trim(),unit:(r.unit||r.unitid||"").trim(),unitTitle:(r.unittitle||"").trim()||(un?"Unit "+un:""),era:(r.era||"").trim()});});
    try{localStorage.setItem("lessonComposerLessons",JSON.stringify(LESSONS));}catch(e){}
  }catch(e){try{const c=JSON.parse(localStorage.getItem("lessonComposerLessons")||"[]");LESSONS.length=0;LESSONS.push(...c);}catch(x){}}
  updateLists();if(S.id.trim()&&applyLesson())rerender();else{const i=$("#lesInfo");if(i){const n=lessonInfo();i.replaceWith(n);}}}
function entityName(id){const e=COURSE.entities.find(x=>x.id===(id||"").trim());return e?e.name:"";}
function updateLists(){
  $("#dl-les").innerHTML="";LESSONS.forEach(l=>$("#dl-les").append(h("option",{value:l.number||l.id},l.title+" ("+(l.unitTitle||"")+")")));
