/* ---------------- Lessons List lookup ---------------- */
const lessonKey=v=>String(v||"").trim().toLowerCase().replace(/^lesson\s*/,"").replace(/[^0-9a-z]+/g,"-").replace(/^-|-$/g,"");
function findLesson(v){const k=lessonKey(v);if(!k)return null;return LESSONS.find(l=>lessonKey(l.id)===k)||LESSONS.find(l=>lessonKey(l.number)===k)||null;}
function applyLesson(){const l=findLesson(S.id);if(!l)return false;
  S.id=l.id;S.number=l.number||S.number;S.title=l.title||S.title;S.unit=l.unit||"";S.unitTitle=l.unitTitle||"";return true;}
function fileName(){return (S.number||S.id||"lesson").trim()+(S.ext?".json":"");}
function lessonInfo(){
  const box=h("div",{class:"hint",id:"lesInfo"});
  const l=findLesson(S.id);
  if(l)box.append(`Found in your Lessons List — ${l.unitTitle&&!/^Unit \d+$/.test(l.unitTitle)?l.unitTitle:"Unit "+(l.unit||"").replace(/\D+/g,"")} · ${l.number} ${l.title}`);
  else if(S.id.trim())box.append(LESSONS.length?"Not in your Lessons List yet — add it there first, or fill in the number and title yourself.":"Lessons List not loaded (offline?) — fill in the number and title yourself.");
  else box.append(LESSONS.length?`${LESSONS.length} lessons loaded from your Lessons List — type a number like 4.2 and the title fills in.`:"Loading your Lessons List…");
  const url=LESSON_FILES_URL+encodeURIComponent(fileName());
  const ext=h("input",{type:"checkbox"});ext.checked=S.ext;ext.onchange=()=>{S.ext=ext.checked;rerender();};
