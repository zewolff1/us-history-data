/* ---------------- reading blocks (same block types as the Reading Composer) ---------------- */
const BLOCK_TYPES=[["paragraph","Paragraph"],["h1","Heading 1"],["h2","Heading 2"],["h3","Heading 3 (small)"],["quote","Quote"],["poem","Poem"],["centered","Centered"],["attribution","Attribution"],["list","Bullet list"],["callout","Callout box"],["divider","Divider line"]];
const BLOCK_PH={paragraph:"Type a paragraph of the reading.",h1:"Heading text",h2:"Subheading text",h3:"Small subheading text",quote:"Quoted text",poem:"Type or paste the poem. Enter = new line, blank line = new stanza (each stanza counts as its own block for questions).",centered:"Centered text (a poem's title, an epigraph)",attribution:"Who it's by, e.g. Langston Hughes, 1926 (the dash is added for you)",list:"One item per line",callout:"Text for the highlighted box"};
const cleanBT=t=>t.replace(/\s*\n\s*/g," ").trim();
const blkLines=t=>t.replace(/\r/g,"").split("\n").map(l=>l.replace(/\s+$/,"").replace(/ \/\/ /g," / ")).filter(l=>l.trim()!=="");
function blockToRaws(b){
  if(b.type==="divider")return["---"];
  if(b.type==="poem")return b.text.replace(/\r/g,"").split(/\n\s*\n/).map(blkLines).filter(l=>l.length).map(l=>"~ "+l.join(" // "));
  if(b.type==="list"){const l=blkLines(b.text).map(x=>x.trim().replace(/^[-•*]\s+/,""));return l.length?["- "+l.join(" // ")]:[];}
  const t=cleanBT(b.text);if(!t)return[];
  return({h1:"# ",h2:"## ",h3:"### ",quote:"> ",centered:"^ ",callout:"! "}[b.type]!==undefined)?[({h1:"# ",h2:"## ",h3:"### ",quote:"> ",centered:"^ ",callout:"! "})[b.type]+t]
    :b.type==="attribution"?["-- "+t.replace(/^[-—–]+\s*/,"")]:[t];
}
function rawsOf(s){return(s.blocks||[]).flatMap(blockToRaws);}
function parseRawText(text){const out=[];
  String(text||"").split(/\n\s*\n/).map(x=>x.trim()).filter(Boolean).forEach(r=>{
    const pre=[["### ","h3"],["## ","h2"],["# ","h1"],["> ","quote"],["^ ","centered"],["-- ","attribution"],["! ","callout"]];
    if(/^---+$/.test(r)){out.push({type:"divider",text:""});return;}
    const hit=pre.find(([p])=>r.startsWith(p));
    if(hit){out.push({type:hit[1],text:r.slice(hit[0].length).trim()});return;}
    if(r.startsWith("~ ")){const lines=r.slice(2).split(/\r?\n|[ \t]+\/\/(?=[ \t]|$)[ \t]?/).map(l=>l.replace(/\s+$/,"")).filter(l=>l.trim()).join("\n");
      const last=out[out.length-1];if(last&&last.type==="poem")last.text+="\n\n"+lines;else out.push({type:"poem",text:lines});return;}
    if(r.startsWith("- ")){out.push({type:"list",text:r.slice(2).split(/\r?\n|[ \t]+\/\/(?=[ \t]|$)[ \t]?/).map(l=>l.trim()).filter(Boolean).join("\n")});return;}
    out.push({type:"paragraph",text:r.replace(/\s*\n\s*/g," ")});});
  return out;}
function previewInto(box,s){box.innerHTML="";let n=0;
  const add=(tag,text,cls)=>{const e=h(tag,{class:cls||null});e.append(h("span",{class:"bn"},"#"+n),text);box.append(e);n++;};
  (s.blocks||[]).forEach(b=>{
    if(b.type==="divider"){box.append(h("hr"));n++;return;}
    if(b.type==="poem"){b.text.replace(/\r/g,"").split(/\n\s*\n/).map(blkLines).filter(l=>l.length).forEach(l=>add("p",l.join("\n"),"poem"));return;}
    if(b.type==="list"){const l=blkLines(b.text).map(x=>x.trim().replace(/^[-•*]\s+/,""));if(!l.length)return;const ul=h("ul",{},l.map(x=>h("li",{},x)));box.append(h("span",{class:"bn"},"#"+n),ul);n++;return;}
    const t=cleanBT(b.text);if(!t)return;
    ({h1:()=>add("h1",t),h2:()=>add("h2",t),h3:()=>add("h5",t),quote:()=>add("blockquote",t),centered:()=>add("p",t,"centered"),attribution:()=>add("p","— "+t.replace(/^[-—–]+\s*/,""),"attribution"),callout:()=>add("p",t,"callout")}[b.type]||(()=>add("p",t)))();});
  if(!n)box.append(h("em",{},"Nothing to preview yet."));}
function blockEditor(s){
  const wrap=h("div",{});
  if(!s.blocks)s.blocks=[{type:"paragraph",text:""}];
  const pv=h("div",{class:"pv"});const refresh=()=>previewInto(pv,s);
  let rawIdx=0;
  s.blocks.forEach((b,i)=>{
    const sel=h("select",{},BLOCK_TYPES.map(([v,t])=>h("option",{value:v},t)));sel.value=b.type;sel.onchange=()=>{b.type=sel.value;rerender();};
    const cnt=blockToRaws(b).length;const lab=cnt>1?`#${rawIdx}–${rawIdx+cnt-1}`:(cnt?`#${rawIdx}`:"#–");rawIdx+=cnt;
    const box=h("div",{class:"blk t-"+b.type},h("div",{class:"blk-head"},h("span",{class:"num"},lab),sel,h("span",{class:"sp"}),
      h("button",{class:"sm",title:"Move up",onclick:()=>move(s.blocks,i,-1)},"↑"),h("button",{class:"sm",title:"Move down",onclick:()=>move(s.blocks,i,1)},"↓"),
      h("button",{class:"sm danger",title:"Remove block",onclick:()=>{s.blocks.splice(i,1);rerender();}},"✕")));
    if(b.type==="divider")box.append(h("div",{class:"dv"},"A divider line — nothing to type."));
    else{const ta=h("textarea",{placeholder:BLOCK_PH[b.type]||"",rows:b.type==="poem"?6:2});ta.value=b.text;ta.oninput=()=>{b.text=ta.value;refresh();touch();};box.append(ta);}
    wrap.append(box);});
  wrap.append(h("div",{class:"addrow"},BLOCK_TYPES.map(([v,t])=>h("button",{class:"sm",onclick:()=>{s.blocks.push({type:v,text:""});rerender();}},"+ "+t.replace(" (small)","")))),
    h("div",{class:"addrow"},h("button",{class:"sm",onclick:()=>{const t=prompt("Paste the reading text. Blank lines separate blocks. You can also use the sheet symbols (# heading, > quote, ~ poem, - list, ! callout, --- divider).");
      if(t){const nb=parseRawText(t);if(s.blocks.length===1&&!s.blocks[0].text)s.blocks=nb;else s.blocks.push(...nb);rerender();}}},"Paste whole text…")));
  const d=h("details",{open:true},h("summary",{style:"cursor:pointer;font-size:.82rem;margin-bottom:.3rem"},"Preview (numbers = block # for “after paragraph”)"),pv);wrap.append(d);refresh();
  return wrap;}

