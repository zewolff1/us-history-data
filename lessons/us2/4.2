    q.choices=[c[1],c[2],c[3],c[4]].map(x=>(x||"").trim()).filter(Boolean);const k=(c[5]||"A").trim().toUpperCase().charCodeAt(0)-65;q.correct=k>=0&&k<q.choices.length?k:0;q.skill=(c[6]||"").trim();q.explanation=(c[7]||"").trim();S.questions.push(q);});
