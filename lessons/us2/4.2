<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Lesson Composer — US History II</title>
<style>
:root{--ink:#1B2430;--ink-soft:#3C4656;--parchment:#EFE6D3;--card:#F7F1E3;--brass:#8C6A2F;--brass-light:#B79A5C;--stamp:#8C3B2E;--forest:#3F5443;--rule:rgba(27,36,48,.2);--focus:#2E6E8E}
*{box-sizing:border-box}
body{margin:0;background:var(--parchment);color:var(--ink);font-family:Georgia,"Source Serif 4",serif;line-height:1.45}
header.top{padding:1rem 1.2rem;border-bottom:3px double var(--ink);display:flex;flex-wrap:wrap;gap:.6rem 1.2rem;align-items:center}
header.top h1{margin:0;font-size:1.3rem}
header.top .sub{font-size:.8rem;color:var(--ink-soft)}
main{max-width:980px;margin:0 auto;padding:1rem 1rem 7rem}
details.panel{background:var(--card);border:1px solid var(--rule);border-left:5px solid var(--brass);margin-bottom:.9rem;border-radius:3px}
details.panel>summary{cursor:pointer;padding:.7rem 1rem;font-weight:700;font-size:1.02rem;list-style:none;display:flex;gap:.6rem;align-items:center}
details.panel>summary::-webkit-details-marker{display:none}
details.panel>summary::before{content:"▸";color:var(--brass)}
details.panel[open]>summary::before{content:"▾"}
details.panel>summary .count{margin-left:auto;font-weight:400;font-size:.78rem;color:var(--ink-soft)}
.body{padding:.2rem 1rem 1rem}
.hint{font-size:.82rem;color:var(--ink-soft);margin:.1rem 0 .6rem}
label.f{display:block;margin:0 0 .55rem;font-size:.74rem;text-transform:uppercase;letter-spacing:.05em;color:var(--brass);font-family:"Courier New",monospace}
label.f>input[type=text],label.f>input[type=number],label.f>select,label.f>textarea{display:block;width:100%;margin-top:.15rem;font:inherit;font-size:.95rem;text-transform:none;letter-spacing:0;color:var(--ink);padding:.42rem .5rem;border:1px solid var(--rule);border-radius:3px;background:#fffdf7}
label.f>textarea{resize:vertical}
label.c{display:inline-flex;gap:.35rem;align-items:center;margin:0 1rem .5rem 0;font-size:.9rem}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:0 .8rem}
.item{border:1px solid var(--rule);border-radius:3px;background:rgba(255,255,255,.45);padding:.7rem .8rem .3rem;margin-bottom:.7rem}
.item.reading{border-left:4px solid var(--forest)}.item.video{border-left:4px solid var(--stamp)}.item.image{border-left:4px solid var(--focus)}
.item.q{border-left:4px solid var(--brass)}.item.a{border-left:4px dashed var(--stamp)}
.itemhead{display:flex;gap:.4rem;align-items:center;margin-bottom:.5rem;flex-wrap:wrap}
.itemhead .tag{font-family:"Courier New",monospace;font-size:.7rem;text-transform:uppercase;letter-spacing:.06em;font-weight:700}
.itemhead .sp{flex:1}
button{font:inherit;font-size:.82rem;cursor:pointer;border:2px solid var(--ink);background:var(--card);color:var(--ink);padding:.28rem .65rem;border-radius:3px}
button:hover{background:var(--brass-light)}
button.primary{background:var(--stamp);color:#fff}button.primary:hover{background:#a64a3b}
button.sm{padding:.1rem .45rem;font-size:.75rem}button.danger{border-color:var(--stamp);color:var(--stamp)}
.row{display:flex;gap:.5rem;align-items:center;margin-bottom:.45rem}
.row>input{flex:1;font:inherit;font-size:.95rem;padding:.4rem .5rem;border:1px solid var(--rule);border-radius:3px;background:#fffdf7}
.row>input[type=radio]{flex:none;width:auto}
.row .n{font-family:"Courier New",monospace;font-size:.78rem;color:var(--brass);min-width:1.6rem}
.chip{display:inline-block;font-size:.74rem;background:var(--parchment);border:1px solid var(--rule);padding:0 .4rem;border-radius:9px;margin-left:.3rem;color:var(--ink-soft)}
.bar{position:fixed;left:0;right:0;bottom:0;background:var(--ink);color:#fff;padding:.6rem 1rem;display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;z-index:50}
.bar button{border-color:#fff}.bar .status{margin-left:auto;font-size:.8rem;opacity:.85}
.warns{background:#fff3cd;border:1px solid #d9b94a;color:#6b5100;padding:.5rem .8rem;border-radius:3px;margin-bottom:.9rem;font-size:.85rem}
.warns ul{margin:.2rem 0 0 1.1rem;padding:0}
pre#preview{background:#101722;color:#d8e2f0;padding:.8rem;border-radius:3px;max-height:420px;overflow:auto;font-size:.76rem;white-space:pre-wrap;word-break:break-word}
.chk{border:1px solid var(--rule);background:#fffdf7;border-radius:3px;padding:.4rem .6rem;margin-bottom:.5rem}
.chk .row{margin-bottom:.2rem}

.blk{border:1px solid var(--rule);border-radius:3px;background:#fffdf7;margin-bottom:.5rem;overflow:hidden}
.blk-head{display:flex;gap:.4rem;align-items:center;padding:.25rem .45rem;background:var(--parchment);border-bottom:1px solid var(--rule)}
.blk-head .num{font-family:"Courier New",monospace;font-size:.72rem;color:var(--brass);min-width:3.2rem}
.blk-head select{font:inherit;font-size:.8rem;padding:.1rem .3rem;border:1px solid var(--rule);border-radius:3px;background:#fff}
.blk-head .sp{flex:1}
.blk textarea{display:block;width:100%;border:none;background:#fffdf7;font:inherit;font-size:.93rem;padding:.55rem .7rem;resize:vertical;min-height:3.2rem}
.blk.t-h1 textarea,.blk.t-h2 textarea{font-weight:700;font-family:"Trebuchet MS",sans-serif}.blk.t-h1 textarea{font-size:1.15rem}
.blk.t-h3 textarea{font-weight:600;text-transform:uppercase;letter-spacing:.04em;font-size:.85rem}
.blk.t-quote textarea,.blk.t-poem textarea{font-style:italic}.blk.t-poem textarea{white-space:pre;min-height:7rem}
.blk.t-centered textarea{text-align:center}.blk.t-attribution textarea{text-align:right}
.blk.t-divider .dv{padding:.5rem .7rem;font-style:italic;color:var(--ink-soft);font-size:.85rem}
.addrow{display:flex;flex-wrap:wrap;gap:.35rem;margin:.3rem 0 .6rem}.addrow button{font-size:.74rem;padding:.2rem .5rem}
.pv{background:#fffdf7;border:1px solid var(--rule);border-radius:3px;padding:.8rem 1rem;margin:.4rem 0 .6rem}
.pv h1{font-size:1.25rem;margin:0 0 .6rem}.pv h2{font-size:1.05rem;margin:0 0 .5rem}.pv h5{font-size:.82rem;text-transform:uppercase;letter-spacing:.05em;margin:0 0 .4rem;color:var(--ink-soft)}
.pv p{margin:0 0 .8rem}.pv blockquote{margin:0 0 .8rem;padding:.4rem .8rem;border-left:4px solid var(--stamp);background:var(--parchment);font-style:italic}
.pv p.poem{white-space:pre-wrap;font-style:italic;margin-left:1rem;padding-left:.8rem;border-left:3px solid var(--stamp)}
.pv p.centered{text-align:center;font-weight:600}.pv p.attribution{text-align:right;font-size:.8rem;text-transform:uppercase;color:var(--ink-soft)}
.pv p.callout{border:2px solid var(--ink);border-left-width:6px;background:var(--parchment);padding:.5rem .8rem;border-radius:3px}
.pv hr{border:none;border-top:2px dashed var(--ink-soft);margin:1rem 0}
.pv .bn{display:inline-block;font-family:"Courier New",monospace;font-size:.65rem;color:var(--brass);margin-right:.3rem}
.tabs{display:flex;flex-wrap:wrap;gap:.3rem;margin:.2rem 0 .6rem;border-bottom:2px solid var(--rule);padding-bottom:.4rem}
.tabs button.tab{border-width:1px;border-radius:14px;padding:.2rem .75rem;font-size:.82rem}
.tabs button.tab.on{background:var(--ink);color:#fff}
.tabs button.tab .ct{opacity:.75;margin-left:.3rem;font-size:.74rem}
.opts{display:grid;grid-template-columns:repeat(auto-fill,minmax(215px,1fr));gap:.15rem .8rem;margin:.4rem 0 .6rem}
label.opt{display:flex;gap:.45rem;align-items:flex-start;padding:.18rem .3rem;border-radius:3px;font-size:.88rem;cursor:pointer}
label.opt:hover{background:rgba(183,154,92,.25)}label.opt.on{background:rgba(63,84,67,.14)}
label.opt small{color:var(--ink-soft);font-size:.72rem;display:block}
.opts.one{grid-template-columns:1fr}
.subs{display:flex;flex-wrap:wrap;gap:.3rem;margin:.2rem 0 .3rem}.subs button{font-size:.72rem;padding:.05rem .5rem;border-radius:10px;border-width:1px}.subs button.on{background:var(--brass);color:#fff;border-color:var(--brass)}
input.search{width:100%;font:inherit;font-size:.92rem;padding:.4rem .5rem;border:1px solid var(--rule);border-radius:3px;background:#fffdf7;margin-bottom:.3rem}
.lp{background:#fffdf7;border:1px solid var(--rule);border-radius:3px;padding:1rem 1.2rem}
.lp h1.lt{font-size:1.5rem;margin:0 0 .2rem}.lp .unit{font-family:"Courier New",monospace;font-size:.75rem;text-transform:uppercase;letter-spacing:.06em;color:var(--brass)}
.lp h3.sec{font-size:.8rem;text-transform:uppercase;letter-spacing:.08em;color:var(--brass);border-bottom:1px solid var(--rule);padding-bottom:.2rem;margin:1.2rem 0 .5rem;font-family:"Courier New",monospace}
.lp ul{margin:.2rem 0 .4rem 1.2rem;padding:0}
.lp .chips span{display:inline-block;background:var(--parchment);border:1px solid var(--rule);border-radius:12px;padding:.05rem .6rem;margin:0 .3rem .3rem 0;font-size:.82rem}
.lp .chips span.key{background:var(--forest);color:#fff;border-color:var(--forest)}
.lp .src{border:1px solid var(--rule);border-left:4px solid var(--forest);border-radius:3px;padding:.7rem .9rem;margin-bottom:.8rem;background:#fff}
.lp .src.video{border-left-color:var(--stamp)}.lp .src.image{border-left-color:var(--focus)}
.lp .src h4{margin:0 0 .1rem;font-size:1.05rem}.lp .src .meta{font-size:.78rem;color:var(--ink-soft);margin-bottom:.6rem}
.lp .src img{max-width:100%;max-height:220px;border-radius:3px;margin:.2rem .4rem .2rem 0}
.lp .ph{background:#101722;color:#d8e2f0;padding:1.6rem;text-align:center;border-radius:3px;font-size:.85rem}
.lp p{margin:0 0 .8rem}.lp blockquote{margin:0 0 .8rem;padding:.4rem .8rem;border-left:4px solid var(--stamp);background:var(--parchment);font-style:italic}
.lp h2.rb{font-size:1.15rem;margin:.4rem 0}.lp h4.rb{font-size:1rem;margin:.4rem 0}.lp h5.rb{font-size:.8rem;text-transform:uppercase;letter-spacing:.05em;margin:.4rem 0;color:var(--ink-soft)}
.lp .poem{white-space:pre-wrap;font-style:italic;margin-left:1rem;padding-left:.8rem;border-left:3px solid var(--stamp)}
.lp .cen{text-align:center;font-weight:600}.lp .att{text-align:right;font-size:.8rem;text-transform:uppercase;color:var(--ink-soft)}
.lp .call{border:2px solid var(--ink);border-left-width:6px;background:var(--parchment);padding:.5rem .8rem;border-radius:3px}
.lp .q{border:1px solid var(--brass);background:#fbf5e6;border-radius:3px;padding:.6rem .8rem;margin:.2rem 0 .9rem}
.lp .q .qt{font-weight:700;margin-bottom:.4rem}.lp .q label{display:block;padding:.15rem .3rem;border-radius:3px;cursor:pointer}
.lp .q label.right{background:#d9ecd9}.lp .q label.wrong{background:#f3d6d2}
.lp .q .fb{font-size:.85rem;margin-top:.4rem;color:var(--ink-soft)}.lp .q textarea{width:100%;font:inherit;padding:.4rem;border:1px solid var(--rule);border-radius:3px}
.lp .q .tagline{font-family:"Courier New",monospace;font-size:.68rem;text-transform:uppercase;color:var(--brass);margin-bottom:.2rem}
.lp .donow{border:2px solid var(--stamp);border-radius:3px;padding:.6rem .9rem;background:#fff5f2}
.lp .acard{border:1px solid var(--ink);border-radius:3px;padding:.6rem .9rem;margin-bottom:.6rem;background:#fff}
.lp .acard .hid{font-size:.72rem;font-family:"Courier New",monospace;color:var(--stamp);text-transform:uppercase}
.lp .btn{display:inline-block;border:2px solid var(--ink);padding:.25rem .7rem;border-radius:3px;background:var(--card);font-size:.85rem}
</style>
</head>
<body>
<header class="top">
  <div><h1>Lesson Composer</h1><div class="sub">Everything a lesson tab holds, in one place. Download the lesson as JSON.</div></div>
</header>
<main>
  <div id="warns"></div>
  <div id="app"></div>
  <details class="panel" id="lpPanel"><summary>Lesson preview (roughly how students will see it)</summary><div class="body"><div class="lp" id="lessonPv"></div></div></details>
  <details class="panel"><summary>JSON preview</summary><div class="body"><pre id="preview"></pre></div></details>
</main>
<div class="bar">
  <button class="primary" id="dl">⬇ Download JSON</button>
  <button id="cp">Copy JSON</button>
  <button id="ld">Open JSON…</button>
  <button id="csv">Import sheet tab (CSV)…</button>
  <button id="ent">Load entities</button><button id="entdl" title="Download the loaded entities as entities.json for GitHub">Save entities.json</button><button id="inqdl" title="Download the inquiries as inquiries.json for GitHub">Save inquiries.json</button>
  <button id="nw" class="danger">New lesson</button>
  <span class="status" id="status"></span>
</div>
<input type="file" id="fJson" accept=".json,application/json" hidden>
<input type="file" id="fCsv" accept=".csv,text/csv,text/plain" hidden>
<input type="file" id="fEnt" accept=".json,.csv" hidden>
<datalist id="dl-ent"></datalist><datalist id="dl-les"></datalist><datalist id="dl-inq"></datalist><datalist id="dl-tl"></datalist>

<script>
/* ---- helpers copied from the site's sheets-loader.js so a pasted sheet tab converts the same way ---- */
function normalizeKey(k) {
  return k.toLowerCase().replace(/\s+/g, "");
}

function normalizeRow(row) {
  const out = {};
  Object.keys(row).forEach(k => { out[normalizeKey(k)] = row[k]; });
  return out;
}

function splitList(cell) {
  return String(cell || "").split(/\s*;\s*/).map(x => x.trim()).filter(Boolean);
}

function numberOrUndefined(cell) {
  const n = parseFloat(String(cell || "").trim());
  return isNaN(n) ? undefined : n;
}

function isTruthy(value) {
  return ["yes", "true", "y", "1"].includes((value || "").trim().toLowerCase());
}

function extractYear(dateText) {
  const match = (dateText || "").match(/\b(1[0-9]{3}|20[0-9]{2})\b/);
  return match ? Number(match[1]) : null;
}

function applyLessonSheetRowsLocal(lesson, rows, COURSE_DATA) {
  const objectives = [];
  const mentions = [];
  const keyTerms = [];
  const inquiries = [];
  const timelineFocus = [];
  let timelineStartYear = null;
  let timelineEndYear = null;
  const readings = [];
  const videos = [];
  const images = [];
  const assessment = [];
  const presetLabels = [];
  const termGroups = {}; // key-term groups: lowercase name -> { name, members: [{ id, order, pos }] }
  const pinnedTerms = []; // terms the teacher pinned from the sheet (Key Term Pin column) -- shown in every resource popup for this lesson
  let termPos = 0;
  const pendingQuestions = []; // resolved to a reading or the standalone list after the main pass
  const imagesByGallery = {}; // keyed by Gallery Name, or a unique key per standalone image
  let standaloneImageCount = 0;
  let sourceOrderCounter = 0; // stamped onto each reading/video/image so the site can display them in the same order as your sheet's rows, not grouped by type

  const assessmentLinks = []; // "Assessment Link" rows: links to Hexagon Web, the Stock Market Game, etc.
  let notesLink = "", notesTitle = "";   // teacher-only "Notes Link" column
  const lessonSkills = [];   // "Lesson Skills" column: skills EVERYONE works on in this lesson
  rows.forEach(raw => {
    const r = normalizeRow(raw);
    String(r.lessonskills || r.coreskills || r.lessonskill || "").split(/[;,]/).map(x => x.trim()).filter(Boolean)
      .forEach(x => { if (!lessonSkills.some(y => y.toLowerCase() === x.toLowerCase())) lessonSkills.push(x); });
    if (!notesLink) { notesLink = (r.noteslink || "").trim(); notesTitle = (r.notestitle || "").trim(); }
    const aLink = (r.assessmentlink || "").trim();
    if (aLink) {
      // Assessments are separate from Check Your Understanding. Hidden from students unless "Assessment Show" is checked.
      assessmentLinks.push({
        title: (r.assessmenttitle || "").trim(),
        description: (r.assessmentdescription || "").trim(),
        link: aLink,
        linkLabel: (r.assessmentlabel || r.assessmentbutton || "").trim(),
        visible: isTruthy(r.assessmentshow || r.assessmentvisible || r.showassessment),
        doNow: isTruthy(r.assessmentdonow)
      });
    }
    const objectiveText = (r.objective || "").trim();
    if (objectiveText) {
      objectives.push({ id: `${lesson.id}-o${objectives.length + 1}`, text: objectiveText });
    }
    const entityId = (r.mention || "").trim();
    if (entityId) {
      mentions.push(entityId);
      if (isTruthy(r.keyterm)) keyTerms.push(entityId);
      // Key Term Pin: tick it on a term's row to pin that term for every
      // student on this lesson (the same "Pinned terms" panel students
      // already get when they pin one themselves, just set ahead of time).
      if (isTruthy(r.keytermpin || r.keytermpinned || r.pinkeyterm || r.pinterm || r.pinned || r.pin) && !pinnedTerms.includes(entityId)) pinnedTerms.push(entityId);

      // Key Term Group: put this term in one or more named groups (several
      // separated by ;). A reading/video/image then names a group in its
      // own "... Term Group" column to show it side by side in its popup.
      // Key Term Order (optional number) orders terms within a group.
      const termOrder = numberOrUndefined(r.keytermorder);
      splitList(r.keytermgroup).forEach(groupName => {
        const key = groupName.toLowerCase();
        if (!termGroups[key]) termGroups[key] = { name: groupName, members: [] };
        if (!termGroups[key].members.some(m => m.id === entityId)) {
          termGroups[key].members.push({ id: entityId, order: termOrder, pos: termPos++ });
        }
      });
    }
    if (isTruthy(r.include || r.inquiryused)) {
      const inquiryId = (r.inquiryid || "").trim();
      if (inquiryId) inquiries.push(inquiryId);
    }
    const timelineId = (r.timelinefocus || r.timelineid || "").trim();
    if (timelineId) timelineFocus.push(timelineId);
    const startYearRaw = (r.timelinestartyear || "").trim();
    if (startYearRaw && !timelineStartYear) timelineStartYear = Number(startYearRaw);
    const endYearRaw = (r.timelineendyear || "").trim();
    if (endYearRaw && !timelineEndYear) timelineEndYear = Number(endYearRaw);

    // One preset label per row that has one — students saving a
    // highlight on this lesson see these offered first, before any
    // labels they've made themselves on this device. Color is
    // optional; leave it blank and one gets assigned automatically.
    const presetLabelName = (r.presetlabel || "").trim();
    if (presetLabelName) {
      const presetLabelColor = (r.presetlabelcolor || "").trim().toLowerCase();
      presetLabels.push({ name: presetLabelName, color: presetLabelColor || null });
    }

    // Each of these three is a full row of related columns — only counted
    // as a real reading/video/image if its title cell has something in it.
    const readingTitle = (r.readingtitle || "").trim();
    if (readingTitle) {
      readings.push({
        title: readingTitle,
        source: (r.readingsource || "").trim(),
        note: (r.readingnote || "").trim() || undefined,
        text: (r.readingtext || "").trim().split(/\s*\|\|\|\s*/).join("\n\n"),
        image: (r.readingimage || "").trim() || undefined,
        embedUrl: (r.readingembedurl || "").trim() || undefined,
        set: (r.readingset || "").trim() || undefined,
        setOrder: numberOrUndefined(r.setorder),
        order: numberOrUndefined(r.readingorder),
        termGroup: splitList(r.readingtermgroup),
        teacherPinned: isTruthy(r.sourcepin || r.pinsource || r.pinnedsource) || undefined,
        _order: sourceOrderCounter++
      });
    }

    const videoTitle = (r.videotitle || "").trim();
    if (videoTitle) {
      videos.push({
        title: videoTitle,
        length: (r.videolength || "").trim() || undefined,
        note: (r.videonote || "").trim() || undefined,
        src: (r.videosrc || "").trim(),
        image: (r.videoimage || "").trim() || undefined,
        set: (r.videoset || "").trim() || undefined,
        setOrder: numberOrUndefined(r.setorder),
        order: numberOrUndefined(r.videoorder),
        termGroup: splitList(r.videotermgroup),
        teacherPinned: isTruthy(r.sourcepin || r.pinsource || r.pinnedsource) || undefined,
        _order: sourceOrderCounter++
      });
    }

    // Original style: one row = one image or gallery, with a comma-list of
    // URLs in "Image Files". Still fully supported.
    const imageTitle = (r.imagetitle || "").trim();
    const imageFilesRaw = (r.imagefiles || "").trim();
    if (imageFilesRaw) {
      images.push({
        title: imageTitle,
        note: (r.imagenote || "").trim() || undefined,
        files: imageFilesRaw.split(",").map(s => s.trim()).filter(Boolean),
        set: (r.imageset || "").trim() || undefined,
        setOrder: numberOrUndefined(r.setorder),
        order: numberOrUndefined(r.imageorder),
        termGroup: splitList(r.imagetermgroup),
        teacherPinned: isTruthy(r.sourcepin || r.pinsource || r.pinnedsource) || undefined,
        _order: sourceOrderCounter++
      });
    }

    // Newer style: one row = one image URL. Rows sharing the same "Gallery
    // Name" get grouped into a single gallery; a blank Gallery Name makes
    // that row its own standalone image. "Image Caption" is per-row, shown
    // under whichever image is currently displayed.
    const imageUrl = (r.imageurl || "").trim();
    if (imageUrl) {
      const galleryName = (r.galleryname || "").trim();
      const key = galleryName || `__standalone_${standaloneImageCount++}`;
      if (!imagesByGallery[key]) {
        imagesByGallery[key] = { title: galleryName || imageTitle, note: undefined, files: [], _order: sourceOrderCounter++ };
      }
      const group = imagesByGallery[key];
      const imageCaption = (r.imagecaption || "").trim();
      group.files.push(imageCaption ? { src: imageUrl, caption: imageCaption } : imageUrl);
      if (!group.title && imageTitle) group.title = imageTitle;
      const rowNote = (r.imagenote || "").trim();
      if (!group.note && rowNote) group.note = rowNote;
      const rowSet = (r.imageset || "").trim();
      if (!group.set && rowSet) group.set = rowSet;
      if (group.setOrder === undefined) group.setOrder = numberOrUndefined(r.setorder);
      if (group.order === undefined) group.order = numberOrUndefined(r.imageorder);
      const rowTermGroups = splitList(r.imagetermgroup);
      if (rowTermGroups.length && !group.termGroup) group.termGroup = rowTermGroups;
      if (isTruthy(r.sourcepin || r.pinsource || r.pinnedsource)) group.teacherPinned = true;

    }

    // A question — one row = one question, only counted if Question
    // Prompt has something in it. "Question Objectives" references
    // objectives by their POSITION in this same tab's Objective column
    // (e.g. "1, 3"), not their real id — same as the Lesson Builder tool,
    // since the real ids aren't visible here and aren't worth memorizing.
    //
    // To attach this question to something specific instead of the
    // standalone "Check Your Understanding" list, fill in exactly ONE of:
    //   - Question Reading (+ Question After Paragraph) — drops it inside
    //     that reading, after the given paragraph (0 = after the 1st).
    //   - Question Video — shows it below that video, once it's playing.
    //   - Question Gallery — shows it below that image/gallery.
    // Each must exactly match a Title from this same tab. Leave all three
    // blank for a standalone question at the end of the lesson, same as
    // before.
    //
    // "Question Group" is optional. Give two or more questions AT THE
    // SAME SPOT (same reading+paragraph, same video, same gallery, or
    // all marked Do Now) the same group name, and they're answered one
    // after another as a sequence instead of all appearing separately.
    // Any exact text works as a group name — it just has to match
    // across the rows you want grouped. Leave it blank and a question
    // behaves exactly as it does today, on its own.
    const questionPrompt = (r.questionprompt || "").trim();
    if (questionPrompt) {
      const type = (r.questiontype || "multiple_choice").trim().toLowerCase();
      const q = { type, prompt: questionPrompt };

      const objNums = (r.questionobjectives || "").split(",").map(s => s.trim()).filter(Boolean);
      if (objNums.length) q.objectiveIds = objNums.map(n => `${lesson.id}-o${n}`);

      const questionImage = (r.questionimage || "").trim();
      if (questionImage) q.image = questionImage;

      const questionTermGroup = (r.questiontermgroup || "").trim();
      if (questionTermGroup) q.termGroup = questionTermGroup;

      const questionSkill = (r.questionskill || "").trim();
      if (questionSkill) q.skill = questionSkill;

      // Short-answer only: hold every student's answer back from OTHER
      // students until the teacher approves it (Teacher View -> Answers).
      // The student who wrote it always sees their own answer right away.
      if (isTruthy(r.questionrequiresapproval)) q.requiresApproval = true;

      // Questions sharing the same (non-blank) group, at the same spot
      // (same reading+paragraph, same video, same gallery, or all Do
      // Now questions for this lesson), get answered one after another
      // as a sequence instead of all showing separately.
      const questionGroup = (r.questiongroup || "").trim();
      if (questionGroup) q.group = questionGroup;

      if (type === "link") {
        q.link = (r.questionlink || "").trim();
        q.linkLabel = (r.questionlinklabel || "").trim();
      } else if (type === "short_answer") {
        q.sampleAnswer = (r.questionsampleanswer || "").trim();
      } else {
        q.choices = (r.questionchoices || "").split(/[,;]/).map(s => s.trim()).filter(Boolean);
        q.correctIndex = Number(r.questioncorrectindex) || 0;
        const expl = (r.questionexplanation || "").trim();
        if (expl) q.explanation = expl;
      }

      if (isTruthy(r.donow)) {
        if (!lesson.doNow) lesson.doNow = [];
        lesson.doNow.push(q); // shown automatically when this lesson opens — see maybeShowDoNow(); answered as a sequence if there's more than one
      } else {
        const targetReadingTitle = (r.questionreading || "").trim();
        const targetVideoTitle = (r.questionvideo || "").trim();
        const targetGalleryTitle = (r.questiongallery || "").trim();
        const afterParagraphRaw = (r.questionafterparagraph || "").trim();
        pendingQuestions.push({
          readingTitle: targetReadingTitle,
          videoTitle: targetVideoTitle,
          galleryTitle: targetGalleryTitle,
          afterParagraph: afterParagraphRaw !== "" ? (Number(afterParagraphRaw) || 0) : 0,
          question: q
        });
      }
    }
  });

  Object.values(imagesByGallery).forEach(group => images.push(group));

  // Now that every reading/video/image in this tab has been collected,
  // resolve each pending question to its target (matched by title) or
  // drop it into the standalone list if it didn't specify one.
  pendingQuestions.forEach(({ readingTitle, videoTitle, galleryTitle, afterParagraph, question }) => {
    if (readingTitle) {
      const target = readings.find(r => r.title.trim().toLowerCase() === readingTitle.toLowerCase());
      if (target) {
        question.afterParagraph = afterParagraph;
        if (!target.questions) target.questions = [];
        target.questions.push(question);
        return;
      }
      console.warn(`A question's "Question Reading" ("${readingTitle}") doesn't match any Reading Title in this tab — adding it to Check Your Understanding instead.`);
    } else if (videoTitle) {
      const target = videos.find(v => v.title.trim().toLowerCase() === videoTitle.toLowerCase());
      if (target) {
        if (!target.questions) target.questions = [];
        target.questions.push(question);
        return;
      }
      console.warn(`A question's "Question Video" ("${videoTitle}") doesn't match any Video Title in this tab — adding it to Check Your Understanding instead.`);
    } else if (galleryTitle) {
      const target = images.find(i => (i.title || "").trim().toLowerCase() === galleryTitle.toLowerCase());
      if (target) {
        if (!target.questions) target.questions = [];
        target.questions.push(question);
        return;
      }
      console.warn(`A question's "Question Gallery" ("${galleryTitle}") doesn't match any Image/Gallery Title in this tab — adding it to Check Your Understanding instead.`);
    }
    assessment.push(question);
  });

  if (objectives.length) lesson.objectives = objectives;
  if (lessonSkills.length) lesson.skills = lessonSkills;
  if (notesLink) { lesson.notesLink = notesLink; if (notesTitle) lesson.notesTitle = notesTitle; }
  // Students see at most MAX_QUESTIONS_PER_SOURCE questions on any one reading / video / image.
  [...readings, ...videos, ...images].forEach(src => {
    if (src.questions && src.questions.length > 5) console.warn(`"${src.title}" has ${src.questions.length} questions attached; students will only see 5 of them (focus-skill questions first).`);
  });
  if (mentions.length) {
    lesson.mentions = mentions;
    lesson.keyTerms = keyTerms;
    lesson.pinnedTerms = pinnedTerms;
  }
  if (inquiries.length) lesson.inquiryFocus = inquiries;
  if (timelineFocus.length) {
    lesson.timelineFocus = timelineFocus;
  } else if (timelineStartYear !== null) {
    const endYear = timelineEndYear !== null ? timelineEndYear : timelineStartYear;
    const matches = COURSE_DATA.timeline
      .filter(t => {
        const year = extractYear(t.date);
        return year !== null && year >= timelineStartYear && year <= endYear;
      })
      .map(t => t.id);
    if (matches.length) lesson.timelineFocus = matches;
    else console.warn(`No timeline entries found between ${timelineStartYear} and ${endYear} for lesson "${lesson.id}".`);
  }
  if (readings.length) lesson.readings = readings;
  if (videos.length) lesson.videos = videos;
  if (images.length) lesson.images = images;
  if (assessmentLinks.length) lesson.assessments = assessmentLinks;
  if (assessment.length) lesson.assessment = assessment;
  if (presetLabels.length) lesson.presetLabels = presetLabels;
  const termGroupList = Object.values(termGroups);
  if (termGroupList.length) lesson.termGroups = termGroupList;
}


