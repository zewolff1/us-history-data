/* ---------------- terms: tabs of checkboxes ---------------- */
let termTab="sel",termQ="",termSub="";
const catLabel=c=>({Person:"People",Topic:"Topics",Event:"Events"})[c]||c;
const entCat=e=>e.category||"Other";
function selSet(){return new Set(S.terms.map(t=>t.id.trim()).filter(Boolean));}
function setTerm(id,on){
  const i=S.terms.findIndex(t=>t.id.trim()===id);
  if(on&&i<0)S.terms.push({id,key:true,pin:false,groups:"",order:""});
  if(!on&&i>=0)S.terms.splice(i,1);
  touch();updateTermCounts();}
function updateTermCounts(){
  const sel=selSet();const el=$("#termCount");if(el)el.textContent=S.terms.length;
  const tc=$("#tc-sel");if(tc)tc.textContent=S.terms.length;
  [...new Set(COURSE.entities.map(entCat))].forEach(c=>{const e=$("#tc-"+c.replace(/\W/g,"_"));if(e)e.textContent=COURSE.entities.filter(x=>entCat(x)===c&&sel.has(x.id)).length+"/"+COURSE.entities.filter(x=>entCat(x)===c).length;});}
function refreshTerms(){const old=$("#termsPanel");if(!old)return;const n=termsPanel();n.open=old.open;old.replaceWith(n);}
function termsPanel(){
  const ents=COURSE.entities;const cats=[...new Set(ents.map(entCat))].sort((x,y)=>(x==='Person'?0:1)-(y==='Person'?0:1)||x.localeCompare(y));
  if(termTab!=="sel"&&!cats.includes(termTab))termTab="sel";
  const p=h("details",{class:"panel",id:"termsPanel",open:true},
    h("summary",{},"People, Topics & Events (key terms)",h("span",{class:"count",id:"termCount"},S.terms.length)));
  const body=h("div",{class:"body"});p.append(body);
  if(!ents.length)body.append(h("div",{class:"hint"},"Click “Load entities” (bottom bar) to get checkbox lists of your people, topics and events. You can still add ids by hand under Selected."));
  const sel=selSet();
  const tabs=h("div",{class:"tabs"});
  const tabBtn=(key,label,ctId,ct)=>h("button",{class:"tab"+(termTab===key?" on":""),onclick:()=>{termTab=key;termSub="";termQ="";refreshTerms();}},label,h("span",{class:"ct",id:ctId},ct));
  tabs.append(tabBtn("sel","Selected","tc-sel",S.terms.length));
  cats.forEach(c=>{const all=ents.filter(x=>entCat(x)===c);tabs.append(tabBtn(c,catLabel(c),"tc-"+c.replace(/\W/g,"_"),all.filter(x=>sel.has(x.id)).length+"/"+all.length));});
  body.append(tabs);
  if(termTab==="sel"){
    if(!S.terms.length)body.append(h("div",{class:"hint"},"Nothing selected yet — open a tab above and check the people, topics and events this lesson uses."));
    S.terms.forEach((t,i)=>{const nm=entityName(t.id);
      body.append(h("div",{class:"item"},ctl(S.terms,i,h("span",{class:"tag"},"Term"+(nm?" — "+nm:""))),
        h("div",{class:"grid"},field(t,"id","Term (name or id)",{list:"dl-ent",after:()=>{const m=COURSE.entities.find(e=>e.name.toLowerCase()===t.id.trim().toLowerCase());if(m){t.id=m.id;rerender();return;}const c=$("#nm"+i);if(c)c.textContent=entityName(t.id)}}),
          field(t,"groups","Key-term group(s) (; separated)",{ph:"Trusts; Gilded Age"}),field(t,"order","Order in group",{type:"number"})),
        h("div",{},h("span",{class:"chip",id:"nm"+i},nm||""),check(t,"key","Key term (“What You Need to Know”)"),check(t,"pin","Pinned for everyone"))));});
    body.append(h("button",{onclick:()=>{S.terms.push({id:"",key:true,pin:false,groups:"",order:""});rerender();}},"+ Term by id"),
      h("button",{style:"margin-left:.4rem",onclick:bulkTerms},"+ Paste several names or ids"));
  } else {
    const inCat=ents.filter(e=>entCat(e)===termTab);
    const subs=[...new Set(inCat.map(e=>e.subcategory).filter(Boolean))].sort();
    const search=h("input",{class:"search",type:"text",placeholder:"Search "+catLabel(termTab).toLowerCase()+"…",value:termQ});
    const list=h("div",{class:"opts"});
    const fill=()=>{list.innerHTML="";const q=termQ.trim().toLowerCase();const cur=selSet();
      const shown=inCat.filter(e=>(!termSub||e.subcategory===termSub)&&(!q||(e.name+" "+e.id).toLowerCase().includes(q))).sort((a,b)=>a.name.localeCompare(b.name));
      if(!shown.length)list.append(h("em",{},"No matches."));
      shown.forEach(e=>{const c=h("input",{type:"checkbox"});c.checked=cur.has(e.id);
        const lab=h("label",{class:"opt"+(c.checked?" on":"")},c,h("span",{},e.name,e.subcategory?h("small",{},e.subcategory):null));
        c.onchange=()=>{lab.classList.toggle("on",c.checked);setTerm(e.id,c.checked);};list.append(lab);});};
    search.oninput=()=>{termQ=search.value;fill();};
    body.append(search);
    if(subs.length)body.append(h("div",{class:"subs"},[["","All"],...subs.map(x=>[x,x])].map(([v,t])=>h("button",{class:termSub===v?"on":"",onclick:()=>{termSub=v;refreshTerms();}},t))));
    body.append(list);fill();
  }
  return p;}
function bulkTerms(){const t=prompt("Paste entity names or ids (comma, semicolon or one per line):");if(!t)return;
  t.split(/[\n,;]+/).map(x=>x.trim()).filter(Boolean).map(x=>{const m=COURSE.entities.find(e=>e.name.toLowerCase()===x.toLowerCase());return m?m.id:x;}).forEach(id=>{if(!S.terms.some(x=>x.id===id))S.terms.push({id,key:true,pin:false,groups:"",order:""});});rerender();}

/* ---------------- inquiries: checkboxes ---------------- */
function inquiryPanel(){
  const chosen=splitLC(S.inquiries);
  const known=COURSE.inquiries.map(q=>q.id);
  const p=h("details",{class:"panel",id:"inqPanel",open:true},h("summary",{},"Big questions (inquiries)",h("span",{class:"count",id:"inqCount"},chosen.length)));
  const body=h("div",{class:"body"});p.append(body);
