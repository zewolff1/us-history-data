/* ---------------- state -> lesson JSON ---------------- */
const splitL=t=>String(t||"").split(/\s*;\s*/).map(x=>x.trim()).filter(Boolean);
const splitLC=t=>String(t||"").split(/[;,]/).map(x=>x.trim()).filter(Boolean);
const numOr=v=>{const n=parseFloat(String(v==null?"":v).trim());return isNaN(n)?undefined:n;};
function clean(o){Object.keys(o).forEach(k=>{if(o[k]===undefined||o[k]===""||(Array.isArray(o[k])&&!o[k].length&&k!=="choices"))delete o[k];});return o;}
function toJson(S){
  const id=S.id.trim();const out={schemaVersion:1,id};
  if(S.number.trim())out.number=S.number.trim();if(S.title.trim())out.title=S.title.trim();if(S.unit)out.unit=S.unit;if(S.unitTitle)out.unitTitle=S.unitTitle;
  const objs=S.objectives.map(x=>x.trim()).filter(Boolean);
  if(objs.length)out.objectives=objs.map((t,i)=>({id:`${id}-o${i+1}`,text:t}));
  const sk=splitLC(S.skills);if(sk.length)out.skills=sk;
  if(S.notesLink.trim()){out.notesLink=S.notesLink.trim();if(S.notesTitle.trim())out.notesTitle=S.notesTitle.trim();}
  const terms=S.terms.filter(t=>t.id.trim());
  if(terms.length){out.mentions=[];out.keyTerms=[];out.pinnedTerms=[];const groups={};let pos=0;
    terms.forEach(t=>{const e=t.id.trim();out.mentions.push(e);if(t.key)out.keyTerms.push(e);if(t.pin)out.pinnedTerms.push(e);
      splitL(t.groups).forEach(g=>{const k=g.toLowerCase();if(!groups[k])groups[k]={name:g,members:[]};
        if(!groups[k].members.some(m=>m.id===e))groups[k].members.push(clean({id:e,order:numOr(t.order),pos:pos++}));});});
    const gl=Object.values(groups);if(gl.length)out.termGroups=gl;}
  const inq=splitLC(S.inquiries);if(inq.length)out.inquiryFocus=inq;
  ["presetLabels","timelineFocus","timelineStartYear","timelineEndYear"].forEach(k=>{if(S.keep&&S.keep[k]!==undefined)out[k]=S.keep[k];}); // not edited here, but kept if the file had them
  /* sources */
  const readings=[],videos=[],images=[];
  S.sources.forEach((s,i)=>{
    if(!s.title.trim()&&!(s.kind==="image"&&s.files.some(f=>f.src.trim())))return;
    const common={set:s.set.trim()||undefined,setOrder:numOr(s.setOrder),order:numOr(s.order),termGroup:splitL(s.termGroup),teacherPinned:s.pin||undefined,_order:i};
    if(s.kind==="reading")readings.push(clean({title:s.title.trim(),source:s.source.trim(),note:s.note.trim()||undefined,
      text:rawsOf(s).join("\n\n"),image:s.image.trim()||undefined,embedUrl:s.embedUrl.trim()||undefined,...common}));
    if(s.kind==="video")videos.push(clean({title:s.title.trim(),length:s.length.trim()||undefined,note:s.note.trim()||undefined,src:s.src.trim(),image:s.image.trim()||undefined,...common}));
    if(s.kind==="image")images.push(clean({title:s.title.trim(),note:s.note.trim()||undefined,
      files:s.files.filter(f=>f.src.trim()).map(f=>f.caption.trim()?{src:f.src.trim(),caption:f.caption.trim()}:f.src.trim()),...common}));
  });
  /* questions */
  const doNow=[],std=[];
  S.questions.forEach(q=>{if(!q.prompt.trim())return;
    const o={type:q.type,prompt:q.prompt.trim()};
    const on=(q.objectives||"").split(",").map(x=>x.trim()).filter(Boolean);if(on.length)o.objectiveIds=on.map(n=>`${id}-o${n}`);
    if(q.image.trim())o.image=q.image.trim();if(q.termGroup.trim())o.termGroup=q.termGroup.trim();if(q.skill.trim())o.skill=q.skill.trim();
    if(q.requiresApproval&&q.type==="short_answer")o.requiresApproval=true;if(q.group.trim())o.group=q.group.trim();
    if(q.type==="link"){o.link=q.link.trim();if(q.linkLabel.trim())o.linkLabel=q.linkLabel.trim();}
    else if(q.type==="short_answer")o.sampleAnswer=q.sampleAnswer.trim();
    else{o.choices=q.choices.map(c=>c.trim()).filter(Boolean);o.correctIndex=Number(q.correct)||0;if(q.explanation.trim())o.explanation=q.explanation.trim();}
    const find=(arr)=>arr.find(x=>x.title.toLowerCase()===q.target.trim().toLowerCase());
    if(q.where==="donow")doNow.push(o);
    else if(q.where==="reading"&&find(readings)){o.afterParagraph=Number(q.afterParagraph)||0;(find(readings).questions=find(readings).questions||[]).push(o);}
    else if(q.where==="video"&&find(videos))(find(videos).questions=find(videos).questions||[]).push(o);
    else if(q.where==="gallery"&&find(images))(find(images).questions=find(images).questions||[]).push(o);
    else std.push(o);
  });
  if(readings.length)out.readings=readings;if(videos.length)out.videos=videos;if(images.length)out.images=images;
  if(doNow.length)out.doNow=doNow;if(std.length)out.assessment=std;
  const as=S.assessments.filter(a=>a.link.trim()).map(a=>clean({title:a.title.trim(),description:a.description.trim(),link:a.link.trim(),linkLabel:a.linkLabel.trim(),visible:!!a.visible,doNow:!!a.doNow}));
  if(as.length)out.assessments=as.map(a=>({visible:false,doNow:false,...a}));
  return out;
}

/* ---------------- lesson JSON -> state ---------------- */
function toState(j){const s=blankState();
  s.id=j.id||"";s.number=j.number||"";s.title=j.title||"";s.unit=j.unit||"";s.unitTitle=j.unitTitle||"";
  s.objectives=(j.objectives||[]).map(o=>o.text);if(!s.objectives.length)s.objectives=[""];
  s.skills=(j.skills||[]).join("; ");s.notesLink=j.notesLink||"";s.notesTitle=j.notesTitle||"";
  const g={};(j.termGroups||[]).forEach(tg=>tg.members.forEach(m=>{(g[m.id]=g[m.id]||[]).push({name:tg.name,order:m.order});}));
  s.terms=(j.mentions||[]).map(id=>({id,key:(j.keyTerms||[]).includes(id),pin:(j.pinnedTerms||[]).includes(id),groups:(g[id]||[]).map(x=>x.name).join("; "),order:(g[id]||[]).find(x=>x.order!=null)?.order??""}));
  s.inquiries=(j.inquiryFocus||[]).join("; ");
  ["presetLabels","timelineFocus","timelineStartYear","timelineEndYear"].forEach(k=>{if(j[k]!==undefined)s.keep[k]=j[k];});
  const src=[];const qs=[];
  const cq=(q,where,target,ap)=>{const n=newQuestion();Object.assign(n,{type:q.type||"multiple_choice",where,target:target||"",afterParagraph:ap||0,prompt:q.prompt||"",
    choices:q.choices&&q.choices.length?q.choices.slice():(q.type==="multiple_choice"||!q.type?["","","",""]:[]),correct:q.correctIndex||0,explanation:q.explanation||"",sampleAnswer:q.sampleAnswer||"",
    link:q.link||"",linkLabel:q.linkLabel||"",skill:q.skill||"",objectives:(q.objectiveIds||[]).map(x=>String(x).split("-o").pop()).join(", "),group:q.group||"",image:q.image||"",termGroup:q.termGroup||"",requiresApproval:!!q.requiresApproval});qs.push(n);};
  const base=(x,kind,order)=>({...newSource(kind),title:x.title||"",note:x.note||"",set:x.set||"",setOrder:x.setOrder??"",order:x.order??"",termGroup:(x.termGroup||[]).join("; "),pin:!!x.teacherPinned,_o:x._order??order});
  (j.readings||[]).forEach((r,i)=>{src.push({...base(r,"reading",i),source:r.source||"",blocks:(()=>{const b=parseRawText(r.text);return b.length?b:[{type:"paragraph",text:""}];})(),image:r.image||"",embedUrl:r.embedUrl||""});(r.questions||[]).forEach(q=>cq(q,"reading",r.title,q.afterParagraph));});
  (j.videos||[]).forEach((v,i)=>{src.push({...base(v,"video",100+i),src:v.src||"",length:v.length||"",image:v.image||""});(v.questions||[]).forEach(q=>cq(q,"video",v.title));});
  (j.images||[]).forEach((m,i)=>{src.push({...base(m,"image",200+i),files:(m.files||[]).map(f=>typeof f==="string"?{src:f,caption:""}:{src:f.src,caption:f.caption||""})});(m.questions||[]).forEach(q=>cq(q,"gallery",m.title));});
  src.sort((a,b)=>a._o-b._o);src.forEach(x=>delete x._o);s.sources=src;
  (j.doNow||[]).forEach(q=>cq(q,"donow"));(j.assessment||[]).forEach(q=>cq(q,"standalone"));
  s.questions=qs;
  s.assessments=(j.assessments||[]).map(a=>({title:a.title||"",link:a.link||"",description:a.description||"",linkLabel:a.linkLabel||"",visible:!!a.visible,doNow:!!a.doNow}));
  return s;}

/* ---------------- checks, preview, io ---------------- */
function problems(){const w=[];const id=S.id.trim();
  if(!id)w.push("Pick a lesson — type its number (like 4.2) so the id, title and unit fill in.");
  const titles=S.sources.map(s=>s.title.trim().toLowerCase()).filter(Boolean);
  if(new Set(titles).size!==titles.length)w.push("Two sources share a title; questions attach by title, so make them different.");
  S.questions.forEach((q,i)=>{const n="Question "+(i+1);
    if(!q.prompt.trim())return;
    if(["reading","video","gallery"].includes(q.where)&&!q.target.trim())w.push(n+": choose which "+q.where+" it belongs to (it will land in the Check Your Understanding list otherwise).");
    if(q.type==="multiple_choice"){const c=q.choices.map(x=>x.trim()).filter(Boolean);if(c.length<2)w.push(n+": needs at least 2 answer choices.");
      if(!q.choices[q.correct]||!q.choices[q.correct].trim())w.push(n+": the selected correct answer is blank.");}
    if(q.type==="link"&&!q.link.trim())w.push(n+": add a link.");
    if(/YOUR READING TITLE/i.test(q.target))w.push(n+": placeholder text left in.");});
  const per={};S.questions.forEach(q=>{if(q.where!=="standalone"&&q.where!=="donow"&&q.target){const k=q.where+"|"+q.target;per[k]=(per[k]||0)+1;}});
  Object.entries(per).forEach(([k,n])=>{if(n>5)w.push(`"${k.split("|")[1]}" has ${n} questions; students see at most 5.`);});
  S.terms.forEach(t=>{if(t.id.trim()&&COURSE.entities.length&&!COURSE.entities.some(e=>e.id===t.id.trim()))w.push(`Term id “${t.id}” isn't in the loaded entities.`);});
  return w;}

/* ---------------- lesson preview ---------------- */
function lpQuestion(q,tag){
  const box=h("div",{class:"q"});
  box.append(h("div",{class:"tagline"},[tag,q.skill?"Skill: "+q.skill:""].filter(Boolean).join(" · ")),h("div",{class:"qt"},q.prompt||""));
  if(q.type==="link"){box.append(h("span",{class:"btn"},q.linkLabel||"Open →"),h("span",{class:"hint",style:"margin-left:.5rem"},q.link||""));}
  else if(q.type==="short_answer"){box.append(h("textarea",{rows:2,placeholder:"Student types an answer…"}));
    if(q.sampleAnswer)box.append(h("div",{class:"fb"},"Sample answer: "+q.sampleAnswer));if(q.requiresApproval)box.append(h("div",{class:"fb"},"(Answers held until you approve them.)"));}
  else{const fb=h("div",{class:"fb"});const labs=[];
    (q.choices||[]).forEach((c,i)=>{const r=h("input",{type:"radio",name:"lp"+Math.random()});const lab=h("label",{},r,"  "+c);labs.push(lab);
      r.onchange=()=>{labs.forEach((l,k)=>l.className=k===(q.correctIndex||0)?"right":(k===i?"wrong":""));fb.textContent=(i===(q.correctIndex||0)?"Correct. ":"Not quite. ")+(q.explanation||"");};box.append(lab);});
    box.append(fb);}
  return box;}
function lpBlocks(text,questions){
  const wrap=h("div",{});const raws=String(text||"").split(/\n\s*\n/).map(x=>x.trim()).filter(Boolean);
  const qs=(questions||[]);
  raws.forEach((r,i)=>{
    let el;
    if(/^---+$/.test(r))el=h("hr");
    else if(r.startsWith("### "))el=h("h5",{class:"rb"},r.slice(4));
    else if(r.startsWith("## "))el=h("h4",{class:"rb"},r.slice(3));
    else if(r.startsWith("# "))el=h("h2",{class:"rb"},r.slice(2));
    else if(r.startsWith("> "))el=h("blockquote",{},r.slice(2));
    else if(r.startsWith("^ "))el=h("p",{class:"cen"},r.slice(2));
    else if(r.startsWith("-- "))el=h("p",{class:"att"},"— "+r.slice(3));
    else if(r.startsWith("! "))el=h("p",{class:"call"},r.slice(2));
    else if(r.startsWith("~ "))el=h("p",{class:"poem"},r.slice(2).split(/ \/\/ /).join("\n"));
    else if(r.startsWith("- "))el=h("ul",{},r.slice(2).split(/ \/\/ /).map(x=>h("li",{},x)));
    else el=h("p",{},r);
    wrap.append(el);
    qs.filter(q=>(q.afterParagraph||0)===i).forEach(q=>wrap.append(lpQuestion(q,"Question after block #"+i)));});
  qs.filter(q=>(q.afterParagraph||0)>=raws.length).forEach(q=>wrap.append(lpQuestion(q,"Question")));
  return wrap;}
function renderLessonPreview(){
  const box=$("#lessonPv");if(!box)return;box.innerHTML="";const j=toJson(S);
  const sec=t=>box.append(h("h3",{class:"sec"},t));
  box.append(h("div",{class:"unit"},[j.unitTitle||(j.unit?"Unit "+String(j.unit).replace(/\D+/g,""):""),j.number?"Lesson "+j.number:""].filter(Boolean).join(" · ")),
    h("h1",{class:"lt"},j.title||"(untitled lesson)"));
  if(j.skills&&j.skills.length)box.append(h("div",{class:"hint"},"Lesson skills: "+j.skills.join(", ")));
  if(j.notesLink)box.append(h("div",{class:"hint"},"📝 Notes button (teacher only) → "+j.notesLink));
  const dn=[...(j.doNow||[]),...(j.assessments||[]).filter(a=>a.doNow).map(a=>({type:"link",prompt:a.title||"Assessment",link:a.link,linkLabel:a.linkLabel||"Start"}))];
  if(dn.length){sec("Do Now");const d=h("div",{class:"donow"});dn.forEach(q=>d.append(lpQuestion(q,"Do Now")));box.append(d);}
  if(j.objectives&&j.objectives.length){sec("Objectives");box.append(h("ul",{},j.objectives.map(o=>h("li",{},o.text))));}
  if(j.inquiryFocus&&j.inquiryFocus.length){sec("Big questions");
    box.append(h("ul",{},j.inquiryFocus.map(id=>{const q=COURSE.inquiries.find(x=>x.id===id);return h("li",{},q?q.question:id+" (not in your inquiry list)");})));}
  if(j.mentions&&j.mentions.length){sec("People, topics & events");
    const keys=new Set(j.keyTerms||[]);box.append(h("div",{class:"chips"},j.mentions.map(id=>h("span",{class:keys.has(id)?"key":""},entityName(id)||id))));
    const k=j.mentions.filter(id=>keys.has(id));
    if(k.length){box.append(h("div",{class:"hint"},"Filled chips are key terms (“What You Need to Know”)."));}}
  const src=[...(j.readings||[]).map(x=>({k:"reading",x})),...(j.videos||[]).map(x=>({k:"video",x})),...(j.images||[]).map(x=>({k:"image",x}))].sort((a,b)=>(a.x._order??0)-(b.x._order??0));
  if(src.length){sec("Sources");
    src.forEach(({k,x})=>{const card=h("div",{class:"src "+k},h("h4",{},x.title||"(untitled)"),
      h("div",{class:"meta"},[k==="reading"?"Reading":k==="video"?"Video"+(x.length?" · "+x.length:""):"Image"+((x.files||[]).length>1?" gallery":""),x.source,x.note].filter(Boolean).join(" · ")));
      if(k==="reading"){card.append(lpBlocks(x.text,x.questions));if(x.image)card.append(h("img",{src:x.image,alt:""}));}
      if(k==="video"){card.append(h("div",{class:"ph"},"▶ "+(x.src||"no video link yet")));(x.questions||[]).forEach(q=>card.append(lpQuestion(q,"Question below video")));}
      if(k==="image"){(x.files||[]).forEach(f=>{const u=typeof f==="string"?f:f.src;card.append(h("img",{src:u,alt:"",onerror:function(){this.style.display="none";}}));if(typeof f!=="string"&&f.caption)card.append(h("div",{class:"hint"},f.caption));});(x.questions||[]).forEach(q=>card.append(lpQuestion(q,"Question below image")));}
      box.append(card);});}
  if(j.assessment&&j.assessment.length){sec("Check your understanding");j.assessment.forEach(q=>box.append(lpQuestion(q,"Check your understanding")));}
  if(j.assessments&&j.assessments.length){sec("Assessments");
    j.assessments.forEach(a=>box.append(h("div",{class:"acard"},a.visible?null:h("div",{class:"hid"},"Hidden from students — you see it in teacher mode"),h("h4",{style:"margin:.1rem 0"},a.title||"Assessment"),
      a.description?h("p",{style:"margin:.2rem 0 .5rem"},a.description):null,h("span",{class:"btn"},a.linkLabel||"Open →"))));}
  if(box.children.length<=2)box.append(h("div",{class:"hint"},"Start filling in the lesson above and it shows up here."));
}
function updatePreview(){const w=problems();const box=$("#warns");box.innerHTML="";
  if(w.length)box.append(h("div",{class:"warns"},"Check before you download:",h("ul",{},w.map(x=>h("li",{},x)))));
  $("#preview").textContent=JSON.stringify(toJson(S),null,2);
  if($("#lpPanel").open){clearTimeout(lpTimer);lpTimer=setTimeout(renderLessonPreview,250);}}
let lpTimer=null;
function download(){const w=problems();if(!S.id.trim()){alert("Add a Lesson ID first.");return;}
  if(w.length&&!confirm(w.length+" thing(s) to check:\n\n• "+w.slice(0,6).join("\n• ")+"\n\nDownload anyway?"))return;
  const blob=new Blob([JSON.stringify(toJson(S),null,2)],{type:"application/json"});const a=h("a",{href:URL.createObjectURL(blob),download:fileName()});document.body.append(a);a.click();a.remove();$("#status").textContent="Downloaded "+fileName();}
function readFile(f,cb){const r=new FileReader();r.onload=()=>cb(String(r.result));r.readAsText(f);}
function parseCsv(text){const rows=[];let row=[],f="",q=false;text=text.replace(/^\uFEFF/,"");
  for(let i=0;i<text.length;i++){const c=text[i];
    if(q){if(c==='"'){if(text[i+1]==='"'){f+='"';i++;}else q=false;}else f+=c;}
    else if(c==='"')q=true;else if(c===","){row.push(f);f="";}
    else if(c==="\n"||c==="\r"){if(c==="\r"&&text[i+1]==="\n")i++;row.push(f);f="";rows.push(row);row=[];}
    else f+=c;}
  if(f!==""||row.length){row.push(f);rows.push(row);}
  const head=rows.shift()||[];return rows.filter(r=>r.some(x=>x.trim())).map(r=>{const o={};head.forEach((k,i)=>o[k]=r[i]||"");return o;});}
function importCsv(text,idGuess){
  const rows=parseCsv(text);const lesson={id:idGuess||S.id||""};
  const COURSE_DATA={timeline:[]};
  const warn=console.warn;console.warn=()=>{};
  try{applyLessonSheetRowsLocal(lesson,rows,COURSE_DATA);}finally{console.warn=warn;}
  const st=toState(lesson);
  st.id=lesson.id;st.number=S.number;st.title=S.title;S=st;applyLesson();rerender();
  $("#status").textContent="Imported "+rows.length+" rows — check each section, then set the Lesson ID.";}
const entRow=r=>({id:String(r.id||"").trim(),name:String(r.name||"").trim(),category:String(r.category||"").trim(),subcategory:r.subcategory||r.role||r.type||undefined,
  definition:r.definition||"",actions:Array.isArray(r.actions)?r.actions:(r.actions?String(r.actions).split(/\s*\|\|\|\s*/).filter(Boolean):[]),image:r.image||undefined});
function setEntities(list,from){COURSE.entities=list.filter(e=>e.id&&e.name);
  try{localStorage.setItem("lessonComposerCourse",JSON.stringify(COURSE));}catch(e){}
  $("#status").textContent=`${COURSE.entities.length} entities loaded from ${from}.`;rerender();}
async function loadCourse(){
  loadInquiries();
  /* 1) entities.json on GitHub  2) the published Entities tab  3) a file you pick */
  try{const res=await fetch(ENTITIES_URL,{cache:"no-cache"});if(!res.ok)throw 0;const j=await res.json();
    setEntities((Array.isArray(j)?j:j.entities||[]).map(entRow),"GitHub (entities.json)");return;}catch(e){}
  try{const res=await fetch(`${SHEETS_BASE_URL}?gid=2103913057&single=true&output=csv`);if(!res.ok)throw 0;
    setEntities(parseCsv(await res.text()).map(normalizeRow).map(entRow),"your sheet (no entities.json on GitHub yet)");return;}catch(e){}
  $("#status").textContent="Couldn't reach GitHub or the sheet — pick an entities file instead.";$("#fEnt").click();}
function saveEntities(){if(!COURSE.entities.length){alert("Load entities first.");return;}
  const blob=new Blob([JSON.stringify(COURSE.entities,null,1)],{type:"application/json"});const a=h("a",{href:URL.createObjectURL(blob),download:"entities.json"});document.body.append(a);a.click();a.remove();}

$("#dl").onclick=download;
$("#cp").onclick=()=>{navigator.clipboard.writeText(JSON.stringify(toJson(S),null,2)).then(()=>$("#status").textContent="Copied JSON");};
$("#ld").onclick=()=>$("#fJson").click();
$("#fJson").onchange=e=>{const f=e.target.files[0];if(!f)return;readFile(f,t=>{try{S=toState(JSON.parse(t));rerender();$("#status").textContent="Opened "+f.name;}catch(err){alert("That file isn't valid lesson JSON: "+err.message);}});e.target.value="";};
$("#csv").onclick=()=>$("#fCsv").click();
$("#fCsv").onchange=e=>{const f=e.target.files[0];if(!f)return;readFile(f,t=>importCsv(t,(f.name.match(/\d+[-–]\d+/)||[""])[0].replace("–","-")));e.target.value="";};
$("#ent").onclick=loadCourse;$("#entdl").onclick=saveEntities;$("#inqdl").onclick=saveInquiries;
$("#fEnt").onchange=e=>{const f=e.target.files[0];if(!f)return;readFile(f,t=>{let rows;try{rows=JSON.parse(t);}catch(x){rows=parseCsv(t).map(normalizeRow);}
  setEntities((Array.isArray(rows)?rows:rows.entities||[]).map(entRow),f.name);});e.target.value="";};
$("#nw").onclick=()=>{if(confirm("Start a blank lesson? (Download first if you need this one.)")){S=blankState();rerender();}};

document.body.append(h("datalist",{id:"dl-skill"},SKILL_HINTS.map(x=>h("option",{value:x}))));
try{const c=JSON.parse(localStorage.getItem("lessonComposerCourse")||"null");if(c)Object.assign(COURSE,c);}catch(e){}
try{const d=JSON.parse(localStorage.getItem("lessonComposerDraft")||"null");if(d&&(d.id||d.sources&&d.sources.length||d.questions&&d.questions.length)){S=Object.assign(blankState(),d);$("#status").textContent="Restored your unsaved draft";}}catch(e){}
$("#lpPanel").addEventListener("toggle",()=>{if($("#lpPanel").open)renderLessonPreview();});
render();loadLessonsList();
loadInquiries();
if(!COURSE.entities.length||true)fetch(ENTITIES_URL,{cache:"no-cache"}).then(r=>r.ok?r.json():Promise.reject()).then(j=>{COURSE.entities=(Array.isArray(j)?j:j.entities||[]).map(entRow).filter(e=>e.id&&e.name);rerender();$("#status").textContent=COURSE.entities.length+" entities loaded from GitHub";}).catch(()=>{});
</script>
</body>
