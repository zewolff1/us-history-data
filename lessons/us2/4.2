function bulkQuestions(){
  const t=prompt("Paste rows, one question per line, tab-separated:\nPrompt ⇥ Choice A ⇥ Choice B ⇥ Choice C ⇥ Choice D ⇥ Correct (A–D) ⇥ Skill ⇥ Explanation\n(copy straight from a spreadsheet)");
