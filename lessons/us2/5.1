            "Obsession with Crime and Punishment",
            "Rampant Cronyism and Corruption",
            "Fraudulent Elections"
          ],
          "per": 3,
          "glossary": {
            "nationalism": "Extreme pride in and loyalty to your own country, often believing it is better than all others.",
            "disdain": "A feeling that something is unworthy of respect. Looking down on it.",
            "scapegoat": "A person or group that is unfairly blamed for a problem.",
            "supremacy": "Being the most powerful or most important.",
            "rampant": "Spreading widely with nothing to stop it.",
            "intertwined": "Closely connected and mixed together.",
            "intellectual": "A person who studies and thinks deeply about ideas, such as a professor, writer or scientist.",
            "cronyism": "Giving jobs and favors to friends and allies instead of the most qualified people.",
            "fraudulent": "Dishonest and done to cheat."
          }
        },
