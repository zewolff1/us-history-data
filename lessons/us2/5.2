        "name": "Predict the Order",
        "directions": "These are the ten stages of genocide. Predict the order they happen in. Extermination is already placed to help you.",
        "order": {
          "title": "Predict the Order",
          "stages": [
            {
              "name": "Classification",
              "desc": "People are divided into “us” and “them” using stereotypes, or by leaving out people who seem different."
            },
            {
              "name": "Symbolization",
              "desc": "Hatred is made visible with names, symbols or clothing, like the yellow Star of David."
            },
            {
              "name": "Discrimination",
              "desc": "The dominant group denies civil rights or citizenship to certain groups, like the 1935 Nuremberg Laws."
            },
            {
              "name": "Dehumanization",
              "desc": "Targeted people are treated as less than human. They are called “vermin” or “cockroaches.”"
            },
            {
              "name": "Organization",
              "desc": "Genocide is planned. Regimes train and arm the people who will carry it out."
            },
            {
              "name": "Polarization",
              "desc": "Hate groups spread propaganda that pushes people apart."
            },
            {
              "name": "Preparation",
              "desc": "Perpetrators plan the genocide and use code words like “The Final Solution.”"
            },
            {
              "name": "Persecution",
              "desc": "Victims are identified, moved into ghettos, deported or starved, and their property is taken. Massacres begin."
            },
            {
              "name": "Extermination",
              "desc": "The hate group murders its victims in a deliberate, systematic campaign of violence."
            },
            {
              "name": "Denial",
              "desc": "Perpetrators or later generations deny the crime, destroy evidence and scare witnesses."
            }
          ],
